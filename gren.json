    "platform": "node",
    "name": "joeybright/gren-sqlite-auth",
    "summary": "Authentication primitives for Gren applications backed by SQLite.",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Sqlite.Auth.User",
        "Sqlite.Auth.Username",
        "Sqlite.Auth.Email",
        "Sqlite.Auth.Email.Parser",
