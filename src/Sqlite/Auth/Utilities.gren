module Sqlite.Auth.Utilities exposing
    ( base64
    , base64UrlSafe
    , sha256Base64
    , hashTokenString
    , nowMillis
    )

{-| Helpers shared across the `Sqlite.Auth` modules. Not exposed by the
package.

@docs base64
@docs base64UrlSafe
@docs sha256Base64
@docs hashTokenString
@docs nowMillis

-}

import Base64.Encode
import Bytes exposing ( Bytes )
import Crypto
import Task exposing ( Task )
import Time


{-| Encode bytes as a standard base64 string.
-}
base64 : Bytes -> String
base64 bytes =
    Base64.Encode.bytes bytes
        |> Base64.Encode.encode


{-| Encode bytes as a URL-safe base64 string: standard base64 with `+`/`/`
swapped for `-`/`_` and padding dropped — safe to embed in URLs and cookies.
-}
base64UrlSafe : Bytes -> String
base64UrlSafe bytes =
    base64 bytes
        |> String.replace "+" "-"
        |> String.replace "/" "_"
        |> String.replace "=" ""


{-| Hash bytes into the base64-encoded SHA-256 stored in token columns.
Tokens are full-entropy random values, so a single hash (no salt, no
stretching) makes the stored value useless to an attacker while staying
reproducible for lookups.
-}
sha256Base64 : Crypto.SecureContext -> Bytes -> Task x String
sha256Base64 secureContext bytes =
    Crypto.digest secureContext Crypto.Sha256 bytes
        |> Task.map base64


{-| Hash a presented token string into its stored value. The string itself is
hashed — never decoded back to bytes — so issuance and lookup agree by
construction.
-}
hashTokenString : Crypto.SecureContext -> String -> Task x String
hashTokenString secureContext token =
    sha256Base64 secureContext (Bytes.fromString token)


{-| The current time in milliseconds since the epoch — the form every
timestamp column stores.
-}
nowMillis : Task x Int
nowMillis =
    Time.now
        |> Task.map Time.posixToMillis
