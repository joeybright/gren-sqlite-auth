module Sqlite.Auth.Password exposing
    ( migrationV1
    , Password
    , PlainText
    , Hashed
    , Options
    , defaultOptions
    , fromString
    , hash
    , HashError(..)
    , add
    , validate
    , Outcome(..)
    , ValidateError(..)
    , VerifyError(..)
    , change
    , delete
    , requestReset
    , reset
    , ResetError(..)
    )

{-| Create, hash, store, validate, change, reset, and delete users' passwords.

This module prevents saving passwords as plain-text strings through its
functions. The [`Password`](#Password) type enforces this at compile time.
Passwords must be [hashed](#hash) before they can be saved to the database, and
all verification functions properly compare against the stored password hash.

## Migrations

All migrations are meant to be plug-and-play with the `gren-sqlite-migrate`
package:

    Sqlite.Migrate.migrate database
        { secureContext = secureContext }
        (Sqlite.Auth.Password.migrationV1 ++ yourOtherMigrations)

If you are using a different method of migration, the individual SQL statements
can be extracted from each migration's `statements` field.

@docs migrationV1

## Working with passwords

@docs Password, PlainText, Hashed

### Creating passwords

@docs Options, defaultOptions
@docs fromString
@docs hash, HashError

### Adding and validating passwords

@docs add
@docs validate, Outcome, ValidateError, VerifyError

### Changing, resetting, and deleting passwords

@docs change
@docs delete
@docs requestReset
@docs reset, ResetError

-}

import Base64.Decode
import Bytes exposing ( Bytes )
import Crypto
import Dict exposing ( Dict )
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Auth.Password.PhcString as PhcString
import Sqlite.Auth.Session as Session
import Sqlite.Auth.User as User
import Sqlite.Decode
import Sqlite.Decode.Row
import Sqlite.Encode
import Sqlite.Encode.Row
import Task exposing ( Task )
import Utils.Base64
import Utils.Crypto
import Utils.Time


{-| Initial migration required for functions in this module to operate. Adds
the `passwords` and `password_reset_tokens` tables. Both reference users, so
run this after [`Sqlite.Auth.User.migrationV1`](Sqlite.Auth.User#migrationV1).

The first statement creates the `passwords` table:

    CREATE TABLE IF NOT EXISTS passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );

- `user_id` is the primary key and references the users (in the
[`Sqlite.Auth.User`](Sqlite.Auth.User) module), so there is one password per user.
- `password` is the user's hashed password, stored in PHC string format.
- Both `created_at` and `updated_at` are posix timestamp values.
- `last_used` is a posix timestamp of the last successful check, or null if never.
- `failed_login_attempts_count` counts consecutive failed checks.
- `locked_until` is the posix timestamp the password stays locked until after
too many failures, or null when unlocked.

The second statement creates the `password_reset_tokens` table:

    CREATE TABLE IF NOT EXISTS password_reset_tokens (
        reset_token TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );

- `reset_token` is the primary key and stores the SHA-256 hash of the token.
- `user_id` references the users and is `UNIQUE`, so there is at most one live
reset token per user.
- `created_at` is a posix timestamp, and `expires_at` is the posix timestamp the
token stops being redeemable.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.Password.migrationV1` - Add passwords and password_reset_tokens tables"
    , statements =
        [ addPasswordsTableMigrationSQL
        , addPasswordResetTokensTableMigrationSQL
        ]
    }


{-|-}
addPasswordsTableMigrationSQL : String
addPasswordsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-|-}
addPasswordResetTokensTableMigrationSQL : String
addPasswordResetTokensTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS password_reset_tokens (
        reset_token TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| A password in plain text, as received from the user.
-}
type PlainText
    = PlainText


{-| A password that has been hashed and is safe to persist.
-}
type Hashed
    = Hashed


{-| A password, with a phantom type state of either [`PlainText`](#PlainText) or
[`Hashed`](#Hashed). Only the hashed form can be saved to the database.
-}
type Password state
    = Password String


{-| Turn a `String` into a plain-text [`Password`](#Password), ready to
[`hash`](#hash), or to pass to [`validate`](#validate).
-}
fromString : String -> Password PlainText
fromString =
    Password


{-| Errors that can happen while deriving a password hash.

- `ImportPbkdf2KeyError` happens when the plain-text password cannot be
imported as PBKDF2 key material.
- `Pbkdf2DeriveBitsError` happens when the PBKDF2 derivation itself fails.
- `TooManyIterations` happens raised when [`hash`](#hash) is asked for more rounds
than ten times the default. It carries the rejected count.
-}
type HashError
    = ImportPbkdf2KeyError Crypto.ImportPbkdf2KeyError
    | Pbkdf2DeriveBitsError Crypto.Pbkdf2DeriveBitsError
    | TooManyIterations Int


{-| The options the password functions take.

- `iterations` is the PBKDF2 round count for new hashes. The `Crypto` library
enforces a minimum of `600000` for SHA-256. Lower values make [`hash`](#hash)
fail with a [`HashError`](#HashError). Values ten times the default (6000000 
or above) are also denied as `error`
- `maxFailedAttempts` and `lockoutDurationMillis` control the lockout.
- `resetTokenLifetimeMillis` is how long a reset token stays redeemable.
  Longer lifetimes forgive users who click late; shorter ones shrink the
  window a leaked link stays live. See [`requestReset`](#requestReset).
-}
type alias Options =
    { iterations : Int
    , maxFailedAttempts : Int
    , lockoutDurationMillis : Int
    , resetTokenLifetimeMillis : Int
    }


{-| The default, recommended, options for password hashing.

    { iterations = 600000
    , maxFailedAttempts = 5
    , lockoutDurationMillis = 900000 -- 15 minutes
    , resetTokenLifetimeMillis = 1800000 -- 30 minutes
    }
-}
defaultOptions : Options
defaultOptions =
    { iterations = 600000
    , maxFailedAttempts = 5
    , lockoutDurationMillis = 15 * 60 * 1000
    , resetTokenLifetimeMillis = 30 * 60 * 1000
    }


{-| The largest PBKDF2 iteration count this package accepts, whether creating a
hash ([`hash`](#hash)) or verifying a stored one ([`verify`](#verify)).
-}
maxIterations : Int
maxIterations =
    defaultOptions.iterations * 10


{-| The largest salt length, in bytes, accepted when verifying a stored hash.
-}
maxSaltBytes : Int
maxSaltBytes =
    64


{-| Hash a plain-text password into a [`Password Hashed`](#Password) ready for
[`add`](#add). Uses PBKDF2-SHA256 with `options.iterations` rounds and a random
16-byte salt. Returns a `Password Hashed` that can then be saved to the database.

Iterations above ten times the default are rejected with
[`TooManyIterations`](#TooManyIterations), so the cost of every stored hash
stays bounded.

Note that the algorithm used to produce the password hash is SHA-256. This cannot
currently be changed.
-}
hash : Crypto.SecureContext -> Options -> Password PlainText -> Task HashError (Password Hashed)
hash secureContext options (Password string) =
    if options.iterations > maxIterations then
        Task.fail (TooManyIterations options.iterations)

    else
        Crypto.getRandomUInt8Values 16
            |> Task.andThen
                (\salt ->
                    derivePhcString secureContext
                        { password = string
                        , salt = salt
                        , iterations = options.iterations
                        , digestAlgorithm = Crypto.Sha256
                        }
                )
            |> Task.map Password


{-| Run the PBKDF2 derivation. Imports the password as key material, then
derives the hash bytes from the salt, iteration count, and digest algorithm.
-}
deriveBits :
    Crypto.SecureContext
    -> { password : String, salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
    -> Task HashError Bytes
deriveBits secureContext { password, salt, iterations, digestAlgorithm } =
    password
        |> Bytes.fromString
        |> Crypto.importPbkdf2KeyFromRaw secureContext
        |> Task.mapError ImportPbkdf2KeyError
        |> Task.andThen
            (\importedPbkdf2Key ->
                Crypto.deriveBitsWithPbkdf2
                    { salt = salt
                    , iterations = iterations
                    , hash = digestAlgorithm
                    }
                    Nothing
                    importedPbkdf2Key
                    |> Task.mapError Pbkdf2DeriveBitsError
            )


{-| Derive a hash from an explicit salt, iteration count, and digest algorithm,
and encode it as a PHC string.
-}
derivePhcString :
    Crypto.SecureContext
    -> { password : String, salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
    -> Task HashError String
derivePhcString secureContext ({ salt, iterations, digestAlgorithm } as params) =
    deriveBits secureContext params
        |> Task.map
            (\hashedPasswordBytes ->
                PhcString.toString
                    { id = pbkdf2IdString digestAlgorithm
                    , params = Dict.singleton "i" (String.fromInt iterations)
                    , tail =
                        PhcString.SaltAndHash
                            { salt = Utils.Base64.encodeBytes salt
                            , hash = Utils.Base64.encodeBytes hashedPasswordBytes
                            }
                    }
            )


{-| The PHC identifier for a PBKDF2 hash with the given digest algorithm. The
inverse of [`digestAlgorithmFromId`](#digestAlgorithmFromId).
-}
pbkdf2IdString : Crypto.DigestAlgorithm -> String
pbkdf2IdString digestAlgorithm =
    when digestAlgorithm is
        Crypto.Sha256 ->
            "pbkdf2-sha256"

        Crypto.Sha384 ->
            "pbkdf2-sha384"

        Crypto.Sha512 ->
            "pbkdf2-sha512"


{-| Store a hashed password for the given user to the database, returning the 
user on success for further pipeline steps.

    User.new database secureContext
        |> Task.andThen (Username.new database alice)
        |> Task.andThen (Password.add database hashedPassword)
-}
add : Sqlite.Database -> Password Hashed -> User.User -> Task Sqlite.Error User.User
add database (Password phcString) ((Internal.User { userId }) as user) =
    insertRow database { userId = userId, phcString = phcString }
        |> Task.map (\_ -> user)


{-| The outcome of validating a candidate password.

- [`Verified`](Sqlite.Auth.User#Verified) contains the verified user
[`Sqlite.Auth.Session.issue`](Sqlite.Auth.Session#issue) requires to issue a
session. 
- `Rejected` means the candidate did not match or the user has no password. 
- `Locked` means the password is temporarily locked after repeated failures.
-}
type Outcome
    = Verified User.Verified
    | Rejected
    | Locked


{-| An error when validating a password.

- `StorageError` is an underlying error in the Sqlite database.
- `VerificationError` is a fault in the stored hash itself; see
[`VerifyError`](#VerifyError) for the ways it can happen.
-}
type ValidateError
    = StorageError Sqlite.Error
    | VerificationError VerifyError


{-| The ways a stored PHC string can fail to verify against other than a plain
mismatch.

- `ParsePhcStringError` is when the stored hash is not a valid PHC string.
- `UnknownDigestAlgorithm` is when the PHC string names a digest algorithm this
module does not support.
- `MissingSalt` is when the PHC string has no salt segment.
- `InvalidSalt` is when the salt segment is not valid base64.
- `SaltTooLong` is when the salt exceeds the accepted maximum length.
- `MissingHash` is when the PHC string has no hash segment.
- `InvalidHash` is when the hash segment is not valid base64.
- `HashLengthMismatch` is when the hash length does not match the digest
algorithm's native output size.
- `MissingIterations` is when the PHC string has no `i` (iterations) parameter.
- `InvalidIterations` is when the `i` parameter is not a valid integer.
- `IterationsTooLarge` is when the iteration count exceeds the accepted maximum.
- `RederiveError` is when re-deriving the candidate's hash fails; it wraps a
[`HashError`](#HashError).
-}
type VerifyError
    = ParsePhcStringError PhcString.Error
    | UnknownDigestAlgorithm String
    | MissingSalt
    | InvalidSalt Base64.Decode.Error
    | SaltTooLong Int
    | MissingHash
    | InvalidHash Base64.Decode.Error
    | HashLengthMismatch { expected : Int, actual : Int }
    | MissingIterations
    | InvalidIterations String
    | IterationsTooLarge Int
    | RederiveError HashError


{-| Check a plain-text password against a user's stored password. The user argument 
is the `Maybe` that [`Sqlite.Auth.Username.user`](Sqlite.Auth.Username#user) returns 
to make chaining easier. For example, you might handle user login like this:

    Username.user database givenUserName
        |> Task.andThen (Password.validate database secureContext options candidate)
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Password.Verified proof ->
                        Session.issue database secureContext sessionOptions proof
                    ...
            )
-}
validate : Sqlite.Database -> Crypto.SecureContext -> Options -> Password PlainText -> Maybe User.User -> Task ValidateError Outcome
validate database secureContext options candidate maybeUser =
    when maybeUser is
        Nothing ->
            burnCandidate secureContext options candidate
                |> Task.map (\_ -> Rejected)

        Just (Internal.User { userId }) ->
            Utils.Time.nowMillis
                |> Task.andThen
                    (\now ->
                        getPasswordByUserId database { userId = userId }
                            |> Task.mapError StorageError
                            |> Task.andThen
                                (\maybeRow ->
                                    when maybeRow is
                                        Nothing ->
                                            burnCandidate secureContext options candidate
                                                |> Task.map (\_ -> Rejected)

                                        Just row ->
                                            when row.lockedUntil is
                                                Just lockedUntil ->
                                                    if lockedUntil > now then
                                                        burnCandidate secureContext options candidate
                                                            |> Task.map (\_ -> Locked)

                                                    else
                                                        clearExpiredLock database { now = now, userId = userId }
                                                            |> Task.mapError StorageError
                                                            |> Task.andThen
                                                                (\_ -> verifyAgainstRow database secureContext options { now = now, candidate = candidate, row = row })

                                                Nothing ->
                                                    verifyAgainstRow database secureContext options { now = now, candidate = candidate, row = row }
                                )
                    )


{-| The two expected outcomes of re-deriving a candidate against a stored hash.
Anything else is a fault and stays an error.
-}
type VerifyOutcome
    = Matched
    | Mismatched


{-| Re-derive a plain text password against an unlocked `passwords` row and record
the outcome.
-}
verifyAgainstRow :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Options
    -> { now : Int, candidate : Password PlainText, row : Row }
    -> Task ValidateError Outcome
verifyAgainstRow database secureContext options { now, candidate, row } =
    verify secureContext candidate row.password
        |> Task.andThen
            (\verifyOutcome ->
                when verifyOutcome is
                    Matched ->
                        updateRow database
                            { userId = row.userId
                            , lastUsed = Just now
                            , failedLoginAttemptsCount = 0
                            , lockedUntil = Nothing
                            }
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Verified (Internal.Verified { userId = row.userId }))

                    Mismatched ->
                        recordFailedAttempt database options { now = now, userId = row.userId }
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Rejected)
            )


{-| Record a failed check for the given users id. This bumps the failure counter 
and, when the new count reaches `options.maxFailedAttempts`, sets the lock.
-}
recordFailedAttempt : Sqlite.Database -> Options -> { now : Int, userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
recordFailedAttempt database options { now, userId } =
    Sqlite.execute database
        { statement =
            """
            UPDATE passwords
            SET updated_at = :updated_at,
                failed_login_attempts_count = failed_login_attempts_count + 1,
                locked_until = CASE
                    WHEN failed_login_attempts_count + 1 >= :max_failed_attempts
                    THEN :locked_until
                    ELSE NULL
                END
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.Row.column "updated_at" <| Sqlite.Encode.int now
            , Sqlite.Encode.Row.column "max_failed_attempts" <| Sqlite.Encode.int options.maxFailedAttempts
            , Sqlite.Encode.Row.column "locked_until" <| Sqlite.Encode.int (now + options.lockoutDurationMillis)
            , Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
            ]
        }


{-| Clear a user's failure counter and lock once the lock has expired, so the
next attempt starts fresh instead of immediately re-locking.
-}
clearExpiredLock : Sqlite.Database -> { now : Int, userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
clearExpiredLock database { now, userId } =
    Sqlite.execute database
        { statement =
            """
            UPDATE passwords
            SET failed_login_attempts_count = 0, locked_until = NULL, updated_at = :updated_at
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.Row.column "updated_at" <| Sqlite.Encode.int now
            , Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
            ]
        }


{-| Check a plain-text password against a stored PHC string. The stored string
carries everything needed to reproduce its own hash: the salt, the iteration
count, and the digest algorithm. So we parse those back out, re-derive the
candidate's hash through the same [`deriveBits`](#deriveBits) used to create the
stored one, and compare the raw hash bytes.
-}
verify : Crypto.SecureContext -> Password PlainText -> String -> Task ValidateError VerifyOutcome
verify secureContext (Password candidate) phcString =
    when parseStoredHash phcString is
        Err error ->
            Task.fail (VerificationError error)

        Ok { salt, iterations, digestAlgorithm, hashBytes } ->
            deriveBits secureContext
                { password = candidate
                , salt = salt
                , iterations = iterations
                , digestAlgorithm = digestAlgorithm
                }
                |> Task.mapError (RederiveError >> VerificationError)
                |> Task.map
                    (\rederivedBytes ->
                        if rederivedBytes == hashBytes then
                            Matched

                        else
                            Mismatched
                    )


{-| Recover everything [`verify`](#verify) needs from a stored PHC string.
-}
parseStoredHash : String -> Result VerifyError { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm, hashBytes : Bytes }
parseStoredHash phcString =
    PhcString.parse phcString
        |> Result.mapError ParsePhcStringError
        |> Result.andThen
            (\parsed ->
                Result.map3
                    (\salt iterations digestAlgorithm ->
                        (\hashBytes ->
                            { salt = salt
                            , iterations = iterations
                            , digestAlgorithm = digestAlgorithm
                            , hashBytes = hashBytes
                            }
                        )
                    )
                    (saltBytesFromTail parsed.tail)
                    (iterationsFromParams parsed.params)
                    (digestAlgorithmFromId parsed.id)
                    |> Result.andMap (hashBytesFromTail parsed.tail)
                    |> Result.andThen checkHashLength
            )


{-| Pull the raw salt `Bytes` out of a parsed PHC string's tail by base64
decoding the salt segment.
-}
saltBytesFromTail : PhcString.Tail -> Result VerifyError Bytes
saltBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash { salt } ->
            decodeSalt salt

        PhcString.SaltOnly salt ->
            decodeSalt salt

        PhcString.NoTail ->
            Err MissingSalt


{-| Decode a salt chunk and reject it when its length exceeds the accepted
maximum.
-}
decodeSalt : String -> Result VerifyError Bytes
decodeSalt encoded =
    Base64.Decode.bytes encoded
        |> Result.mapError InvalidSalt
        |> Result.andThen
            (\bytes ->
                if Bytes.length bytes > maxSaltBytes then
                    Err (SaltTooLong (Bytes.length bytes))

                else
                    Ok bytes
            )


{-| Pull the raw hash `Bytes` out of a parsed PHC string's tail by base64
decoding the hash segment. A tail without a hash segment can't be verified
against.
-}
hashBytesFromTail : PhcString.Tail -> Result VerifyError Bytes
hashBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash saltAndHash ->
            Base64.Decode.bytes saltAndHash.hash
                |> Result.mapError InvalidHash

        PhcString.SaltOnly _ ->
            Err MissingHash

        PhcString.NoTail ->
            Err MissingHash


{-| The native output size, in bytes, of a digest algorithm. Used to reject a
stored hash whose length does not match the digest that produced it.
-}
digestOutputBytes : Crypto.DigestAlgorithm -> Int
digestOutputBytes algorithm =
    when algorithm is
        Crypto.Sha256 ->
            32

        Crypto.Sha384 ->
            48

        Crypto.Sha512 ->
            64


{-| Reject a parsed stored hash whose `hashBytes` length does not match the
digest algorithm's native size.
-}
checkHashLength :
    { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm, hashBytes : Bytes }
    -> Result VerifyError { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm, hashBytes : Bytes }
checkHashLength record =
    let
        outputBytesCount = 
            digestOutputBytes record.digestAlgorithm
    in
    if Bytes.length record.hashBytes == outputBytesCount then
        Ok record

    else
        Err
            (HashLengthMismatch
                { expected = outputBytesCount
                , actual = Bytes.length record.hashBytes
                }
            )


{-| Read the PBKDF2 iteration count from a parsed PHC string's `i` parameter.
-}
iterationsFromParams : Dict String String -> Result VerifyError Int
iterationsFromParams params =
    when Dict.get "i" params is
        Nothing ->
            Err MissingIterations

        Just value ->
            when String.toInt value is
                Nothing ->
                    Err (InvalidIterations value)

                Just iterations ->
                    if iterations > maxIterations then
                        Err (IterationsTooLarge iterations)

                    else
                        Ok iterations


{-| Map a PHC identifier back to the digest algorithm it was hashed with.
Inverse of [`pbkdf2IdString`](#pbkdf2IdString).
-}
digestAlgorithmFromId : String -> Result VerifyError Crypto.DigestAlgorithm
digestAlgorithmFromId id =
    when id is
        "pbkdf2-sha256" ->
            Ok Crypto.Sha256

        "pbkdf2-sha384" ->
            Ok Crypto.Sha384

        "pbkdf2-sha512" ->
            Ok Crypto.Sha512

        _ ->
            Err (UnknownDigestAlgorithm id)


{-| Hash the plain text password and throw the result away.
-}
burnCandidate : Crypto.SecureContext -> Options -> Password PlainText -> Task x {}
burnCandidate secureContext options candidate =
    hash secureContext options candidate
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| Replace a user's password. This requires the [`Verified`](Sqlite.Auth.User#Verified) type. A password
check with [`validate`](#validate) creates it, and so does verifying a live session
through [`Sqlite.Auth.Session.verify`](Sqlite.Auth.Session#verify). To
require the current password, check it with [`validate`](#validate) and pass along
the [`Verified`](Sqlite.Auth.User#Verified) that check returns.

Changing the password revokes the user's sessions and deletes any outstanding reset token.

All operations are completed in a SQLite transaction, preventing data corruption.
-}
change : Sqlite.Database -> Password Hashed -> User.Verified -> Task Sqlite.Error User.Verified
change database (Password phcString) ((Internal.Verified { userId }) as verified) =
    Sqlite.inTransaction database
        (deleteRow database { userId = userId }
            |> Task.andThen (\_ -> insertRow database { userId = userId, phcString = phcString })
            |> Task.andThen (\_ -> deleteResetTokenRow database { userId = userId })
            |> Task.andThen (\_ -> Session.revokeAll database { userId = userId })
        )
        |> Task.map (\_ -> verified)


{-| Remove a user's password and any outstanding reset token, leaving the
account without a password. Requires the [`Verified`](Sqlite.Auth.User#Verified) type,
which a password check with [`validate`](#validate) or a live session through
[`Sqlite.Auth.Session.verify`](Sqlite.Auth.Session#verify) creates.

Existing sessions are not revoked. They are a separate credential and keep
working until they expire. Deleting a password when there is none succeeds and
changes nothing. Both writes happen in one transaction.
-}
delete : Sqlite.Database -> User.Verified -> Task Sqlite.Error {}
delete database (Internal.Verified { userId }) =
    Sqlite.inTransaction database
        (deleteRow database { userId = userId }
            |> Task.andThen (\_ -> deleteResetTokenRow database { userId = userId })
        )
        |> Task.map (\_ -> {})


{-| Creates a reset token for the given user and returns `{ token }` exactly once. 
It's intended for this token to be transmitted safely, such as being emailed to the 
user.

The token is a standard base64 string, so it can contain `+`, `/`, and `=`. This
library does not make the token safe for any particular transport: if it travels
in a URL or form field, encode it for that context and hand [`reset`](#reset)
back the exact original string.

A new request replaces any existing token for the same user, so the previous
link stops working immediately.

To reset the password using the generated token, use the [`reset`](#reset) function.
-}
requestReset : Sqlite.Database -> Crypto.SecureContext -> Options -> User.User -> Task Sqlite.Error { token : String }
requestReset database secureContext options (Internal.User { userId }) =
    sweepResetTokens database
        |> Task.andThen (\_ -> Crypto.getRandomUInt8Values 32)
        |> Task.andThen
            (\tokenBytes ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            let
                                token : String
                                token =
                                    Utils.Base64.encodeBytes tokenBytes
                            in
                            Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
                                |> Task.andThen
                                    (\hashed ->
                                        insertResetTokenRow database
                                            { resetToken = hashed
                                            , userId = userId
                                            , createdAt = now
                                            , expiresAt = now + options.resetTokenLifetimeMillis
                                            }
                                            |> Task.map (\_ -> { token = token })
                                    )
                        )
            )


{-| The ways redeeming a reset token can go wrong. 

- `InvalidResetToken` is a token that matches no live row, whether it is unknown, 
already used, replaced, or expired. The caller cannot tell which, deliberately.
- `ResetStorageError` is a database fault.
-}
type ResetError
    = InvalidResetToken
    | ResetStorageError Sqlite.Error


{-| Use a generated reset token to set a new password. No user is needed, because the
 token resolves the user itself.

If successful, this function deletes the token, replaces the password, and revokes
all sessions the user may have. This function returns [`Verified`](Sqlite.Auth.User#Verified),
allowing you to issue a new session if you choose after a successful reset.

Note: A token can be redeemed only once and is invalid after redemption.

    Password.reset database secureContext
        { token = generatedToken
        , new = hashedNew -- `Password Hashed`
        }
        |> Task.andThen (Session.issue database secureContext sessionOptions)
-}
reset : Sqlite.Database -> Crypto.SecureContext -> { token : String, new : Password Hashed } -> Task ResetError User.Verified
reset database secureContext { token, new } =
    let
        (Password phcString) =
            new
    in
    sweepResetTokens database
        |> Task.mapError ResetStorageError
        |> Task.andThen (\_ -> Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token))
        |> Task.andThen
            (\hashedToken ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            getResetTokenRow database { resetToken = hashedToken }
                                |> Task.mapError ResetStorageError
                                |> Task.andThen
                                    (\maybeRow ->
                                        when maybeRow is
                                            Nothing ->
                                                Task.fail InvalidResetToken

                                            Just row ->
                                                if row.expiresAt > now then
                                                    redeem database 
                                                        { resetToken = hashedToken
                                                        , userId = row.userId
                                                        , phcString = phcString 
                                                        }
                                                        |> Task.mapError ResetStorageError
                                                        |> Task.andThen
                                                            (\outcome ->
                                                                when outcome is
                                                                    Redeemed ->
                                                                        Task.succeed (Internal.Verified { userId = row.userId })

                                                                    AlreadyRedeemed ->
                                                                        Task.fail InvalidResetToken
                                                            )

                                                else
                                                    Task.fail InvalidResetToken
                                    )
                        )
            )


{-| The two ways the redemption transaction can finish: This call consumed the
token row and replaced the password, or a concurrent redemption consumed the
token first and nothing was written.
-}
type RedeemOutcome
    = Redeemed
    | AlreadyRedeemed


{-|-}
redeem : Sqlite.Database -> { resetToken : String, userId : String, phcString : String } -> Task Sqlite.Error RedeemOutcome
redeem database { resetToken, userId, phcString } =
    Sqlite.inTransaction database
        (deleteResetTokenRowByToken database { resetToken = resetToken }
            |> Task.andThen
                (\summary ->
                    if summary.changes == 0 then
                        Task.succeed AlreadyRedeemed

                    else
                        deleteRow database { userId = userId }
                            |> Task.andThen (\_ -> insertRow database { userId = userId, phcString = phcString })
                            |> Task.andThen (\_ -> Session.revokeAll database { userId = userId })
                            |> Task.map (\_ -> Redeemed)
                )
        )


{-| A row from the `passwords` table.
-}
type alias Row =
    { userId : String
    , password : String
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }


{-| Decode a single `passwords` row into a [`Row`](#Row).
-}
rowDecoder : Sqlite.Decode.Row.Decoder Row
rowDecoder =
    Sqlite.Decode.Row.column "user_id" Sqlite.Decode.string <| \userId ->
    Sqlite.Decode.Row.column "password" Sqlite.Decode.string <| \password ->
    Sqlite.Decode.Row.column "last_used" (Sqlite.Decode.maybe Sqlite.Decode.int) <| \lastUsed ->
    Sqlite.Decode.Row.column "failed_login_attempts_count" Sqlite.Decode.int <| \failedLoginAttemptsCount ->
    Sqlite.Decode.Row.column "locked_until" (Sqlite.Decode.maybe Sqlite.Decode.int) <| \lockedUntil ->
        Sqlite.Decode.Row.succeed
            { userId = userId
            , password = password
            , lastUsed = lastUsed
            , failedLoginAttemptsCount = failedLoginAttemptsCount
            , lockedUntil = lockedUntil
            }


{-| Insert a fresh password row for `userId`.
-}
insertRow : Sqlite.Database -> { userId : String, phcString : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
insertRow database { userId, phcString } =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        INSERT INTO passwords (user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until)
                        VALUES (:user_id, :password, :created_at, :updated_at, NULL, 0, NULL)
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
                        , Sqlite.Encode.Row.column "password" <| Sqlite.Encode.string phcString
                        , Sqlite.Encode.Row.column "created_at" <| Sqlite.Encode.int now
                        , Sqlite.Encode.Row.column "updated_at" <| Sqlite.Encode.int now
                        ]
                    }
            )


{-| Delete a user's password row.
-}
deleteRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteRow database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
            ]
        }


{-| Read a single user's password row by `userId`, returning `Nothing` when no
password exists.
-}
getPasswordByUserId : Sqlite.Database -> { userId : String } -> Task Sqlite.Error (Maybe Row)
getPasswordByUserId database { userId } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, password, last_used, failed_login_attempts_count, locked_until
            FROM passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
            ]
        , rowDecoder = rowDecoder
        }


{-| Write a row's mutable bookkeeping, meaning `last_used`, the failure counter,
and the lock, bumping `updated_at` to now.
-}
updateRow :
    Sqlite.Database
    -> { userId : String, lastUsed : Maybe Int, failedLoginAttemptsCount : Int, lockedUntil : Maybe Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
updateRow database { userId, lastUsed, failedLoginAttemptsCount, lockedUntil } =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE passwords
                        SET updated_at = :updated_at, last_used = :last_used, failed_login_attempts_count = :failed_login_attempts_count, locked_until = :locked_until
                        WHERE user_id = :user_id
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "updated_at" <| Sqlite.Encode.int now
                        , Sqlite.Encode.Row.column "last_used" <| Sqlite.Encode.maybe Sqlite.Encode.int lastUsed
                        , Sqlite.Encode.Row.column "failed_login_attempts_count" <| Sqlite.Encode.int failedLoginAttemptsCount
                        , Sqlite.Encode.Row.column "locked_until" <| Sqlite.Encode.maybe Sqlite.Encode.int lockedUntil
                        , Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
                        ]
                    }
            )


{-| Write a user's reset token row, replacing any existing one. `resetToken` 
must be the hashed token value, never the raw token.
-}
insertResetTokenRow :
    Sqlite.Database
    -> { resetToken : String, userId : String, createdAt : Int, expiresAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insertResetTokenRow database { resetToken, userId, createdAt, expiresAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT OR REPLACE INTO password_reset_tokens (reset_token, user_id, created_at, expires_at)
            VALUES (:reset_token, :user_id, :created_at, :expires_at)
            """
        , parameters =
            [ Sqlite.Encode.Row.column "reset_token" <| Sqlite.Encode.string resetToken
            , Sqlite.Encode.Row.column "user_id" <| Sqlite.Encode.string userId
            , Sqlite.Encode.Row.column "created_at" <| Sqlite.Encode.int createdAt
            , Sqlite.Encode.Row.column "expires_at" <| Sqlite.Encode.int expiresAt
            ]
        }


{-| Read a reset token row by the hash of a presented token, returning
`Nothing` when no such row exists.
-}
getResetTokenRow : Sqlite.Database -> { resetToken : String } -> Task Sqlite.Error (Maybe { userId : String, expiresAt : Int })
getResetTokenRow database { resetToken } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, expires_at
            FROM password_reset_tokens
            WHERE reset_token = :reset_token
            """
        , parameters =
            [ Sqlite.Encode.Row.column "reset_token" (Sqlite.Encode.string resetToken)
            ]
        , rowDecoder =
            Sqlite.Decode.Row.column "user_id" Sqlite.Decode.string <| \userId ->
            Sqlite.Decode.Row.column "expires_at" Sqlite.Decode.int <| \expiresAt ->
                Sqlite.Decode.Row.succeed
                    { userId = userId
                    , expiresAt = expiresAt
                    }
        }


{-| Delete a user's reset token row.
-}
deleteResetTokenRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteResetTokenRow database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM password_reset_tokens
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.Row.column "user_id" (Sqlite.Encode.string userId)
            ]
        }


{-| Delete a reset token row by the hash of a presented token.
-}
deleteResetTokenRowByToken : Sqlite.Database -> { resetToken : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteResetTokenRowByToken database { resetToken } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM password_reset_tokens
            WHERE reset_token = :reset_token
            """
        , parameters =
            [ Sqlite.Encode.Row.column "reset_token" <| Sqlite.Encode.string resetToken
            ]
        }


{-| Delete every expired reset token row as of now.
-}
sweepResetTokens : Sqlite.Database -> Task Sqlite.Error {}
sweepResetTokens database =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        DELETE FROM password_reset_tokens
                        WHERE expires_at <= :now
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "now" <| Sqlite.Encode.int now
                        ]
                    }
            )
        |> Task.map (\_ -> {})
