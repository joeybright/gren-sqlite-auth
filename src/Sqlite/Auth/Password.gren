module Sqlite.Auth.Password exposing
    ( migrationV1
    , Password
    , PlainText
    , Hashed
    , fromString
    , hash
    , HashError(..)
    , add
    , validate
    , Outcome(..)
    , ValidateError(..)
    , VerifyError(..)
    , change
    , requestReset
    , reset
    , ResetError(..)
    )

{-| The password credential: the `auth_passwords` table and the pipeable steps
that write to and check against it.

Each row stores one user's hashed (PHC-formatted) password — keyed by
`user_id`, one password per user — plus the bookkeeping for lockout
(`failed_login_attempts_count`, `locked_until`) and last-use tracking
(`last_used`).

A password enters as a [`Password PlainText`](#Password) via
[`fromString`](#fromString), becomes a `Password Hashed` via [`hash`](#hash),
and only the hashed form can be persisted with [`add`](#add) — the phantom
type makes storing plain text impossible. [`validate`](#validate) checks a
plain-text candidate against the stored hash and, on a match, mints the
opaque `Verified` witness that
[`Sqlite.Auth.Session.issue`](Sqlite.Auth.Session#issue) demands.

@docs migrationV1

# Passwords

@docs Password, PlainText, Hashed
@docs fromString
@docs hash, HashError

# Pipeline steps

@docs add
@docs validate, Outcome, ValidateError, VerifyError

# Changing and resetting

@docs change
@docs requestReset
@docs reset, ResetError

-}

import Base64.Decode
import Bytes exposing ( Bytes )
import Crypto
import Dict exposing ( Dict )
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Auth.Password.PhcString as PhcString
import Sqlite.Auth.Session as Session
import Sqlite.Auth.Utilities as Utilities
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )


{-| Create the `auth_passwords` and `auth_password_reset_tokens` tables. Run
after [`Sqlite.Auth.User.migrationV1`](Sqlite.Auth.User#migrationV1) (they
reference `users`).
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.Password.migrationV1` - Add auth_passwords and auth_password_reset_tokens tables"
    , statements =
        [ addPasswordsTableMigrationSQL
        , addPasswordResetTokensTableMigrationSQL
        ]
    }


{-|-}
addPasswordsTableMigrationSQL : String
addPasswordsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| `reset_token` stores the SHA-256 hash of an emailed reset token and is the
primary key because redemption looks the token up directly. `UNIQUE (user_id)`
keeps one live reset token per user — issuing a new one replaces the old.
-}
addPasswordResetTokensTableMigrationSQL : String
addPasswordResetTokensTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_password_reset_tokens (
        reset_token TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """



-- passwords


{-| A password in plain text, as received from the user.
-}
type PlainText
    = PlainText


{-| A password that has been hashed and is safe to persist.
-}
type Hashed
    = Hashed


{-| A password, tagged with whether it is still [`PlainText`](#PlainText) or
already [`Hashed`](#Hashed). Only the hashed form can reach the database.
-}
type Password state
    = Password String


{-| Turn a `String` into a plain-text [`Password`](#Password), ready to
[`hash`](#hash) or to hand to [`validate`](#validate) as the candidate secret.
-}
fromString : String -> Password PlainText
fromString =
    Password



-- hashing


{-| Errors that can happen while deriving a password hash.
-}
type HashError
    = ImportPbkdf2KeyError Crypto.ImportPbkdf2KeyError
    | Pbkdf2DeriveBitsError Crypto.Pbkdf2DeriveBitsError


{-| PBKDF2 iteration count used when hashing: 600,000 over SHA-256, per
current OWASP guidance.
-}
defaultIterations : Int
defaultIterations =
    600000


{-| Hash a plain-text password — PBKDF2-SHA256, [`defaultIterations`](#defaultIterations),
a random 16-byte salt — into a PHC-formatted [`Password Hashed`](#Password)
ready for [`add`](#add).
-}
hash : Crypto.SecureContext -> Password PlainText -> Task HashError (Password Hashed)
hash secureContext (Password string) =
    Crypto.getRandomUInt8Values 16
        |> Task.andThen
            (\salt ->
                derivePhcString secureContext
                    { password = string
                    , salt = salt
                    , iterations = defaultIterations
                    , digestAlgorithm = Crypto.Sha256
                    }
            )
        |> Task.map Password


{-| Run the PBKDF2 derivation itself: import the password as key material,
then derive the hash bytes from the salt, iteration count, and digest
algorithm. Shared by [`derivePhcString`](#derivePhcString) (which encodes the
result as a PHC string) and [`verify`](#verify) (which compares the raw
bytes), so creation and re-derivation stay identical.
-}
deriveBits :
    Crypto.SecureContext
    -> { password : String, salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
    -> Task HashError Bytes
deriveBits secureContext { password, salt, iterations, digestAlgorithm } =
    password
        |> Bytes.fromString
        |> Crypto.importPbkdf2KeyFromRaw secureContext
        |> Task.mapError ImportPbkdf2KeyError
        |> Task.andThen
            (\importedPbkdf2Key ->
                Crypto.deriveBitsWithPbkdf2
                    { salt = salt
                    , iterations = iterations
                    , hash = digestAlgorithm
                    }
                    Nothing
                    importedPbkdf2Key
                    |> Task.mapError Pbkdf2DeriveBitsError
            )


{-| Derive a PHC-formatted hash string from an explicit salt, iteration count,
and digest algorithm: [`deriveBits`](#deriveBits) plus the PHC encoding.
-}
derivePhcString :
    Crypto.SecureContext
    -> { password : String, salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
    -> Task HashError String
derivePhcString secureContext ({ salt, iterations, digestAlgorithm } as params) =
    deriveBits secureContext params
        |> Task.map
            (\hashedPasswordBytes ->
                PhcString.toString
                    { id = pbkdf2IdString digestAlgorithm
                    , params = Dict.singleton "i" (String.fromInt iterations)
                    , tail =
                        PhcString.SaltAndHash
                            { salt = Utilities.base64 salt
                            , hash = Utilities.base64 hashedPasswordBytes
                            }
                    }
            )


{-| The PHC identifier for a PBKDF2 hash over the given digest algorithm.
Inverse of [`digestAlgorithmFromId`](#digestAlgorithmFromId).
-}
pbkdf2IdString : Crypto.DigestAlgorithm -> String
pbkdf2IdString digestAlgorithm =
    when digestAlgorithm is
        Crypto.Sha256 ->
            "pbkdf2-sha256"

        Crypto.Sha384 ->
            "pbkdf2-sha384"

        Crypto.Sha512 ->
            "pbkdf2-sha512"



-- adding passwords


{-| Store a hashed password for the given user, returning the
[`User`](Sqlite.Auth.User#User) witness for further pipeline steps:

    User.new database secureContext
        |> Task.andThen (Username.new database { username = "alice" })
        |> Task.andThen (Password.add database hashedPassword)

The phantom type guards this entry point — only a
[`Password Hashed`](#Password) from [`hash`](#hash) can be persisted. Stamps
`created_at`/`updated_at` to now and starts the user with zero failed login
attempts and no lock.
-}
add : Sqlite.Database -> Password Hashed -> Internal.User -> Task Sqlite.Error Internal.User
add database (Password phcString) ((Internal.User { userId }) as user) =
    insertRow database { userId = userId, phcString = phcString }
        |> Task.map (\_ -> user)



-- validating passwords


{-| The outcome of validating a candidate password. An expected negative is a
value, not an error: the candidate didn't match or the user has no password
(`Rejected`), or the password is temporarily locked after repeated failures
(`Locked`). `Verified` carries the opaque witness
[`Sqlite.Auth.Session.issue`](Sqlite.Auth.Session#issue) demands — it cannot
be constructed outside this package, only passed along.
-}
type Outcome
    = Verified Internal.Verified
    | Rejected
    | Locked


{-| Real faults while validating — a database error, or a corrupt stored hash
that cannot be verified against. A wrong password is not an error; it is
[`Rejected`](#Outcome).
-}
type ValidateError
    = StorageError Sqlite.Error
    | VerificationError VerifyError


{-| The ways a stored PHC string can fail to verify against, other than a
plain mismatch: it cannot be parsed, names an unknown algorithm, is missing a
segment, or the re-derivation itself faults.
-}
type VerifyError
    = ParsePhcStringError PhcString.Error
    | UnknownDigestAlgorithm String
    | MissingSalt
    | InvalidSalt Base64.Decode.Error
    | MissingHash
    | InvalidHash Base64.Decode.Error
    | MissingIterations
    | InvalidIterations String
    | RederiveError HashError


{-| Lock the password after this many consecutive failed validations.
-}
maxFailedAttempts : Int
maxFailedAttempts =
    5


{-| How long a locked password stays locked: 15 minutes.
-}
lockoutDurationMillis : Int
lockoutDurationMillis =
    15 * 60 * 1000


{-| Check a plain-text candidate against a user's stored password — the step
that gates session issuance. The user argument is the `Maybe` that
[`Sqlite.Auth.Username.user`](Sqlite.Auth.Username#user) produces — pass it
through whole:

    Username.user database { username = candidateName }
        |> Task.andThen (Password.validate database secureContext candidate)
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Password.Verified proof ->
                        Session.issue database secureContext proof
                    ...
            )

A pipeline holding a definite user (e.g. registration, straight from
[`Sqlite.Auth.User.new`](Sqlite.Auth.User#new)) passes `Just user`.

A match resets the failure bookkeeping, stamps `last_used`, and mints the
`Verified` witness. A mismatch increments the failure counter — locking the
password for [`lockoutDurationMillis`](#lockoutDurationMillis) once it reaches
[`maxFailedAttempts`](#maxFailedAttempts) — and answers `Rejected`.

Every negative answer costs a full hashing round: given `Nothing` (no user
owns the identifier), a user with no password row, or a locked row, this burns
the candidate before answering — so an unknown username costs the same as a
wrong password and a clock-watching attacker cannot tell the two apart. There
is no way to skip that burn — which is the point. `Rejected` deliberately
covers all of "unknown identifier", "no password", and "wrong password".
-}
validate : Sqlite.Database -> Crypto.SecureContext -> Password PlainText -> Maybe Internal.User -> Task ValidateError Outcome
validate database secureContext candidate maybeUser =
    when maybeUser is
        Nothing ->
            burnCandidate secureContext candidate
                |> Task.map (\_ -> Rejected)

        Just (Internal.User { userId }) ->
            Task.map2
                (\now maybeRow -> { now = now, maybeRow = maybeRow })
                Utilities.nowMillis
                (getRow database { userId = userId } |> Task.mapError StorageError)
                |> Task.andThen
                    (\{ now, maybeRow } ->
                        when maybeRow is
                            Nothing ->
                                burnCandidate secureContext candidate
                                    |> Task.map (\_ -> Rejected)

                            Just row ->
                                when row.lockedUntil is
                                    Just lockedUntil ->
                                        if lockedUntil > now then
                                            burnCandidate secureContext candidate
                                                |> Task.map (\_ -> Locked)

                                        else
                                            verifyAgainstRow database secureContext { now = now, candidate = candidate, row = row }

                                    Nothing ->
                                        verifyAgainstRow database secureContext { now = now, candidate = candidate, row = row }
                    )


{-| The two expected outcomes of re-deriving a candidate against a stored
hash; anything else is a fault and stays an error.
-}
type VerifyOutcome
    = Matched
    | Mismatched


{-| Re-derive a candidate against an unlocked `auth_passwords` row and record
the outcome: reset the failure bookkeeping (and stamp `last_used`) on a match,
increment it — locking at [`maxFailedAttempts`](#maxFailedAttempts) — on a
mismatch. Only [`verify`](#verify) faults other than a plain mismatch surface
as errors.
-}
verifyAgainstRow :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { now : Int, candidate : Password PlainText, row : Row }
    -> Task ValidateError Outcome
verifyAgainstRow database secureContext { now, candidate, row } =
    verify secureContext candidate row.password
        |> Task.andThen
            (\verifyOutcome ->
                when verifyOutcome is
                    Matched ->
                        updateRow database
                            { userId = row.userId
                            , lastUsed = Just now
                            , failedLoginAttemptsCount = 0
                            , lockedUntil = Nothing
                            }
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Verified (Internal.Verified { userId = row.userId }))

                    Mismatched ->
                        let
                            newCount : Int
                            newCount =
                                row.failedLoginAttemptsCount + 1

                            newLockedUntil : Maybe Int
                            newLockedUntil =
                                if newCount >= maxFailedAttempts then
                                    Just (now + lockoutDurationMillis)

                                else
                                    Nothing
                        in
                        updateRow database
                            { userId = row.userId
                            , lastUsed = row.lastUsed
                            , failedLoginAttemptsCount = newCount
                            , lockedUntil = newLockedUntil
                            }
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Rejected)
            )


{-| Check a plain-text candidate against a stored PHC string. The stored
string carries everything needed to reproduce its own hash — the salt, the
iteration count, and the digest algorithm — so we parse those back out,
re-derive the candidate's hash through the same [`deriveBits`](#deriveBits)
used to create the stored one, and compare the raw hash bytes. A mismatch is
the `Mismatched` value; only real faults fail the task.
-}
verify : Crypto.SecureContext -> Password PlainText -> String -> Task ValidateError VerifyOutcome
verify secureContext (Password candidate) phcString =
    when parseStoredHash phcString is
        Err error ->
            Task.fail (VerificationError error)

        Ok { salt, iterations, digestAlgorithm, hashBytes } ->
            deriveBits secureContext
                { password = candidate
                , salt = salt
                , iterations = iterations
                , digestAlgorithm = digestAlgorithm
                }
                |> Task.mapError (RederiveError >> VerificationError)
                |> Task.map
                    (\rederivedBytes ->
                        if rederivedBytes == hashBytes then
                            Matched

                        else
                            Mismatched
                    )


{-| Recover everything [`verify`](#verify) needs from a stored PHC string: the
raw salt `Bytes`, the iteration count, the digest algorithm, and the stored
hash's raw `Bytes` to compare against.
-}
parseStoredHash : String -> Result VerifyError { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm, hashBytes : Bytes }
parseStoredHash phcString =
    PhcString.parse phcString
        |> Result.mapError ParsePhcStringError
        |> Result.andThen
            (\parsed ->
                Result.map3
                    (\salt iterations digestAlgorithm ->
                        (\hashBytes ->
                            { salt = salt
                            , iterations = iterations
                            , digestAlgorithm = digestAlgorithm
                            , hashBytes = hashBytes
                            }
                        )
                    )
                    (saltBytesFromTail parsed.tail)
                    (iterationsFromParams parsed.params)
                    (digestAlgorithmFromId parsed.id)
                    |> Result.andMap (hashBytesFromTail parsed.tail)
            )


{-| Pull the raw salt `Bytes` out of a parsed PHC string's tail by base64
decoding the salt segment.
-}
saltBytesFromTail : PhcString.Tail -> Result VerifyError Bytes
saltBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash { salt } ->
            Base64.Decode.bytes salt
                |> Result.mapError InvalidSalt

        PhcString.SaltOnly salt ->
            Base64.Decode.bytes salt
                |> Result.mapError InvalidSalt

        PhcString.NoTail ->
            Err MissingSalt


{-| Pull the raw hash `Bytes` out of a parsed PHC string's tail by base64
decoding the hash segment. A tail without a hash segment can't be verified
against.
-}
hashBytesFromTail : PhcString.Tail -> Result VerifyError Bytes
hashBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash saltAndHash ->
            Base64.Decode.bytes saltAndHash.hash
                |> Result.mapError InvalidHash

        PhcString.SaltOnly _ ->
            Err MissingHash

        PhcString.NoTail ->
            Err MissingHash


{-| Read the PBKDF2 iteration count from a parsed PHC string's `i` parameter.
-}
iterationsFromParams : Dict String String -> Result VerifyError Int
iterationsFromParams params =
    when Dict.get "i" params is
        Nothing ->
            Err MissingIterations

        Just value ->
            when String.toInt value is
                Nothing ->
                    Err (InvalidIterations value)

                Just iterations ->
                    Ok iterations


{-| Map a PHC identifier back to the digest algorithm it was hashed with.
Inverse of [`pbkdf2IdString`](#pbkdf2IdString).
-}
digestAlgorithmFromId : String -> Result VerifyError Crypto.DigestAlgorithm
digestAlgorithmFromId id =
    when id is
        "pbkdf2-sha256" ->
            Ok Crypto.Sha256

        "pbkdf2-sha384" ->
            Ok Crypto.Sha384

        "pbkdf2-sha512" ->
            Ok Crypto.Sha512

        _ ->
            Err (UnknownDigestAlgorithm id)


{-| Hash the candidate and throw the result away. Costs the same
[`defaultIterations`](#defaultIterations) PBKDF2 rounds as a real verification
and never fails, so [`validate`](#validate) can spend it when there is no
stored hash to check and answer in uniform time.
-}
burnCandidate : Crypto.SecureContext -> Password PlainText -> Task x {}
burnCandidate secureContext candidate =
    hash secureContext candidate
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})



-- changing and resetting


{-| Replace a user's password — the logged-in "change my password" flow. For
the forgotten-password flow, where there is no current password to prove, use
[`requestReset`](#requestReset) / [`reset`](#reset) instead.

Demands the `Verified` witness, so the current password must be proven through
[`validate`](#validate) first — there is no way to change a password without
it. In one transaction the old password row is deleted, a fresh one inserted
(deliberately resetting the lockout bookkeeping — correct for a fresh secret),
and every session the user holds is revoked — a stolen session must not
survive a password change. That includes the session on the device making the
change: the witness is returned back, so pipe into
[`Sqlite.Auth.Session.issue`](Sqlite.Auth.Session#issue) for the replacement:

    Password.validate database secureContext current (Just user)
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Password.Verified proof ->
                        Password.change database hashedNew proof
                            |> Task.andThen (Session.issue database secureContext)
                    ...
            )
-}
change : Sqlite.Database -> Password Hashed -> Internal.Verified -> Task Sqlite.Error Internal.Verified
change database (Password phcString) ((Internal.Verified { userId }) as verified) =
    Sqlite.inTransaction database
        (deleteRow database { userId = userId }
            |> Task.andThen (\_ -> insertRow database { userId = userId, phcString = phcString })
            |> Task.andThen (\_ -> Session.revokeAll database { userId = userId })
        )
        |> Task.map (\_ -> verified)


{-| How long an emailed reset token stays redeemable: 30 minutes.
-}
resetTokenLifetimeMillis : Int
resetTokenLifetimeMillis =
    30 * 60 * 1000


{-| Phase one of a forgotten-password reset: mint a reset token for the user a
username resolved to, returning `{ token }` exactly once for you to embed in
an emailed link. Phase two is [`reset`](#reset) with the token from that link.

The user argument is the `Maybe` that
[`Sqlite.Auth.Username.user`](Sqlite.Auth.Username#user) produces — pass it
through whole:

    Username.user database { username = typedUsername }
        |> Task.andThen (Password.requestReset database secureContext)

`Nothing` succeeds with `Nothing` — nothing is minted, and nothing should be
sent. Respond to the requester identically in both cases so the endpoint
cannot be used to enumerate accounts.

Only the token's SHA-256 hash is stored, expiring after
[`resetTokenLifetimeMillis`](#resetTokenLifetimeMillis); the write replaces
the user's previous reset token, so at most one is ever live.
-}
requestReset : Sqlite.Database -> Crypto.SecureContext -> Internal.User -> Task Sqlite.Error { token : String }
requestReset database secureContext (Internal.User { userId }) =
    Task.map2
        (\tokenBytes now -> { token = encodeUrlSafe tokenBytes, now = now })
        (Crypto.getRandomUInt8Values 32)
        Utilities.nowMillis
        |> Task.andThen
            (\{ token, now } ->
                hashResetToken secureContext token
                    |> Task.andThen
                        (\hashed ->
                            insertResetTokenRow database
                                { resetToken = hashed
                                , userId = userId
                                , createdAt = now
                                , expiresAt = now + resetTokenLifetimeMillis
                                }
                                |> Task.map (\_ -> { token = token })
                        )
            )


{-| Everything a reset redemption can go wrong on: a token that matches no
live row (`InvalidResetToken` — unknown, already used, replaced, or expired;
the caller can't tell which, deliberately) or a database fault
(`ResetStorageError`).
-}
type ResetError
    = InvalidResetToken
    | ResetStorageError Sqlite.Error


{-| Phase two of a forgotten-password reset: redeem the token from the emailed
link and set the new password. No user is needed — the token resolves the
user, which is what makes the email-link flow work.

In one transaction the token row is deleted (single-use), the password
replaced (resetting the lockout bookkeeping), and every session the user
holds is revoked — a reset is the canonical "kick the attacker out" action,
so nothing issued before it may survive. Redeeming the token proved control
of the account's delivery channel, so the `Verified` witness is minted — pipe
into [`Sqlite.Auth.Session.issue`](Sqlite.Auth.Session#issue) to log the user
straight in:

    Password.reset database secureContext
        { token = tokenFromLink, new = hashedNew }
        |> Task.andThen (Session.issue database secureContext)
-}
reset : Sqlite.Database -> Crypto.SecureContext -> { token : String, new : Password Hashed } -> Task ResetError Internal.Verified
reset database secureContext { token, new } =
    let
        (Password phcString) =
            new
    in
    Task.map2
        (\hashed now -> { hashed = hashed, now = now })
        (hashResetToken secureContext token)
        Utilities.nowMillis
        |> Task.andThen
            (\{ hashed, now } ->
                getResetTokenRow database { resetToken = hashed }
                    |> Task.mapError ResetStorageError
                    |> Task.andThen
                        (\maybeRow ->
                            when maybeRow is
                                Nothing ->
                                    Task.fail InvalidResetToken

                                Just row ->
                                    if row.expiresAt > now then
                                        Sqlite.inTransaction database
                                            (deleteResetTokenRow database { userId = row.userId }
                                                |> Task.andThen (\_ -> deleteRow database { userId = row.userId })
                                                |> Task.andThen (\_ -> insertRow database { userId = row.userId, phcString = phcString })
                                                |> Task.andThen (\_ -> Session.revokeAll database { userId = row.userId })
                                            )
                                            |> Task.mapError ResetStorageError
                                            |> Task.map (\_ -> Internal.Verified { userId = row.userId })

                                    else
                                        Task.fail InvalidResetToken
                        )
            )


{-| Encode token bytes into the URL-safe string embedded in the emailed link:
standard base64 with `+`/`/` swapped for `-`/`_` and padding dropped. The
token is never decoded back to bytes — redemption hashes the string itself.
-}
encodeUrlSafe : Bytes -> String
encodeUrlSafe tokenBytes =
    Utilities.base64 tokenBytes
        |> String.replace "+" "-"
        |> String.replace "/" "_"
        |> String.replace "=" ""


{-| Hash a reset token string into the value stored in `reset_token`. The
token string itself is hashed — never decoded back to bytes — so redemption
matches exactly what [`requestReset`](#requestReset) stored.
-}
hashResetToken : Crypto.SecureContext -> String -> Task x String
hashResetToken secureContext token =
    Utilities.sha256Base64 secureContext (Bytes.fromString token)



-- `auth_passwords` rows


{-| A row from the `auth_passwords` table.
-}
type alias Row =
    { userId : String
    , password : String
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }


{-| Decode a single `auth_passwords` row into a [`Row`](#Row).
-}
rowDecoder : Sqlite.Decode.Decoder Row
rowDecoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "password"
                (\password ->
                    Sqlite.Decode.maybe Sqlite.Decode.int "last_used"
                        (\lastUsed ->
                            Sqlite.Decode.int "failed_login_attempts_count"
                                (\failedLoginAttemptsCount ->
                                    Sqlite.Decode.maybe Sqlite.Decode.int "locked_until"
                                        (\lockedUntil ->
                                            Sqlite.Decode.succeed
                                                { userId = userId
                                                , password = password
                                                , lastUsed = lastUsed
                                                , failedLoginAttemptsCount = failedLoginAttemptsCount
                                                , lockedUntil = lockedUntil
                                                }
                                        )
                                )
                        )
                )
        )


{-| Insert a fresh password row for `userId`: timestamps stamped to now, zero
failed login attempts, no lock. The single write behind [`add`](#add),
[`change`](#change), and [`reset`](#reset).
-}
insertRow : Sqlite.Database -> { userId : String, phcString : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
insertRow database { userId, phcString } =
    Utilities.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        INSERT INTO auth_passwords (user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until)
                        VALUES (:user_id, :password, :created_at, :updated_at, NULL, 0, NULL)
                        """
                    , parameters =
                        [ Sqlite.Encode.string "user_id" userId
                        , Sqlite.Encode.string "password" phcString
                        , Sqlite.Encode.int "created_at" now
                        , Sqlite.Encode.int "updated_at" now
                        ]
                    }
            )


{-| Delete a user's password row, making room for the fresh one
[`change`](#change) and [`reset`](#reset) write.
-}
deleteRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteRow database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        }


{-| Read a single user's password row by `userId`, returning `Nothing` when no
such row exists.
-}
getRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error (Maybe Row)
getRow database { userId } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, password, last_used, failed_login_attempts_count, locked_until
            FROM auth_passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        , rowDecoder = rowDecoder
        }


{-| Write a row's mutable bookkeeping — `last_used`, the failure counter, and
the lock — bumping `updated_at` to now.
-}
updateRow :
    Sqlite.Database
    -> { userId : String, lastUsed : Maybe Int, failedLoginAttemptsCount : Int, lockedUntil : Maybe Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
updateRow database { userId, lastUsed, failedLoginAttemptsCount, lockedUntil } =
    Utilities.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_passwords
                        SET updated_at = :updated_at, last_used = :last_used, failed_login_attempts_count = :failed_login_attempts_count, locked_until = :locked_until
                        WHERE user_id = :user_id
                        """
                    , parameters =
                        [ Sqlite.Encode.int "updated_at" now
                        , Sqlite.Encode.maybe Sqlite.Encode.int "last_used" lastUsed
                        , Sqlite.Encode.int "failed_login_attempts_count" failedLoginAttemptsCount
                        , Sqlite.Encode.maybe Sqlite.Encode.int "locked_until" lockedUntil
                        , Sqlite.Encode.string "user_id" userId
                        ]
                    }
            )



-- `auth_password_reset_tokens` rows


{-| Write a user's reset token row, replacing any existing one — `user_id` is
unique, so the replace is what enforces one live reset token per user.
`resetToken` is the already-hashed value, never the raw token.
-}
insertResetTokenRow :
    Sqlite.Database
    -> { resetToken : String, userId : String, createdAt : Int, expiresAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insertResetTokenRow database { resetToken, userId, createdAt, expiresAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT OR REPLACE INTO auth_password_reset_tokens (reset_token, user_id, created_at, expires_at)
            VALUES (:reset_token, :user_id, :created_at, :expires_at)
            """
        , parameters =
            [ Sqlite.Encode.string "reset_token" resetToken
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            ]
        }


{-| Read a reset token row by the hash of a presented token, returning
`Nothing` when no such row exists. Expiry is the caller's check.
-}
getResetTokenRow : Sqlite.Database -> { resetToken : String } -> Task Sqlite.Error (Maybe { userId : String, expiresAt : Int })
getResetTokenRow database { resetToken } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, expires_at
            FROM auth_password_reset_tokens
            WHERE reset_token = :reset_token
            """
        , parameters =
            [ Sqlite.Encode.string "reset_token" resetToken
            ]
        , rowDecoder =
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.int "expires_at"
                        (\expiresAt ->
                            Sqlite.Decode.succeed
                                { userId = userId
                                , expiresAt = expiresAt
                                }
                        )
                )
        }


{-| Delete a user's reset token row, ending its life — redeemed tokens are
removed outright.
-}
deleteResetTokenRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteResetTokenRow database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_password_reset_tokens
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        }
