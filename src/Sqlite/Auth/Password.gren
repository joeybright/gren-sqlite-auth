module Sqlite.Auth.Password exposing
    ( migrationV1
    , Password
    , PlainText
    , Hashed
    , Options
    , defaultOptions
    , fromString
    , hash
    , HashError(..)
    , add
    , validate
    , Outcome(..)
    , ValidateError(..)
    , VerifyError(..)
    , change
    , requestReset
    , reset
    , ResetError(..)
    )

{-| Set, check, change, and reset users' passwords.

## Expected database schema

This module owns two tables. The minimum required schema for each is below.

### Passwords table

    CREATE TABLE IF NOT EXISTS auth_passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );

- `user_id` is the primary key and references the users 
(in the [Sqlite.Auth.User module](Sqlite.Auth.User)), so there is one password per user.
- `password` is the user's hashed password, stored in PHC string format.
- Both `created_at` and `updated_at` are posix timestamp values. 
- `last_used` is a posix timestamp of the last successful check, or null if never.
- `failed_login_attempts_count` counts consecutive failed checks.
- `locked_until` is the posix timestamp the password stays locked until after too 
many failures, or null when unlocked.

### Password reset tokens table

In addition to the passwords table, this module also owns a table for 
password reset tokens.

    CREATE TABLE IF NOT EXISTS auth_password_reset_tokens (
        reset_token TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );

- `reset_token` is the primary key and stores the SHA-256 hash of the token.
- `user_id` references the users and is `UNIQUE`, so there is at most one live
reset token per user.
- `created_at` is a posix timestamp, and `expires_at` is the posix timestamp 
the token stops being redeemable.

## Migrations

@docs migrationV1

## Working with passwords

@docs Password, PlainText, Hashed

### Creating passwords

@docs Options, defaultOptions
@docs fromString
@docs hash, HashError

### Adding & validating passwords for users

@docs add
@docs validate, Outcome, ValidateError, VerifyError

### Changing and resetting passwords

Changing a password requires the current one. Resetting does not, which is what
makes a forgotten-password flow work.

@docs change
@docs requestReset
@docs reset, ResetError

-}

import Base64.Decode
import Bytes exposing ( Bytes )
import Crypto
import Dict exposing ( Dict )
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Auth.Password.PhcString as PhcString
import Sqlite.Auth.Session as Session
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Utils.Base64
import Utils.Crypto
import Utils.Time


{-| Migrate the database to add the `auth_passwords` and
`auth_password_reset_tokens` tables with the minimum required schema for this
module to operate. Both reference users, so run this after
[`Sqlite.Auth.User.migrationV1`](Sqlite.Auth.User#migrationV1).

This migration is meant to be plug-and-play with the `gren-sqlite-migrate`
package. If you are using a different method of migration, the individual SQL
statements can be extracted from the records `statements` field.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.Password.migrationV1` - Add auth_passwords and auth_password_reset_tokens tables"
    , statements =
        [ addPasswordsTableMigrationSQL
        , addPasswordResetTokensTableMigrationSQL
        ]
    }


{-|-}
addPasswordsTableMigrationSQL : String
addPasswordsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-|-}
addPasswordResetTokensTableMigrationSQL : String
addPasswordResetTokensTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_password_reset_tokens (
        reset_token TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """



-- passwords


{-| A password in plain text, as received from the user.
-}
type PlainText
    = PlainText


{-| A password that has been hashed and is safe to persist.
-}
type Hashed
    = Hashed


{-| A password, with a phantom type state of either [`PlainText`](#PlainText) or
[`Hashed`](#Hashed). Only the hashed form can be saved to the database.
-}
type Password state
    = Password String


{-| Turn a `String` into a plain-text [`Password`](#Password), ready to
[`hash`](#hash), or to pass to [`validate`](#validate) as the candidate to
check.
-}
fromString : String -> Password PlainText
fromString =
    Password



-- hashing


{-| Errors that can happen while deriving a password hash.
-}
type HashError
    = ImportPbkdf2KeyError Crypto.ImportPbkdf2KeyError
    | Pbkdf2DeriveBitsError Crypto.Pbkdf2DeriveBitsError


{-| The options the password functions take.

`iterations` is the PBKDF2 round count for new hashes. The same count is used
for the work [`validate`](#validate) does on a failed check, so pass the same
options to both. Otherwise that work takes a different amount of time than a
real check and the timing gives the difference away.

`maxFailedAttempts` and `lockoutDurationMillis` control the lockout, and
`resetTokenLifetimeMillis` is how long an emailed reset token stays redeemable.
-}
type alias Options =
    { iterations : Int
    , maxFailedAttempts : Int
    , lockoutDurationMillis : Int
    , resetTokenLifetimeMillis : Int
    }


{-| The default, recommended, options for password hashing.

    { iterations = 600000
    , maxFailedAttempts = 5
    , lockoutDurationMillis = 15 * 60 * 1000
    , resetTokenLifetimeMillis = 30 * 60 * 1000
    }
-}
defaultOptions : Options
defaultOptions =
    { iterations = 600000
    , maxFailedAttempts = 5
    , lockoutDurationMillis = 15 * 60 * 1000
    , resetTokenLifetimeMillis = 30 * 60 * 1000
    }


{-| Hash a plain-text password into a [`Password Hashed`](#Password) ready for
[`add`](#add). Uses PBKDF2-SHA256 with `options.iterations` rounds and a random
16-byte salt, and stores the result in PHC string in the database.
-}
hash : Crypto.SecureContext -> Options -> Password PlainText -> Task HashError (Password Hashed)
hash secureContext options (Password string) =
    Crypto.getRandomUInt8Values 16
        |> Task.andThen
            (\salt ->
                derivePhcString secureContext
                    { password = string
                    , salt = salt
                    , iterations = options.iterations
                    , digestAlgorithm = Crypto.Sha256
                    }
            )
        |> Task.map Password


{-| Run the PBKDF2 derivation. Imports the password as key material, then
derives the hash bytes from the salt, iteration count, and digest algorithm.

Both [`derivePhcString`](#derivePhcString), which encodes the result as a PHC
string, and [`verify`](#verify), which compares the raw bytes, share this, so
creating a hash and re-deriving it later stay identical.
-}
deriveBits :
    Crypto.SecureContext
    -> { password : String, salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
    -> Task HashError Bytes
deriveBits secureContext { password, salt, iterations, digestAlgorithm } =
    password
        |> Bytes.fromString
        |> Crypto.importPbkdf2KeyFromRaw secureContext
        |> Task.mapError ImportPbkdf2KeyError
        |> Task.andThen
            (\importedPbkdf2Key ->
                Crypto.deriveBitsWithPbkdf2
                    { salt = salt
                    , iterations = iterations
                    , hash = digestAlgorithm
                    }
                    Nothing
                    importedPbkdf2Key
                    |> Task.mapError Pbkdf2DeriveBitsError
            )


{-| Derive a hash from an explicit salt, iteration count, and digest algorithm,
and encode it as a PHC string. This is [`deriveBits`](#deriveBits) followed by
the PHC encoding.
-}
derivePhcString :
    Crypto.SecureContext
    -> { password : String, salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
    -> Task HashError String
derivePhcString secureContext ({ salt, iterations, digestAlgorithm } as params) =
    deriveBits secureContext params
        |> Task.map
            (\hashedPasswordBytes ->
                PhcString.toString
                    { id = pbkdf2IdString digestAlgorithm
                    , params = Dict.singleton "i" (String.fromInt iterations)
                    , tail =
                        PhcString.SaltAndHash
                            { salt = Utils.Base64.encodeBytes salt
                            , hash = Utils.Base64.encodeBytes hashedPasswordBytes
                            }
                    }
            )


{-| The PHC identifier for a PBKDF2 hash with the given digest algorithm. The
inverse of [`digestAlgorithmFromId`](#digestAlgorithmFromId).
-}
pbkdf2IdString : Crypto.DigestAlgorithm -> String
pbkdf2IdString digestAlgorithm =
    when digestAlgorithm is
        Crypto.Sha256 ->
            "pbkdf2-sha256"

        Crypto.Sha384 ->
            "pbkdf2-sha384"

        Crypto.Sha512 ->
            "pbkdf2-sha512"



-- adding passwords


{-| Store a hashed password for the given user, returning the
[`User`](Sqlite.Auth.User#User) on success.

    User.new database secureContext
        |> Task.andThen (Username.new database { username = "alice" })
        |> Task.andThen (Password.add database hashedPassword)
-}
add : Sqlite.Database -> Password Hashed -> Internal.User -> Task Sqlite.Error Internal.User
add database (Password phcString) ((Internal.User { userId }) as user) =
    insertRow database { userId = userId, phcString = phcString }
        |> Task.map (\_ -> user)



-- validating passwords


{-| The outcome of validating a candidate password. An expected negative answer
is a value here, not an error.

`Verified` carries the verification
[`Sqlite.Auth.Session.issue`](Sqlite.Auth.Session#issue) requires to issue a
session. `Rejected` means the candidate did not match or the user has no password. 
`Locked` means the password is temporarily locked after repeated failures.
-}
type Outcome
    = Verified Internal.Verified
    | Rejected
    | Locked


{-| A real fault while validating: a database error, or a corrupt stored hash
that cannot be verified against.
-}
type ValidateError
    = StorageError Sqlite.Error
    | VerificationError VerifyError


{-| The ways a stored PHC string can fail to verify against other than a plain
mismatch.
-}
type VerifyError
    = ParsePhcStringError PhcString.Error
    | UnknownDigestAlgorithm String
    | MissingSalt
    | InvalidSalt Base64.Decode.Error
    | MissingHash
    | InvalidHash Base64.Decode.Error
    | MissingIterations
    | InvalidIterations String
    | RederiveError HashError


{-| Check a plain-text candidate against a user's stored password. This is the
step that gates session issuance. The user argument is the `Maybe` that
[`Sqlite.Auth.Username.user`](Sqlite.Auth.Username#user) returns to make chaining
easier. For example, you might handle user login like this:

    Username.user database { username = candidateName }
        |> Task.andThen (Password.validate database secureContext options candidate)
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Password.Verified proof ->
                        Session.issue database secureContext sessionOptions proof
                    ...
            )
-}
validate : Sqlite.Database -> Crypto.SecureContext -> Options -> Password PlainText -> Maybe Internal.User -> Task ValidateError Outcome
validate database secureContext options candidate maybeUser =
    when maybeUser is
        Nothing ->
            burnCandidate secureContext options candidate
                |> Task.map (\_ -> Rejected)

        Just (Internal.User { userId }) ->
            Utils.Time.nowMillis
                |> Task.andThen
                    (\now ->
                        getRow database { userId = userId }
                            |> Task.mapError StorageError
                            |> Task.andThen
                                (\maybeRow ->
                                    when maybeRow is
                                        Nothing ->
                                            burnCandidate secureContext options candidate
                                                |> Task.map (\_ -> Rejected)

                                        Just row ->
                                            when row.lockedUntil is
                                                Just lockedUntil ->
                                                    if lockedUntil > now then
                                                        burnCandidate secureContext options candidate
                                                            |> Task.map (\_ -> Locked)

                                                    else
                                                        verifyAgainstRow database secureContext options { now = now, candidate = candidate, row = row }

                                                Nothing ->
                                                    verifyAgainstRow database secureContext options { now = now, candidate = candidate, row = row }
                                )
                    )


{-| The two expected outcomes of re-deriving a candidate against a stored hash.
Anything else is a fault and stays an error.
-}
type VerifyOutcome
    = Matched
    | Mismatched


{-| Re-derive a candidate against an unlocked `auth_passwords` row and record
the outcome. On a match, reset the failure bookkeeping and stamp `last_used`.
On a mismatch, increment the failure counter, locking the password at
`options.maxFailedAttempts`. Only [`verify`](#verify) faults other than a plain
mismatch surface as errors.
-}
verifyAgainstRow :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Options
    -> { now : Int, candidate : Password PlainText, row : Row }
    -> Task ValidateError Outcome
verifyAgainstRow database secureContext options { now, candidate, row } =
    verify secureContext candidate row.password
        |> Task.andThen
            (\verifyOutcome ->
                when verifyOutcome is
                    Matched ->
                        updateRow database
                            { userId = row.userId
                            , lastUsed = Just now
                            , failedLoginAttemptsCount = 0
                            , lockedUntil = Nothing
                            }
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Verified (Internal.Verified { userId = row.userId }))

                    Mismatched ->
                        let
                            newCount : Int
                            newCount =
                                row.failedLoginAttemptsCount + 1

                            newLockedUntil : Maybe Int
                            newLockedUntil =
                                if newCount >= options.maxFailedAttempts then
                                    Just (now + options.lockoutDurationMillis)

                                else
                                    Nothing
                        in
                        updateRow database
                            { userId = row.userId
                            , lastUsed = row.lastUsed
                            , failedLoginAttemptsCount = newCount
                            , lockedUntil = newLockedUntil
                            }
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Rejected)
            )


{-| Check a plain-text candidate against a stored PHC string. The stored string
carries everything needed to reproduce its own hash: the salt, the iteration
count, and the digest algorithm. So we parse those back out, re-derive the
candidate's hash through the same [`deriveBits`](#deriveBits) used to create the
stored one, and compare the raw hash bytes. A mismatch is the `Mismatched`
value, and only real faults fail the task.
-}
verify : Crypto.SecureContext -> Password PlainText -> String -> Task ValidateError VerifyOutcome
verify secureContext (Password candidate) phcString =
    when parseStoredHash phcString is
        Err error ->
            Task.fail (VerificationError error)

        Ok { salt, iterations, digestAlgorithm, hashBytes } ->
            deriveBits secureContext
                { password = candidate
                , salt = salt
                , iterations = iterations
                , digestAlgorithm = digestAlgorithm
                }
                |> Task.mapError (RederiveError >> VerificationError)
                |> Task.map
                    (\rederivedBytes ->
                        if rederivedBytes == hashBytes then
                            Matched

                        else
                            Mismatched
                    )


{-| Recover everything [`verify`](#verify) needs from a stored PHC string: the
raw salt `Bytes`, the iteration count, the digest algorithm, and the stored
hash's raw `Bytes` to compare against.
-}
parseStoredHash : String -> Result VerifyError { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm, hashBytes : Bytes }
parseStoredHash phcString =
    PhcString.parse phcString
        |> Result.mapError ParsePhcStringError
        |> Result.andThen
            (\parsed ->
                Result.map3
                    (\salt iterations digestAlgorithm ->
                        (\hashBytes ->
                            { salt = salt
                            , iterations = iterations
                            , digestAlgorithm = digestAlgorithm
                            , hashBytes = hashBytes
                            }
                        )
                    )
                    (saltBytesFromTail parsed.tail)
                    (iterationsFromParams parsed.params)
                    (digestAlgorithmFromId parsed.id)
                    |> Result.andMap (hashBytesFromTail parsed.tail)
            )


{-| Pull the raw salt `Bytes` out of a parsed PHC string's tail by base64
decoding the salt segment.
-}
saltBytesFromTail : PhcString.Tail -> Result VerifyError Bytes
saltBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash { salt } ->
            Base64.Decode.bytes salt
                |> Result.mapError InvalidSalt

        PhcString.SaltOnly salt ->
            Base64.Decode.bytes salt
                |> Result.mapError InvalidSalt

        PhcString.NoTail ->
            Err MissingSalt


{-| Pull the raw hash `Bytes` out of a parsed PHC string's tail by base64
decoding the hash segment. A tail without a hash segment can't be verified
against.
-}
hashBytesFromTail : PhcString.Tail -> Result VerifyError Bytes
hashBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash saltAndHash ->
            Base64.Decode.bytes saltAndHash.hash
                |> Result.mapError InvalidHash

        PhcString.SaltOnly _ ->
            Err MissingHash

        PhcString.NoTail ->
            Err MissingHash


{-| Read the PBKDF2 iteration count from a parsed PHC string's `i` parameter.
-}
iterationsFromParams : Dict String String -> Result VerifyError Int
iterationsFromParams params =
    when Dict.get "i" params is
        Nothing ->
            Err MissingIterations

        Just value ->
            when String.toInt value is
                Nothing ->
                    Err (InvalidIterations value)

                Just iterations ->
                    Ok iterations


{-| Map a PHC identifier back to the digest algorithm it was hashed with.
Inverse of [`pbkdf2IdString`](#pbkdf2IdString).
-}
digestAlgorithmFromId : String -> Result VerifyError Crypto.DigestAlgorithm
digestAlgorithmFromId id =
    when id is
        "pbkdf2-sha256" ->
            Ok Crypto.Sha256

        "pbkdf2-sha384" ->
            Ok Crypto.Sha384

        "pbkdf2-sha512" ->
            Ok Crypto.Sha512

        _ ->
            Err (UnknownDigestAlgorithm id)


{-| Hash the candidate and throw the result away. Costs the same
`options.iterations` PBKDF2 rounds as a real verification and never fails, so
[`validate`](#validate) can spend it when there is no stored hash to check
and answer in uniform time.
-}
burnCandidate : Crypto.SecureContext -> Options -> Password PlainText -> Task x {}
burnCandidate secureContext options candidate =
    hash secureContext options candidate
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})



-- changing and resetting


{-| Replace a user's password. This requires the `Verified` type. A password 
check with [`validate`](#validate) creates it, and so does verifying a live session
through [`Sqlite.Auth.Session.verify`](Sqlite.Auth.Session#verify).
-}
change : Sqlite.Database -> Password Hashed -> Internal.Verified -> Task Sqlite.Error Internal.Verified
change database (Password phcString) ((Internal.Verified { userId }) as verified) =
    Sqlite.inTransaction database
        (deleteRow database { userId = userId }
            |> Task.andThen (\_ -> insertRow database { userId = userId, phcString = phcString })
            |> Task.andThen (\_ -> Session.revokeAll database { userId = userId })
        )
        |> Task.map (\_ -> verified)


{-| Phase one of a forgotten-password reset. Creates a reset token for the given
user and returns `{ token }` exactly once. It's intended for this token to be transmitted
safely, such as being emailed to a user with a known and confirmed email address. 

Phase two is [`reset`](#reset) with the generated token.
-}
requestReset : Sqlite.Database -> Crypto.SecureContext -> Options -> Internal.User -> Task Sqlite.Error { token : String }
requestReset database secureContext options (Internal.User { userId }) =
    Crypto.getRandomUInt8Values 32
        |> Task.andThen
            (\tokenBytes ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            let
                                token : String
                                token =
                                    Utils.Base64.encodeBytesUrlSafe tokenBytes
                            in
                            Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
                                |> Task.andThen
                                    (\hashed ->
                                        insertResetTokenRow database
                                            { resetToken = hashed
                                            , userId = userId
                                            , createdAt = now
                                            , expiresAt = now + options.resetTokenLifetimeMillis
                                            }
                                            |> Task.map (\_ -> { token = token })
                                    )
                        )
            )


{-| The ways redeeming a reset token can go wrong. 

- `InvalidResetToken` is a token that matches no live row, whether it is unknown, 
already used, replaced, or expired. The caller cannot tell which, deliberately.
- `ResetStorageError` is a database fault.
-}
type ResetError
    = InvalidResetToken
    | ResetStorageError Sqlite.Error


{-| Phase two of a forgotten-password reset. Use the generated reset token to set a 
new password. No user is needed, because the token resolves the user itself.

If successful, this function deletes the token, replaces the password, and revokes
all sessions the user may have. This function returns `Verified`, allowing you to
issue a new session if you choose after a successful reset.

    Password.reset database secureContext
        { token = tokenFromLink, new = hashedNew }
        |> Task.andThen (Session.issue database secureContext sessionOptions)
-}
reset : Sqlite.Database -> Crypto.SecureContext -> { token : String, new : Password Hashed } -> Task ResetError Internal.Verified
reset database secureContext { token, new } =
    let
        (Password phcString) =
            new
    in
    Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
        |> Task.andThen
            (\hashed ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            getResetTokenRow database { resetToken = hashed }
                                |> Task.mapError ResetStorageError
                                |> Task.andThen
                                    (\maybeRow ->
                                        when maybeRow is
                                            Nothing ->
                                                Task.fail InvalidResetToken

                                            Just row ->
                                                if row.expiresAt > now then
                                                    Sqlite.inTransaction database
                                                        (deleteResetTokenRow database { userId = row.userId }
                                                            |> Task.andThen (\_ -> deleteRow database { userId = row.userId })
                                                            |> Task.andThen (\_ -> insertRow database { userId = row.userId, phcString = phcString })
                                                            |> Task.andThen (\_ -> Session.revokeAll database { userId = row.userId })
                                                        )
                                                        |> Task.mapError ResetStorageError
                                                        |> Task.map (\_ -> Internal.Verified { userId = row.userId })

                                                else
                                                    Task.fail InvalidResetToken
                                    )
                        )
            )


{-| A row from the `auth_passwords` table.
-}
type alias Row =
    { userId : String
    , password : String
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }


{-| Decode a single `auth_passwords` row into a [`Row`](#Row).
-}
rowDecoder : Sqlite.Decode.Decoder Row
rowDecoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "password"
                (\password ->
                    Sqlite.Decode.maybe Sqlite.Decode.int "last_used"
                        (\lastUsed ->
                            Sqlite.Decode.int "failed_login_attempts_count"
                                (\failedLoginAttemptsCount ->
                                    Sqlite.Decode.maybe Sqlite.Decode.int "locked_until"
                                        (\lockedUntil ->
                                            Sqlite.Decode.succeed
                                                { userId = userId
                                                , password = password
                                                , lastUsed = lastUsed
                                                , failedLoginAttemptsCount = failedLoginAttemptsCount
                                                , lockedUntil = lockedUntil
                                                }
                                        )
                                )
                        )
                )
        )


{-| Insert a fresh password row for `userId`: timestamps stamped to now, zero
failed login attempts, no lock. The single write behind [`add`](#add),
[`change`](#change), and [`reset`](#reset).
-}
insertRow : Sqlite.Database -> { userId : String, phcString : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
insertRow database { userId, phcString } =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        INSERT INTO auth_passwords (user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until)
                        VALUES (:user_id, :password, :created_at, :updated_at, NULL, 0, NULL)
                        """
                    , parameters =
                        [ Sqlite.Encode.string "user_id" userId
                        , Sqlite.Encode.string "password" phcString
                        , Sqlite.Encode.int "created_at" now
                        , Sqlite.Encode.int "updated_at" now
                        ]
                    }
            )


{-| Delete a user's password row, making room for the fresh one
[`change`](#change) and [`reset`](#reset) write.
-}
deleteRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteRow database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        }


{-| Read a single user's password row by `userId`, returning `Nothing` when no
such row exists.
-}
getRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error (Maybe Row)
getRow database { userId } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, password, last_used, failed_login_attempts_count, locked_until
            FROM auth_passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        , rowDecoder = rowDecoder
        }


{-| Write a row's mutable bookkeeping, meaning `last_used`, the failure counter,
and the lock, bumping `updated_at` to now.
-}
updateRow :
    Sqlite.Database
    -> { userId : String, lastUsed : Maybe Int, failedLoginAttemptsCount : Int, lockedUntil : Maybe Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
updateRow database { userId, lastUsed, failedLoginAttemptsCount, lockedUntil } =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_passwords
                        SET updated_at = :updated_at, last_used = :last_used, failed_login_attempts_count = :failed_login_attempts_count, locked_until = :locked_until
                        WHERE user_id = :user_id
                        """
                    , parameters =
                        [ Sqlite.Encode.int "updated_at" now
                        , Sqlite.Encode.maybe Sqlite.Encode.int "last_used" lastUsed
                        , Sqlite.Encode.int "failed_login_attempts_count" failedLoginAttemptsCount
                        , Sqlite.Encode.maybe Sqlite.Encode.int "locked_until" lockedUntil
                        , Sqlite.Encode.string "user_id" userId
                        ]
                    }
            )



-- `auth_password_reset_tokens` rows


{-| Write a user's reset token row, replacing any existing one. `user_id` is
unique, so the replace is what enforces one live reset token per user.
`resetToken` is the already-hashed value, never the raw token.
-}
insertResetTokenRow :
    Sqlite.Database
    -> { resetToken : String, userId : String, createdAt : Int, expiresAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insertResetTokenRow database { resetToken, userId, createdAt, expiresAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT OR REPLACE INTO auth_password_reset_tokens (reset_token, user_id, created_at, expires_at)
            VALUES (:reset_token, :user_id, :created_at, :expires_at)
            """
        , parameters =
            [ Sqlite.Encode.string "reset_token" resetToken
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            ]
        }


{-| Read a reset token row by the hash of a presented token, returning
`Nothing` when no such row exists. Expiry is the caller's check.
-}
getResetTokenRow : Sqlite.Database -> { resetToken : String } -> Task Sqlite.Error (Maybe { userId : String, expiresAt : Int })
getResetTokenRow database { resetToken } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, expires_at
            FROM auth_password_reset_tokens
            WHERE reset_token = :reset_token
            """
        , parameters =
            [ Sqlite.Encode.string "reset_token" resetToken
            ]
        , rowDecoder =
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.int "expires_at"
                        (\expiresAt ->
                            Sqlite.Decode.succeed
                                { userId = userId
                                , expiresAt = expiresAt
                                }
                        )
                )
        }


{-| Delete a user's reset token row. Redeemed tokens are removed outright.
-}
deleteResetTokenRow : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteResetTokenRow database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_password_reset_tokens
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        }
