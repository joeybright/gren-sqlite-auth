module Sqlite.Auth.Username exposing
    ( migrationV1
    , Username
    , Raw
    , Normalized
    , fromString
    , normalize
    , toString
    , new
    , change
    , user
    )

{-| Manage users usernames in the database.

## Expected database schema

The minimum required table schema for this module to work is below:

    CREATE TABLE IF NOT EXISTS usernames (
        username TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        FOREIGN KEY (user_id)
            REFERENCES users(id)
            ON DELETE CASCADE
    );

`username` is, of course, the username of the user as a `String`. `user_id` 
references the users (in [Sqlite.Auth.User module](Sqlite.Auth.User)). Both 
`created_at` and `updated_at` are posix timestamp values.

## Migrations

@docs migrationV1

# Creating a username

You must create a `Username` before being able to save it for a user or
find a user by that username. These functions ensure usernames are properly
formatted before being saved to or searched within the database.

If you want to manipulate a username in any way, you must do so to the raw
`String` before calling `fromString`. That includes content policy:
[`normalize`](#normalize) only trims, rejects empty strings, and lowercases.

Invisible characters (like zero-width spaces) and lookalike glyphs are not
removed. Two visually identical usernames can be distinct rows. If that matters 
to your application — for example, to prevent impersonation — reject or strip
such characters before calling [`fromString`](#fromString).

@docs Username, Raw, Normalized
@docs fromString
@docs normalize
@docs toString

# Working with usernames

Adding & changing usernames are supported, as is finding users by a given
username.

@docs new
@docs change
@docs user

-}

import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Decode
import Sqlite.Decode.Row
import Sqlite.Encode
import Sqlite.Encode.Row
import Task exposing ( Task )
import Utils.Time


{-| Migrate the database to add a `usernames` table with the minimum required
schema for this module to operate.

This migration is meant to be plug-and-play with the `gren-sqlite-migrate`
package. If you are using a different method of migration, the individual 
SQL statements can be extracted from the records `statements` field.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.Username.migrationV1` - Add usernames table"
    , statements =
        [ addUsernamesTableMigrationSQL
        ]
    }


{-|-}
addUsernamesTableMigrationSQL : String
addUsernamesTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS usernames (
        username TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        FOREIGN KEY (user_id)
            REFERENCES users(id)
            ON DELETE CASCADE
    );
    """


{-| A raw, non-normalized, username.
-}
type Raw
    = Raw


{-| A normalized username that is ready to be saved to the database.
-}
type Normalized
    = Normalized


{-| A username, with a phantom type state of either `Raw` or `Normalized`.
-}
type Username state
    = Username String


{-| Turn a `String` into a raw [`Username`](#Username), ready to
[`normalize`](#normalize).
-}
fromString : String -> Username Raw
fromString =
    Username


{-| Ensures the username has been trimmed, is not empty, and all characters
are lowercase. This function does not remove empty spaces.
-}
normalize : Username Raw -> Maybe (Username Normalized)
normalize (Username string) =
    let
        trimmed : String
        trimmed =
            String.toLower (String.trim string)
    in
    if String.isEmpty trimmed then
        Nothing

    else
        Just (Username trimmed)


{-| Get the underlying username `String`.
-}
toString : Username state -> String
toString (Username string) =
    string


{-| Add a username to the given user, returning the user for further pipeline 
steps. The passed username must be normalized using the 
[`normalize`](#normalize) function.
-}
new : Sqlite.Database -> { username : Username Normalized } -> Internal.User -> Task Sqlite.Error Internal.User
new database { username } ((Internal.User { userId }) as userWitness) =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        INSERT INTO usernames (username, user_id, created_at, updated_at)
                        VALUES (:username, :user_id, :created_at, :updated_at)
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "username" (Sqlite.Encode.string (toString username))
                        , Sqlite.Encode.Row.column "user_id" (Sqlite.Encode.string userId)
                        , Sqlite.Encode.Row.column "created_at" (Sqlite.Encode.int now)
                        , Sqlite.Encode.Row.column "updated_at" (Sqlite.Encode.int now)
                        ]
                    }
                    |> Task.map (\_ -> userWitness)
            )


{-| Change one of a user's usernames to a new one. `from` names the username
being replaced and `newUsername` the replacement — a user may hold several
usernames, so only the row matching both the user and `from` changes.

A password check with
[`Sqlite.Auth.Password.validate`](Sqlite.Auth.Password#validate) creates the
`Verified` type, and so does verifying a live session through
[`Sqlite.Auth.Session.verify`](Sqlite.Auth.Session#verify).
-}
change : Sqlite.Database -> { from : Username Normalized, newUsername : Username Normalized } -> Internal.Verified -> Task Sqlite.Error Internal.Verified
change database { from, newUsername } ((Internal.Verified { userId }) as verified) =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE usernames
                        SET username = :to, updated_at = :updated_at
                        WHERE user_id = :user_id AND username = :from
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "to" (Sqlite.Encode.string (toString newUsername))
                        , Sqlite.Encode.Row.column "updated_at" (Sqlite.Encode.int now)
                        , Sqlite.Encode.Row.column "user_id" (Sqlite.Encode.string userId)
                        , Sqlite.Encode.Row.column "from" (Sqlite.Encode.string (toString from))
                        ]
                    }
                    |> Task.map (\_ -> verified)
            )


{-| Get the user who owns the given username. Returns `Nothing` if the given
username is not associated with any user.
-}
user : Sqlite.Database -> { username : Username Normalized } -> Task Sqlite.Error (Maybe Internal.User)
user database { username } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id
            FROM usernames
            WHERE username = :username
            """
        , parameters =
            [ Sqlite.Encode.Row.column "username" (Sqlite.Encode.string (toString username))
            ]
        , rowDecoder =
            Sqlite.Decode.Row.column "user_id" Sqlite.Decode.string <| \userId -> Sqlite.Decode.Row.succeed (Internal.User { userId = userId })
        }
