module Sqlite.Auth.Session exposing
    ( migrationV1
    , Session
    , Options
    , defaultOptions
    , issue
    , verify
    , VerifyError(..)
    , revoke
    , revokeAll
    )

{-| Issue, verify, and revoke users' login sessions.

A session is a login token tied to a user. The raw token is handed to the
client once, when the session is issued. Only its SHA-256 hash is stored, so a
stolen database cannot be replayed as live sessions.

## Expected database schema

The minimum required table schema for this module to work is below:

    CREATE TABLE IF NOT EXISTS sessions (
        session_token TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        last_used_at INTEGER NOT NULL,
        revoked_at INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );

- `session_token` is the primary key and stores the SHA-256 hash of the token,
never the raw token.
- `user_id` references the users (in the [Sqlite.Auth.User module](Sqlite.Auth.User)).
- `created_at` is a posix timestamp, and `expires_at` is the posix timestamp the
session stops being valid.
- `last_used_at` is a posix timestamp of the last successful verification, used
to enforce the idle timeout.
- `revoked_at` is the posix timestamp the session was revoked, or null while live.

## Migrations

@docs migrationV1

## Working with sessions

@docs Session
@docs Options, defaultOptions

### Issuing sessions

@docs issue

### Verifying sessions

@docs verify, VerifyError

### Revoking sessions

@docs revoke
@docs revokeAll

-}

import Bytes
import Crypto
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Decode
import Sqlite.Decode.Row
import Sqlite.Encode
import Sqlite.Encode.Row
import Task exposing ( Task )
import Utils.Base64
import Utils.Crypto
import Utils.Time


{-| Migrate the database to add a `sessions` table with the minimum
required schema for this module to operate. It references users, so run this
after [`Sqlite.Auth.User.migrationV1`](Sqlite.Auth.User#migrationV1).

This migration is meant to be plug-and-play with the `gren-sqlite-migrate`
package. If you are using a different method of migration, the individual SQL
statements can be extracted from the records `statements` field.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.Session.migrationV1` - Add sessions table"
    , statements =
        [ addSessionsTableMigrationSQL
        ]
    }


{-|-}
addSessionsTableMigrationSQL : String
addSessionsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS sessions (
        session_token TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        last_used_at INTEGER NOT NULL,
        revoked_at INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| A row from the `sessions` table. `sessionToken` is the SHA-256 hash of
the raw token, never the raw token itself. `revokedAt` is `Nothing` for a live
session and `Just` the revocation time once it has been explicitly revoked.
-}
type alias Session =
    { sessionToken : String
    , userId : String
    , createdAt : Int
    , expiresAt : Int
    , lastUsedAt : Int
    , revokedAt : Maybe Int
    }


{-| Options for sessions. `lifetimeMillis` caps a session's absolute age; 
`idleTimeoutMillis` caps how long it survives without being used. A stolen 
token on an abandoned session should not stay live for the rest of the absolute 
lifetime.
-}
type alias Options =
    { lifetimeMillis : Int
    , idleTimeoutMillis : Int
    }


{-| The default, recommended, options for sessions: a 30-day lifetime and a
7-day idle timeout.

    { lifetimeMillis = 30 * 24 * 60 * 60 * 1000 -- 30 days
    , idleTimeoutMillis = 7 * 24 * 60 * 60 * 1000 -- 7 days
    }
-}
defaultOptions : Options
defaultOptions =
    { lifetimeMillis = 30 * 24 * 60 * 60 * 1000
    , idleTimeoutMillis = 7 * 24 * 60 * 60 * 1000
    }


{-| Issue a session for a verified user. This requires the `Verified` type, 
which a credential check such as 
[`Sqlite.Auth.Password.validate`](Sqlite.Auth.Password#validate) produces.

Returns `{ session, token }`. Hand `token` to the client exactly once; it is a
standard base64 string, so it can contain `+`, `/`, and `=`. This library does
not make the token safe for any particular transport: if it travels in a URL,
cookie, or form field, encode it for that context and hand [`verify`](#verify)
back the exact original string. Only the token's hash is stored in the database.

    Username.user database { username = candidateName }
        |> Task.andThen (Password.validate database secureContext options candidate)
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Password.Verified proof ->
                        Session.issue database secureContext sessionOptions proof
                    ...
            )
-}
issue : Sqlite.Database -> Crypto.SecureContext -> Options -> Internal.Verified -> Task Sqlite.Error { session : Session, token : String }
issue database secureContext options (Internal.Verified { userId }) =
    sweep database options
        |> Task.andThen
            (\_ ->
                Crypto.getRandomUInt8Values 32
                    |> Task.andThen
                        (\tokenBytes ->
                            Utils.Time.nowMillis
                                |> Task.andThen
                                    (\now ->
                                        let
                                            token : String
                                            token =
                                                Utils.Base64.encodeBytes tokenBytes
                                        in
                                        Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
                                            |> Task.andThen
                                                (\hashedToken ->
                                                    let
                                                        session : Session
                                                        session =
                                                            { sessionToken = hashedToken
                                                            , userId = userId
                                                            , createdAt = now
                                                            , expiresAt = now + options.lifetimeMillis
                                                            , lastUsedAt = now
                                                            , revokedAt = Nothing
                                                            }
                                                    in
                                                    insert database session
                                                        |> Task.map (\_ -> { session = session, token = token })
                                                )
                                    )
                        )
            )


{-| Why a presented token failed to verify. `StorageError` is a real database
fault; the rest are expected rejections — the token names no live session.

  - `TokenNotFound` — the token matches no session row at all.
  - `Revoked` — the session was revoked, including when the revocation lands
    while the verification is in flight.
  - `Expired` — the session is past its absolute lifetime.
  - `IdleTimeout` — the session went unused for longer than `idleTimeoutMillis`.

-}
type VerifyError
    = StorageError Sqlite.Error
    | TokenNotFound
    | Revoked
    | Expired
    | IdleTimeout


{-| Verify a presented raw token, succeeding with the [`Session`](#Session) it
names together with the `Verified` type for the user the token relates to. A successful
verification bumps the session's `last_used_at` to now, and the returned session
reflects it. Anything that makes the token unusable — a revoked, expired, or
idle session, or a token matching no session at all — fails the task with the
matching [`VerifyError`](#VerifyError).

The `verified` field lets a live session authorize actions that require
`Verified` without re-checking a credential:

    Session.verify database secureContext options { token = token }
        |> Task.andThen
            (\{ verified } ->
                Username.change database { from = old, newUsername = new } verified
            )

This functionality opens stolen tokens up to being able to complete any action that
requires the `Verified` type in this package. As such, ensure you're following best-practices
when sending and saving tokens to a client! For example, use HTTP-only cookies!

The read and the touch run in a single transaction, and the touch re-checks
liveness in its own `WHERE` clause, so a session revoked while a verification
is in flight cannot slip through — it fails with `Revoked`.
-}
verify : Sqlite.Database -> Crypto.SecureContext -> Options -> { token : String } -> Task VerifyError { session : Session, verified : Internal.Verified }
verify database secureContext options input =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.inTransaction database
                    (getByToken database secureContext input
                        |> Task.andThen
                            (\maybeSession ->
                                when maybeSession is
                                    Nothing ->
                                        Task.succeed NoSession

                                    Just session ->
                                        when session.revokedAt is
                                            Just _ ->
                                                Task.succeed RevokedSession

                                            Nothing ->
                                                if session.expiresAt <= now then
                                                    Task.succeed ExpiredSession

                                                else if session.lastUsedAt + options.idleTimeoutMillis <= now then
                                                    Task.succeed IdleSession

                                                else
                                                    touch database options { sessionToken = session.sessionToken, now = now }
                                                        |> Task.map
                                                            (\summary ->
                                                                if summary.changes == 0 then
                                                                    RevokedSession

                                                                else
                                                                    LiveSession { session | lastUsedAt = now }
                                                            )
                            )
                    )
            )
        |> Task.mapError StorageError
        |> Task.andThen
            (\outcome ->
                when outcome is
                    LiveSession session ->
                        Task.succeed
                            { session = session
                            , verified = Internal.Verified { userId = session.userId }
                            }

                    NoSession ->
                        Task.fail TokenNotFound

                    RevokedSession ->
                        Task.fail Revoked

                    ExpiredSession ->
                        Task.fail Expired

                    IdleSession ->
                        Task.fail IdleTimeout
            )


{-| What the transactional read-and-touch inside [`verify`](#verify) found the
presented token to name. Each dead variant maps to the matching
[`VerifyError`](#VerifyError); this type exists because a task inside
[`Sqlite.inTransaction`](Sqlite#inTransaction) can only fail with
`Sqlite.Error`, so the expected rejections travel as values. A
[`touch`](#touch) that changed zero rows means the session stopped being live
between the read and the write — revocation is the only cause the shared `now`
leaves open — so it counts as `RevokedSession`.
-}
type TouchOutcome
    = LiveSession Session
    | NoSession
    | RevokedSession
    | ExpiredSession
    | IdleSession


{-| Revoke a session by its presented raw token. If the given token does
not exist, the `Task` will succeed, but no changes will be made to the
database.
-}
revoke : Sqlite.Database -> Crypto.SecureContext -> Options -> { token : String } -> Task Sqlite.Error {}
revoke database secureContext options { token } =
    Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
        |> Task.andThen
            (\hashedToken ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            Sqlite.execute database
                                { statement =
                                    """
                                    UPDATE sessions
                                    SET revoked_at = :revoked_at
                                    WHERE session_token = :session_token
                                    """
                                , parameters =
                                    [ Sqlite.Encode.Row.column "revoked_at" (Sqlite.Encode.int now)
                                    , Sqlite.Encode.Row.column "session_token" (Sqlite.Encode.string hashedToken)
                                    ]
                                }
                        )
            )
        |> Task.andThen (\_ -> sweep database options)


{-| Revoke every live session a user holds. This is also the step 
[`Sqlite.Auth.Password.change`](Sqlite.Auth.Password#change) and
[`Sqlite.Auth.Password.reset`](Sqlite.Auth.Password#reset) run, so a stolen
session never survives a credential change.
-}
revokeAll : Sqlite.Database -> { userId : String } -> Task Sqlite.Error {}
revokeAll database { userId } =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE sessions
                        SET revoked_at = :revoked_at
                        WHERE user_id = :user_id AND revoked_at IS NULL
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "revoked_at" (Sqlite.Encode.int now)
                        , Sqlite.Encode.Row.column "user_id" (Sqlite.Encode.string userId)
                        ]
                    }
            )
        |> Task.map (\_ -> {})


{-| Decode a single `sessions` row into a [`Session`](#Session).
-}
decoder : Sqlite.Decode.Row.Decoder Session
decoder =
    Sqlite.Decode.Row.column "session_token" Sqlite.Decode.string <| \sessionToken ->
    Sqlite.Decode.Row.column "user_id" Sqlite.Decode.string <| \userId ->
    Sqlite.Decode.Row.column "created_at" Sqlite.Decode.int <| \createdAt ->
    Sqlite.Decode.Row.column "expires_at" Sqlite.Decode.int <| \expiresAt ->
    Sqlite.Decode.Row.column "last_used_at" Sqlite.Decode.int <| \lastUsedAt ->
    Sqlite.Decode.Row.column "revoked_at" (Sqlite.Decode.maybe Sqlite.Decode.int) <| \revokedAt ->
        Sqlite.Decode.Row.succeed
            { sessionToken = sessionToken
            , userId = userId
            , createdAt = createdAt
            , expiresAt = expiresAt
            , lastUsedAt = lastUsedAt
            , revokedAt = revokedAt
            }


{-| Insert a session row into the `sessions` table.
-}
insert : Sqlite.Database -> Session -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { sessionToken, userId, createdAt, expiresAt, lastUsedAt, revokedAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT INTO sessions (session_token, user_id, created_at, expires_at, last_used_at, revoked_at)
            VALUES (:session_token, :user_id, :created_at, :expires_at, :last_used_at, :revoked_at)
            """
        , parameters =
            [ Sqlite.Encode.Row.column "session_token" (Sqlite.Encode.string sessionToken)
            , Sqlite.Encode.Row.column "user_id" (Sqlite.Encode.string userId)
            , Sqlite.Encode.Row.column "created_at" (Sqlite.Encode.int createdAt)
            , Sqlite.Encode.Row.column "expires_at" (Sqlite.Encode.int expiresAt)
            , Sqlite.Encode.Row.column "last_used_at" (Sqlite.Encode.int lastUsedAt)
            , Sqlite.Encode.Row.column "revoked_at" (Sqlite.Encode.maybe Sqlite.Encode.int revokedAt)
            ]
        }


{-| Read a single session by its presented raw token, returning `Nothing` when
no row matches. The token string is hashed to the stored value before
matching.
-}
getByToken : Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task Sqlite.Error (Maybe Session)
getByToken database secureContext { token } =
    Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
        |> Task.andThen
            (\hashedToken ->
                Sqlite.getMaybeOne database
                    { query =
                        """
                        SELECT session_token, user_id, created_at, expires_at, last_used_at, revoked_at
                        FROM sessions
                        WHERE session_token = :session_token
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "session_token" (Sqlite.Encode.string hashedToken)
                        ]
                    , rowDecoder = decoder
                    }
            )


{-| Bump a session row's `last_used_at` — the "touch on use" behind
[`verify`](#verify). Keyed by the stored token hash, not the raw token. The
`WHERE` clause only matches a live row: not revoked, not past its absolute
lifetime, and not idle. A revocation landing after the row was read therefore
cannot be overwritten — the update changes zero rows, and the returned
summary's `changes` count says so.
-}
touch : Sqlite.Database -> Options -> { sessionToken : String, now : Int } -> Task Sqlite.Error Sqlite.ExecutionSummary
touch database options { sessionToken, now } =
    Sqlite.execute database
        { statement =
            """
            UPDATE sessions
            SET last_used_at = :now
            WHERE session_token = :session_token
                AND revoked_at IS NULL
                AND expires_at > :now
                AND last_used_at > :idle_cutoff
            """
        , parameters =
            [ Sqlite.Encode.Row.column "now" (Sqlite.Encode.int now)
            , Sqlite.Encode.Row.column "session_token" (Sqlite.Encode.string sessionToken)
            , Sqlite.Encode.Row.column "idle_cutoff" (Sqlite.Encode.int (now - options.idleTimeoutMillis))
            ]
        }


{-| Delete every dead session row: revoked, expired, or idle past
`idleTimeoutMillis` as of now. Run by [`issue`](#issue) and
[`revoke`](#revoke), so the table tends itself during normal use.
-}
sweep : Sqlite.Database -> Options -> Task Sqlite.Error {}
sweep database options =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        DELETE FROM sessions
                        WHERE revoked_at IS NOT NULL OR expires_at <= :now OR last_used_at <= :idle_cutoff
                        """
                    , parameters =
                        [ Sqlite.Encode.Row.column "now" (Sqlite.Encode.int now)
                        , Sqlite.Encode.Row.column "idle_cutoff" (Sqlite.Encode.int (now - options.idleTimeoutMillis))
                        ]
                    }
            )
        |> Task.map (\_ -> {})
