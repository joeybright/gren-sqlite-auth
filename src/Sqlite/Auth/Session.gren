module Sqlite.Auth.Session exposing
    ( migrationV1
    , Session
    , Options
    , defaultOptions
    , issue
    , verify
    , validate
    , revoke
    , revokeAll
    )

{-| Sessions: the `auth_sessions` table and the token lifecycle around it.

A session is a login token tied to a user. The raw token is handed to the
client exactly once (by [`issue`](#issue)); only its SHA-256 hash is stored in
`auth_sessions.session_token`, so a stolen database can't be replayed as live
sessions. `revoked_at` is nullable so revocation can mark a row instead of
deleting it; dead rows (revoked or expired) are swept as part of every
[`issue`](#issue), so the table cleans itself up during normal use.

@docs migrationV1
@docs Session
@docs Options, defaultOptions
@docs issue
@docs verify
@docs validate
@docs revoke
@docs revokeAll

-}

import Bytes
import Crypto
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Utils.Base64
import Utils.Crypto
import Utils.Time


{-| Create the `auth_sessions` table. Run after
[`Sqlite.Auth.User.migrationV1`](Sqlite.Auth.User#migrationV1) (it references
`users`).
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.Session.migrationV1` - Add auth_sessions table"
    , statements =
        [ addSessionsTableMigrationSQL
        ]
    }


{-|-}
addSessionsTableMigrationSQL : String
addSessionsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_sessions (
        session_token TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        last_used_at INTEGER NOT NULL,
        revoked_at INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| A row from the `auth_sessions` table. `sessionToken` is the SHA-256 hash of
the raw token, never the raw token itself. `revokedAt` is `Nothing` for a live
session and `Just` the revocation time once it has been explicitly revoked.
-}
type alias Session =
    { sessionToken : String
    , userId : String
    , createdAt : Int
    , expiresAt : Int
    , lastUsedAt : Int
    , revokedAt : Maybe Int
    }


{-| The tunables every session function takes. `lifetimeMillis` caps a
session's absolute age; `idleTimeoutMillis` caps how long it survives without
being used — a stolen token on an abandoned session should not stay live for
the rest of the absolute lifetime.
-}
type alias Options =
    { lifetimeMillis : Int
    , idleTimeoutMillis : Int
    }


{-| The defaults: 30-day lifetime, 7-day idle timeout. Pass as-is or override
fields:

    { Session.defaultOptions | lifetimeMillis = 60 * 60 * 1000 }
-}
defaultOptions : Options
defaultOptions =
    { lifetimeMillis = 30 * 24 * 60 * 60 * 1000
    , idleTimeoutMillis = 7 * 24 * 60 * 60 * 1000
    }


{-| Issue a session for a verified user — the final step of a login pipeline.
Demands the `Verified` witness only a credential check (e.g.
[`Sqlite.Auth.Password.validate`](Sqlite.Auth.Password#validate)) can mint, so
a session can never be issued for a user who merely exists.

Returns `{ session, token }` — hand `token` to the client (URL-safe base64,
so it travels in cookies and links unescaped), keep nothing else; only its
hash is stored. Sweeps dead rows first, so every login doubles as a cleanup
pass.
-}
issue : Sqlite.Database -> Crypto.SecureContext -> Options -> Internal.Verified -> Task Sqlite.Error { session : Session, token : String }
issue database secureContext options (Internal.Verified { userId }) =
    sweep database options
        |> Task.andThen
            (\_ ->
                Crypto.getRandomUInt8Values 32
                    |> Task.andThen
                        (\tokenBytes ->
                            Utils.Time.nowMillis
                                |> Task.andThen
                                    (\now ->
                                        let
                                            token : String
                                            token =
                                                Utils.Base64.encodeBytesUrlSafe tokenBytes
                                        in
                                        Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
                                            |> Task.andThen
                                                (\hashedToken ->
                                                    let
                                                        session : Session
                                                        session =
                                                            { sessionToken = hashedToken
                                                            , userId = userId
                                                            , createdAt = now
                                                            , expiresAt = now + options.lifetimeMillis
                                                            , lastUsedAt = now
                                                            , revokedAt = Nothing
                                                            }
                                                    in
                                                    insert database session
                                                        |> Task.map (\_ -> { session = session, token = token })
                                                )
                                    )
                        )
            )


{-| Verify a presented raw token: resolve it to its stored row, treating a
revoked (`revoked_at` set), expired (`expires_at` in the past), or idle
(unused for longer than `idleTimeoutMillis`) row — or no row at all — as no
session. A successful verification touches the session: `last_used_at` is
bumped to now, and the returned [`Session`](#Session) reflects it.
-}
verify : Sqlite.Database -> Crypto.SecureContext -> Options -> { token : String } -> Task Sqlite.Error (Maybe Session)
verify database secureContext options input =
    getByToken database secureContext input
        |> Task.andThen
            (\maybeSession ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            when maybeSession is
                                Nothing ->
                                    Task.succeed Nothing

                                Just session ->
                                    when session.revokedAt is
                                        Just _ ->
                                            Task.succeed Nothing

                                        Nothing ->
                                            if session.expiresAt > now && session.lastUsedAt + options.idleTimeoutMillis > now then
                                                touch database { sessionToken = session.sessionToken, lastUsedAt = now }
                                                    |> Task.map (\_ -> Just { session | lastUsedAt = now })

                                            else
                                                Task.succeed Nothing
                        )
            )


{-| Verify a presented raw token and, when it names a live session, mint the
`Verified` witness — so holding a valid session can authorize the
witness-gated steps without re-proving a credential:

    Session.validate database secureContext options { token = token }
        |> Task.andThen
            (\maybeProof ->
                when maybeProof is
                    Just proof ->
                        Username.change database { from = old, to = new } proof
                    ...
            )

This deliberately trades "credential proven just now" for "holds a live
session": a stolen token can reach every step the witness gates, including
[`Sqlite.Auth.Password.change`](Sqlite.Auth.Password#change). Demand the
stricter proof — [`Sqlite.Auth.Password.validate`](Sqlite.Auth.Password#validate)
— where that is not acceptable. Piping the proof into [`issue`](#issue)
rotates the session token.

Built on [`verify`](#verify), so the same rules apply: a revoked, expired, or
unknown token yields `Nothing`, and a successful validation touches the
session.
-}
validate : Sqlite.Database -> Crypto.SecureContext -> Options -> { token : String } -> Task Sqlite.Error (Maybe Internal.Verified)
validate database secureContext options input =
    verify database secureContext options input
        |> Task.map
            (Maybe.map (\session -> Internal.Verified { userId = session.userId }))


{-| Revoke a session by its presented raw token — logout. Stamps `revoked_at`
with the current time, then sweeps dead rows, so logging out also cleans the
table. Idempotent: a token matching no row simply updates nothing.
-}
revoke : Sqlite.Database -> Crypto.SecureContext -> Options -> { token : String } -> Task Sqlite.Error {}
revoke database secureContext options { token } =
    Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
        |> Task.andThen
            (\hashedToken ->
                Utils.Time.nowMillis
                    |> Task.andThen
                        (\now ->
                            Sqlite.execute database
                                { statement =
                                    """
                                    UPDATE auth_sessions
                                    SET revoked_at = :revoked_at
                                    WHERE session_token = :session_token
                                    """
                                , parameters =
                                    [ Sqlite.Encode.int "revoked_at" now
                                    , Sqlite.Encode.string "session_token" hashedToken
                                    ]
                                }
                        )
            )
        |> Task.andThen (\_ -> sweep database options)


{-| Revoke every live session a user holds — "log out everywhere", and the
step [`Sqlite.Auth.Password.change`](Sqlite.Auth.Password#change) and
[`Sqlite.Auth.Password.reset`](Sqlite.Auth.Password#reset) run so a stolen
session never survives a credential change. Idempotent; the dead rows linger
until the next sweep.
-}
revokeAll : Sqlite.Database -> { userId : String } -> Task Sqlite.Error {}
revokeAll database { userId } =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_sessions
                        SET revoked_at = :revoked_at
                        WHERE user_id = :user_id AND revoked_at IS NULL
                        """
                    , parameters =
                        [ Sqlite.Encode.int "revoked_at" now
                        , Sqlite.Encode.string "user_id" userId
                        ]
                    }
            )
        |> Task.map (\_ -> {})



-- `auth_sessions` rows


{-| Decode a single `auth_sessions` row into a [`Session`](#Session).
-}
decoder : Sqlite.Decode.Decoder Session
decoder =
    Sqlite.Decode.string "session_token"
        (\sessionToken ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "expires_at"
                                (\expiresAt ->
                                    Sqlite.Decode.int "last_used_at"
                                        (\lastUsedAt ->
                                            Sqlite.Decode.maybe Sqlite.Decode.int "revoked_at"
                                                (\revokedAt ->
                                                    Sqlite.Decode.succeed
                                                        { sessionToken = sessionToken
                                                        , userId = userId
                                                        , createdAt = createdAt
                                                        , expiresAt = expiresAt
                                                        , lastUsedAt = lastUsedAt
                                                        , revokedAt = revokedAt
                                                        }
                                                )
                                        )
                                )
                        )
                )
        )


{-| Insert a session row into the `auth_sessions` table.
-}
insert : Sqlite.Database -> Session -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { sessionToken, userId, createdAt, expiresAt, lastUsedAt, revokedAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT INTO auth_sessions (session_token, user_id, created_at, expires_at, last_used_at, revoked_at)
            VALUES (:session_token, :user_id, :created_at, :expires_at, :last_used_at, :revoked_at)
            """
        , parameters =
            [ Sqlite.Encode.string "session_token" sessionToken
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            , Sqlite.Encode.int "last_used_at" lastUsedAt
            , Sqlite.Encode.maybe Sqlite.Encode.int "revoked_at" revokedAt
            ]
        }


{-| Read a single session by its presented raw token, returning `Nothing` when
no row matches. The token string is hashed to the stored value before
matching.
-}
getByToken : Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task Sqlite.Error (Maybe Session)
getByToken database secureContext { token } =
    Utils.Crypto.digestAsBase64 secureContext Crypto.Sha256 (Bytes.fromString token)
        |> Task.andThen
            (\hashedToken ->
                Sqlite.getMaybeOne database
                    { query =
                        """
                        SELECT session_token, user_id, created_at, expires_at, last_used_at, revoked_at
                        FROM auth_sessions
                        WHERE session_token = :session_token
                        """
                    , parameters =
                        [ Sqlite.Encode.string "session_token" hashedToken
                        ]
                    , rowDecoder = decoder
                    }
            )


{-| Bump a session row's `last_used_at` — the "touch on use" behind
[`verify`](#verify). Keyed by the stored token hash, not the raw token.
-}
touch : Sqlite.Database -> { sessionToken : String, lastUsedAt : Int } -> Task Sqlite.Error Sqlite.ExecutionSummary
touch database { sessionToken, lastUsedAt } =
    Sqlite.execute database
        { statement =
            """
            UPDATE auth_sessions
            SET last_used_at = :last_used_at
            WHERE session_token = :session_token
            """
        , parameters =
            [ Sqlite.Encode.int "last_used_at" lastUsedAt
            , Sqlite.Encode.string "session_token" sessionToken
            ]
        }


{-| Delete every dead session row: revoked, expired, or idle past
`idleTimeoutMillis` as of now. Run by [`issue`](#issue) and
[`revoke`](#revoke), so the table tends itself during normal use.
-}
sweep : Sqlite.Database -> Options -> Task Sqlite.Error {}
sweep database options =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        DELETE FROM auth_sessions
                        WHERE revoked_at IS NOT NULL OR expires_at <= :now OR last_used_at <= :idle_cutoff
                        """
                    , parameters =
                        [ Sqlite.Encode.int "now" now
                        , Sqlite.Encode.int "idle_cutoff" (now - options.idleTimeoutMillis)
                        ]
                    }
            )
        |> Task.map (\_ -> {})
