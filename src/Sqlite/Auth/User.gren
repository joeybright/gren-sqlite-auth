module Sqlite.Auth.User exposing
    ( migrationV1
    , new
    , get
    , id
    )

{-| Add and get users from the database.

## Migrations

You must run the following migrations, in version order, before running any 
other functions in this module.

@docs migrationV1

## Working with users

@docs new
@docs get
@docs id

-}

import Crypto
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Utils.Time


{-| Migrate the database to add a `users` table with the minimum required
schema for this package to operate.

This migration is meant to be plug-and-play with the `gren-sqlite-migrate` 
package. If you are using a different method of migration, the individual 
SQL statements can be extracted from the records `statements` field.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Sqlite.Auth.User.migrationV1` - Add users table"
    , statements =
        [ addUsersTableMigrationSQL
        ]
    }


{-| SQL to add the `users` table to the database.
-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS users (
        id TEXT PRIMARY KEY,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
    );
    """


{-| Create a new user with a randomly genered UUID v4 identifier.

This function returns a `User` type which is required for many other 
functions in this package to operate. 

It's _highly_ recommended that you immediately create a 
[username](Sqlite.Auth.Username) for the new user in the same SQLite
transaction. After a user is created, the only method of retrieving
it from the database is by it's id (via the [get](#get) function) or by
the users username. If you plan on using this package for user-facing 
authentication, user ids are not the most friendly way to remember how
to log into an account!
-}
new : Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error Internal.User
new database secureContext =
    Utils.Time.nowMillis
        |> Task.andThen
            (\now ->
                Crypto.randomUuidV4 secureContext
                    |> Task.andThen
                        (\userId ->
                            Sqlite.execute database
                                { statement =
                                    """
                                    INSERT INTO users (id, created_at, updated_at)
                                    VALUES (:id, :created_at, :updated_at)
                                    """
                                , parameters =
                                    [ Sqlite.Encode.string "id" userId
                                    , Sqlite.Encode.int "created_at" now
                                    , Sqlite.Encode.int "updated_at" now
                                    ]
                                }
                                |> Task.map (\_ -> Internal.User { userId = userId })
                        )
            )


{-| Look up a user by id, returning the [`User`](#User) for the row. The 
task fails when there's no user with the given id.
-}
get : Sqlite.Database -> { id : String } -> Task Sqlite.Error Internal.User
get database input =
    Sqlite.getOne database
        { query =
            """
            SELECT id
            FROM users
            WHERE id = :id
            """
        , parameters =
            [ Sqlite.Encode.string "id" input.id
            ]
        , rowDecoder =
            Sqlite.Decode.string "id"
                (\userId -> Sqlite.Decode.succeed (Internal.User { userId = userId }))
        }


{-| Get the id of the given [`User`](#User) as a `String`.
-}
id : Internal.User -> String
id (Internal.User { userId }) =
    userId
