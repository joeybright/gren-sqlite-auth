module Sqlite.Auth.Password.PhcString exposing
    ( PhcString
    , Tail(..)
    , Error(..)
    , parse
    , toString
    )

{-| Parser and encoder for the PHC string format used to store
password hashes such as Argon2 output.

The spec lives at <https://github.com/P-H-C/phc-string-format>.

This module's job is *string → structured data*. It deliberately does no
semantic validation: charset rules, length limits, base64 well-formedness,
and algorithm-specific requirements are the consumer's responsibility. The
one normalization it does perform is re-padding the salt and hash: PHC
stores them as unpadded base64, so the parser restores the trailing `=` so
the chunks are ready to decode.

Two structural details are lossy and cannot be checked after the fact:
duplicate parameter names collapse to the last occurrence, and multiple
kv segments merge into the single `params` `Dict`. Callers that need to
reject non-canonical input on those grounds must not rely on `parse`.
The version (`v=<n>`) lives in `params` under the key `"v"`.

The parser is a sequential, no-backtracking state machine driven by
`String.Parser.Advanced.loop`. Each chomp is terminator-driven: we walk
to the next `$`, `=`, or `,` (or end of input) and let the next
character decide the transition.
-}

import Dict exposing (Dict)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String
import String.Parser.Advanced as Parser exposing (Step(..))
import Math exposing (remainderBy)


{-| A parsed PHC string.

`params` holds every `name=value` pair found in any kv segment,
including the version under the key `"v"`. `tail` carries the
optional salt and hash; see [`Tail`](#Tail).
-}
type alias PhcString =
    { id : String
    , params : Dict String String
    , tail : Tail
    }


{-| Reasons `parse` can fail.

  - `EmptyInput` — the input was empty.
  - `MissingLeadingDollar` — the input is non-empty but doesn't
    start with `$`.
  - `KvPairMissingEquals` — inside a comma-separated kv segment a
    pair was missing its `=`; the wrapped string is the offending
    chunk.
  - `UnexpectedParseFailure` — defensive catch-all for parser
    dead-ends that do not map to a public error; should never fire
    given the current parser.
-}
type Error
    = EmptyInput
    | MissingLeadingDollar
    | KvPairMissingEquals String
    | UnexpectedParseFailure String


{-| The optional trailing salt-and-hash section.

The PHC spec allows a string to end after the identifier, after the
kv section, after the salt, or after the salt-and-hash — so `NoTail`,
`SaltOnly`, and `SaltAndHash` are all legitimate. Hash-without-salt
is structurally impossible by the spec; this custom type encodes
that invariant.
-}
type Tail
    = NoTail
    | SaltOnly String
    | SaltAndHash { salt : String, hash : String }


{-| Parse a PHC string into a structured [`PhcString`](#PhcString)
record. PHC stores the salt and hash as unpadded base64, so those
chunks are re-padded with `=` on the way out. Everything else is returned 
exactly as parsed.
-}
parse : String -> Result Error PhcString
parse input =
    if String.isEmpty input then
        Err EmptyInput

    else
        Parser.run phcParser {} input
            |> Result.mapError deadEndsToError


unexpectedEnd : Error
unexpectedEnd =
    UnexpectedParseFailure "expected end of input"


{-| Translate the most useful advanced parser dead-end into a typed
[`Error`](#Error). `unexpectedEnd` is only used to satisfy parser
primitive APIs in branches that should be unreachable, so we prefer any
more specific domain error when one is present.
-}
deadEndsToError : Array (Parser.DeadEnd {} Error) -> Error
deadEndsToError des =
    when Array.findFirst isDomainDeadEnd des is
        Just found ->
            found.value.problem

        Nothing ->
            when Array.popFirst des is
                Just { first } ->
                    first.problem

                Nothing ->
                    UnexpectedParseFailure "parser failed without a dead end"


isDomainDeadEnd : Parser.DeadEnd {} Error -> Bool
isDomainDeadEnd de =
    when de.problem is
        UnexpectedParseFailure _ ->
            False

        _ ->
            True


{-| Encode a [`PhcString`](#PhcString) record back into its canonical
string form. If `params` contains the key `"v"` it is emitted as its
own `$v=<value>` segment; any remaining params are emitted as a
single comma-separated segment.

The output is canonical for *this module*, not input-preserving:
params are emitted in the `Dict`'s alphabetical key order, so
algorithm-mandated orders (like Argon2's `m,t,p`) are not preserved
and strict external decoders may reject the result. Fields are also
emitted verbatim — a `$`, `,`, or `=` inside `id`, a param, the salt,
or the hash is neither escaped nor rejected, and produces a string
that parses back to a different structure.
-}
toString : PhcString -> String
toString phc =
    let
        versionPart =
            when Dict.get "v" phc.params is
                Nothing ->
                    ""

                Just v ->
                    "$v=" ++ v

        otherParams =
            Dict.remove "v" phc.params

        paramsPart =
            if Dict.isEmpty otherParams then
                ""

            else
                "$" ++ joinKvs otherParams

        tailPart =
            when phc.tail is
                NoTail ->
                    ""

                SaltOnly s ->
                    "$" ++ stripTrailingEquals s

                SaltAndHash r ->
                    "$" ++ stripTrailingEquals r.salt ++ "$" ++ stripTrailingEquals r.hash
    in
    "$" ++ phc.id ++ versionPart ++ paramsPart ++ tailPart


{-| Strip the trailing `=` padding so the output is spec-conforming
PHC. Tail-recursive, so safe on any input.
-}
stripTrailingEquals : String -> String
stripTrailingEquals string =
    if String.endsWith "=" string then
        stripTrailingEquals (String.dropLast 1 string)

    else
        string


{-| Restore base64 `=` padding to a chunk that the PHC format stored
unpadded.
-}
padBase64 : String -> String
padBase64 string =
    when (remainderBy 4 (String.count string)) is
        2 ->
            string ++ "=="

        3 ->
            string ++ "="

        _ ->
            string


{-| Fold a dict of params into a comma-separated `name=value,...`
string, in the dict's natural key order.
-}
joinKvs : Dict String String -> String
joinKvs params =
    Dict.foldl
        (\name value acc ->
            if String.isEmpty acc then
                name ++ "=" ++ value

            else
                acc ++ "," ++ name ++ "=" ++ value
        )
        ""
        params


type alias PhcParser a =
    Parser.Parser {} Error a


{-| Loop state. Each variant carries the fields already parsed when the
state is entered.
-}
type LoopState
    = ParsingId
    | ParsingParamOrSalt { id : String, params : Dict String String }
    | ParsingKvPairAfterComma { id : String, params : Dict String String }
    | ParsingHash { id : String, params : Dict String String, salt : String }


{-| Top-level parser: consume the leading `$`, then drive the state
machine. The `chompChar '$'` does the gating — there is no separate
"missing leading dollar" parser branch.
-}
phcParser : PhcParser PhcString
phcParser =
    Parser.succeed identity
        |> Parser.skip (Parser.chompChar '$' MissingLeadingDollar)
        |> Parser.keep (Parser.loop ParsingId step)


{-| One step of the loop. Dispatches to the per-state parser so each
state's logic can be read (and reviewed) in isolation.
-}
step : LoopState -> PhcParser (Step LoopState PhcString)
step state =
    when state is
        ParsingId ->
            parseId

        ParsingParamOrSalt r ->
            parseParamOrSalt { id = r.id, params = r.params }

        ParsingKvPairAfterComma r ->
            parseKvPairAfterComma { id = r.id, params = r.params }

        ParsingHash r ->
            parseHash r


{-| Parse the identifier segment. Terminates on `$` (kv section
follows) or end of input (id-only string).
-}
parseId : PhcParser (Step LoopState PhcString)
parseId =
    Parser.getChompedString (Parser.chompUntilEndOr "$")
        |> Parser.andThen
            (\id ->
                Parser.oneOf
                    [ Parser.chompChar '$' unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Loop
                                    (ParsingParamOrSalt
                                        { id = id
                                        , params = Dict.empty
                                        }
                                    )
                            )
                    , Parser.end unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Done
                                    { id = id
                                    , params = Dict.empty
                                    , tail = NoTail
                                    }
                            )
                    ]
            )


{-| Parse the next `$`-delimited segment after the identifier or after
a previous kv segment.

At this point PHC is intentionally ambiguous: `$name=value` starts a
parameter segment, while `$salt` starts the tail. We resolve that by
chomping until `=` or `$`:

  - `=` means the chunk is a kv name, so parse the value.
  - `$` means the chunk is the salt, and the next state parses the hash.
  - end means the chunk is a salt with no hash.
-}
parseParamOrSalt : { id : String, params : Dict String String } -> PhcParser (Step LoopState PhcString)
parseParamOrSalt r =
    Parser.getChompedString (Parser.chompWhile isNotKvNameTerminator)
        |> Parser.andThen
            (\chunk ->
                Parser.oneOf
                    [ Parser.chompChar '=' unexpectedEnd
                        |> Parser.andThen
                            (\_ ->
                                parseKvValue
                                    { id = r.id
                                    , params = r.params
                                    , name = chunk
                                    }
                            )
                    , Parser.chompChar '$' unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Loop
                                    (ParsingHash
                                        { id = r.id
                                        , params = r.params
                                        , salt = chunk
                                        }
                                    )
                            )
                    , Parser.end unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Done
                                    { id = r.id
                                    , params = r.params
                                    , tail = SaltOnly (padBase64 chunk)
                                    }
                            )
                    ]
            )


{-| Parse after a `,` inside a kv segment. The chunk must be a
kv-name, so only the `=` continuation is valid.
-}
parseKvPairAfterComma : { id : String, params : Dict String String } -> PhcParser (Step LoopState PhcString)
parseKvPairAfterComma r =
    Parser.getChompedString (Parser.chompWhile isNotKvNameTerminator)
        |> Parser.andThen
            (\chunk ->
                Parser.chompChar '=' (KvPairMissingEquals chunk)
                    |> Parser.andThen
                        (\_ ->
                            parseKvValue
                                { id = r.id
                                , params = r.params
                                , name = chunk
                                }
                        )
            )


{-| Parse the hash segment (everything remaining until end of input)
and finish the parse.
-}
parseHash : { id : String, params : Dict String String, salt : String } -> PhcParser (Step LoopState PhcString)
parseHash r =
    Parser.getChompedString (Parser.chompWhile (\_ -> True))
        |> Parser.andThen
            (\hash ->
                Parser.end unexpectedEnd
                    |> Parser.map
                        (\_ ->
                            Done
                                { id = r.id
                                , params = r.params
                                , tail = SaltAndHash { salt = padBase64 r.salt, hash = padBase64 hash }
                                }
                        )
            )


{-| After a `name=`, parse the value chunk and dispatch on the
character that followed: `,` for another kv pair in the same segment,
`$` to leave the segment (either more kv or salt — same state
re-disambiguates), or end of input to finish.
-}
parseKvValue :
    { id : String
    , params : Dict String String
    , name : String
    }
    -> PhcParser (Step LoopState PhcString)
parseKvValue r =
    let
        isNotKvValueTerminator c =
            c /= ',' && c /= '$'
    in
    Parser.getChompedString (Parser.chompWhile isNotKvValueTerminator)
        |> Parser.andThen
            (\value ->
                let
                    nextParams =
                        Dict.set r.name value r.params
                in
                Parser.oneOf
                    [ Parser.chompChar ',' unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Loop
                                    (ParsingKvPairAfterComma
                                        { id = r.id, params = nextParams }
                                    )
                            )
                    , Parser.chompChar '$' unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Loop
                                    (ParsingParamOrSalt
                                        { id = r.id, params = nextParams }
                                    )
                            )
                    , Parser.end unexpectedEnd
                        |> Parser.map
                            (\_ ->
                                Done
                                    { id = r.id, params = nextParams, tail = NoTail }
                            )
                    ]
            )


{-| Stop chomping when we hit a kv-name terminator: `=` (this was a
name) or `$` (this was the salt).
-}
isNotKvNameTerminator : Char -> Bool
isNotKvNameTerminator c =
    c /= '=' && c /= '$'
