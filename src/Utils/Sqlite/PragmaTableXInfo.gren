module Utils.Sqlite.PragmaTableXInfo exposing
    ( Column
    , Nullability(..)
    , PrimaryKey(..)
    , Visibility(..)
    , columnDecoder
    , tableSchemaQuery
    )

{-| Introspect a SQLite table's schema via `pragma_table_xinfo`.

@docs Column, Nullability, PrimaryKey, Visibility
@docs tableSchemaQuery, columnDecoder

-}

import Sqlite
import Sqlite.Decode
import Sqlite.Encode


{-| One row from `pragma_table_xinfo(<table>)`.
-}
type alias Column =
    { cid : Int
    , name : String
    , columnType : String
    , nullability : Nullability
    , defaultValue : Maybe String
    , primaryKey : PrimaryKey
    , visibility : Visibility
    }


{-| Whether the column has a `NOT NULL` constraint.
-}
type Nullability
    = NotNull
    | Nullable


{-| Whether the column participates in the table's primary key.
-}
type PrimaryKey
    = IsPrimaryKey
    | NotPrimaryKey


{-| Maps SQLite's `hidden` column: `0` normal, `1` hidden virtual-table
column, `2` generated stored column, `3` generated virtual column.
-}
type Visibility
    = Visible
    | Hidden
    | GeneratedStored
    | GeneratedVirtual


{-| Query the schema of any table by name.

    Sqlite.getAll db (Utils.Sqlite.PragmaTableXInfo.tableSchemaQuery { table = "users" })

resolves to `Task Sqlite.Error (Array Column)`.
-}
tableSchemaQuery : { table : String } -> Sqlite.Query Column
tableSchemaQuery { table } =
    { query = tableSchemaSql
    , parameters =
        [ Sqlite.Encode.string "table" table ]
    , rowDecoder = columnDecoder
    }


tableSchemaSql : String
tableSchemaSql =
    """
    SELECT cid, name, type, "notnull", dflt_value, pk, hidden
    FROM pragma_table_xinfo(:table)
    """


{-| Decode a single row of `pragma_table_xinfo` output.
-}
columnDecoder : Sqlite.Decode.Decoder Column
columnDecoder =
    Sqlite.Decode.int "cid"
        (\cid ->
            Sqlite.Decode.string "name"
                (\name ->
                    Sqlite.Decode.string "type"
                        (\columnType ->
                            Sqlite.Decode.int "notnull"
                                (\notNullInt ->
                                    Sqlite.Decode.maybe Sqlite.Decode.string "dflt_value"
                                        (\defaultValue ->
                                            Sqlite.Decode.int "pk"
                                                (\pkInt ->
                                                    Sqlite.Decode.int "hidden"
                                                        (\hiddenInt ->
                                                            Sqlite.Decode.succeed
                                                                { cid = cid
                                                                , name = name
                                                                , columnType = columnType
                                                                , nullability = nullabilityFromInt notNullInt
                                                                , defaultValue = defaultValue
                                                                , primaryKey = primaryKeyFromInt pkInt
                                                                , visibility = visibilityFromInt hiddenInt
                                                                }
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )


nullabilityFromInt : Int -> Nullability
nullabilityFromInt n =
    if n == 0 then
        Nullable

    else
        NotNull


primaryKeyFromInt : Int -> PrimaryKey
primaryKeyFromInt n =
    if n == 0 then
        NotPrimaryKey

    else
        IsPrimaryKey


visibilityFromInt : Int -> Visibility
visibilityFromInt n =
    when n is
        0 ->
            Visible

        1 ->
            Hidden

        2 ->
            GeneratedStored

        3 ->
            GeneratedVirtual

        _ ->
            Visible
