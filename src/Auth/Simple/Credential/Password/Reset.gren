module Auth.Simple.Credential.Password.Reset exposing
    ( issue
    , redeem
    , RedeemError(..)
    , resetTokenLifetimeMillis
    )

{-| The password reset flow, backed by the `password_reset_tokens` table that
[`Auth.Simple.Credential.Password.migrationV1`](Auth.Simple.Credential.Password)
owns.

This is for the *forgotten* password: the user can't prove the current secret
(for that, see [`Auth.Simple.Change`](Auth.Simple.Change)), so they prove
control of an out-of-band channel instead. [`issue`](#issue) mints a single-use,
expiring token for a user — delivering it (email, SMS) is the consumer's job,
as is deciding what to reveal when the requested account doesn't exist.
[`redeem`](#redeem) exchanges a presented token for a password replacement.

Like sessions, the raw token is returned exactly once and only its SHA-256 hash
is stored, so a stolen database can't redeem outstanding resets.

@docs issue
@docs redeem
@docs RedeemError
@docs resetTokenLifetimeMillis

-}

import Auth.Simple.Credential.Password as Password
import Base64.Decode
import Base64.Encode
import Bytes exposing ( Bytes )
import Crypto
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-| How long an issued reset token stays redeemable: 1 hour, in milliseconds.

Hard-coded for now; a future revision can lift this into configuration.
-}
resetTokenLifetimeMillis : Int
resetTokenLifetimeMillis =
    60 * 60 * 1000


{-| A row from the `password_reset_tokens` table. `consumedAt` is `Nothing`
until the token is redeemed.
-}
type alias ResetToken =
    { id : String
    , userId : String
    , tokenHash : String
    , createdAt : Int
    , expiresAt : Int
    , consumedAt : Maybe Int
    }


{-| Decode a single `password_reset_tokens` row into a [`ResetToken`](#ResetToken).
-}
decoder : Sqlite.Decode.Decoder ResetToken
decoder =
    Sqlite.Decode.string "id"
        (\id ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.string "token_hash"
                        (\tokenHash ->
                            Sqlite.Decode.int "created_at"
                                (\createdAt ->
                                    Sqlite.Decode.int "expires_at"
                                        (\expiresAt ->
                                            Sqlite.Decode.maybe Sqlite.Decode.int "consumed_at"
                                                (\consumedAt ->
                                                    Sqlite.Decode.succeed
                                                        { id = id
                                                        , userId = userId
                                                        , tokenHash = tokenHash
                                                        , createdAt = createdAt
                                                        , expiresAt = expiresAt
                                                        , consumedAt = consumedAt
                                                        }
                                                )
                                        )
                                )
                        )
                )
        )



--- token helpers


{-| Generate a fresh reset token: 32 cryptographically-random bytes, mirroring
the session token. Duplicated from `Auth.Simple.Token.Session` so a credential
module never depends on a token species.
-}
generateTokenBytes : Task x Bytes
generateTokenBytes =
    Crypto.getRandomUInt8Values 32


{-| Encode raw token bytes into the string handed to the consumer for delivery.
-}
encodeToken : Bytes -> String
encodeToken tokenBytes =
    Base64.Encode.bytes tokenBytes
        |> Base64.Encode.encode


{-| Hash raw token bytes into the value stored in `token_hash`. Full-entropy
random bytes need only a single SHA-256 — useless if stolen, reproducible for
lookups.
-}
hashToken : Crypto.SecureContext -> Bytes -> Task x String
hashToken secureContext tokenBytes =
    Crypto.digest secureContext Crypto.Sha256 tokenBytes
        |> Task.map
            (\digestBytes ->
                Base64.Encode.bytes digestBytes
                    |> Base64.Encode.encode
            )


{-| Map a presented base64 token string to its stored `token_hash`. An
undecodable token is passed through verbatim and simply matches no row.
-}
hashTokenString : Crypto.SecureContext -> String -> Task x String
hashTokenString secureContext rawToken =
    when Base64.Decode.bytes rawToken is
        Ok tokenBytes ->
            hashToken secureContext tokenBytes

        Err _ ->
            Task.succeed rawToken



--- issuing reset tokens


{-| Mint a reset token for `userId`: store its hash with a fresh expiry and
return the raw `resetToken` exactly once, for the consumer to deliver
out-of-band. The raw token is never persisted.

Issuing does not invalidate earlier tokens; each stays independently redeemable
until consumed or expired (a user may request twice and click either mail).
-}
issue :
    { userId : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task Sqlite.Error { resetToken : String }
issue { userId } database secureContext =
    Task.map3
        (\id tokenBytes now -> { id = id, tokenBytes = tokenBytes, now = Time.posixToMillis now })
        (Crypto.randomUuidV4 secureContext)
        generateTokenBytes
        Time.now
        |> Task.andThen
            (\{ id, tokenBytes, now } ->
                hashToken secureContext tokenBytes
                    |> Task.andThen
                        (\tokenHash ->
                            Sqlite.execute database
                                { statement =
                                    """
                                    INSERT INTO password_reset_tokens (id, user_id, token_hash, created_at, expires_at, consumed_at)
                                    VALUES (:id, :user_id, :token_hash, :created_at, :expires_at, :consumed_at)
                                    """
                                , parameters =
                                    [ Sqlite.Encode.string "id" id
                                    , Sqlite.Encode.string "user_id" userId
                                    , Sqlite.Encode.string "token_hash" tokenHash
                                    , Sqlite.Encode.int "created_at" now
                                    , Sqlite.Encode.int "expires_at" (now + resetTokenLifetimeMillis)
                                    , Sqlite.Encode.maybe Sqlite.Encode.int "consumed_at" Nothing
                                    ]
                                }
                                |> Task.map (\_ -> { resetToken = encodeToken tokenBytes })
                        )
            )



--- redeeming reset tokens


{-| Why a redemption was refused: `InvalidToken` deliberately covers an unknown
token, an already-consumed one, and an expired one — a caller (or an attacker
probing tokens) learns nothing about which. `StorageError` is a real database
fault.
-}
type RedeemError
    = InvalidToken
    | StorageError Sqlite.Error


{-| Redeem a reset token: replace the user's password with `newPassword` (an
already-hashed [`Password_ Hashed`](Auth.Simple.Credential.Password#Password_) —
run the new plain text through
[`validateLength`](Auth.Simple.Credential.Password#validateLength) and the
[`hash`](Auth.Simple.Credential.Password#hash) pipeline first).

The token is looked up and judged first (unknown, consumed, and expired all
answer `InvalidToken`); then, inside one
[`Sqlite.inTransaction`](Sqlite#inTransaction), the token is stamped consumed
(single-use), the old password row — if any — is deleted, and a fresh one is
inserted, which also resets any lockout.
-}
redeem :
    { token : String, newPassword : Password.Password_ Password.Hashed }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task RedeemError {}
redeem { token, newPassword } database secureContext =
    Task.map2
        (\tokenHash now -> { tokenHash = tokenHash, now = Time.posixToMillis now })
        (hashTokenString secureContext token)
        Time.now
        |> Task.andThen
            (\{ tokenHash, now } ->
                getByTokenHash tokenHash database
                    |> Task.mapError StorageError
                    |> Task.andThen
                        (\maybeRow ->
                            when maybeRow is
                                Nothing ->
                                    Task.fail InvalidToken

                                Just row ->
                                    when row.consumedAt is
                                        Just _ ->
                                            Task.fail InvalidToken

                                        Nothing ->
                                            if row.expiresAt <= now then
                                                Task.fail InvalidToken

                                            else
                                                Sqlite.inTransaction database
                                                    (consume { id = row.id, now = now } database
                                                        |> Task.andThen (\_ -> Password.delete row.userId database)
                                                        |> Task.andThen (\_ -> Password.create { userId = row.userId, password = newPassword } database)
                                                    )
                                                    |> Task.mapError StorageError
                                                    |> Task.map (\_ -> {})
                        )
            )


{-| Read a single reset-token row by its stored `token_hash`, returning
`Nothing` when no such row exists.
-}
getByTokenHash : String -> Sqlite.Database -> Task Sqlite.Error (Maybe ResetToken)
getByTokenHash tokenHash database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT id, user_id, token_hash, created_at, expires_at, consumed_at
            FROM password_reset_tokens
            WHERE token_hash = :token_hash
            """
        , parameters =
            [ Sqlite.Encode.string "token_hash" tokenHash
            ]
        , rowDecoder = decoder
        }


{-| Stamp a reset-token row consumed at `now`, making it unredeemable from here
on.
-}
consume : { id : String, now : Int } -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
consume { id, now } database =
    Sqlite.execute database
        { statement =
            """
            UPDATE password_reset_tokens
            SET consumed_at = :consumed_at
            WHERE id = :id
            """
        , parameters =
            [ Sqlite.Encode.int "consumed_at" now
            , Sqlite.Encode.string "id" id
            ]
        }
