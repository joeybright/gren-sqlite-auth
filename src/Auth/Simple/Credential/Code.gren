module Auth.Simple.Credential.Code exposing
    ( migration
    , migrationV1
    , Code
    , Config
    , defaultConfig
    , request
    , RequestError(..)
    , issue
    , credential
    , AsCredentialError(..)
    )

{-| The one-time code credential: a 6-digit numeric code minted by the package,
delivered out of band by the consumer (email, SMS), and good for a single
authentication.

A code login has two phases. [`request`](#request) resolves an identifier and
mints a code for its user — you deliver it. The user then comes back through
the ordinary [`Auth.Simple.Login.login`](Auth.Simple.Login) with
[`credential`](#credential), exactly like a password. A code is for logging in
only — forgotten passwords have their own reset tokens
([`Auth.Simple.Credential.Password.requestReset`](Auth.Simple.Credential.Password)),
so each temporary credential carries a single intent.

A user has at most one live code: issuing a new one invalidates the rest. A code
dies on use, on expiry, or after too many wrong guesses — both limits live in
the [`Config`](#Config) the pieces of this module are built with.

Codes are stored as a single SHA-256 hash. A 6-digit code is inherently
offline-guessable during its short life if the database is read-compromised —
the real fences are the expiry, single-use, and the attempt cap; the hash just
keeps live codes out of casual reads and backups.

@docs migration
@docs migrationV1
@docs Code
@docs Config
@docs defaultConfig
@docs request
@docs RequestError
@docs issue
@docs credential
@docs AsCredentialError

-}

import Auth.Simple.Credential as Credential exposing ( Credential )
import Auth.Simple.Identifier exposing ( Identifier )
import Base64.Encode
import Bytes
import Bytes.Decode
import Crypto
import Math
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-| Policy for the one-time code credential: how long an issued code stays
redeemable (milliseconds) and how many wrong guesses kill it. Build the pieces
of this module with [`defaultConfig`](#defaultConfig) when the defaults suit
you, or a record update on it when they don't:

    Code.credential Code.defaultConfig
    Code.credential { defaultConfig | maxCodeAttempts = 3 }
-}
type alias Config =
    { codeLifetimeMillis : Int
    , maxCodeAttempts : Int
    }


{-| The default code policy: codes live **10 minutes** and die after **5**
wrong guesses. With 6-digit codes and a fresh code per request, that is a
5-in-a-million chance per issuance.
-}
defaultConfig : Config
defaultConfig =
    { codeLifetimeMillis = 10 * 60 * 1000
    , maxCodeAttempts = 5
    }


{-| How many decimal digits a code has: **6**.
-}
codeDigits : Int
codeDigits =
    6



--- `auth_codes` table


{-|-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-| Create the `auth_codes` table backing the one-time code credential. Run after
[`Auth.Simple.migrationV1`](Auth.Simple) (it references `users`).
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Credential.Code.migrationV1` - Add auth_codes table"
    , statements =
        [ addCodesTableMigrationSQL
        ]
    }


{-|-}
addCodesTableMigrationSQL : String
addCodesTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_codes (
        user_id TEXT PRIMARY KEY NOT NULL,
        code TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        failed_attempts_count INTEGER NOT NULL CHECK (failed_attempts_count >= 0),
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| A row from the `auth_codes` table — at most one per user, keyed on `user_id`,
and its presence is what makes a code live. `code` holds the SHA-256 hash of the
issued code, never the plaintext. Consuming a code (successful use, or
exhausting the config's `maxCodeAttempts`) deletes the row; issuing a new code
replaces it outright. An expired row may linger until either, but never
verifies.
-}
type alias Code =
    { userId : String
    , code : String
    , createdAt : Int
    , expiresAt : Int
    , failedAttemptsCount : Int
    }


{-| Decode a single `auth_codes` row into a [`Code`](#Code).
-}
decoder : Sqlite.Decode.Decoder Code
decoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "code"
                (\code ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "expires_at"
                                (\expiresAt ->
                                    Sqlite.Decode.int "failed_attempts_count"
                                        (\failedAttemptsCount ->
                                            Sqlite.Decode.succeed
                                                { userId = userId
                                                , code = code
                                                , createdAt = createdAt
                                                , expiresAt = expiresAt
                                                , failedAttemptsCount = failedAttemptsCount
                                                }
                                        )
                                )
                        )
                )
        )



--- generating and hashing codes


{-| Generate a fresh 6-digit code, zero-padded, from cryptographically secure
randomness. Four random bytes are rejection-sampled below the largest multiple
of 10^6 that fits in 32 bits, so every code is equally likely (no modulo bias).
-}
generateCode : Task x String
generateCode =
    Crypto.getRandomUInt8Values 4
        |> Task.andThen
            (\bytes ->
                when Bytes.Decode.decode (Bytes.Decode.unsignedInt32 Bytes.BE) bytes is
                    Just n ->
                        if n < 4294000000 then
                            n
                                |> Math.modBy 1000000
                                |> String.fromInt
                                |> String.padLeft codeDigits '0'
                                |> Task.succeed

                        else
                            generateCode

                    Nothing ->
                        generateCode
            )


{-| Hash a code into the value stored in `code`: a single SHA-256,
base64-encoded.
-}
hashCode : Crypto.SecureContext -> String -> Task x String
hashCode secureContext code =
    Crypto.digest secureContext Crypto.Sha256 (Bytes.fromString code)
        |> Task.map
            (\digestBytes ->
                Base64.Encode.bytes digestBytes
                    |> Base64.Encode.encode
            )



--- requesting codes


{-| Everything a code request can go wrong on: resolving the identifier
(`ResolveError`) or minting the code (`IssueError`).
-}
type RequestError identifierError
    = ResolveError identifierError
    | IssueError Sqlite.Error


{-| Phase one of authenticating with a code: resolve the identifier and mint a
code for its user, returning `{ code }` exactly once for the consumer to send
out of band. Phase two is the ordinary
[`Auth.Simple.Login.login`](Auth.Simple.Login) with the delivered code as the
candidate.

An identifier owned by no user succeeds with `Nothing` — nothing is minted, and
nothing should be sent. Respond to the requester identically in both cases so
the request endpoint can't be used to enumerate accounts.

    Code.request db ctx Code.defaultConfig Username.identifier { identifier = "alice" }
-}
request :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Config
    -> Identifier identifierError value
    -> { identifier : value }
    -> Task (RequestError identifierError) (Maybe { code : String })
request database secureContext config identifier input =
    identifier.resolve database secureContext { value = input.identifier }
        |> Task.mapError ResolveError
        |> Task.andThen
            (\maybeUserId ->
                when maybeUserId is
                    Nothing ->
                        Task.succeed Nothing

                    Just userId ->
                        issue database secureContext config { userId = userId }
                            |> Task.mapError IssueError
                            |> Task.map Just
            )


{-| Mint a code for a known `userId`: store only its hash and return `{ code }`
exactly once, expiring after the config's `codeLifetimeMillis`. The write
replaces the user's row, so any previous code dies with it — one live code per
user, by the table's primary key. Most callers want [`request`](#request),
which resolves an identifier first.
-}
issue : Sqlite.Database -> Crypto.SecureContext -> Config -> { userId : String } -> Task Sqlite.Error { code : String }
issue database secureContext config { userId } =
    Task.map2
        (\code now -> { code = code, now = Time.posixToMillis now })
        generateCode
        Time.now
        |> Task.andThen
            (\{ code, now } ->
                hashCode secureContext code
                    |> Task.andThen
                        (\hashed ->
                            insert database
                                { userId = userId
                                , code = hashed
                                , createdAt = now
                                , expiresAt = now + config.codeLifetimeMillis
                                }
                                |> Task.map (\_ -> { code = code })
                        )
            )



--- as a credential


{-| Failure modes when driving the `auth_codes` table through the generic
[`Auth.Simple.Credential`](Auth.Simple.Credential) interface: only database
faults — a wrong, expired, consumed, or never-issued code is `Invalid`, not an
error.
-}
type AsCredentialError
    = StorageError Sqlite.Error


{-| Expose code verification as a core [`Credential`](Auth.Simple.Credential),
built from a [`Config`](#Config): `validate` hashes the presented code and
compares it against the user's one live code, consuming it on a match
(single-use) and counting wrong guesses toward the config's `maxCodeAttempts`;
`burn` hashes and discards, so an unknown identifier costs the same as a real
check.
-}
credential : Config -> Credential AsCredentialError String
credential config =
    { validate = validateCandidate config
    , burn = burnCandidate
    }


{-| The `validate` of the [`credential`](#credential) bundle. The candidate is
hashed before any lookup so every path pays the same hashing cost. No live code
(none issued, expired, consumed, or attempts exhausted) is `Invalid` — never an
error — so a caller can't distinguish it from a wrong guess.
-}
validateCandidate :
    Config
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> { userId : String, secret : String }
    -> Task AsCredentialError Credential.Validity
validateCandidate config database secureContext { userId, secret } =
    Task.map2
        (\candidateHash now -> { candidateHash = candidateHash, now = Time.posixToMillis now })
        (hashCode secureContext secret)
        Time.now
        |> Task.andThen
            (\{ candidateHash, now } ->
                getLiveByUserId database { userId = userId, now = now }
                    |> Task.mapError StorageError
                    |> Task.andThen
                        (\maybeRow ->
                            when maybeRow is
                                Nothing ->
                                    Task.succeed Credential.Invalid

                                Just row ->
                                    if candidateHash == row.code then
                                        consume database { userId = userId }
                                            |> Task.mapError StorageError
                                            |> Task.map (\_ -> Credential.Valid)

                                    else
                                        recordFailedAttempt config database { row = row }
                                            |> Task.mapError StorageError
                                            |> Task.map (\_ -> Credential.Invalid)
                        )
            )


{-| The `burn` of the [`credential`](#credential) bundle: hash the candidate
and throw the result away — the cost of a real check, and it never fails.
-}
burnCandidate : Sqlite.Database -> Crypto.SecureContext -> { secret : String } -> Task AsCredentialError {}
burnCandidate _ secureContext { secret } =
    hashCode secureContext secret
        |> Task.map (\_ -> {})



--- `auth_codes` rows


{-| Write a user's code row, live and with no failed attempts, replacing any
existing row — `user_id` is the primary key, so the replace is what enforces
one live code per user. `code` is the already-hashed value, never the plaintext.
-}
insert :
    Sqlite.Database
    -> { userId : String, code : String, createdAt : Int, expiresAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { userId, code, createdAt, expiresAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT OR REPLACE INTO auth_codes (user_id, code, created_at, expires_at, failed_attempts_count)
            VALUES (:user_id, :code, :created_at, :expires_at, 0)
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.string "code" code
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            ]
        }


{-| Read the user's code row if it is live: present and unexpired as of `now`.
-}
getLiveByUserId : Sqlite.Database -> { userId : String, now : Int } -> Task Sqlite.Error (Maybe Code)
getLiveByUserId database { userId, now } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, code, created_at, expires_at, failed_attempts_count
            FROM auth_codes
            WHERE user_id = :user_id AND expires_at > :now
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "now" now
            ]
        , rowDecoder = decoder
        }


{-| Consume a user's code, ending its life — the row is deleted, not kept.
-}
consume : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
consume database { userId } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_codes
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        }


{-| Count a wrong guess against a user's code row, consuming it once the count
reaches the config's `maxCodeAttempts`.
-}
recordFailedAttempt : Config -> Sqlite.Database -> { row : Code } -> Task Sqlite.Error Sqlite.ExecutionSummary
recordFailedAttempt config database { row } =
    let
        newCount : Int
        newCount =
            row.failedAttemptsCount + 1
    in
    if newCount >= config.maxCodeAttempts then
        consume database { userId = row.userId }

    else
        Sqlite.execute database
            { statement =
                """
                UPDATE auth_codes
                SET failed_attempts_count = :failed_attempts_count
                WHERE user_id = :user_id
                """
            , parameters =
                [ Sqlite.Encode.int "failed_attempts_count" newCount
                , Sqlite.Encode.string "user_id" row.userId
                ]
            }
