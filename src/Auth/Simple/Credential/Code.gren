module Auth.Simple.Credential.Code exposing
    ( migration
    , migrationV1
    , Code
    , codeLifetimeMillis
    , maxCodeAttempts
    , request
    , RequestError(..)
    , issue
    , credential
    , AsCredentialError(..)
    )

{-| The one-time code credential: a 6-digit numeric code minted by the package,
delivered out of band by the consumer (email, SMS), and good for a single
authentication.

A code login has two phases. [`request`](#request) resolves an identifier and
mints a code for its user — you deliver it. The user then comes back through
the ordinary [`Auth.Simple.Login.login`](Auth.Simple.Login) with
[`credential`](#credential), exactly like a password. The same code also serves
as the proof for a forgotten-password reset via
[`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password).

A user has at most one live code: issuing a new one invalidates the rest. A code
dies on use, on expiry ([`codeLifetimeMillis`](#codeLifetimeMillis)), or after
[`maxCodeAttempts`](#maxCodeAttempts) wrong guesses.

Codes are stored as a single SHA-256 hash. A 6-digit code is inherently
offline-guessable during its short life if the database is read-compromised —
the real fences are the expiry, single-use, and the attempt cap; the hash just
keeps live codes out of casual reads and backups.

@docs migration
@docs migrationV1
@docs Code
@docs codeLifetimeMillis
@docs maxCodeAttempts
@docs request
@docs RequestError
@docs issue
@docs credential
@docs AsCredentialError

-}

import Auth.Simple.Credential as Credential exposing ( Credential )
import Auth.Simple.Identifier exposing ( Identifier )
import Base64.Encode
import Bytes
import Bytes.Decode
import Crypto
import Math
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-| How long an issued code stays redeemable: 10 minutes, in milliseconds.

Hard-coded for now; a future revision can lift this into configuration.
-}
codeLifetimeMillis : Int
codeLifetimeMillis =
    10 * 60 * 1000


{-| How many wrong guesses kill a code: **5**. With 6-digit codes and a fresh
code per request, that is a 5-in-a-million chance per issuance.

Hard-coded for now; a future revision can lift this into configuration.
-}
maxCodeAttempts : Int
maxCodeAttempts =
    5


{-| How many decimal digits a code has: **6**.
-}
codeDigits : Int
codeDigits =
    6



--- `codes` table


{-|-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-| Create the `codes` table backing the one-time code credential. Run after
[`Auth.Simple.migrationV1`](Auth.Simple) (it references `users`).
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Credential.Code.migrationV1` - Add codes table"
    , statements =
        [ addCodesTableMigrationSQL
        , codesUserIdIndexSQL
        ]
    }


{-|-}
addCodesTableMigrationSQL : String
addCodesTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS codes (
        id TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL,
        code_hash TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        consumed_at INTEGER,
        failed_attempts_count INTEGER NOT NULL CHECK (failed_attempts_count >= 0),
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-|-}
codesUserIdIndexSQL : String
codesUserIdIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_codes_user_id
    ON codes(user_id);
    """


{-| A row from the `codes` table. `consumedAt` is `Nothing` while the code is
live; it is stamped on successful use, on invalidation by a newer code, and
when `failedAttemptsCount` reaches [`maxCodeAttempts`](#maxCodeAttempts).
-}
type alias Code =
    { id : String
    , userId : String
    , codeHash : String
    , createdAt : Int
    , expiresAt : Int
    , consumedAt : Maybe Int
    , failedAttemptsCount : Int
    }


{-| Decode a single `codes` row into a [`Code`](#Code).
-}
decoder : Sqlite.Decode.Decoder Code
decoder =
    Sqlite.Decode.string "id"
        (\id ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.string "code_hash"
                        (\codeHash ->
                            Sqlite.Decode.int "created_at"
                                (\createdAt ->
                                    Sqlite.Decode.int "expires_at"
                                        (\expiresAt ->
                                            Sqlite.Decode.maybe Sqlite.Decode.int "consumed_at"
                                                (\consumedAt ->
                                                    Sqlite.Decode.int "failed_attempts_count"
                                                        (\failedAttemptsCount ->
                                                            Sqlite.Decode.succeed
                                                                { id = id
                                                                , userId = userId
                                                                , codeHash = codeHash
                                                                , createdAt = createdAt
                                                                , expiresAt = expiresAt
                                                                , consumedAt = consumedAt
                                                                , failedAttemptsCount = failedAttemptsCount
                                                                }
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )



--- generating and hashing codes


{-| Generate a fresh 6-digit code, zero-padded, from cryptographically secure
randomness. Four random bytes are rejection-sampled below the largest multiple
of 10^6 that fits in 32 bits, so every code is equally likely (no modulo bias).
-}
generateCode : Task x String
generateCode =
    Crypto.getRandomUInt8Values 4
        |> Task.andThen
            (\bytes ->
                when Bytes.Decode.decode (Bytes.Decode.unsignedInt32 Bytes.BE) bytes is
                    Just n ->
                        if n < 4294000000 then
                            n
                                |> Math.modBy 1000000
                                |> String.fromInt
                                |> String.padLeft codeDigits '0'
                                |> Task.succeed

                        else
                            generateCode

                    Nothing ->
                        generateCode
            )


{-| Hash a code into the value stored in `code_hash`: a single SHA-256,
base64-encoded.
-}
hashCode : Crypto.SecureContext -> String -> Task x String
hashCode secureContext code =
    Crypto.digest secureContext Crypto.Sha256 (Bytes.fromString code)
        |> Task.map
            (\digestBytes ->
                Base64.Encode.bytes digestBytes
                    |> Base64.Encode.encode
            )



--- requesting codes


{-| Everything a code request can go wrong on: resolving the identifier
(`ResolveError`) or minting the code (`IssueError`).
-}
type RequestError identifierError
    = ResolveError identifierError
    | IssueError Sqlite.Error


{-| Phase one of authenticating with a code: resolve the identifier and mint a
code for its user, returning `{ code }` exactly once for the consumer to send
out of band. Phase two is the ordinary
[`Auth.Simple.Login.login`](Auth.Simple.Login) with the delivered code as the
candidate — or a password reset via
[`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password).

An identifier owned by no user succeeds with `Nothing` — nothing is minted, and
nothing should be sent. Respond to the requester identically in both cases so
the request endpoint can't be used to enumerate accounts.

    Code.request db ctx Username.identifier { identifier = "alice" }
-}
request :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> { identifier : value }
    -> Task (RequestError identifierError) (Maybe { code : String })
request database secureContext identifier input =
    identifier.resolve input.identifier database secureContext
        |> Task.mapError ResolveError
        |> Task.andThen
            (\maybeUserId ->
                when maybeUserId is
                    Nothing ->
                        Task.succeed Nothing

                    Just userId ->
                        issue { userId = userId } database secureContext
                            |> Task.mapError IssueError
                            |> Task.map Just
            )


{-| Mint a code for a known `userId`: store only its hash and return `{ code }`
exactly once. Any previously live codes for the user are invalidated in the
same transaction — one live code per user. Most callers want
[`request`](#request), which resolves an identifier first.
-}
issue : { userId : String } -> Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error { code : String }
issue { userId } database secureContext =
    Task.map3
        (\code id now -> { code = code, id = id, now = Time.posixToMillis now })
        generateCode
        (Crypto.randomUuidV4 secureContext)
        Time.now
        |> Task.andThen
            (\{ code, id, now } ->
                hashCode secureContext code
                    |> Task.andThen
                        (\codeHash ->
                            Sqlite.inTransaction database
                                (consumeAllForUser { userId = userId, now = now } database
                                    |> Task.andThen
                                        (\_ ->
                                            insert database
                                                { id = id
                                                , userId = userId
                                                , codeHash = codeHash
                                                , createdAt = now
                                                , expiresAt = now + codeLifetimeMillis
                                                }
                                        )
                                )
                                |> Task.map (\_ -> { code = code })
                        )
            )



--- as a credential


{-| Failure modes when driving the `codes` table through the generic
[`Auth.Simple.Credential`](Auth.Simple.Credential) interface: only database
faults — a wrong, expired, consumed, or never-issued code is `Invalid`, not an
error.
-}
type AsCredentialError
    = StorageError Sqlite.Error


{-| Expose code verification as a core [`Credential`](Auth.Simple.Credential):
`validate` hashes the presented code and compares it against the user's one
live code, consuming it on a match (single-use) and counting wrong guesses
toward [`maxCodeAttempts`](#maxCodeAttempts); `burn` hashes and discards, so an
unknown identifier costs the same as a real check.
-}
credential : Credential AsCredentialError String
credential =
    { validate = validateCandidate
    , burn = burnCandidate
    }


{-| The `validate` of the [`credential`](#credential) bundle. The candidate is
hashed before any lookup so every path pays the same hashing cost. No live code
(none issued, expired, consumed, or attempts exhausted) is `Invalid` — never an
error — so a caller can't distinguish it from a wrong guess.
-}
validateCandidate :
    { userId : String, secret : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task AsCredentialError Credential.Validity
validateCandidate { userId, secret } database secureContext =
    Task.map2
        (\candidateHash now -> { candidateHash = candidateHash, now = Time.posixToMillis now })
        (hashCode secureContext secret)
        Time.now
        |> Task.andThen
            (\{ candidateHash, now } ->
                getLiveByUserId { userId = userId, now = now } database
                    |> Task.mapError StorageError
                    |> Task.andThen
                        (\maybeRow ->
                            when maybeRow is
                                Nothing ->
                                    Task.succeed Credential.Invalid

                                Just row ->
                                    if candidateHash == row.codeHash then
                                        consume { id = row.id, now = now } database
                                            |> Task.mapError StorageError
                                            |> Task.map (\_ -> Credential.Valid)

                                    else
                                        recordFailedAttempt { row = row, now = now } database
                                            |> Task.mapError StorageError
                                            |> Task.map (\_ -> Credential.Invalid)
                        )
            )


{-| The `burn` of the [`credential`](#credential) bundle: hash the candidate
and throw the result away — the cost of a real check, and it never fails.
-}
burnCandidate : String -> Sqlite.Database -> Crypto.SecureContext -> Task AsCredentialError {}
burnCandidate secret _ secureContext =
    hashCode secureContext secret
        |> Task.map (\_ -> {})



--- `codes` rows


{-| Insert a code row into the `codes` table, live and with no failed attempts.
-}
insert :
    Sqlite.Database
    -> { id : String, userId : String, codeHash : String, createdAt : Int, expiresAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { id, userId, codeHash, createdAt, expiresAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT INTO codes (id, user_id, code_hash, created_at, expires_at, consumed_at, failed_attempts_count)
            VALUES (:id, :user_id, :code_hash, :created_at, :expires_at, NULL, 0)
            """
        , parameters =
            [ Sqlite.Encode.string "id" id
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.string "code_hash" codeHash
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            ]
        }


{-| Read the user's single live code row: unconsumed and unexpired as of `now`.
-}
getLiveByUserId : { userId : String, now : Int } -> Sqlite.Database -> Task Sqlite.Error (Maybe Code)
getLiveByUserId { userId, now } database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT id, user_id, code_hash, created_at, expires_at, consumed_at, failed_attempts_count
            FROM codes
            WHERE user_id = :user_id AND consumed_at IS NULL AND expires_at > :now
            ORDER BY created_at DESC
            LIMIT 1
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "now" now
            ]
        , rowDecoder = decoder
        }


{-| Stamp a code row consumed at `now`, ending its life.
-}
consume : { id : String, now : Int } -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
consume { id, now } database =
    Sqlite.execute database
        { statement =
            """
            UPDATE codes
            SET consumed_at = :consumed_at
            WHERE id = :id
            """
        , parameters =
            [ Sqlite.Encode.int "consumed_at" now
            , Sqlite.Encode.string "id" id
            ]
        }


{-| Stamp every live code a user holds as consumed, so a freshly issued code is
the only one standing.
-}
consumeAllForUser : { userId : String, now : Int } -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
consumeAllForUser { userId, now } database =
    Sqlite.execute database
        { statement =
            """
            UPDATE codes
            SET consumed_at = :consumed_at
            WHERE user_id = :user_id AND consumed_at IS NULL
            """
        , parameters =
            [ Sqlite.Encode.int "consumed_at" now
            , Sqlite.Encode.string "user_id" userId
            ]
        }


{-| Count a wrong guess against a code row, stamping it consumed once the count
reaches [`maxCodeAttempts`](#maxCodeAttempts).
-}
recordFailedAttempt : { row : Code, now : Int } -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
recordFailedAttempt { row, now } database =
    let
        newCount : Int
        newCount =
            row.failedAttemptsCount + 1

        consumedAt : Maybe Int
        consumedAt =
            if newCount >= maxCodeAttempts then
                Just now

            else
                Nothing
    in
    Sqlite.execute database
        { statement =
            """
            UPDATE codes
            SET failed_attempts_count = :failed_attempts_count, consumed_at = :consumed_at
            WHERE id = :id
            """
        , parameters =
            [ Sqlite.Encode.int "failed_attempts_count" newCount
            , Sqlite.Encode.maybe Sqlite.Encode.int "consumed_at" consumedAt
            , Sqlite.Encode.string "id" row.id
            ]
        }
