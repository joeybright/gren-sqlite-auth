module Auth.Simple.Credential.Stored exposing ( Stored )

{-| The stored half of a credential: a durable secret, prepared by the caller
and written by the package (a hashed password today; a TOTP enrollment
tomorrow).

Validation lives in the credential's core
[`Credential`](Auth.Simple.Credential); this record carries only the writes,
which is what [`Auth.Simple.Register`](Auth.Simple.Register) drives.

@docs Stored

-}

import Crypto
import Sqlite
import Task exposing ( Task )


{-| The write operations of a durable credential: persist a caller-prepared
secret of type `stored` (e.g. an already-hashed password), and remove it.

Both are plain database writes — `Sqlite.Error`, no custom error — so
workflows can run them inside [`Sqlite.inTransaction`](Sqlite#inTransaction).
-}
type alias Stored stored =
    { insert :
        { userId : String
        , secret : stored
        }
        -> Sqlite.Database
        -> Crypto.SecureContext
        -> Task Sqlite.Error {}
    , remove :
        { userId : String
        }
        -> Sqlite.Database
        -> Crypto.SecureContext
        -> Task Sqlite.Error {}
    }
