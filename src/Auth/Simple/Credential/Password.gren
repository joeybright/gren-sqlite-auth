module Auth.Simple.Credential.Password exposing
    ( migrationV1
    , Password
    , create
    , insert
    , get
    , update
    , delete
    , Password_, PlainText, Hashed
    , fromString
    , minimumPasswordLength
    , validateLength
    , hash
    , hashWithDefaults
    , hashPassword, HashPasswordError(..)
    , VerifyPasswordError(..)
    , credential, stored, AsCredentialError(..)
    , change, ChangeError(..)
    , requestReset, RequestResetError(..)
    , issueReset
    , reset, ResetError(..)
    )

{-| The password authentication method: its schema migration and CRUD access to
the `auth_passwords` table.

Each row stores one user's hashed (PHC-formatted) password plus the bookkeeping
needed for lockout (`failed_login_attempts_count`, `locked_until`) and last-use
tracking (`last_used`). The table is keyed by `user_id` (one password per user),
so every CRUD function here is keyed on the user's id rather than a separate row
id. The schema is owned by [`migrationV1`](#migrationV1), which also creates the
`auth_password_reset_tokens` table backing the forgotten-password flow
([`requestReset`](#requestReset) / [`reset`](#reset)).

@docs migrationV1
@docs Password
@docs create
@docs insert
@docs get
@docs update
@docs delete

# Plain-text passwords

@docs Password_, PlainText, Hashed
@docs fromString
@docs minimumPasswordLength
@docs validateLength

# Hashing

@docs hash
@docs hashPassword, HashPasswordError
@docs VerifyPasswordError

# As a credential

@docs credential, stored, AsCredentialError

# Changing and resetting

@docs change, ChangeError
@docs requestReset, RequestResetError
@docs issueReset
@docs reset, ResetError

@docs hashWithDefaults

-}

import Base64.Decode
import Base64.Encode
import Bytes exposing ( Bytes )
import Crypto
import Dict exposing ( Dict )
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time
import Auth.Simple.Credential as Credential exposing ( Credential )
import Auth.Simple.Credential.Stored exposing ( Stored )
import Auth.Simple.Credential.Password.PhcString as PhcString
import Auth.Simple.Identifier exposing ( Identifier )
import Auth.Simple.Token exposing ( Token )


{-| A password in plain text. Pass this into the `prepare` function to evauluate
any password requirements and prepare for hashing.
-}
type PlainText =
    PlainText


{-| A password that has been hashed and is ready to save to the database.
-}
type Hashed =
    Hashed


{-| A password.
-}
type Password_ state =
    Password_ String


{-| Available algorithms for hashing the password and available configuration
for the algorithm.

Any algorithms in the future added to this package will be expected to be in 
the `Crypto` module of the `gren-core` package. If you want to use your own 
algorithm, vendor this code and rewrite it to support what you're looking for!

The only currently supported algorithm is Pbkdf2. Both iterations and hash can
be customized, but the salt will always be a randomly generated set of `Bytes`,
the generation function of which cannot be changed.
-}
type Algorithm =
    Pbkdf2 
        { iterations : Int
        , hash : Crypto.DigestAlgorithm
        }


{-| Turn a `String` into a plain-text [`Password_`](#Password_), ready to hash or
to hand to a login workflow as the candidate secret.

No validation happens here — a login candidate must be comparable however short
it is. When taking a *new* password at registration or change time, run it
through [`validateLength`](#validateLength) before hashing.
-}
fromString : String -> Password_ PlainText
fromString passwordString =
    Password_ passwordString


{-| The minimum length [`validateLength`](#validateLength) enforces: **8
characters**.

This is a baseline floor, not a full password policy. A consumer wanting stricter
or categorical rules — a longer minimum, character classes, breach-list checks, and
so on — should validate them in the application before hashing; those rules are
intentionally not modelled here.
-}
minimumPasswordLength : Int
minimumPasswordLength =
    8


{-| Validate a *new* plain-text password before hashing it: rejects one shorter
than [`minimumPasswordLength`](#minimumPasswordLength), reporting the limit and
the actual character count (via `String.count`). Use this at registration and
password-change time; login candidates skip it.
-}
validateLength : Password_ PlainText -> Result { minimum : Int, actual : Int } (Password_ PlainText)
validateLength (Password_ string) =
    let
        actual : Int
        actual =
            String.count string
    in
    if actual < minimumPasswordLength then
        Err
            { minimum = minimumPasswordLength
            , actual = actual
            }

    else
        Ok (Password_ string)


{-| Properly hash the password into a base64-encoded phc string, ready to save
to the database.

This function does absolutely no checking for password string integrity beyond
what the caller has done — run a new password through
[`validateLength`](#validateLength) (and any app-specific policy) first.
-}
hash : Crypto.SecureContext -> Algorithm -> Dict String String -> Password_ PlainText -> Task HashPasswordError (Password_ Hashed)
hash secureContext algorithm _params (Password_ string) =
    when algorithm is
        Pbkdf2 config ->
            Crypto.getRandomUInt8Values 16
                |> Task.andThen
                    (\salt ->
                        hashPasswordHelper secureContext
                            { password = string
                            , salt = salt
                            , iterations = config.iterations
                            , digestAlgorithm = config.hash
                            }
                    )
                |> Task.map Password_


{-| Hash a plain-text password with this package's default PBKDF2 configuration
(600,000 iterations over SHA-256), yielding a [`Password_ Hashed`](#Password_)
ready to hand to [`create`](#create).

This is the phantom-typed counterpart to [`hashPassword`](#hashPassword): same
parameters, but it returns a guarded `Password_ Hashed` instead of a raw `String`.
For control over the algorithm, use [`hash`](#hash) directly.
-}
hashWithDefaults : Password_ PlainText -> Crypto.SecureContext -> Task HashPasswordError (Password_ Hashed)
hashWithDefaults plainText secureContext =
    hash secureContext defaultAlgorithm Dict.empty plainText


{-| The configuration [`hashWithDefaults`](#hashWithDefaults) hashes with: PBKDF2,
600,000 iterations, SHA-256 — matching [`hashPassword`](#hashPassword).
-}
defaultAlgorithm : Algorithm
defaultAlgorithm =
    Pbkdf2
        { iterations = 600000
        , hash = Crypto.Sha256
        }


{-| How many consecutive failed login attempts lock a password: **5**.

Hard-coded for now; a future revision can lift this into configuration.
-}
maxFailedLoginAttempts : Int
maxFailedLoginAttempts =
    5


{-| How long a lockout lasts once triggered: 15 minutes, in milliseconds.

Hard-coded for now; a future revision can lift this into configuration.
-}
lockoutDurationMillis : Int
lockoutDurationMillis =
    15 * 60 * 1000



-- migrations


{-| The first migration needed in order for passwords to work.
-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-|-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Credential.Password.migrationV1` - Add auth_passwords and auth_password_reset_tokens tables"
    , statements =
        [ addPasswordsTableMigrationSQL
        , addPasswordResetTokensTableMigrationSQL
        ]
    }



--- `auth_passwords` table


{-|-}
addPasswordsTableMigrationSQL : String
addPasswordsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| `reset_token` stores the SHA-256 hash of an emailed reset token and is the
primary key because redemption looks the token up directly. `UNIQUE (user_id)`
keeps one live reset token per user — issuing a new one replaces the old.
-}
addPasswordResetTokensTableMigrationSQL : String
addPasswordResetTokensTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_password_reset_tokens (
        reset_token TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """




--- `auth_passwords` rows


{-| A row from the `auth_passwords` table.

`password` is the PHC-formatted hash (see [`hashPassword`](#hashPassword)).
`lastUsed` and `lockedUntil` are nullable; `failedLoginAttemptsCount` is
constrained to be non-negative by the schema.
-}
type alias Password =
    { userId : String
    , password : String
    , createdAt : Int
    , updatedAt : Int
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }


{-| Decode a single `auth_passwords` row into a [`Password`](#Password).
-}
decoder : Sqlite.Decode.Decoder Password
decoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "password"
                (\password ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "updated_at"
                                (\updatedAt ->
                                    Sqlite.Decode.maybe Sqlite.Decode.int "last_used"
                                        (\lastUsed ->
                                            Sqlite.Decode.int "failed_login_attempts_count"
                                                (\failedLoginAttemptsCount ->
                                                    Sqlite.Decode.maybe Sqlite.Decode.int "locked_until"
                                                        (\lockedUntil ->
                                                            Sqlite.Decode.succeed
                                                                { userId = userId
                                                                , password = password
                                                                , createdAt = createdAt
                                                                , updatedAt = updatedAt
                                                                , lastUsed = lastUsed
                                                                , failedLoginAttemptsCount = failedLoginAttemptsCount
                                                                , lockedUntil = lockedUntil
                                                                }
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )



--- creating passwords


{-| Store a hashed `password` for `userId` and save it to the database.

`password` is a [`Password_ Hashed`](#Password_): the phantom type guards this
entry point so a plain-text password can never be persisted. Produce one with
[`hash`](#hash) or [`hashWithDefaults`](#hashWithDefaults) first. Stamps
`created_at`/`updated_at` to now, starts the user with zero failed login attempts
and no lock, inserts the row, and returns the created [`Password`](#Password). To
insert inside an existing transaction with caller-supplied values, use
[`insert`](#insert) directly.
-}
create :
    { userId : String, password : Password_ Hashed }
    -> Sqlite.Database
    -> Task Sqlite.Error Password
create { userId, password } database =
    let
        (Password_ passwordString) =
            password
    in
    Time.now
        |> Task.andThen
            (\now ->
                let
                    record : Password
                    record =
                        { userId = userId
                        , password = passwordString
                        , createdAt = Time.posixToMillis now
                        , updatedAt = Time.posixToMillis now
                        , lastUsed = Nothing
                        , failedLoginAttemptsCount = 0
                        , lockedUntil = Nothing
                        }
                in
                insert database record
                    |> Task.map (\_ -> record)
            )


{-| Insert a password row into the `auth_passwords` table using caller-supplied values.
-}
insert :
    Sqlite.Database
    ->
        { userId : String
        , password : String
        , createdAt : Int
        , updatedAt : Int
        , lastUsed : Maybe Int
        , failedLoginAttemptsCount : Int
        , lockedUntil : Maybe Int
        }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { userId, password, createdAt, updatedAt, lastUsed, failedLoginAttemptsCount, lockedUntil } =
    let
        statement : String
        statement =
            """
            INSERT INTO auth_passwords (user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until)
            VALUES (:user_id, :password, :created_at, :updated_at, :last_used, :failed_login_attempts_count, :locked_until)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.string "password" password
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "updated_at" updatedAt
            , Sqlite.Encode.maybe Sqlite.Encode.int "last_used" lastUsed
            , Sqlite.Encode.int "failed_login_attempts_count" failedLoginAttemptsCount
            , Sqlite.Encode.maybe Sqlite.Encode.int "locked_until" lockedUntil
            ]
        }



--- reading passwords


{-| Read a single user's password row by `userId`, returning `Nothing` when no
such row exists.
-}
get : { userId : String } -> Sqlite.Database -> Task Sqlite.Error (Maybe Password)
get { userId } database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until
            FROM auth_passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId 
            ]
        , rowDecoder = decoder
        }



--- updating passwords


{-| Update a user's password row by `userId`, bumping `updated_at` to now.

Covers the mutable fields: the stored `password` (on a password change), the
lockout bookkeeping (`failedLoginAttemptsCount`, `lockedUntil`), and `lastUsed`.
Pass `Nothing` for `lockedUntil`/`lastUsed` to clear them.
-}
update :
    { userId : String
    , password : String
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }
    -> Sqlite.Database
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update { userId, password, lastUsed, failedLoginAttemptsCount, lockedUntil } database =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_passwords
                        SET password = :password, updated_at = :updated_at, last_used = :last_used, failed_login_attempts_count = :failed_login_attempts_count, locked_until = :locked_until
                        WHERE user_id = :user_id
                        """
                    , parameters =
                        [ Sqlite.Encode.string "password" password
                        , Sqlite.Encode.int "updated_at" (Time.posixToMillis now)
                        , Sqlite.Encode.maybe Sqlite.Encode.int "last_used" lastUsed
                        , Sqlite.Encode.int "failed_login_attempts_count" failedLoginAttemptsCount
                        , Sqlite.Encode.maybe Sqlite.Encode.int "locked_until" lockedUntil
                        , Sqlite.Encode.string "user_id" userId
                        ]
                    }
            )



--- deleting passwords


{-| Delete a user's password row by `userId`.
-}
delete : { userId : String } -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
delete { userId } database =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId 
            ]
        }



-- hashing


{-| Errors that can happen when creating a hashed password `String`.
-}
type HashPasswordError
    = ImportPbkdf2KeyError Crypto.ImportPbkdf2KeyError
    | Pbkdf2DeriveBitsError Crypto.Pbkdf2DeriveBitsError


{-| Properly hash a password, returning a PHC-formatted `String` ready to
safely save to a database.
-}
hashPassword : String -> Crypto.SecureContext -> Task HashPasswordError String
hashPassword password secureContext =
    let
        digest : Crypto.DigestAlgorithm
        digest =
            Crypto.Sha256

        iterations : Int
        iterations =
            600000
    in
    Crypto.getRandomUInt8Values 16
        |> Task.andThen
            (\saltBytes ->
                hashPasswordHelper secureContext
                    { password = password
                    , salt = saltBytes
                    , iterations = iterations
                    , digestAlgorithm = digest
                    }
            )


{-| Everything [`hashPasswordHelper`](#hashPasswordHelper) needs to derive a hash.
-}
type alias HashPasssword =
    { password : String
    , salt : Bytes
    , iterations : Int
    , digestAlgorithm : Crypto.DigestAlgorithm
    }


{-| Run the PBKDF2 derivation itself: import the password as key material, then
derive the hash bytes from the salt, iteration count, and digest algorithm.
Shared by [`hashPasswordHelper`](#hashPasswordHelper) (which encodes the result
as a PHC string) and [`verify`](#verify) (which compares the raw bytes), so
creation and re-derivation stay identical.
-}
deriveBits : Crypto.SecureContext -> HashPasssword -> Task HashPasswordError Bytes
deriveBits secureContext { password, salt, iterations, digestAlgorithm } =
    password
        |> Bytes.fromString
        |> Crypto.importPbkdf2KeyFromRaw secureContext
        |> Task.mapError ImportPbkdf2KeyError
        |> Task.andThen
            (\importedPbkdf2Key ->
                Crypto.deriveBitsWithPbkdf2
                    { salt = salt
                    , iterations = iterations
                    , hash = digestAlgorithm
                    }
                    Nothing
                    importedPbkdf2Key
                    |> Task.mapError Pbkdf2DeriveBitsError
            )


{-| Derive a PHC-formatted hash from an explicit salt, iteration count, and digest
algorithm: [`deriveBits`](#deriveBits) plus the PHC encoding. Used by
[`hash`](#hash) and [`hashPassword`](#hashPassword).
-}
hashPasswordHelper : Crypto.SecureContext -> HashPasssword -> Task HashPasswordError String
hashPasswordHelper secureContext ({ salt, iterations, digestAlgorithm } as params) =
    let
        pbkdf2IdString : Crypto.DigestAlgorithm -> String
        pbkdf2IdString usedHash =
            when usedHash is
                Crypto.Sha256 ->
                    "pbkdf2-sha256"

                Crypto.Sha384 ->
                    "pbkdf2-sha384"

                Crypto.Sha512 ->
                    "pbkdf2-sha512"
    in
    deriveBits secureContext params
        |> Task.map
            (\hashedPasswordBytes ->
                PhcString.toString
                    { id = pbkdf2IdString digestAlgorithm
                    , params = Dict.singleton "i" (String.fromInt iterations)
                    , tail =
                        PhcString.SaltAndHash
                            { salt =
                                Base64.Encode.bytes salt
                                    |> Base64.Encode.encode
                            , hash =
                                Base64.Encode.bytes hashedPasswordBytes
                                    |> Base64.Encode.encode
                            }
                    }
            )


{-| Errors that can happen when verifying a password against a stored PHC
`String`.
-}
type VerifyPasswordError
    = ParsePhcStringError PhcString.Error
    | UnknownDigestAlgorithm String
    | MissingSalt
    | InvalidSalt Base64.Decode.Error
    | MissingHash
    | InvalidHash Base64.Decode.Error
    | MissingIterations
    | InvalidIterations String
    | RederiveError HashPasswordError
    | PasswordMismatch


{-| Check a plain-text `password` against a stored PHC `String`, succeeding with
`{}` when they match and failing with a [`VerifyPasswordError`](#VerifyPasswordError)
otherwise.

The stored string carries everything needed to reproduce its own hash: the salt,
the iteration count, and the digest algorithm. We parse those back out, re-derive
the candidate's hash through the same [`deriveBits`](#deriveBits) used to create
the stored one, and compare the raw hash bytes — the stored hash's base64
segment decoded, against the freshly derived `Bytes`. A match proves the
password is the one that produced the stored hash.
-}
verify : String -> Password_ Hashed -> Crypto.SecureContext -> Task VerifyPasswordError {}
verify password (Password_ phcString) secureContext =
    when PhcString.parse phcString is
        Err error ->
            Task.fail (ParsePhcStringError error)

        Ok parsed ->
            when paramsFromPhcString parsed is
                Err error ->
                    Task.fail error

                Ok { salt, iterations, digestAlgorithm, hashBytes } ->
                    deriveBits secureContext
                        { password = password
                        , salt = salt
                        , iterations = iterations
                        , digestAlgorithm = digestAlgorithm
                        }
                        |> Task.mapError RederiveError
                        |> Task.andThen
                            (\rederivedBytes ->
                                if rederivedBytes == hashBytes then
                                    Task.succeed {}

                                else
                                    Task.fail PasswordMismatch
                            )


{-| Recover everything [`verify`](#verify) needs from a parsed PHC string: the
raw salt `Bytes`, the iteration count, the digest algorithm, and the stored
hash's raw `Bytes` to compare against.
-}
paramsFromPhcString : PhcString.PhcString -> Result VerifyPasswordError { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm, hashBytes : Bytes }
paramsFromPhcString parsed =
    Result.map3
        (\salt iterations digestAlgorithm ->
            (\hashBytes ->
                { salt = salt
                , iterations = iterations
                , digestAlgorithm = digestAlgorithm
                , hashBytes = hashBytes
                }
            )
        )
        (saltBytesFromTail parsed.tail)
        (iterationsFromParams parsed.params)
        (digestAlgorithmFromId parsed.id)
        |> Result.andMap (hashBytesFromTail parsed.tail)


{-| Pull the raw salt `Bytes` out of a parsed PHC string's tail by base64
decoding the salt segment.
-}
saltBytesFromTail : PhcString.Tail -> Result VerifyPasswordError Bytes
saltBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash { salt } ->
            decodeSalt salt

        PhcString.SaltOnly salt ->
            decodeSalt salt

        PhcString.NoTail ->
            Err MissingSalt


{-| Pull the raw hash `Bytes` out of a parsed PHC string's tail by base64
decoding the hash segment. A tail without a hash segment can't be verified
against.
-}
hashBytesFromTail : PhcString.Tail -> Result VerifyPasswordError Bytes
hashBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash saltAndHash ->
            Base64.Decode.bytes saltAndHash.hash
                |> Result.mapError InvalidHash

        PhcString.SaltOnly _ ->
            Err MissingHash

        PhcString.NoTail ->
            Err MissingHash


{-| Base64 decode a salt segment into raw `Bytes`.
-}
decodeSalt : String -> Result VerifyPasswordError Bytes
decodeSalt salt =
    Base64.Decode.bytes salt
        |> Result.mapError InvalidSalt


{-| Read the PBKDF2 iteration count from a parsed PHC string's `i` parameter.
-}
iterationsFromParams : Dict String String -> Result VerifyPasswordError Int
iterationsFromParams params =
    when Dict.get "i" params is
        Nothing ->
            Err MissingIterations

        Just value ->
            when String.toInt value is
                Nothing ->
                    Err (InvalidIterations value)

                Just iterations ->
                    Ok iterations


{-| Map a PHC identifier back to the digest algorithm it was hashed with. This
is the inverse of the `pbkdf2IdString` mapping inside
[`hashPasswordHelper`](#hashPasswordHelper).
-}
digestAlgorithmFromId : String -> Result VerifyPasswordError Crypto.DigestAlgorithm
digestAlgorithmFromId id =
    when id is
        "pbkdf2-sha256" ->
            Ok Crypto.Sha256

        "pbkdf2-sha384" ->
            Ok Crypto.Sha384

        "pbkdf2-sha512" ->
            Ok Crypto.Sha512

        _ ->
            Err (UnknownDigestAlgorithm id)



-- credential


{-| Failure modes when driving the `auth_passwords` table through the generic
[`Auth.Simple.Credential`](Auth.Simple.Credential) interface: a database fault,
or a real verification fault (a corrupt stored PHC string, a crypto error — a
wrong password is *not* an error, it's `Invalid`; a missing password row is a
plain mismatch).
-}
type AsCredentialError
    = StorageError Sqlite.Error
    | VerificationError VerifyPasswordError


{-| The two expected outcomes of re-deriving a candidate against a stored hash;
anything else is a fault and stays an error.
-}
type VerifyOutcome
    = Matched
    | Mismatched


{-| Expose password verification as a core
[`Credential`](Auth.Simple.Credential): `validate` re-derives a plain-text
candidate against the stored PHC string via [`verify`](#verify), enforcing
lockout (see [`maxFailedLoginAttempts`](#maxFailedLoginAttempts)); `burn`
spends a full hashing round so callers with no user to check can stay
timing-uniform. The writes live in [`stored`](#stored).

This is a pure function bundle: the database and secure context are supplied per
call by whatever drives the credential (e.g. [`Auth.Simple.Login`](Auth.Simple.Login)).
-}
credential : Credential AsCredentialError (Password_ PlainText)
credential =
    { validate = validateCandidate
    , burn = burnCandidate
    }


{-| Expose the `auth_passwords` table writes as a
[`Stored`](Auth.Simple.Credential.Stored) credential, for
[`Auth.Simple.Register`](Auth.Simple.Register): `insert` persists an
already-hashed [`Password_ Hashed`](#Password_) (run the [`hash`](#hash)
pipeline first) and `remove` deletes the user's password row.
-}
stored : Stored (Password_ Hashed)
stored =
    { insert =
        (\{ userId, secret } database _ ->
            create { userId = userId, password = secret } database
                |> Task.map (\_ -> {})
        )
    , remove =
        (\{ userId } database _ ->
            delete { userId = userId } database
                |> Task.map (\_ -> {})
        )
    }


{-| The `validate` of the [`credential`](#credential) bundle: check a plain-text
candidate against the user's `auth_passwords` row, enforcing lockout.

A user with no password row gets a [`burnCandidate`](#burnCandidate) round and
`Invalid`, and a row locked into the future gets a burn round and `Locked`, so
every negative answer costs the same as a real verification. Otherwise the
candidate is re-derived: a match resets the failure bookkeeping and stamps
`last_used`; a mismatch increments the counter and, on reaching the limit, sets
`locked_until`.
-}
validateCandidate :
    { userId : String, secret : Password_ PlainText }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task AsCredentialError Credential.Validity
validateCandidate { userId, secret } database secureContext =
    Task.map2
        (\posixNow maybeRow -> { now = Time.posixToMillis posixNow, maybeRow = maybeRow })
        Time.now
        (get { userId = userId } database |> Task.mapError StorageError)
        |> Task.andThen
            (\{ now, maybeRow } ->
                when maybeRow is
                    Nothing ->
                        burnCandidate { secret = secret } database secureContext
                            |> Task.map (\_ -> Credential.Invalid)

                    Just row ->
                        when row.lockedUntil is
                            Just lockedUntil ->
                                if lockedUntil > now then
                                    burnCandidate { secret = secret } database secureContext
                                        |> Task.map (\_ -> Credential.Locked)

                                else
                                    verifyAgainstRow { now = now, secret = secret, row = row } database secureContext

                            Nothing ->
                                verifyAgainstRow { now = now, secret = secret, row = row } database secureContext
            )


{-| Re-derive a candidate against an unlocked `auth_passwords` row and record the
outcome: reset the failure bookkeeping (and stamp `last_used`) on a match,
increment it — locking at [`maxFailedLoginAttempts`](#maxFailedLoginAttempts) —
on a mismatch. Only [`verify`](#verify) faults other than a plain mismatch
surface as errors.
-}
verifyAgainstRow :
    { now : Int, secret : Password_ PlainText, row : Password }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task AsCredentialError Credential.Validity
verifyAgainstRow { now, secret, row } database secureContext =
    let
        (Password_ candidate) =
            secret
    in
    verify candidate (Password_ row.password) secureContext
        |> Task.map (\_ -> Matched)
        |> Task.onError
            (\error ->
                when error is
                    PasswordMismatch ->
                        Task.succeed Mismatched

                    other ->
                        Task.fail (VerificationError other)
            )
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Matched ->
                        update
                            { userId = row.userId
                            , password = row.password
                            , lastUsed = Just now
                            , failedLoginAttemptsCount = 0
                            , lockedUntil = Nothing
                            }
                            database
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Credential.Valid)

                    Mismatched ->
                        let
                            newCount : Int
                            newCount =
                                row.failedLoginAttemptsCount + 1

                            newLockedUntil : Maybe Int
                            newLockedUntil =
                                if newCount >= maxFailedLoginAttempts then
                                    Just (now + lockoutDurationMillis)

                                else
                                    Nothing
                        in
                        update
                            { userId = row.userId
                            , password = row.password
                            , lastUsed = row.lastUsed
                            , failedLoginAttemptsCount = newCount
                            , lockedUntil = newLockedUntil
                            }
                            database
                            |> Task.mapError StorageError
                            |> Task.map (\_ -> Credential.Invalid)
            )


{-| The `burn` of the [`credential`](#credential) bundle: hash the candidate
with the default configuration and throw the result away. Costs the same
600,000 PBKDF2 iterations as a real verification and never fails, so workflows
can spend it when there is no stored secret to check and then fail uniformly.
-}
burnCandidate : { secret : Password_ PlainText } -> Sqlite.Database -> Crypto.SecureContext -> Task AsCredentialError {}
burnCandidate { secret } _ secureContext =
    hashWithDefaults secret secureContext
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})



-- changing and resetting


{-| Everything a password change can go wrong on: the current password didn't
match (`InvalidCredentials`), the password is locked after repeated failures
(`Locked`), a real fault while validating the current password (`ProofError` —
a database fault or a corrupt stored hash), or the transactional replacement
itself (`TransactionError` — the delete/insert and the
`BEGIN`/`COMMIT`/`ROLLBACK` around them are all plain database operations).
-}
type ChangeError
    = InvalidCredentials
    | Locked
    | ProofError AsCredentialError
    | TransactionError Sqlite.Error


{-| Replace a user's password after proving the current one — the logged-in
"change my password" flow. For the forgotten-password flow, where there is no
current password to prove, use [`requestReset`](#requestReset) /
[`reset`](#reset) instead.

The current password is validated exactly like a login attempt (a wrong guess
counts toward lockout); then, inside one
[`Sqlite.inTransaction`](Sqlite#inTransaction), the old password row is deleted,
a fresh one inserted (so the user is never left without a password), and every
outstanding token the user holds is revoked via the passed
[`Token`](Auth.Simple.Token) bundle's `revokeAllForUser` — a stolen session must
not survive a password change. That includes the token on the device making the
change: issue a fresh one (e.g. log the user back in) after success. Replacing
rather than mutating deliberately resets the lockout bookkeeping — correct for a
fresh secret. `new` is an already-hashed [`Password_ Hashed`](#Password_): run
the plain text through [`validateLength`](#validateLength) and
[`hashWithDefaults`](#hashWithDefaults) first.

    Password.change db ctx Session.token
        { userId = userId
        , current = Password.fromString currentPassword
        , new = hashedNew
        }
-}
change :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Token tokenError issued verified
    -> { userId : String, current : Password_ PlainText, new : Password_ Hashed }
    -> Task ChangeError {}
change database secureContext token input =
    validateCandidate
        { userId = input.userId, secret = input.current }
        database
        secureContext
        |> Task.mapError ProofError
        |> Task.andThen
            (\validity ->
                when validity is
                    Credential.Valid ->
                        Sqlite.inTransaction database
                            (delete { userId = input.userId } database
                                |> Task.andThen
                                    (\_ ->
                                        create { userId = input.userId, password = input.new } database
                                    )
                                |> Task.andThen
                                    (\_ ->
                                        token.revokeAllForUser { userId = input.userId } database secureContext
                                    )
                            )
                            |> Task.mapError TransactionError
                            |> Task.map (\_ -> {})

                    Credential.Invalid ->
                        Task.fail InvalidCredentials

                    Credential.Locked ->
                        Task.fail Locked
            )



-- resetting passwords


{-| How long an issued reset token stays redeemable: 30 minutes, in
milliseconds.

Hard-coded for now; a future revision can lift this into configuration.
-}
resetTokenLifetimeMillis : Int
resetTokenLifetimeMillis =
    30 * 60 * 1000


{-| A row from the `auth_password_reset_tokens` table — at most one per user,
and its presence is what makes a reset token live. `resetToken` holds the
SHA-256 hash of the emailed token, never the raw value. Redeeming the token
(or issuing a new one) deletes the row; an expired row may linger until either,
but never redeems.
-}
type alias ResetToken =
    { resetToken : String
    , userId : String
    , createdAt : Int
    , expiresAt : Int
    }


{-| Decode a single `auth_password_reset_tokens` row into a
[`ResetToken`](#ResetToken).
-}
resetTokenDecoder : Sqlite.Decode.Decoder ResetToken
resetTokenDecoder =
    Sqlite.Decode.string "reset_token"
        (\resetToken ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "expires_at"
                                (\expiresAt ->
                                    Sqlite.Decode.succeed
                                        { resetToken = resetToken
                                        , userId = userId
                                        , createdAt = createdAt
                                        , expiresAt = expiresAt
                                        }
                                )
                        )
                )
        )


{-| Generate the raw bytes of a reset token: 32 cryptographically-random bytes,
the same entropy as a session token.
-}
generateResetTokenBytes : Task x Bytes
generateResetTokenBytes =
    Crypto.getRandomUInt8Values 32


{-| Encode token bytes into the URL-safe string embedded in the emailed link:
standard base64 with `+`/`/` swapped for `-`/`_` and padding dropped. The token
is never decoded back to bytes — redemption hashes the string itself.
-}
encodeUrlSafe : Bytes -> String
encodeUrlSafe tokenBytes =
    Base64.Encode.bytes tokenBytes
        |> Base64.Encode.encode
        |> String.replace "+" "-"
        |> String.replace "/" "_"
        |> String.replace "=" ""


{-| Hash a reset token string into the value stored in `reset_token`: a single
SHA-256, base64-encoded. Tokens are full-entropy, so no salt or stretching is
needed — the hash just keeps live tokens out of casual reads and backups.
-}
hashResetToken : Crypto.SecureContext -> String -> Task x String
hashResetToken secureContext token =
    Crypto.digest secureContext Crypto.Sha256 (Bytes.fromString token)
        |> Task.map
            (\digestBytes ->
                Base64.Encode.bytes digestBytes
                    |> Base64.Encode.encode
            )


{-| Everything a reset request can go wrong on: resolving the identifier
(`ResolveError`) or minting the token (`IssueError`).
-}
type RequestResetError identifierError
    = ResolveError identifierError
    | IssueError Sqlite.Error


{-| Phase one of a forgotten-password reset: resolve the identifier and mint a
reset token for its user, returning `{ token }` exactly once for the consumer
to embed in an emailed link. Phase two is [`reset`](#reset) with the token from
that link.

An identifier owned by no user succeeds with `Nothing` — nothing is minted, and
nothing should be sent. Respond to the requester identically in both cases so
the request endpoint can't be used to enumerate accounts.

    Password.requestReset db ctx Username.identifier { identifier = "alice" }
-}
requestReset :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> { identifier : value }
    -> Task (RequestResetError identifierError) (Maybe { token : String })
requestReset database secureContext identifier input =
    identifier.resolve { value = input.identifier } database secureContext
        |> Task.mapError ResolveError
        |> Task.andThen
            (\maybeUserId ->
                when maybeUserId is
                    Nothing ->
                        Task.succeed Nothing

                    Just userId ->
                        issueReset { userId = userId } database secureContext
                            |> Task.mapError IssueError
                            |> Task.map Just
            )


{-| Mint a reset token for a known `userId`: store only its hash and return
`{ token }` exactly once. The write replaces the user's row, so any previous
reset token dies with it — one live token per user. Most callers want
[`requestReset`](#requestReset), which resolves an identifier first.
-}
issueReset : { userId : String } -> Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error { token : String }
issueReset { userId } database secureContext =
    Task.map2
        (\tokenBytes now -> { token = encodeUrlSafe tokenBytes, now = Time.posixToMillis now })
        generateResetTokenBytes
        Time.now
        |> Task.andThen
            (\{ token, now } ->
                hashResetToken secureContext token
                    |> Task.andThen
                        (\hashed ->
                            insertResetToken database
                                { resetToken = hashed
                                , userId = userId
                                , createdAt = now
                                , expiresAt = now + resetTokenLifetimeMillis
                                }
                                |> Task.map (\_ -> { token = token })
                        )
            )


{-| Everything a reset redemption can go wrong on: a token that matches no live
row (`InvalidResetToken` — unknown, already used, replaced, or expired; the
caller can't tell which, deliberately) or a database fault
(`ResetStorageError`).
-}
type ResetError
    = InvalidResetToken
    | ResetStorageError Sqlite.Error


{-| Phase two of a forgotten-password reset: redeem the token from the emailed
link and set the new password. No `userId` is needed — the token resolves the
user, which is what makes the email-link flow work; the resolved
`{ userId }` is returned so the consumer can notify the user or issue a fresh
login.

Inside one [`Sqlite.inTransaction`](Sqlite#inTransaction): the token row is
deleted (single-use), the password replaced (the user is never left without
one), and every outstanding token the user holds is revoked via the passed
[`Token`](Auth.Simple.Token) bundle's `revokeAllForUser` — a reset is the
canonical "kick the attacker out" action, so nothing issued before it may
survive. `new` is an already-hashed [`Password_ Hashed`](#Password_): run the
plain text through [`validateLength`](#validateLength) and
[`hashWithDefaults`](#hashWithDefaults) first.

    Password.reset db ctx Session.token { token = tokenFromLink, new = hashedNew }
-}
reset :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Token tokenError issued verified
    -> { token : String, new : Password_ Hashed }
    -> Task ResetError { userId : String }
reset database secureContext token input =
    Task.map2
        (\hashed now -> { hashed = hashed, now = Time.posixToMillis now })
        (hashResetToken secureContext input.token)
        Time.now
        |> Task.andThen
            (\{ hashed, now } ->
                getResetTokenByHash hashed database
                    |> Task.mapError ResetStorageError
                    |> Task.andThen
                        (\maybeRow ->
                            when maybeRow is
                                Nothing ->
                                    Task.fail InvalidResetToken

                                Just row ->
                                    if row.expiresAt > now then
                                        Sqlite.inTransaction database
                                            (deleteResetToken { userId = row.userId } database
                                                |> Task.andThen (\_ -> delete { userId = row.userId } database)
                                                |> Task.andThen
                                                    (\_ ->
                                                        create { userId = row.userId, password = input.new } database
                                                    )
                                                |> Task.andThen
                                                    (\_ ->
                                                        token.revokeAllForUser { userId = row.userId } database secureContext
                                                    )
                                            )
                                            |> Task.mapError ResetStorageError
                                            |> Task.map (\_ -> { userId = row.userId })

                                    else
                                        Task.fail InvalidResetToken
                        )
            )



--- `auth_password_reset_tokens` rows


{-| Write a user's reset token row, replacing any existing one — `user_id` is
unique, so the replace is what enforces one live reset token per user.
`resetToken` is the already-hashed value, never the raw token.
-}
insertResetToken :
    Sqlite.Database
    -> { resetToken : String, userId : String, createdAt : Int, expiresAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insertResetToken database { resetToken, userId, createdAt, expiresAt } =
    Sqlite.execute database
        { statement =
            """
            INSERT OR REPLACE INTO auth_password_reset_tokens (reset_token, user_id, created_at, expires_at)
            VALUES (:reset_token, :user_id, :created_at, :expires_at)
            """
        , parameters =
            [ Sqlite.Encode.string "reset_token" resetToken
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            ]
        }


{-| Read a reset token row by the hash of a presented token, returning `Nothing`
when no such row exists. Expiry is the caller's check.
-}
getResetTokenByHash : String -> Sqlite.Database -> Task Sqlite.Error (Maybe ResetToken)
getResetTokenByHash hashed database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT reset_token, user_id, created_at, expires_at
            FROM auth_password_reset_tokens
            WHERE reset_token = :reset_token
            """
        , parameters =
            [ Sqlite.Encode.string "reset_token" hashed
            ]
        , rowDecoder = resetTokenDecoder
        }


{-| Delete a user's reset token row, ending its life — redeemed tokens are
removed outright.
-}
deleteResetToken : { userId : String } -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
deleteResetToken { userId } database =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_password_reset_tokens
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        }
