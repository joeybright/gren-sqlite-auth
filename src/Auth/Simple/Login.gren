module Auth.Simple.Login exposing ( login, Error(..) )

{-| Drive an [`Identifier`](Auth.Simple.Identifier), a
[`Credential`](Auth.Simple.Credential), and a [`Token`](Auth.Simple.Token) into a
login workflow: resolve the identifier to a user, validate the credential, and
issue a token.

This one function covers every credential. A credential needing a first phase
(an emailed one-time code) carries it on its own module — e.g.
[`Auth.Simple.Credential.Code.request`](Auth.Simple.Credential.Code) mints the
code, and the user comes back through this [`login`](#login) with it.

@docs login, Error

-}

import Auth.Simple.Credential as Credential exposing ( Credential )
import Auth.Simple.Identifier exposing ( Identifier )
import Auth.Simple.Token exposing ( Token )
import Crypto
import Sqlite
import Task exposing ( Task )


{-| Everything a login can go wrong on.

`InvalidCredentials` deliberately covers both "no user owns that identifier" and
"the secret didn't match", so a caller (or an attacker reading its responses)
cannot tell whether an account exists. `Locked` is distinct: it is only reachable
after repeated observable failures against an identifier that therefore is known
to exist, and a locked-out user with the *correct* secret deserves a better
answer than a shrug.

The remaining variants are real faults from the underlying pieces: resolving the
identifier (`identifierError`), validating the credential (`credentialError`), or
issuing the token (`tokenError`).
-}
type Error identifierError credentialError tokenError
    = InvalidCredentials
    | Locked
    | IdentifierError identifierError
    | CredentialError credentialError
    | TokenError tokenError


{-| Build a login function from a database, secure context, an
[`Identifier`](Auth.Simple.Identifier), a
[`Credential`](Auth.Simple.Credential), and a [`Token`](Auth.Simple.Token).
Partially apply the first five arguments to get your app's own login, then call it
with a runtime identifier value and secret:

    myLogin =
        Auth.Simple.Login.login db ctx
            Auth.Simple.Identifier.Username.identifier
            Auth.Simple.Credential.Password.credential
            Auth.Simple.Token.Session.token

    myLogin { identifier = "alice", secret = plainTextPassword }

On success it issues a token and returns whatever the [`Token`](Auth.Simple.Token)
produces — for the database-stored session that is `{ session, token }`; hand
`token` to the client, keep nothing else.

The workflow resists user enumeration: an unknown identifier runs the
credential's `burn` (the cost of a real validation) before failing, and fails
with the same [`InvalidCredentials`](#Error) as a wrong secret.
-}
login :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError identifierValue
    -> Credential credentialError candidateCredential
    -> Token tokenError issued verified
    -> { identifier : identifierValue, secret : candidateCredential }
    -> Task (Error identifierError credentialError tokenError) issued
login database secureContext identifier credential token input =
    identifier.resolve database secureContext { value = input.identifier }
        |> Task.mapError IdentifierError
        |> Task.andThen
            (\maybeUserId ->
                when maybeUserId is
                    Nothing ->
                        credential.burn database secureContext { secret = input.secret }
                            |> Task.mapError CredentialError
                            |> Task.andThen (\_ -> Task.fail InvalidCredentials)

                    Just userId ->
                        credential.validate database
                            secureContext
                            { userId = userId, secret = input.secret }
                            |> Task.mapError CredentialError
                            |> Task.andThen
                                (\validity ->
                                    when validity is
                                        Credential.Valid ->
                                            token.issue database secureContext { userId = userId }
                                                |> Task.mapError TokenError

                                        Credential.Invalid ->
                                            Task.fail InvalidCredentials

                                        Credential.Locked ->
                                            Task.fail Locked
                                )
            )
