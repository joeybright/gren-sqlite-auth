module Auth.Simple.Login exposing ( check, issue, Error(..) )

{-| Pipe the steps of a login into one chain. Start from a resolve step (e.g.
[`Auth.Simple.Identifier.Username.resolve`](Auth.Simple.Identifier.Username#resolve)),
pipe it through [`check`](#check) with a credential's check function (e.g.
[`Auth.Simple.Credential.Password.check`](Auth.Simple.Credential.Password#check)),
and finish with [`issue`](#issue) and a token issuer (e.g.
[`Auth.Simple.Token.Session.issue`](Auth.Simple.Token.Session#issue)):

    Username.resolve database { username = username }
        |> Login.check
            (Password.check database secureContext Password.defaultConfig
                { password = Password.fromString password }
            )
        |> Login.issue (Session.issue database secureContext sessionConfig)

The combinators contribute the plumbing a raw pipeline would make you write
yourself: each step's failure is mapped into one [`Error`](#Error), and the
check's [`Outcome`](Auth.Simple.Proof#Outcome) collapses into `InvalidCredentials`
or `Locked`. The [`Auth.Simple.Proof`](Auth.Simple.Proof) witness types keep
the chain honest — [`issue`](#issue) only accepts a chain that went through a
credential check, so a pipeline that skips one does not compile.

A credential needing a first phase (an emailed one-time code) carries it on its
own module — e.g. [`Auth.Simple.Credential.Code.request`](Auth.Simple.Credential.Code)
mints the code, and the user comes back through this same chain with it.

@docs check, issue, Error

-}

import Auth.Simple.Proof as Proof
import Task exposing ( Task )


{-| Everything a login can go wrong on.

`InvalidCredentials` deliberately covers both "no user owns that identifier" and
"the secret didn't match", so a caller (or an attacker reading its responses)
cannot tell whether an account exists. `Locked` is distinct: it is only reachable
after repeated observable failures against an identifier that therefore is known
to exist, and a locked-out user with the *correct* secret deserves a better
answer than a shrug.

The remaining variants are real faults from the underlying steps: resolving the
identifier (`identifierError`), checking the credential (`credentialError`), or
issuing the token (`tokenError`).
-}
type Error identifierError credentialError tokenError
    = InvalidCredentials
    | Locked
    | IdentifierError identifierError
    | CredentialError credentialError
    | TokenError tokenError


{-| Pipe a credential check onto a resolve step. The resolve's failure becomes
[`IdentifierError`](#Error); the check runs on the whole `Maybe` (burning a
validation round on `Nothing`, so unknown identifiers cost the same as wrong
secrets) and its failure becomes [`CredentialError`](#Error); the outcome
collapses — `Accepted` continues the chain with the proof, `Rejected` fails
with [`InvalidCredentials`](#Error), `Locked` fails with [`Locked`](#Error).

    Username.resolve database { username = username }
        |> Login.check
            (Password.check database secureContext Password.defaultConfig
                { password = candidate }
            )

-}
check :
    (Maybe Proof.ResolvedUser -> Task credentialError Proof.Outcome)
    -> Task identifierError (Maybe Proof.ResolvedUser)
    -> Task (Error identifierError credentialError tokenError) Proof.Authenticated
check checkStep resolved =
    resolved
        |> Task.mapError IdentifierError
        |> Task.andThen (checkStep >> Task.mapError CredentialError)
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Proof.Accepted proof ->
                        Task.succeed proof

                    Proof.Rejected ->
                        Task.fail InvalidCredentials

                    Proof.Locked ->
                        Task.fail Locked
            )


{-| Pipe token issuance onto a checked chain, mapping its failure to
[`TokenError`](#Error). On success the chain yields whatever the issuer
produces — for the database-stored session that is `{ session, token }`; hand
`token` to the client, keep nothing else.

This only accepts a chain carrying the
[`Authenticated`](Auth.Simple.Proof#Authenticated) proof a credential check
mints, so it cannot follow a bare resolve.
-}
issue :
    (Proof.Authenticated -> Task tokenError issued)
    -> Task (Error identifierError credentialError tokenError) Proof.Authenticated
    -> Task (Error identifierError credentialError tokenError) issued
issue issueStep =
    Task.andThen (issueStep >> Task.mapError TokenError)
