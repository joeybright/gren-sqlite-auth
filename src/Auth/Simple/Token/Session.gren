module Auth.Simple.Token.Session exposing
    ( Session
    , Config
    , defaultConfig
    , issue
    , token
    , generateTokenBytes
    , encodeToken
    , hashToken
    , create
    , insert
    , getByToken
    , verifyToken
    , update
    , revoke
    , revokeAllForUser
    , sweep
    , delete
    , migration
    , migrationV1
    )

{-| The database-stored [`Token`](Auth.Simple.Token) species, plus CRUD access to
the `auth_sessions` table that backs it.

A session is a login token tied to a user. The raw token is handed to the client
once (as a cookie); only its SHA-256 hash is stored in `auth_sessions.session_token`, so a stolen
database can't be replayed as live sessions. Functions that take a token hash it
at the boundary. `revoked_at` is nullable so logout can mark a row instead of
deleting it; dead rows (revoked or expired) are deleted by [`sweep`](#sweep),
which the [`token`](#token) bundle runs on issue and [`revoke`](#revoke) runs on
logout — the table cleans itself up as part of normal use.

[`token`](#token) bundles `create`/`verifyToken`/`revoke`/`revokeAllForUser`
into the pluggable `Token` interface; this module owns the `auth_sessions`
table via [`migration`](#migration).

@docs Session
@docs Config
@docs defaultConfig
@docs issue
@docs token
@docs generateTokenBytes
@docs encodeToken
@docs hashToken
@docs create
@docs insert
@docs getByToken
@docs verifyToken
@docs update
@docs revoke
@docs revokeAllForUser
@docs sweep
@docs delete
@docs migration
@docs migrationV1

-}

import Auth.Simple.Proof as Proof
import Auth.Simple.Token exposing ( Token )
import Base64.Decode
import Base64.Encode
import Bytes exposing ( Bytes )
import Crypto
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-| A row from the `auth_sessions` table. `revokedAt` is `Nothing` for a live session
and `Just` the revocation time once it has been explicitly revoked.
-}
type alias Session =
    { sessionToken : String
    , userId : String
    , createdAt : Int
    , expiresAt : Int
    , lastUsedAt : Int
    , revokedAt : Maybe Int
    }


{-| Policy for the database-stored token: how long an issued session stays
valid, in milliseconds. Build the bundle with [`defaultConfig`](#defaultConfig)
when the defaults suit you, or a record update on it when they don't:

    Session.token Session.defaultConfig
    Session.token { defaultConfig | sessionLifetimeMillis = 7 * 24 * 60 * 60 * 1000 }
-}
type alias Config =
    { sessionLifetimeMillis : Int
    }


{-| The default session policy: sessions live for 30 days.
-}
defaultConfig : Config
defaultConfig =
    { sessionLifetimeMillis = 30 * 24 * 60 * 60 * 1000
    }


{-| The database-stored implementation of the [`Token`](Auth.Simple.Token)
interface, built from a [`Config`](#Config): issue a session with
[`create`](#create), verify a presented token with [`verifyToken`](#verifyToken),
and revoke it with [`revoke`](#revoke). Login pipelines use [`issue`](#issue)
instead; this bundle remains for the workflows that revoke through it (e.g.
[`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password#change)).

`issue` returns `{ session, token }` — hand `token` to the client, keep nothing
else; it also runs [`sweep`](#sweep) first, so every login doubles as a cleanup
pass. `verify` resolves a raw token to its stored [`Session`](#Session) via
[`verifyToken`](#verifyToken), treating revoked and expired rows as no session.
`revokeAllForUser` revokes every live session a user holds, which is how
password change/reset kick out stolen sessions.
-}
token : Config -> Token Sqlite.Error { session : Session, token : String } Session
token config =
    { issue = issueForUserId config
    , verify = verifyToken
    , revoke = revoke
    , revokeAllForUser = revokeAllForUser
    }


{-| Issue a session for an authenticated user — the final step of a login
pipeline. Demands the [`Authenticated`](Auth.Simple.Proof#Authenticated) proof
only a credential check (e.g.
[`Auth.Simple.Credential.Password.check`](Auth.Simple.Credential.Password#check))
can mint, so a session can never be issued for a user who was merely resolved.

Returns `{ session, token }` — hand `token` to the client, keep nothing else.
Runs [`sweep`](#sweep) first, so every login doubles as a cleanup pass.
-}
issue :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Config
    -> Proof.Authenticated
    -> Task Sqlite.Error { session : Session, token : String }
issue database secureContext config proof =
    issueForUserId config database secureContext { userId = Proof.userId proof }


{-| The engine of [`issue`](#issue) and the [`token`](#token) bundle's issue:
sweep dead rows, then open a session expiring one config lifetime from now.
-}
issueForUserId :
    Config
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> { userId : String }
    -> Task Sqlite.Error { session : Session, token : String }
issueForUserId config database secureContext { userId } =
    sweep database
        |> Task.andThen (\_ -> Time.now)
        |> Task.andThen
            (\now ->
                create database
                    secureContext
                    { userId = userId
                    , expiresAt = Time.posixToMillis now + config.sessionLifetimeMillis
                    }
            )


{-| Decode a single `auth_sessions` row into a [`Session`](#Session).
-}
decoder : Sqlite.Decode.Decoder Session
decoder =
    Sqlite.Decode.string "session_token"
        (\sessionToken ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "expires_at"
                                (\expiresAt ->
                                    Sqlite.Decode.int "last_used_at"
                                        (\lastUsedAt ->
                                            Sqlite.Decode.maybe Sqlite.Decode.int "revoked_at"
                                                (\revokedAt ->
                                                    Sqlite.Decode.succeed
                                                        { sessionToken = sessionToken
                                                        , userId = userId
                                                        , createdAt = createdAt
                                                        , expiresAt = expiresAt
                                                        , lastUsedAt = lastUsedAt
                                                        , revokedAt = revokedAt
                                                        }
                                                )
                                        )
                                )
                        )
                )
        )



--- creating sessions


{-| Open a new session for `userId`, expiring at `expiresAt`, and save it.

Generates a random token, stores only its SHA-256 hash as the row's `session_token` value, and
returns `{ session, token }`: the stored [`Session`](#Session) plus the raw
`token` for the client's cookie. The raw token is never persisted. To insert
inside an existing transaction with caller-supplied values, use
[`insert`](#insert) (passing an already-hashed `sessionToken`).
-}
create :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { userId : String, expiresAt : Int }
    -> Task Sqlite.Error { session : Session, token : String }
create database secureContext { userId, expiresAt } =
    Task.map2
        (\tokenBytes now -> { tokenBytes = tokenBytes, now = now })
        generateTokenBytes
        Time.now
        |> Task.andThen
            (\{ tokenBytes, now } ->
                hashToken secureContext tokenBytes
                    |> Task.andThen
                        (\hashedToken ->
                            let
                                session : Session
                                session =
                                    { sessionToken = hashedToken
                                    , userId = userId
                                    , createdAt = Time.posixToMillis now
                                    , expiresAt = expiresAt
                                    , lastUsedAt = Time.posixToMillis now
                                    , revokedAt = Nothing
                                    }
                            in
                            insert database session
                                |> Task.map (\_ -> { session = session, token = encodeToken tokenBytes })
                        )
            )


{-| Generate a fresh session token: 32 cryptographically-random bytes. These are
the canonical token — [`encodeToken`](#encodeToken) turns them into a string,
[`hashToken`](#hashToken) into the stored `session_token` value.
-}
generateTokenBytes : Task x Bytes
generateTokenBytes =
    Crypto.getRandomUInt8Values 32


{-| Encode raw token bytes into the cookie string handed to the client. Inverse
of [`decodeToken`](#decodeToken).
-}
encodeToken : Bytes -> String
encodeToken tokenBytes =
    Base64.Encode.bytes tokenBytes
        |> Base64.Encode.encode


{-| Hash raw token bytes into the value stored in `auth_sessions.session_token`.

Tokens are full-entropy random bytes, so a single SHA-256 (no salt, no stretching)
makes the stored value useless as a cookie while staying reproducible for lookups.
-}
hashToken : Crypto.SecureContext -> Bytes -> Task x String
hashToken secureContext tokenBytes =
    Crypto.digest secureContext Crypto.Sha256 tokenBytes
        |> Task.map
            (\digestBytes ->
                Base64.Encode.bytes digestBytes
                    |> Base64.Encode.encode
            )


{-| Recover raw token bytes from a cookie string, the inverse of
[`encodeToken`](#encodeToken). A non-base64 token yields `Nothing`.
-}
decodeToken : String -> Maybe Bytes
decodeToken rawToken =
    when Base64.Decode.bytes rawToken is
        Ok tokenBytes ->
            Just tokenBytes

        Err _ ->
            Nothing


{-| Map a base64 token string to the value stored in `auth_sessions.session_token`. Decode it to raw
bytes, then [`hashToken`](#hashToken). The boundary used by
[`getByToken`](#getByToken), [`update`](#update), [`revoke`](#revoke), and
[`delete`](#delete). An undecodable cookie is passed through verbatim and simply
matches no row.
-}
hashTokenString : Crypto.SecureContext -> String -> Task x String
hashTokenString secureContext rawToken =
    when decodeToken rawToken is
        Just tokenBytes ->
            hashToken secureContext tokenBytes

        Nothing ->
            Task.succeed rawToken


{-| Insert a session row into the `auth_sessions` table using caller-supplied values.
-}
insert :
    Sqlite.Database
    ->
        { sessionToken : String
        , userId : String
        , createdAt : Int
        , expiresAt : Int
        , lastUsedAt : Int
        , revokedAt : Maybe Int
        }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { sessionToken, userId, createdAt, expiresAt, lastUsedAt, revokedAt } =
    let
        statement : String
        statement =
            """
            INSERT INTO auth_sessions (session_token, user_id, created_at, expires_at, last_used_at, revoked_at)
            VALUES (:session_token, :user_id, :created_at, :expires_at, :last_used_at, :revoked_at)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "session_token" sessionToken
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            , Sqlite.Encode.int "last_used_at" lastUsedAt
            , Sqlite.Encode.maybe Sqlite.Encode.int "revoked_at" revokedAt
            ]
        }



--- reading sessions


{-| Read a single session by its raw token, returning `Nothing` when no row
matches. The token is mapped to the stored `session_token` via
[`hashTokenString`](#hashTokenString) before matching.
-}
getByToken : Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task Sqlite.Error (Maybe Session)
getByToken database secureContext input =
    hashTokenString secureContext input.token
        |> Task.andThen
            (\hashedToken ->
                Sqlite.getMaybeOne database
                    { query =
                        """
                        SELECT session_token, user_id, created_at, expires_at, last_used_at, revoked_at
                        FROM auth_sessions
                        WHERE session_token = :session_token
                        """
                    , parameters =
                        [ Sqlite.Encode.string "session_token" hashedToken
                        ]
                    , rowDecoder = decoder
                    }
            )


{-| Verify a presented raw token: resolve it via [`getByToken`](#getByToken),
then treat a revoked (`revoked_at` set) or expired (`expires_at` in the past) row
as no session at all. This is the `verify` of the [`token`](#token) bundle —
unlike [`getByToken`](#getByToken), a row that exists but is no longer live
yields `Nothing`.

A successful verification touches the session: `last_used_at` is bumped to now,
and the returned [`Session`](#Session) reflects it.
-}
verifyToken : Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task Sqlite.Error (Maybe Session)
verifyToken database secureContext input =
    Task.map2
        (\maybeSession now -> { maybeSession = maybeSession, now = Time.posixToMillis now })
        (getByToken database secureContext input)
        Time.now
        |> Task.andThen
            (\{ maybeSession, now } ->
                when maybeSession is
                    Nothing ->
                        Task.succeed Nothing

                    Just session ->
                        when session.revokedAt is
                            Just _ ->
                                Task.succeed Nothing

                            Nothing ->
                                if session.expiresAt > now then
                                    update database
                                        secureContext
                                        { token = input.token
                                        , expiresAt = session.expiresAt
                                        , lastUsedAt = now
                                        , revokedAt = Nothing
                                        }
                                        |> Task.map (\_ -> Just { session | lastUsedAt = now })

                                else
                                    Task.succeed Nothing
            )



--- updating sessions


{-| Update a session's mutable fields, identified by its raw token.

Covers "touch on use" (bump `lastUsedAt`) and lifetime changes (`expiresAt`); for
logout use [`revoke`](#revoke). Pass `Nothing` for `revokedAt` to keep the session
live. The `token` is mapped to the stored `session_token` via
[`hashTokenString`](#hashTokenString) before matching.
-}
update :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { token : String, expiresAt : Int, lastUsedAt : Int, revokedAt : Maybe Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update database secureContext input =
    hashTokenString secureContext input.token
        |> Task.andThen
            (\hashedToken ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_sessions
                        SET expires_at = :expires_at, last_used_at = :last_used_at, revoked_at = :revoked_at
                        WHERE session_token = :session_token
                        """
                    , parameters =
                        [ Sqlite.Encode.int "expires_at" input.expiresAt
                        , Sqlite.Encode.int "last_used_at" input.lastUsedAt
                        , Sqlite.Encode.maybe Sqlite.Encode.int "revoked_at" input.revokedAt
                        , Sqlite.Encode.string "session_token" hashedToken
                        ]
                    }
            )


{-| Revoke a session by its raw token, stamping `revoked_at` with the current
time, then run [`sweep`](#sweep) — so logout both ends this session and clears
any dead rows. Idempotent: a token matching no row simply updates nothing. The
`token` is mapped to the stored `session_token` via
[`hashTokenString`](#hashTokenString) before matching.
-}
revoke : Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task Sqlite.Error {}
revoke database secureContext input =
    Task.map2
        (\hashedToken now -> { hashedToken = hashedToken, now = now })
        (hashTokenString secureContext input.token)
        Time.now
        |> Task.andThen
            (\{ hashedToken, now } ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_sessions
                        SET revoked_at = :revoked_at
                        WHERE session_token = :session_token
                        """
                    , parameters =
                        [ Sqlite.Encode.int "revoked_at" (Time.posixToMillis now)
                        , Sqlite.Encode.string "session_token" hashedToken
                        ]
                    }
            )
        |> Task.andThen (\_ -> sweep database)


{-| Revoke every live session a user holds, stamping `revoked_at` with the
current time. The `revokeAllForUser` of the [`token`](#token) bundle — driven by
[`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password) and
[`Auth.Simple.Credential.Password.reset`](Auth.Simple.Credential.Password) so a
stolen session never survives a credential change. Idempotent; the rows linger
until the next [`sweep`](#sweep). The secure context is unused — sessions
revoke by a plain database write.
-}
revokeAllForUser : Sqlite.Database -> Crypto.SecureContext -> { userId : String } -> Task Sqlite.Error {}
revokeAllForUser database _ { userId } =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_sessions
                        SET revoked_at = :revoked_at
                        WHERE user_id = :user_id AND revoked_at IS NULL
                        """
                    , parameters =
                        [ Sqlite.Encode.int "revoked_at" (Time.posixToMillis now)
                        , Sqlite.Encode.string "user_id" userId
                        ]
                    }
            )
        |> Task.map (\_ -> {})



--- deleting sessions


{-| Delete every dead session row: revoked, or expired as of now. The cleanup
pass behind the [`token`](#token) bundle's issue and [`revoke`](#revoke), so the
table tends itself during normal logins and logouts; call it directly to clean
on your own schedule as well.
-}
sweep : Sqlite.Database -> Task Sqlite.Error {}
sweep database =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        DELETE FROM auth_sessions
                        WHERE revoked_at IS NOT NULL OR expires_at <= :now
                        """
                    , parameters =
                        [ Sqlite.Encode.int "now" (Time.posixToMillis now)
                        ]
                    }
            )
        |> Task.map (\_ -> {})


{-| Hard-delete a session by its raw token. The `token` is mapped to the stored
`session_token` via [`hashTokenString`](#hashTokenString) before matching.
-}
delete : Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
delete database secureContext input =
    hashTokenString secureContext input.token
        |> Task.andThen
            (\hashedToken ->
                Sqlite.execute database
                    { statement =
                        """
                        DELETE FROM auth_sessions
                        WHERE session_token = :session_token
                        """
                    , parameters =
                        [ Sqlite.Encode.string "session_token" hashedToken
                        ]
                    }
            )



--- migrations


{-| The migrations this token species owns, keyed by version.
-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-| Create the `auth_sessions` table backing the database-stored token. Run after
[`Auth.Simple.migrationV1`](Auth.Simple) (it references `users`).
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Token.Session.migrationV1` - Add auth_sessions table"
    , statements =
        [ addSessionsTableMigrationSQL
        ]
    }


{-| Migration SQL for adding a `auth_sessions` table.

`revoked_at` is nullable so explicit logout/revocation can mark a row; dead
rows (revoked or expired) are removed by [`sweep`](#sweep) during normal use.
-}
addSessionsTableMigrationSQL : String
addSessionsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_sessions (
        session_token TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        last_used_at INTEGER NOT NULL,
        revoked_at INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """
