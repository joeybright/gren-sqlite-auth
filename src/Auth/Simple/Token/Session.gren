module Auth.Simple.Token.Session exposing
    ( Session
    , token
    , generateTokenBytes
    , encodeToken
    , hashToken
    , create
    , insert
    , getByToken
    , update
    , revoke
    , delete
    , migration
    , migrationV1
    )

{-| The database-stored [`Token`](Auth.Simple.Token) species, plus CRUD access to
the `sessions` table that backs it.

A session is a login token tied to a user. The raw token is handed to the client
once (as a cookie); only its SHA-256 hash is stored in `sessions.id`, so a stolen
database can't be replayed as live sessions. Functions that take a token hash it
at the boundary. `revoked_at` is nullable so logout can mark a row instead of
deleting it.

[`token`](#token) bundles `create`/`getByToken`/`revoke` into the pluggable
`Token` interface; this module owns the `sessions` table via [`migration`](#migration).

@docs Session
@docs token
@docs generateTokenBytes
@docs encodeToken
@docs hashToken
@docs create
@docs insert
@docs getByToken
@docs update
@docs revoke
@docs delete
@docs migration
@docs migrationV1

-}

import Auth.Simple.Token exposing ( Token )
import Base64.Decode
import Base64.Encode
import Bytes exposing ( Bytes )
import Crypto
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-| A row from the `sessions` table. `revokedAt` is `Nothing` for a live session
and `Just` the revocation time once it has been explicitly revoked.
-}
type alias Session =
    { id : String
    , userId : String
    , createdAt : Int
    , expiresAt : Int
    , lastUsedAt : Int
    , revokedAt : Maybe Int
    }


{-| The database-stored implementation of the [`Token`](Auth.Simple.Token)
interface: issue a session with [`create`](#create), verify a presented token with
[`getByToken`](#getByToken), and revoke it with [`revoke`](#revoke). Pass this as
the token argument to [`Auth.Simple.Login.login`](Auth.Simple.Login).

`issue` returns `{ session, token }` — hand `token` to the client, keep nothing
else. `verify` resolves a raw token to its stored [`Session`](#Session).
-}
token : Token Sqlite.Error { session : Session, token : String } Session
token =
    { issue =
        (\{ userId } database secureContext ->
            Time.now
                |> Task.andThen
                    (\now ->
                        create
                            { userId = userId
                            , expiresAt = Time.posixToMillis now + sessionLifetimeMillis
                            }
                            database
                            secureContext
                    )
        )
    , verify = getByToken
    , revoke = revoke
    }


{-| How long an issued session stays valid: 30 days, in milliseconds.

Hard-coded for now; a future revision can lift this into configuration.
-}
sessionLifetimeMillis : Int
sessionLifetimeMillis =
    30 * 24 * 60 * 60 * 1000


{-| Decode a single `sessions` row into a [`Session`](#Session).
-}
decoder : Sqlite.Decode.Decoder Session
decoder =
    Sqlite.Decode.string "id"
        (\id ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "expires_at"
                                (\expiresAt ->
                                    Sqlite.Decode.int "last_used_at"
                                        (\lastUsedAt ->
                                            Sqlite.Decode.maybe Sqlite.Decode.int "revoked_at"
                                                (\revokedAt ->
                                                    Sqlite.Decode.succeed
                                                        { id = id
                                                        , userId = userId
                                                        , createdAt = createdAt
                                                        , expiresAt = expiresAt
                                                        , lastUsedAt = lastUsedAt
                                                        , revokedAt = revokedAt
                                                        }
                                                )
                                        )
                                )
                        )
                )
        )



--- creating sessions


{-| Open a new session for `userId`, expiring at `expiresAt`, and save it.

Generates a random token, stores only its SHA-256 hash as the row `id`, and
returns `{ session, token }`: the stored [`Session`](#Session) plus the raw
`token` for the client's cookie. The raw token is never persisted. To insert
inside an existing transaction with caller-supplied values, use
[`insert`](#insert) (passing an already-hashed `id`).
-}
create :
    { userId : String, expiresAt : Int }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task Sqlite.Error { session : Session, token : String }
create { userId, expiresAt } database secureContext =
    Task.map2
        (\tokenBytes now -> { tokenBytes = tokenBytes, now = now })
        generateTokenBytes
        Time.now
        |> Task.andThen
            (\{ tokenBytes, now } ->
                hashToken secureContext tokenBytes
                    |> Task.andThen
                        (\hashedToken ->
                            let
                                session : Session
                                session =
                                    { id = hashedToken
                                    , userId = userId
                                    , createdAt = Time.posixToMillis now
                                    , expiresAt = expiresAt
                                    , lastUsedAt = Time.posixToMillis now
                                    , revokedAt = Nothing
                                    }
                            in
                            insert database session
                                |> Task.map (\_ -> { session = session, token = encodeToken tokenBytes })
                        )
            )


{-| Generate a fresh session token: 32 cryptographically-random bytes. These are
the canonical token — [`encodeToken`](#encodeToken) turns them into a string,
[`hashToken`](#hashToken) into the stored id.
-}
generateTokenBytes : Task x Bytes
generateTokenBytes =
    Crypto.getRandomUInt8Values 32


{-| Encode raw token bytes into the cookie string handed to the client. Inverse
of [`decodeToken`](#decodeToken).
-}
encodeToken : Bytes -> String
encodeToken tokenBytes =
    Base64.Encode.bytes tokenBytes
        |> Base64.Encode.encode


{-| Hash raw token bytes into the value stored in `sessions.id`.

Tokens are full-entropy random bytes, so a single SHA-256 (no salt, no stretching)
makes the stored value useless as a cookie while staying reproducible for lookups.
-}
hashToken : Crypto.SecureContext -> Bytes -> Task x String
hashToken secureContext tokenBytes =
    Crypto.digest secureContext Crypto.Sha256 tokenBytes
        |> Task.map
            (\digestBytes ->
                Base64.Encode.bytes digestBytes
                    |> Base64.Encode.encode
            )


{-| Recover raw token bytes from a cookie string, the inverse of
[`encodeToken`](#encodeToken). A non-base64 token yields `Nothing`.
-}
decodeToken : String -> Maybe Bytes
decodeToken rawToken =
    when Base64.Decode.bytes rawToken is
        Ok tokenBytes ->
            Just tokenBytes

        Err _ ->
            Nothing


{-| Map a base64 token string to the value stored in `sessions.id`. Decode it to raw
bytes, then [`hashToken`](#hashToken). The boundary used by
[`getByToken`](#getByToken), [`update`](#update), [`revoke`](#revoke), and
[`delete`](#delete). An undecodable cookie is passed through verbatim and simply
matches no row.
-}
hashTokenString : Crypto.SecureContext -> String -> Task x String
hashTokenString secureContext rawToken =
    when decodeToken rawToken is
        Just tokenBytes ->
            hashToken secureContext tokenBytes

        Nothing ->
            Task.succeed rawToken


{-| Insert a session row into the `sessions` table using caller-supplied values.
-}
insert :
    Sqlite.Database
    ->
        { id : String
        , userId : String
        , createdAt : Int
        , expiresAt : Int
        , lastUsedAt : Int
        , revokedAt : Maybe Int
        }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { id, userId, createdAt, expiresAt, lastUsedAt, revokedAt } =
    let
        statement : String
        statement =
            """
            INSERT INTO sessions (id, user_id, created_at, expires_at, last_used_at, revoked_at)
            VALUES (:id, :user_id, :created_at, :expires_at, :last_used_at, :revoked_at)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "id" id
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "expires_at" expiresAt
            , Sqlite.Encode.int "last_used_at" lastUsedAt
            , Sqlite.Encode.maybe Sqlite.Encode.int "revoked_at" revokedAt
            ]
        }



--- reading sessions


{-| Read a single session by its raw token, returning `Nothing` when no row
matches. The token is mapped to the stored id via
[`hashTokenString`](#hashTokenString) before matching.
-}
getByToken : String -> Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error (Maybe Session)
getByToken rawToken database secureContext =
    hashTokenString secureContext rawToken
        |> Task.andThen
            (\hashedToken ->
                Sqlite.getMaybeOne database
                    { query =
                        """
                        SELECT id, user_id, created_at, expires_at, last_used_at, revoked_at
                        FROM sessions
                        WHERE id = :id
                        """
                    , parameters =
                        [ Sqlite.Encode.string "id" hashedToken
                        ]
                    , rowDecoder = decoder
                    }
            )



--- updating sessions


{-| Update a session's mutable fields, identified by its raw token.

Covers "touch on use" (bump `lastUsedAt`) and lifetime changes (`expiresAt`); for
logout use [`revoke`](#revoke). Pass `Nothing` for `revokedAt` to keep the session
live. The `rawToken` is mapped to the stored id via
[`hashTokenString`](#hashTokenString) before matching.
-}
update :
    { rawToken : String, expiresAt : Int, lastUsedAt : Int, revokedAt : Maybe Int }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update { rawToken, expiresAt, lastUsedAt, revokedAt } database secureContext =
    hashTokenString secureContext rawToken
        |> Task.andThen
            (\hashedToken ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE sessions
                        SET expires_at = :expires_at, last_used_at = :last_used_at, revoked_at = :revoked_at
                        WHERE id = :id
                        """
                    , parameters =
                        [ Sqlite.Encode.int "expires_at" expiresAt
                        , Sqlite.Encode.int "last_used_at" lastUsedAt
                        , Sqlite.Encode.maybe Sqlite.Encode.int "revoked_at" revokedAt
                        , Sqlite.Encode.string "id" hashedToken
                        ]
                    }
            )


{-| Revoke a session by its raw token, stamping `revoked_at` with the current
time. Idempotent: a token matching no row simply updates nothing. The row is kept
for auditing — to hard-delete instead, use [`delete`](#delete). The `rawToken` is
mapped to the stored id via [`hashTokenString`](#hashTokenString) before matching.
-}
revoke : String -> Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error {}
revoke rawToken database secureContext =
    Task.map2
        (\hashedToken now -> { hashedToken = hashedToken, now = now })
        (hashTokenString secureContext rawToken)
        Time.now
        |> Task.andThen
            (\{ hashedToken, now } ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE sessions
                        SET revoked_at = :revoked_at
                        WHERE id = :id
                        """
                    , parameters =
                        [ Sqlite.Encode.int "revoked_at" (Time.posixToMillis now)
                        , Sqlite.Encode.string "id" hashedToken
                        ]
                    }
            )
        |> Task.map (\_ -> {})



--- deleting sessions


{-| Hard-delete a session by its raw token. To keep the row for auditing, use
[`revoke`](#revoke) instead. The `rawToken` is mapped to the stored id via
[`hashTokenString`](#hashTokenString) before matching.
-}
delete : String -> Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error Sqlite.ExecutionSummary
delete rawToken database secureContext =
    hashTokenString secureContext rawToken
        |> Task.andThen
            (\hashedToken ->
                Sqlite.execute database
                    { statement =
                        """
                        DELETE FROM sessions
                        WHERE id = :id
                        """
                    , parameters =
                        [ Sqlite.Encode.string "id" hashedToken
                        ]
                    }
            )



--- migrations


{-| The migrations this token species owns, keyed by version.
-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-| Create the `sessions` table backing the database-stored token. Run after
[`Auth.Simple.migrationV1`](Auth.Simple) (it references `users`).
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Token.Session.migrationV1` - Add sessions table"
    , statements =
        [ addSessionsTableMigrationSQL
        ]
    }


{-| Migration SQL for adding a `sessions` table.

`revoked_at` is nullable so explicit logout/revocation can mark a row without
deleting it, preserving the `auth_events` audit trail.
-}
addSessionsTableMigrationSQL : String
addSessionsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS sessions (
        id TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        last_used_at INTEGER NOT NULL,
        revoked_at INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """
