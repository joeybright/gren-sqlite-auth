module Auth.Simple.Method.Password exposing
    ( migrationV1
    , Password
    , create
    , insert
    , get
    , update
    , delete
    , Password_
    )

{-| The password authentication method: its schema migration and CRUD access to
the `passwords` table.

Each row stores one user's hashed (PHC-formatted) password plus the bookkeeping
needed for lockout (`failed_login_attempts_count`, `locked_until`) and last-use
tracking (`last_used`). The table is keyed by `user_id` (one password per user),
so every CRUD function here is keyed on the user's id rather than a separate row
id. The schema is owned by [`migrationV1`](#migrationV1).

@docs migrationV1
@docs Password
@docs create
@docs insert
@docs get
@docs update
@docs delete

-}

import Crypto
import Dict exposing ( Dict )
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time
import Auth.Simple.Method as Method exposing ( Method )


{-|-}
type Configured =
    Configured


{-| A password in plain text. Pass this into the `prepare` function to evauluate
any password requirements and prepare for hashing.
-}
type PlainText =
    PlainText


{-| A password that has been hashed and is ready to save to the database.
-}
type Hashed =
    Hashed


{-| A password...
-}
type Password_ state =
    Password_
        { string : String
        , params : Dict String String
        , algorithm : Algorithm
        }


{-| Available algorithms for hashing the password and available configuration
for the algorithm.

Any algorithms in the future added to this package will be expected to be in 
the `Crypto` module of the `gren-core` package. If you want to use your own 
algorithm, vendor this code and rewrite it to support what you're looking for!

The only currently supported algorithm is Pbkdf2. Both iterations and hash can
be customized, but the salt will always be a randomly generated set of `Bytes`,
the generation function of which cannot be changed.
-}
type Algorithm =
    Pbkdf2 
        { iterations : Int
        , hash : Crypto.DigestAlgorithm
        }


{-| Configure the password to use a chosen `Algorithm`.
-}
configure : Algorithm -> Password_ Configured
configure algorithm =
    when algorithm is
        Pbkdf2 config ->
            Password_
                { string = ""
                , params = 
                    -- Seed the params with the iterations as they are required
                    -- to be saved into the PHC string in the database.
                    Dict.singleton "i" 
                        (String.fromInt config.iterations)
                , algorithm = algorithm
                }


{-| Turn a `String` into a `Password PlainText`. Requires a configured password
-}
fromString : String -> Password_ Configured -> Password_ PlainText
fromString passwordString (Password_ { params, algorithm }) =
    Password_ 
        { string = passwordString
        , params = params
        , algorithm = algorithm
        }


{-| Properly hash the password into a base64-encoded phc string, ready to save
to the database.

This function does absolutely no checking for password string integrity. Password
complexity and other requirements are completely up to the caller. It's highly 
recommended that you use `Password.prepare` in order to perform checks on the 
password before hashing it.

    Password.configure Password.defaultConfiguration
        |> Password.fromString "bad password"
        |> Password.map normalizePasswordSpaces
        |> Password.map normalizePasswordCase
        |> Password.validate checkNoSpacesInPassword
        |> Task.andThen (Password.validate checkPasswordLength)
        |> Task.andThen (Password.validate checkPasswordCharacterComplication)
        |> Task.andThen (Password.withAdditionalPhcParams "a" "b")
        |> Task.andThen Password.hash

    Password.configure Password.recommendedConfiguration
        |> Password.recommendedNormalization
        |> Password.recommendedValidation
        |> Task.andThen Password.hash

Where `checkPasswordLength` and other checking functions may be implemented 
something like this:

    checkPasswordLength : String -> Result {} (Password PlainText)
    checkPasswordLength passwordString =
        if String.count passwordString <= 8 then
            Err {}
        
        else
            Ok passwordString
-}
hash : Password_ PlainText -> Task {} (Password_ Hashed)
hash (Password_ password) = 
    Debug.todo "hash the password"

 
{-|-}
withAdditionalParams : Password_ PlainText -> String -> String -> Password_ PlainText
withAdditionalParams (Password_ { string, params, algorithm }) key value =
    Password_
        { string = string
        , params = Dict.union params (Dict.singleton key value)
        , algorithm = algorithm
        }


{-| Apply a function to the password string that can result in failure. This is used
to take a plain text password and prepare it for hashing.

This function returns a `Task` for easier chaining into the `hash` function.
-}
validate : (String -> Result a String) -> Task a (Password_ PlainText) -> Task a (Password_ PlainText)
validate func =
    Task.andThen
        (\(Password_ { string, params, algorithm }) ->
            when (func string) is
                Ok newPasswordString ->
                    Task.succeed 
                        (Password_ 
                            { string = newPasswordString
                            , params = params
                            , algorithm = algorithm
                            }
                        )
                
                Err err ->
                    Task.fail err
        )


{-| Map over a plain text password, changing it's value. It's highly recommended this
is only used to normalize the given password to match the format expected by the
database.
-}
map : Password_ PlainText -> (String -> String) -> Password_ PlainText
map (Password_ { string, params, algorithm }) func =
    Password_ 
        { string = func string
        , params = params
        , algorithm = algorithm
        }



-- migrations


{-| The first migration needed in order for passwords to work.
-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-|-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Method.Password.migrationV1` - Add passwords and password_reset_tokens table" 
    , statements = 
        [ addPasswordsTableMigrationSQL
        , addPasswordsResetTokensTableMigrationSQL
        , passwordsUserIdIndexSQL
        , passwordResetTokensUserIdIndexSQL
        , passwordResetTokensExpiresAtIndexSQL
        ]
    }



--- `passwords` table


{-|-}
addPasswordsTableMigrationSQL : String
addPasswordsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-|-}
passwordsUserIdIndexSQL : String
passwordsUserIdIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_passwords_user_id
    ON passwords(user_id);
    """



--- `password_reset_tokens` table


{-|-}
addPasswordsResetTokensTableMigrationSQL : String
addPasswordsResetTokensTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS password_reset_tokens (
    id TEXT PRIMARY KEY NOT NULL,
    user_id TEXT NOT NULL,
    token_hash TEXT NOT NULL UNIQUE,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    consumed_at INTEGER,
    FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE
    );
    """


{-|-}
passwordResetTokensUserIdIndexSQL : String
passwordResetTokensUserIdIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_password_reset_tokens_user_id
    ON password_reset_tokens(user_id);
    """


{-|-}
passwordResetTokensExpiresAtIndexSQL : String
passwordResetTokensExpiresAtIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_password_reset_tokens_expires_at
    ON password_reset_tokens(expires_at);
    """



--- `passwords` rows


{-| A row from the `passwords` table.

`password` is the PHC-formatted hash (see
[`Auth.Simple.UsernamePassword.hashPassword`](Auth.Simple.UsernamePassword)).
`lastUsed` and `lockedUntil` are nullable; `failedLoginAttemptsCount` is
constrained to be non-negative by the schema.
-}
type alias Password =
    { userId : String
    , password : String
    , createdAt : Int
    , updatedAt : Int
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }


{-| Decode a single `passwords` row into a [`Password`](#Password).
-}
decoder : Sqlite.Decode.Decoder Password
decoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "password"
                (\password ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "updated_at"
                                (\updatedAt ->
                                    Sqlite.Decode.maybe Sqlite.Decode.int "last_used"
                                        (\lastUsed ->
                                            Sqlite.Decode.int "failed_login_attempts_count"
                                                (\failedLoginAttemptsCount ->
                                                    Sqlite.Decode.maybe Sqlite.Decode.int "locked_until"
                                                        (\lockedUntil ->
                                                            Sqlite.Decode.succeed
                                                                { userId = userId
                                                                , password = password
                                                                , createdAt = createdAt
                                                                , updatedAt = updatedAt
                                                                , lastUsed = lastUsed
                                                                , failedLoginAttemptsCount = failedLoginAttemptsCount
                                                                , lockedUntil = lockedUntil
                                                                }
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )



--- creating passwords


{-| Store a hashed `password` for `userId` and save it to the database.

`password` must already be a PHC-formatted hash. Stamps `created_at`/`updated_at`
to now, starts the user with zero failed login attempts and no lock, inserts the
row, and returns the created [`Password`](#Password). To insert inside an existing
transaction with caller-supplied values, use [`insert`](#insert) directly.
-}
create :
    { userId : String, password : String }
    -> Sqlite.Database
    -> Task Sqlite.Error Password
create { userId, password } database =
    Time.now
        |> Task.andThen
            (\now ->
                let
                    record : Password
                    record =
                        { userId = userId
                        , password = password
                        , createdAt = Time.posixToMillis now
                        , updatedAt = Time.posixToMillis now
                        , lastUsed = Nothing
                        , failedLoginAttemptsCount = 0
                        , lockedUntil = Nothing
                        }
                in
                insert database record
                    |> Task.map (\_ -> record)
            )


{-| Insert a password row into the `passwords` table using caller-supplied values.
-}
insert :
    Sqlite.Database
    ->
        { userId : String
        , password : String
        , createdAt : Int
        , updatedAt : Int
        , lastUsed : Maybe Int
        , failedLoginAttemptsCount : Int
        , lockedUntil : Maybe Int
        }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { userId, password, createdAt, updatedAt, lastUsed, failedLoginAttemptsCount, lockedUntil } =
    let
        statement : String
        statement =
            """
            INSERT INTO passwords (user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until)
            VALUES (:user_id, :password, :created_at, :updated_at, :last_used, :failed_login_attempts_count, :locked_until)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.string "password" password
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "updated_at" updatedAt
            , Sqlite.Encode.maybe Sqlite.Encode.int "last_used" lastUsed
            , Sqlite.Encode.int "failed_login_attempts_count" failedLoginAttemptsCount
            , Sqlite.Encode.maybe Sqlite.Encode.int "locked_until" lockedUntil
            ]
        }



--- reading passwords


{-| Read a single user's password row by `userId`, returning `Nothing` when no
such row exists.
-}
get : String -> Sqlite.Database -> Task Sqlite.Error (Maybe Password)
get userId database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until
            FROM passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId 
            ]
        , rowDecoder = decoder
        }



--- updating passwords


{-| Update a user's password row by `userId`, bumping `updated_at` to now.

Covers the mutable fields: the stored `password` (on a password change), the
lockout bookkeeping (`failedLoginAttemptsCount`, `lockedUntil`), and `lastUsed`.
Pass `Nothing` for `lockedUntil`/`lastUsed` to clear them.
-}
update :
    { userId : String
    , password : String
    , lastUsed : Maybe Int
    , failedLoginAttemptsCount : Int
    , lockedUntil : Maybe Int
    }
    -> Sqlite.Database
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update { userId, password, lastUsed, failedLoginAttemptsCount, lockedUntil } database =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE passwords
                        SET password = :password, updated_at = :updated_at, last_used = :last_used, failed_login_attempts_count = :failed_login_attempts_count, locked_until = :locked_until
                        WHERE user_id = :user_id
                        """
                    , parameters =
                        [ Sqlite.Encode.string "password" password
                        , Sqlite.Encode.int "updated_at" (Time.posixToMillis now)
                        , Sqlite.Encode.maybe Sqlite.Encode.int "last_used" lastUsed
                        , Sqlite.Encode.int "failed_login_attempts_count" failedLoginAttemptsCount
                        , Sqlite.Encode.maybe Sqlite.Encode.int "locked_until" lockedUntil
                        , Sqlite.Encode.string "user_id" userId
                        ]
                    }
            )



--- deleting passwords


{-| Delete a user's password row by `userId`.
-}
delete : String -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
delete userId database =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM passwords
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId 
            ]
        }


-- TESTING


method : Sqlite.Database -> Crypto.SecureContext -> Method (Password_ Hashed)
method db sc =
    Method.new db sc
        { insert =
            (\{ userId, secret, createdAt } database secureContext ->
                Task.succeed {}
            )
        , validate =
            (\{ userId, secret } database secureContext ->
                Task.succeed {}
            )
        , get =
            (\{ userId } database secureContext ->
                Task.succeed {}
            )
        , remove =
            (\{ userId } database secureContext ->
                Task.succeed {}
            )
        }
