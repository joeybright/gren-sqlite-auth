module Auth.Simple.Password exposing ( migrationV1 )

{-|-}


{-| The first migration needed in order for passwords to work.
-}
migrationV1 : { name : String, statements : Array String } 
migrationV1 =
    { name = "`Auth.Simple.Password.migrationV1` - Add passwords and password_reset_tokens table" 
    , statements = 
        [ addPasswordsTableMigrationSQL
        , addPasswordsResetTokensTableMigrationSQL
        , passwordsUserIdIndexSQL
        , passwordResetTokensUserIdIndexSQL
        , passwordResetTokensExpiresAtIndexSQL
        ]
    }



--- `passwords` table


{-|-}
addPasswordsTableMigrationSQL : String
addPasswordsTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS passwords (
        user_id TEXT PRIMARY KEY NOT NULL,
        password_hash TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        last_used INTEGER,
        failed_login_attempts_count INTEGER NOT NULL CHECK (failed_login_attempts_count >= 0),
        locked_until INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-|-}
passwordsUserIdIndexSQL : String
passwordsUserIdIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_passwords_user_id
    ON passwords(user_id);
    """



--- `password_reset_tokens` table


{-|-}
addPasswordsResetTokensTableMigrationSQL : String
addPasswordsResetTokensTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS password_reset_tokens (
    id TEXT PRIMARY KEY NOT NULL,
    user_id TEXT NOT NULL,
    token_hash TEXT NOT NULL UNIQUE,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    consumed_at INTEGER,
    FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE
    );
    """


{-|-}
passwordResetTokensUserIdIndexSQL : String
passwordResetTokensUserIdIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_password_reset_tokens_user_id
    ON password_reset_tokens(user_id);
    """


{-|-}
passwordResetTokensExpiresAtIndexSQL : String
passwordResetTokensExpiresAtIndexSQL =
    """
    CREATE INDEX IF NOT EXISTS idx_password_reset_tokens_expires_at
    ON password_reset_tokens(expires_at);
    """
