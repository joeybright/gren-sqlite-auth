module Auth.Simple.Internal.Proof exposing ( ResolvedUser(..), Authenticated(..) )

{-| The constructors behind [`Auth.Simple.Proof`](Auth.Simple.Proof). This module
is not exposed by the package, so only modules *inside* the package can mint a
[`ResolvedUser`](#ResolvedUser) or an [`Authenticated`](#Authenticated) — that
restriction is the entire point. Consumers name these types through the aliases
in [`Auth.Simple.Proof`](Auth.Simple.Proof) and receive values from identifier
and credential modules; they can never construct one.

@docs ResolvedUser, Authenticated

-}


{-| Witness that an identifier resolved to an existing user. Minted only by
identifier modules (e.g. `Auth.Simple.Identifier.Username.resolve`).
-}
type ResolvedUser
    = ResolvedUser { userId : String }


{-| Witness that a credential check accepted a candidate secret for a user.
Minted only by credential modules (e.g. `Auth.Simple.Credential.Password.check`).
-}
type Authenticated
    = Authenticated { userId : String }
