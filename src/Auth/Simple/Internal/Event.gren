module Auth.Simple.Internal.Event exposing ( record )

{-| Best-effort audit recording shared by the workflow modules. Internal — not
part of the package's public API.

@docs record

-}

import Auth.Simple.AuthEvent as AuthEvent
import Crypto
import Sqlite
import Task exposing ( Task )


{-| Record an auth event best-effort: a failure to write the row is swallowed,
because surfacing it would mask the workflow's real outcome (a successful login
reported as failed, an `InvalidCredentials` replaced by a database error). No
secret or identifier values are recorded — only the event kind and, when known,
the user id.
-}
record :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { userId : Maybe String, eventType : AuthEvent.AuthEventType }
    -> Task x {}
record database secureContext { userId, eventType } =
    AuthEvent.create { userId = userId, eventType = eventType, metadata = Nothing } database secureContext
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})
