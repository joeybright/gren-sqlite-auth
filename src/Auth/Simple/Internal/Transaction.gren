module Auth.Simple.Internal.Transaction exposing ( withTransaction )

{-| The SQLite transaction wrapper shared by the workflow modules. Internal —
not part of the package's public API.

@docs withTransaction

-}

import Sqlite
import Task exposing ( Task )


{-| Run a workflow's writes inside one SQLite transaction: `BEGIN`, the writes,
then `COMMIT` — or, if any write fails, `ROLLBACK` and re-raise the original
error so a half-finished result never lands. A failing
`BEGIN`/`COMMIT`/`ROLLBACK` itself surfaces through `toError`.
-}
withTransaction : (Sqlite.Error -> error) -> Sqlite.Database -> Task error a -> Task error a
withTransaction toError database task =
    Sqlite.executeScript database "BEGIN TRANSACTION"
        |> Task.mapError toError
        |> Task.andThen
            (\_ ->
                task
                    |> Task.andThen
                        (\result ->
                            Sqlite.executeScript database "COMMIT"
                                |> Task.mapError toError
                                |> Task.map (\_ -> result)
                        )
                    |> Task.onError
                        (\err ->
                            Sqlite.executeScript database "ROLLBACK"
                                |> Task.mapError toError
                                |> Task.andThen (\_ -> Task.fail err)
                        )
            )
