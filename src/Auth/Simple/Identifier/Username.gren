module Auth.Simple.Identifier.Username exposing
    ( migration
    , Username
    , normalize
    , create
    , insert
    , getByUsername
    , update
    , delete
    , resolve
    , identifier
    , AsIdentifierError(..)
    )

{-| The username identifier: its schema migration and CRUD access to the
`auth_usernames` table.

Each row links a `username` to a `user_id`; the username itself is the primary
key. This module is a thin, reusable data-access layer over those columns.
Every function runs its username input through [`normalize`](#normalize) —
writes and lookups can never disagree about case or whitespace, whichever door
a username comes in through.

@docs migration
@docs Username
@docs normalize
@docs create
@docs insert
@docs getByUsername
@docs update
@docs delete
@docs resolve
@docs identifier
@docs AsIdentifierError

-}

import Auth.Simple.Identifier exposing ( Identifier )
import Auth.Simple.Internal.Proof as Internal
import Auth.Simple.Proof as Proof
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-|-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-|-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Identifier.Username.migrationV1` - Add auth_usernames table"
    , statements =
        [ addUsersTableMigrationSQL
        ]
    }



--- `username` table


{-|-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_usernames (
        username TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        FOREIGN KEY (user_id)
            REFERENCES users(id)
            ON DELETE CASCADE
    );
    """



--- username rows


{-| A row from the `auth_usernames` table.
-}
type alias Username =
    { userId : String
    , username : String
    , createdAt : Int
    , updatedAt : Int
    }


{-| Decode a single `auth_usernames` row into a [`Username`](#Username).
-}
decoder : Sqlite.Decode.Decoder Username
decoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "username"
                (\username ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "updated_at"
                                (\updatedAt ->
                                    Sqlite.Decode.succeed
                                        { userId = userId
                                        , username = username
                                        , createdAt = createdAt
                                        , updatedAt = updatedAt
                                        }
                                )
                        )
                )
        )



--- creating usernames


{-| Create a username for an existing user, identified by their `userId`, and
save it to the database.

Stamps the row with the current time, then inserts it (normalizing the
username). To insert a username inside an existing transaction with a shared
timestamp, use [`insert`](#insert) directly.
-}
create :
    Sqlite.Database
    -> { userId : String, username : String }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
create database { userId, username } =
    Time.now
        |> Task.andThen
            (\now ->
                insert database
                    { userId = userId
                    , username = username
                    , createdAt = Time.posixToMillis now
                    }
            )


{-| Insert a username row into the `auth_usernames` table, using the given
`createdAt` timestamp. Both `created_at` and `updated_at` are set to
`createdAt`; the username is stored [`normalize`](#normalize)d.
-}
insert :
    Sqlite.Database
    -> { userId : String, username : String, createdAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { userId, username, createdAt } =
    let
        statement : String
        statement =
            """
            INSERT INTO auth_usernames (username, user_id, created_at, updated_at)
            VALUES (:username, :user_id, :created_at, :updated_at)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "username" (normalize username)
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "updated_at" createdAt
            ]
        }



--- reading usernames


{-| Read a single username row by its `username` value (normalized before
matching), returning `Nothing` when no such row exists.
-}
getByUsername : Sqlite.Database -> { username : String } -> Task Sqlite.Error (Maybe Username)
getByUsername database { username } =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, username, created_at, updated_at
            FROM auth_usernames
            WHERE username = :username
            """
        , parameters =
            [ Sqlite.Encode.string "username" (normalize username)
            ]
        , rowDecoder = decoder
        }



--- updating usernames


{-| Rename a username row from its current value to a new one (both normalized),
bumping `updated_at` to now.

`username` is the primary key, so this fails if the new value is already taken.
-}
update :
    Sqlite.Database
    -> { username : String, newUsername : String }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update database { username, newUsername } =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_usernames
                        SET username = :new_username, updated_at = :updated_at
                        WHERE username = :username
                        """
                    , parameters =
                        [ Sqlite.Encode.string "new_username" (normalize newUsername)
                        , Sqlite.Encode.int "updated_at" (Time.posixToMillis now)
                        , Sqlite.Encode.string "username" (normalize username)
                        ]
                    }
            )



--- deleting usernames


{-| Delete a username row by its `username` value (normalized before matching).
-}
delete : Sqlite.Database -> { username : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
delete database { username } =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_usernames
            WHERE username = :username
            """
        , parameters =
            [ Sqlite.Encode.string "username" (normalize username)
            ]
        }



--- as an identifier


{-| Normalize a username for both storage and lookup: trim surrounding whitespace
and lowercase it, so `"Alice"`, `" alice "`, and `"ALICE"` all resolve to one
account. Every function in this module applies it to its username input, so a
value can neither be stored nor matched un-normalized.
-}
normalize : String -> String
normalize =
    String.trim >> String.toLower


{-| Failure modes when driving the `auth_usernames` table through the generic
[`Identifier`](Auth.Simple.Identifier) interface: a database fault, or a
username that is blank after [`normalize`](#normalize) — a value that can never
resolve to a user nor be registered.
-}
type AsIdentifierError
    = StorageError Sqlite.Error
    | UsernameBlank


{-| Resolve a username to proof that a user owns it — the first step of a login
pipeline. Succeeds with `Nothing` when no user owns the username (pass that
straight to a credential check, e.g.
[`Auth.Simple.Credential.Password.check`](Auth.Simple.Credential.Password#check),
which burns a validation round so unknown usernames cost the same as wrong
secrets). Fails with `UsernameBlank` for a username that is blank after
[`normalize`](#normalize) — malformed input, distinct from well-formed but
unknown.

    Auth.Simple.Identifier.Username.resolve database { username = "alice" }
        |> Task.mapError ResolveProblem
        |> Task.andThen
            (Auth.Simple.Credential.Password.check database secureContext config
                { password = candidate }
                >> Task.mapError CheckProblem
            )

-}
resolve : Sqlite.Database -> { username : String } -> Task AsIdentifierError (Maybe Proof.ResolvedUser)
resolve database { username } =
    if String.isEmpty (normalize username) then
        Task.fail UsernameBlank

    else
        getByUsername database { username = username }
            |> Task.mapError StorageError
            |> Task.map (Maybe.map (\row -> Internal.ResolvedUser { userId = row.userId }))


{-| Expose usernames as a generic [`Identifier`](Auth.Simple.Identifier): `resolve`
maps a username string to the owning user's id via [`getByUsername`](#getByUsername),
and `insert` registers a new username for a user via [`create`](#create) —
normalization is handled by those functions themselves.

`resolve` rejects a blank username (`UsernameBlank`) — malformed input, distinct
from `Nothing` (well-formed but unknown). `insert` is a plain write;
[`Auth.Simple.Register`](Auth.Simple.Register) checks availability via `resolve`
before inserting, and the table's primary key on `username` remains the
backstop for a race.
-}
identifier : Identifier AsIdentifierError String
identifier =
    { resolve =
        (\database _ { value } ->
            if String.isEmpty (normalize value) then
                Task.fail UsernameBlank

            else
                getByUsername database { username = value }
                    |> Task.mapError StorageError
                    |> Task.map (Maybe.map .userId)
        )
    , insert =
        (\database _ { userId, value } ->
            create database { userId = userId, username = value }
                |> Task.map (\_ -> {})
        )
    }
