module Auth.Simple.Identifier.Username exposing
    ( migration
    , Username
    , create
    , insert
    , get
    , getByUsername
    , update
    , delete
    )

{-| The username identifier: its schema migration and CRUD access to the
`usernames` table.

Each row links a `username` (unique across the table) to a `user_id`. This module
is a thin, reusable data-access layer over those columns; CRUD functions are keyed
on the row `id`.

@docs migration
@docs Username
@docs create
@docs insert
@docs get
@docs getByUsername
@docs update
@docs delete

-}

import Crypto
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-|-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-|-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Identifier.Username.migrationV1` - Add usernames table"
    , statements =
        [ addUsersTableMigrationSQL
        ]
    }



--- `username` table


{-|-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS usernames (
        id TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL,
        username TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        FOREIGN KEY (user_id)
            REFERENCES users(id)
            ON DELETE CASCADE,
        UNIQUE (username)
    );
    """



--- username rows


{-| A row from the `usernames` table.
-}
type alias Username =
    { id : String
    , userId : String
    , username : String
    , createdAt : Int
    , updatedAt : Int
    }


{-| Decode a single `usernames` row into a [`Username`](#Username).
-}
decoder : Sqlite.Decode.Decoder Username
decoder =
    Sqlite.Decode.string "id"
        (\id ->
            Sqlite.Decode.string "user_id"
                (\userId ->
                    Sqlite.Decode.string "username"
                        (\username ->
                            Sqlite.Decode.int "created_at"
                                (\createdAt ->
                                    Sqlite.Decode.int "updated_at"
                                        (\updatedAt ->
                                            Sqlite.Decode.succeed
                                                { id = id
                                                , userId = userId
                                                , username = username
                                                , createdAt = createdAt
                                                , updatedAt = updatedAt
                                                }
                                        )
                                )
                        )
                )
        )



--- creating usernames


{-| Create a username for an existing user, identified by their `userId`, and
save it to the database.

Generates a fresh row id and timestamp, then inserts the row. To insert a
username inside an existing transaction with a shared id and timestamp, use
[`insert`](#insert) directly.
-}
create :
    { userId : String, username : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task Sqlite.Error Sqlite.ExecutionSummary
create { userId, username } database secureContext =
    Task.map
        (\id now ->
            { id = id
            , userId = userId
            , username = username
            , createdAt = Time.posixToMillis now
            }
        )
        (Crypto.randomUuidV4 secureContext)
        |> Task.andMap Time.now
        |> Task.andThen (insert database)


{-| Insert a username row into the `usernames` table, using the given row `id`
and `createdAt` timestamp. Both `created_at` and `updated_at` are set to
`createdAt`.
-}
insert :
    Sqlite.Database
    -> { id : String, userId : String, username : String, createdAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { id, userId, username, createdAt } =
    let
        statement : String
        statement =
            """
            INSERT INTO usernames (id, user_id, username, created_at, updated_at)
            VALUES (:id, :user_id, :username, :created_at, :updated_at)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "id" id
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.string "username" username
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "updated_at" createdAt
            ]
        }



--- reading usernames


{-| Read a single username row by `id`, returning `Nothing` when no such row
exists.
-}
get : String -> Sqlite.Database -> Task Sqlite.Error (Maybe Username)
get id database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT id, user_id, username, created_at, updated_at
            FROM usernames
            WHERE id = :id
            """
        , parameters =
            [ Sqlite.Encode.string "id" id
            ]
        , rowDecoder = decoder
        }


{-| Read a single username row by its `username` value, returning `Nothing` when
no such row exists.
-}
getByUsername : String -> Sqlite.Database -> Task Sqlite.Error (Maybe Username)
getByUsername username database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT id, user_id, username, created_at, updated_at
            FROM usernames
            WHERE username = :username
            """
        , parameters =
            [ Sqlite.Encode.string "username" username
            ]
        , rowDecoder = decoder
        }



--- updating usernames


{-| Rename a username row by `id`, bumping `updated_at` to now.

`username` is unique across the table, so this fails if the new value is already
taken.
-}
update :
    { id : String, username : String }
    -> Sqlite.Database
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update { id, username } database =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE usernames
                        SET username = :username, updated_at = :updated_at
                        WHERE id = :id
                        """
                    , parameters =
                        [ Sqlite.Encode.string "username" username
                        , Sqlite.Encode.int "updated_at" (Time.posixToMillis now)
                        , Sqlite.Encode.string "id" id
                        ]
                    }
            )



--- deleting usernames


{-| Delete a username row by `id`.
-}
delete : String -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
delete id database =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM usernames
            WHERE id = :id
            """
        , parameters =
            [ Sqlite.Encode.string "id" id 
            ]
        }
