module Auth.Simple.Identifier.Username exposing
    ( migration
    , Username
    , normalize
    , create
    , insert
    , getByUsername
    , update
    , delete
    , identifier
    , AsIdentifierError(..)
    )

{-| The username identifier: its schema migration and CRUD access to the
`auth_usernames` table.

Each row links a `username` to a `user_id`; the username itself is the primary
key. This module is a thin, reusable data-access layer over those columns; CRUD
functions are keyed on the `username` and store their input literally —
normalization happens in the [`identifier`](#identifier) bundle, which is what
workflows should drive.

@docs migration
@docs Username
@docs normalize
@docs create
@docs insert
@docs getByUsername
@docs update
@docs delete
@docs identifier
@docs AsIdentifierError

-}

import Auth.Simple.Identifier exposing ( Identifier )
import Sqlite
import Sqlite.Decode
import Sqlite.Encode
import Task exposing ( Task )
import Time


{-|-}
migration : { v1 : { name : String, statements : Array String } }
migration =
    { v1 = migrationV1
    }


{-|-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.Identifier.Username.migrationV1` - Add auth_usernames table"
    , statements =
        [ addUsersTableMigrationSQL
        ]
    }



--- `username` table


{-|-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS auth_usernames (
        username TEXT PRIMARY KEY NOT NULL,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        FOREIGN KEY (user_id)
            REFERENCES users(id)
            ON DELETE CASCADE
    );
    """



--- username rows


{-| A row from the `auth_usernames` table.
-}
type alias Username =
    { userId : String
    , username : String
    , createdAt : Int
    , updatedAt : Int
    }


{-| Decode a single `auth_usernames` row into a [`Username`](#Username).
-}
decoder : Sqlite.Decode.Decoder Username
decoder =
    Sqlite.Decode.string "user_id"
        (\userId ->
            Sqlite.Decode.string "username"
                (\username ->
                    Sqlite.Decode.int "created_at"
                        (\createdAt ->
                            Sqlite.Decode.int "updated_at"
                                (\updatedAt ->
                                    Sqlite.Decode.succeed
                                        { userId = userId
                                        , username = username
                                        , createdAt = createdAt
                                        , updatedAt = updatedAt
                                        }
                                )
                        )
                )
        )



--- creating usernames


{-| Create a username for an existing user, identified by their `userId`, and
save it to the database.

Stamps the row with the current time, then inserts it. To insert a username
inside an existing transaction with a shared timestamp, use [`insert`](#insert)
directly.
-}
create :
    { userId : String, username : String }
    -> Sqlite.Database
    -> Task Sqlite.Error Sqlite.ExecutionSummary
create { userId, username } database =
    Time.now
        |> Task.andThen
            (\now ->
                insert database
                    { userId = userId
                    , username = username
                    , createdAt = Time.posixToMillis now
                    }
            )


{-| Insert a username row into the `auth_usernames` table, using the given
`createdAt` timestamp. Both `created_at` and `updated_at` are set to
`createdAt`.
-}
insert :
    Sqlite.Database
    -> { userId : String, username : String, createdAt : Int }
    -> Task Sqlite.Error Sqlite.ExecutionSummary
insert database { userId, username, createdAt } =
    let
        statement : String
        statement =
            """
            INSERT INTO auth_usernames (username, user_id, created_at, updated_at)
            VALUES (:username, :user_id, :created_at, :updated_at)
            """
    in
    Sqlite.execute database
        { statement = statement
        , parameters =
            [ Sqlite.Encode.string "username" username
            , Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.int "created_at" createdAt
            , Sqlite.Encode.int "updated_at" createdAt
            ]
        }



--- reading usernames


{-| Read a single username row by its `username` value, returning `Nothing` when
no such row exists.
-}
getByUsername : String -> Sqlite.Database -> Task Sqlite.Error (Maybe Username)
getByUsername username database =
    Sqlite.getMaybeOne database
        { query =
            """
            SELECT user_id, username, created_at, updated_at
            FROM auth_usernames
            WHERE username = :username
            """
        , parameters =
            [ Sqlite.Encode.string "username" username
            ]
        , rowDecoder = decoder
        }



--- updating usernames


{-| Rename a username row from its current value to a new one, bumping
`updated_at` to now.

`username` is the primary key, so this fails if the new value is already taken.
-}
update :
    { username : String, newUsername : String }
    -> Sqlite.Database
    -> Task Sqlite.Error Sqlite.ExecutionSummary
update { username, newUsername } database =
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.execute database
                    { statement =
                        """
                        UPDATE auth_usernames
                        SET username = :new_username, updated_at = :updated_at
                        WHERE username = :username
                        """
                    , parameters =
                        [ Sqlite.Encode.string "new_username" newUsername
                        , Sqlite.Encode.int "updated_at" (Time.posixToMillis now)
                        , Sqlite.Encode.string "username" username
                        ]
                    }
            )



--- deleting usernames


{-| Delete a username row by its `username` value.
-}
delete : String -> Sqlite.Database -> Task Sqlite.Error Sqlite.ExecutionSummary
delete username database =
    Sqlite.execute database
        { statement =
            """
            DELETE FROM auth_usernames
            WHERE username = :username
            """
        , parameters =
            [ Sqlite.Encode.string "username" username
            ]
        }



--- as an identifier


{-| Normalize a username for both storage and lookup: trim surrounding whitespace
and lowercase it, so `"Alice"`, `" alice "`, and `"ALICE"` all resolve to one
account. Applied by both halves of the [`identifier`](#identifier) bundle; the
raw CRUD functions store and match their input literally.
-}
normalize : String -> String
normalize =
    String.trim >> String.toLower


{-| Failure modes when driving the `auth_usernames` table through the generic
[`Identifier`](Auth.Simple.Identifier) interface: a database fault, or a
username that is blank after [`normalize`](#normalize) — a value that can never
resolve to a user nor be registered.
-}
type AsIdentifierError
    = StorageError Sqlite.Error
    | UsernameBlank


{-| Expose usernames as a generic [`Identifier`](Auth.Simple.Identifier): `resolve`
maps a username string to the owning user's id via [`getByUsername`](#getByUsername),
and `insert` registers a new username for a user via [`create`](#create). Both
run the input through [`normalize`](#normalize) first.

`resolve` rejects a blank username (`UsernameBlank`) — malformed input, distinct
from `Nothing` (well-formed but unknown). `insert` is a plain write;
[`Auth.Simple.Register`](Auth.Simple.Register) checks availability via `resolve`
before inserting, and the table's primary key on `username` remains the
backstop for a race.
-}
identifier : Identifier AsIdentifierError String
identifier =
    { resolve =
        (\username database _ ->
            let
                normalized : String
                normalized =
                    normalize username
            in
            if String.isEmpty normalized then
                Task.fail UsernameBlank

            else
                getByUsername normalized database
                    |> Task.mapError StorageError
                    |> Task.map (Maybe.map .userId)
        )
    , insert =
        (\{ userId, value } database _ ->
            create { userId = userId, username = normalize value } database
                |> Task.map (\_ -> {})
        )
    }
