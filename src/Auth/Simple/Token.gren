module Auth.Simple.Token exposing ( Token )

{-| The artifact a successful login hands back. This `Token` is intended to be 
proof of authentication for future requests.

Currently, the only type of token supported is a database-stored session 
([`Auth.Simple.Token.Session`](Auth.Simple.Token.Session)). Other types of tokens
may be supported in the future such as JWT tokens.

@docs Token

-}

import Crypto
import Sqlite
import Task exposing ( Task )


{-| A bundle of functions describing one way to issue, verify, and revoke a token.

A `Token` type has three parameters:

- `error` is the tokens failure type.
- `issued` is the type of the token that will be returned when a token is successfully
issued.
- `verified` is what a presented token resolves to on success.

The four functions required for a `Token` are:

- `issue` which takes a `{ userId }` and issues a token for that user id. This does not
  control lifetime and expiry as those policies live inside the implementation.
- `verify` takes the raw bearer string the client holds (`{ token }`) and produces the
  `verified` type if it is valid. If not valid, returns a successful `Task` but the
  result is `Nothing`.
- `revoke` takes the raw bearer string the client holds (`{ token }`) and revokes that
  token.
- `revokeAllForUser` invalidates every token the user holds — the "credential changed"
  hook, driven by workflows like
  [`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password) and
  [`Auth.Simple.Credential.Password.reset`](Auth.Simple.Credential.Password) so a stolen
  token never survives the action meant to lock it out. It is pinned to `Sqlite.Error`
  (not the generic `error`) so workflows can run it inside
  [`Sqlite.inTransaction`](Sqlite#inTransaction); a species without per-token rows (a
  future JWT) would implement it with whatever SQLite state backs its invalidation (a
  denylist, a key-version row).
-}
type alias Token error issued verified =
    { issue : { userId : String } -> Sqlite.Database -> Crypto.SecureContext -> Task error issued
    , verify : { token : String } -> Sqlite.Database -> Crypto.SecureContext -> Task error (Maybe verified)
    , revoke : { token : String } -> Sqlite.Database -> Crypto.SecureContext -> Task error {}
    , revokeAllForUser : { userId : String } -> Sqlite.Database -> Crypto.SecureContext -> Task Sqlite.Error {}
    }
