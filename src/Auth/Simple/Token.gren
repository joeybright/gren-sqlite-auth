module Auth.Simple.Token exposing ( Token )

{-| The artifact a successful login hands back. This `Token` is intended to be 
proof of authentication for future requests.

Currently, the only type of token supported is a database-stored session 
([`Auth.Simple.Token.Session`](Auth.Simple.Token.Session)). Other types of tokens
may be supported in the future such as JWT tokens.

@docs Token

-}

import Crypto
import Sqlite
import Task exposing ( Task )


{-| Functions describing one way to issue, verify, and revoke a token.

A `Token` type has three parameters:

- `error` is the tokens failure type.
- `issued` is the token that will be returned when a token is successfully issued.
- `verified` is what a presented token resolves to on success.

View `Auth.Simple.Token.Session.token` for an example implementation.
-}
type alias Token error issued verified =
    { issue : IssueToken error issued
    , verify : VerifyToken error verified
    , revoke : RevokeToken error
    , revokeAllForUser : RevokeAllToken
    }


{-| Issues a token for the given `userId`.
-}
type alias IssueToken error issued =
    Sqlite.Database -> Crypto.SecureContext -> { userId : String } -> Task error issued


{-| Verifies the given `token`.
-}
type alias VerifyToken error verified =
    Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task error (Maybe verified)


{-| Revoke the given `token`.
-}
type alias RevokeToken error =
    Sqlite.Database -> Crypto.SecureContext -> { token : String } -> Task error {}

  
{-| Revoke all sessions for the given `userId`.

This is used to help invalidate all sessions when the user logs out, changes, their
password, or performs some other action that should invalidate all of their sessions.
-}
type alias RevokeAllToken =
    Sqlite.Database -> Crypto.SecureContext -> { userId : String } -> Task Sqlite.Error {}
