module Auth.Simple.Credential exposing ( Credential, new )

{-|

Create account: 
1. Take in an identifier and a method. Both should already be verified 
_outside of_ the flow, with phantom types guarding this before the flow
can actually happen.
2. Insert the identifier and method into the database, assume success.

Login:
1. Take in an identifier and a method. Both, again, should already be
verified and that verification should be guarded via phantom types.
2. Check for the precense of the given identifier.
3. If the identifier exists, find the method in the database.
4. Verify the found identifier vs. the given identifier.
5. If verification succeeds, issue a session token and hand it back to
the caller of the function.

Others:
- Reset method (reset password)
- Change identifier (username, password)
- Delete account

---

Functions I need:

- `insert` for both identifier and method.
- `get` for both identifier and method.
- `verify` for comparing a given method against an existing one.

---

This would allow identifiers of email and username, and methods of
password. I don't believe this would allow for methods other than
password? One-time code is the only one I really want to support...

-}

import Crypto
import Sqlite
import Task exposing ( Task )


{-| A credential's database handle, secure context, and the four functions that
drive it. `stored` is the secret type persisted by `insert`; `candidate` is the
secret type checked by `validate` (they differ when, e.g., a hashed password is
stored but a plain-text one is verified); `error` is the failure type the
functions surface.
-}
type alias Credential error candidate stored =
    { database : Sqlite.Database
    , secureContext : Crypto.SecureContext
    , functions : CredentialFunctions error candidate stored
    }


{-| The four operations a credential supports: persist a new secret, read it,
validate a candidate against the stored secret, and remove it.
-}
type alias CredentialFunctions error candidate stored =
    { insert : -- Insert a new credential secret into the database
        { userId : String
        , secret : stored
        }
        -> Sqlite.Database
        -> Crypto.SecureContext
        -> Task error {}
    , get : -- Get the credential from the database
        { userId : String
        }
        -> Sqlite.Database
        -> Crypto.SecureContext
        -> Task error stored
    , validate : -- Given a candidate secret, validate it against the stored one
        { userId : String
        , secret : candidate
        }
        -> Sqlite.Database
        -> Crypto.SecureContext
        -> Task error {}
    , remove :
        { userId : String
        }
        -> Sqlite.Database
        -> Crypto.SecureContext
        -> Task error {}
    }


{-| Testing

    appAuth =
        Auth.Simple.Credential.new db secureContext

    usernameIdentifier =
        Auth.Simple.Identifier.Username.identifier

    emailIdentifier =
        Auth.Simple.Identifier.Email.identifier

    passwordCredential =
        Auth.Simple.Credential.Password.method

    usernamePasswordAuth =
        appAuth
            { identifier = usernameIdentifier
            , method = passwordCredential
            }

    emailPasswordAuth =
        appAuth
            { identfier = emailIdentifier
            , method = passwordCredential
            }

    loginWithUsernamePasssowrd =
        Auth.Simple.Credential.login usernamePasswordAuth
            { username = username
            , password = password
            }

    loginWithEmailPassword =
        Auth.Simple.Credential.login emailPasswordAuth
            { email = email
            , password = password
            }
-}
new : Sqlite.Database -> Crypto.SecureContext -> CredentialFunctions stored candidate error -> Credential stored candidate error
new database secureContext functions =
    { database = database
    , secureContext = secureContext
    , functions = functions
    }
