module Auth.Simple.Register exposing ( identifier, credential, register, Error(..) )

{-| Drive an [`Identifier`](Auth.Simple.Identifier) and/or a
[`Stored`](Auth.Simple.Credential.Stored) credential into a registration
workflow: optionally create the user, then write the identifier and/or the
credential against that user.

This is the counterpart to [`Auth.Simple.Login`](Auth.Simple.Login). Like login, it
holds no storage logic of its own — it calls the `insert` function each bundle
carries, so the concrete module (e.g. [`Auth.Simple.Credential.Password`](Auth.Simple.Credential.Password))
remains the only place that knows how to persist its own secret.

Registering an identifier and registering a credential are separate operations
([`identifier`](#identifier), [`credential`](#credential)) so a user can hold many
identifiers, a single credential, or an identifier with no credential yet (a
reserved username, an unconfirmed email — login through it simply fails until a
credential exists). [`register`](#register) is the convenience that does a user, an
identifier, and a credential together.

Each registration first checks the identifier value is available (via the
bundle's `resolve`), then runs its writes inside one
[`Sqlite.inTransaction`](Sqlite#inTransaction) so a half-finished account (a user
with no identifier, an identifier with no credential) never lands. The
identifier's unique constraint remains the backstop should two registrations
race past the availability check.

@docs identifier, credential, register, Error

-}

import Auth.Simple.Credential.Stored exposing ( Stored )
import Auth.Simple.Identifier exposing ( Identifier )
import Auth.Simple.User as User
import Crypto
import Sqlite
import Task exposing ( Task )


{-| Everything a registration can go wrong on: resolving the identifier during
the availability check (`identifierError`), the identifier value already
belonging to a user (`IdentifierTaken`), or the transactional writes — user,
identifier, credential, and the `BEGIN`/`COMMIT`/`ROLLBACK` around them are all
plain database operations, so they share `TransactionError`.

[`credential`](#credential) involves no identifier and never produces the
identifier variants; it leaves the parameter polymorphic and unifies cleanly
when composed.
-}
type Error identifierError
    = IdentifierError identifierError
    | IdentifierTaken
    | TransactionError Sqlite.Error


{-| Settle on the user to register against: use the supplied `userId`, or, when it
is `Nothing`, create a fresh user via [`Auth.Simple.User.create`](Auth.Simple.User)
and use its id.
-}
resolveUserId :
    Maybe String
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task Sqlite.Error String
resolveUserId maybeUserId database secureContext =
    when maybeUserId is
        Just userId ->
            Task.succeed userId

        Nothing ->
            User.create database secureContext
                |> Task.map (\user -> user.id)


{-| Check an identifier value is available before any write: resolve it, failing
with [`IdentifierTaken`](#Error) when a user already owns it. Malformed values
(e.g. a blank username) surface as the bundle's own `identifierError`.
-}
ensureAvailable :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> value
    -> Task (Error identifierError) {}
ensureAvailable database secureContext theIdentifier value =
    theIdentifier.resolve { value = value } database secureContext
        |> Task.mapError IdentifierError
        |> Task.andThen
            (\existing ->
                when existing is
                    Just _ ->
                        Task.fail IdentifierTaken

                    Nothing ->
                        Task.succeed {}
            )


{-| Register an [`Identifier`](Auth.Simple.Identifier) value for a user. Pass
`userId = Nothing` to create the user first, or `Just id` to add the identifier to an
existing user. Returns the user the identifier now belongs to.
-}
identifier :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> { userId : Maybe String, value : value }
    -> Task (Error identifierError) { userId : String }
identifier database secureContext theIdentifier input =
    ensureAvailable database secureContext theIdentifier input.value
        |> Task.andThen
            (\_ ->
                Sqlite.inTransaction database
                    (resolveUserId input.userId database secureContext
                        |> Task.andThen
                            (\userId ->
                                theIdentifier.insert
                                    { userId = userId, value = input.value }
                                    database
                                    secureContext
                                    |> Task.map (\_ -> { userId = userId })
                            )
                    )
                    |> Task.mapError TransactionError
            )


{-| Register a [`Stored`](Auth.Simple.Credential.Stored) credential secret for a
user. The secret is the credential's `stored` type (e.g. an already-hashed
password), prepared by the caller. Pass `userId = Nothing` to create the user
first, or `Just id` to add the credential to an existing user. Returns the user
the credential now belongs to.

One-time codes are never registered — they are minted per login by
[`Auth.Simple.Credential.Code.request`](Auth.Simple.Credential.Code); a
code-only user registers just an identifier via [`identifier`](#identifier).
-}
credential :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Stored stored
    -> { userId : Maybe String, secret : stored }
    -> Task (Error identifierError) { userId : String }
credential database secureContext theCredential input =
    Sqlite.inTransaction database
        (resolveUserId input.userId database secureContext
            |> Task.andThen
                (\userId ->
                    theCredential.insert
                        { userId = userId, secret = input.secret }
                        database
                        secureContext
                        |> Task.map (\_ -> { userId = userId })
                )
        )
        |> Task.mapError TransactionError


{-| Register an identifier and a credential for the same user in one task. Pass
`userId = Nothing` to create the user first, or `Just id` to attach both to an
existing user. The user is resolved once and both writes share it; on success returns
that user's id.
-}
register :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> Stored stored
    -> { userId : Maybe String, value : value, secret : stored }
    -> Task (Error identifierError) { userId : String }
register database secureContext theIdentifier theCredential input =
    ensureAvailable database secureContext theIdentifier input.value
        |> Task.andThen
            (\_ ->
                Sqlite.inTransaction database
                    (resolveUserId input.userId database secureContext
                        |> Task.andThen
                            (\userId ->
                                theIdentifier.insert
                                    { userId = userId, value = input.value }
                                    database
                                    secureContext
                                    |> Task.andThen
                                        (\_ ->
                                            theCredential.insert
                                                { userId = userId, secret = input.secret }
                                                database
                                                secureContext
                                        )
                                    |> Task.map (\_ -> { userId = userId })
                            )
                    )
                    |> Task.mapError TransactionError
            )
