module Auth.Simple.Register exposing ( identifier, credential, register, Error(..) )

{-| Register a new [username](Auth.Simple.Identifier.Username) identifier and/or a
[password](Auth.Simple.Credential.Password) credential for a user.

Registering an identifier and registering a credential are separate operations
([`identifier`](#identifier), [`credential`](#credential)) so a user can hold many
identifiers, a single credential, or an identifier with no credential. 
[`register`](#register) is the convenience that does a user, an identifier, and a 
credential together.

@docs identifier, credential, register, Error

-}

import Auth.Simple.Credential.Stored exposing ( Stored )
import Auth.Simple.Identifier exposing ( Identifier )
import Auth.Simple.User as User
import Crypto
import Sqlite
import Task exposing ( Task )


{-| Everything a registration can go wrong on: resolving the identifier during
the availability check (`identifierError`), the identifier value already
belonging to a user (`IdentifierTaken`), or the transactional writes — user,
identifier, credential, and the `BEGIN`/`COMMIT`/`ROLLBACK` around them are all
plain database operations, so they share `TransactionError`.
-}
type Error identifierError
    = IdentifierError identifierError
    | IdentifierTaken
    | TransactionError Sqlite.Error


{-| Settle on the user to register against: use the supplied `userId`, or, when it
is `Nothing`, create a fresh user via [`Auth.Simple.User.create`](Auth.Simple.User)
and use its id.
-}
resolveUserId :
    Maybe String
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task Sqlite.Error String
resolveUserId maybeUserId database secureContext =
    when maybeUserId is
        Just userId ->
            Task.succeed userId

        Nothing ->
            User.create database secureContext
                |> Task.map (\user -> user.id)


{-| Check an identifier value is available before any write: resolve it, failing
with [`IdentifierTaken`](#Error) when a user already owns it. Malformed values
(e.g. a blank username) surface as the bundle's own `identifierError`.
-}
ensureAvailable :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> value
    -> Task (Error identifierError) {}
ensureAvailable database secureContext passedIdentifier value =
    passedIdentifier.resolve database secureContext { value = value }
        |> Task.mapError IdentifierError
        |> Task.andThen
            (\existing ->
                when existing is
                    Just _ ->
                        Task.fail IdentifierTaken

                    Nothing ->
                        Task.succeed {}
            )


{-| Register an identifier (like a [username](Auth.Simple.Identifier.Username)) 
for a user. 

Pass `Nothing` to the `userId` to create a new user first, or `Just id` to add 
the identifier to an existing user. Returns the user the identifier now belongs
to.

For example, to register a new username for an existing user, you can use the 
following, where the given `userId` is the id of the existing user:

    Auth.Simple.Register.identifier database secureContext
        Auth.Simple.Identifier.Username.identifier
        { userId = Just "826f1968-46d4-4dcc-aefb-ea1b55dfccf7"
        , value = "new_username"
        }

This will create a username for the given user id (if it exists).
-}
identifier :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> { userId : Maybe String, value : value }
    -> Task (Error identifierError) { userId : String }
identifier database secureContext passedIdentifier input =
    ensureAvailable database secureContext passedIdentifier input.value
        |> Task.andThen
            (\_ ->
                Sqlite.inTransaction database
                    (resolveUserId input.userId database secureContext
                        |> Task.andThen
                            (\userId ->
                                passedIdentifier.insert database secureContext
                                    { userId = userId
                                    , value = input.value 
                                    }
                                    |> Task.map (\_ -> 
                                        { userId = userId 
                                        }
                                    )
                            )
                    )
                    |> Task.mapError TransactionError
            )


{-| Register a credential (like a [password](Auth.Simple.Credential.Password)) 
for a user. 

Pass `Nothing` to the `userId` to create a new user first, or `Just id` to add 
the identifier to an existing user. Returns the user the identifier now belongs
to.

For example, to register a new password for an existing user, you can use the 
following, where the given `userId` is the id of the existing user:

    Auth.Simple.Register.credential database secureContext
        Auth.Simple.Credential.Password.stored
        { userId = Just "826f1968-46d4-4dcc-aefb-ea1b55dfccf7"
        , value = 
            "new_password"
                |> Auth.Simple.Credential.Password.fromString
                |> Auth.Simple.Credential.Password.hash Crypto.Sha256 Dict.empty
        }

This will create a password that's properly hashed for the given user id (if it
exists) and stores it in the database.

For more information on how to properly prepare a password for saving to the database,
refer to the [Auth.Simple.Identifier.Passsword](Auth.Simple.Identifier.Password) module.
-}
credential :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Stored stored
    -> { userId : Maybe String, secret : stored }
    -> Task (Error identifierError) { userId : String }
credential database secureContext theCredential input =
    Sqlite.inTransaction database
        (resolveUserId input.userId database secureContext
            |> Task.andThen
                (\userId ->
                    theCredential.insert database
                        secureContext
                        { userId = userId, secret = input.secret }
                        |> Task.map (\_ -> { userId = userId })
                )
        )
        |> Task.mapError TransactionError


{-| Register an identifier (like a [username](Auth.Identifier.Username)) and a 
credential (like a [password](Auth.Simple.Credential.Password)) for a user. 

Like `identifier` and `credential` functions in this module, pass `Nothing` to the 
`userId` to create a new user first, or `Just id` to add the identifier to an 
existing user.

Example:

    Auth.Simple.Register.register database secureContext
        Auth.Simple.Identifier.Username.identifier
        Auth.Simple.Credential.Password.stored
        { userId = Just "826f1968-46d4-4dcc-aefb-ea1b55dfccf7"
        , value = "new_username"
        , secret = 
            "new_password"
                |> Auth.Simple.Credential.Password.fromString
                |> Auth.Simple.Credential.Password.hash Crypto.Sha256 Dict.empty
        }
-}
register :
    Sqlite.Database
    -> Crypto.SecureContext
    -> Identifier identifierError value
    -> Stored stored
    -> { userId : Maybe String, value : value, secret : stored }
    -> Task (Error identifierError) { userId : String }
register database secureContext passedIdentifier passedCredential input =
    ensureAvailable database secureContext passedIdentifier input.value
        |> Task.andThen
            (\_ ->
                Sqlite.inTransaction database
                    (resolveUserId input.userId database secureContext
                        |> Task.andThen
                            (\userId ->
                                passedIdentifier.insert database
                                    secureContext
                                    { userId = userId, value = input.value }
                                    |> Task.andThen
                                        (\_ ->
                                            passedCredential.insert database
                                                secureContext
                                                { userId = userId, secret = input.secret }
                                        )
                                    |> Task.map (\_ -> { userId = userId })
                            )
                    )
                    |> Task.mapError TransactionError
            )
