module Auth.Simple.UsernamePassword exposing ( .. )

{-| Workflows for the username (identifier) and password (authentication
method). Includes: register, login, ...
-}

import Auth.Simple.AuthEvent
import Auth.Simple.Identifier.Username
import Auth.Simple.Method.Password
import Auth.Simple.Session
import Auth.Simple.User
import Base64.Decode
import Base64.Encode
import Bytes exposing ( Bytes )
import Crypto
import Dict
import Sqlite
import Sqlite.Encode
import Auth.Simple.Method.Password.PhcString as PhcString
import Task exposing ( Task )
import Time


{-| Errors that can happen when creating a hashed password `String`.
-}
type HashPasswordError
    = ImportPbkdf2KeyError Crypto.ImportPbkdf2KeyError
    | Pbkdf2DeriveBitsError Crypto.Pbkdf2DeriveBitsError


{-| Properly hash a password, returning a PHC-formatted `String` ready to
safely save to a database.
-}
hashPassword : String -> Crypto.SecureContext -> Task HashPasswordError String
hashPassword password secureContext =
    let
        hash : Crypto.DigestAlgorithm
        hash =
            Crypto.Sha256

        iterations : Int
        iterations =
            600000
    in
    Crypto.getRandomUInt8Values 16
        |> Task.andThen (\saltBytes ->
            hashPasswordHelper secureContext
                { password = password
                , salt = saltBytes
                , iterations = iterations
                , digestAlgorithm = hash
                }
        )


{-|-}
type alias HashPasssword =
    { password : String
    , salt : Bytes
    , iterations : Int
    , digestAlgorithm : Crypto.DigestAlgorithm
    }


{-|-}
hashPasswordHelper : Crypto.SecureContext -> HashPasssword -> Task HashPasswordError String
hashPasswordHelper secureContext { password, salt, iterations, digestAlgorithm } =
    let
        pbkdf2IdString : Crypto.DigestAlgorithm -> String
        pbkdf2IdString usedHash =
            when usedHash is
                Crypto.Sha256 ->
                    "pbkdf2-sha256"

                Crypto.Sha384 ->
                    "pbkdf2-sha384"

                Crypto.Sha512 ->
                    "pbkdf2-sha512"
    in
    password
        |> Bytes.fromString
        |> Crypto.importPbkdf2KeyFromRaw secureContext
        |> Task.mapError ImportPbkdf2KeyError
        |> Task.andThen (\importedPbkdf2Key ->
            Crypto.deriveBitsWithPbkdf2
                { salt = salt
                , iterations = iterations
                , hash = digestAlgorithm
                }
                Nothing
                importedPbkdf2Key
                |> Task.mapError Pbkdf2DeriveBitsError
                |> Task.map (\hashedPasswordBytes ->
                    PhcString.toString
                        { id = pbkdf2IdString digestAlgorithm
                        , params = Dict.singleton "i" (String.fromInt iterations)
                        , tail =
                            PhcString.SaltAndHash
                                { salt = 
                                    Base64.Encode.bytes salt 
                                        |> Base64.Encode.encode
                                , hash = 
                                    Base64.Encode.bytes hashedPasswordBytes 
                                        |> Base64.Encode.encode
                                }
                        }
                )
        )


{-| Errors that can happen when verifying a password against a stored PHC
`String`.
-}
type VerifyPasswordError
    = ParsePhcStringError PhcString.Error
    | UnknownDigestAlgorithm String
    | MissingSalt
    | InvalidSalt Base64.Decode.Error
    | MissingIterations
    | InvalidIterations String
    | RederiveError HashPasswordError
    | PasswordMismatch


{-| Check a plain-text `password` against a stored PHC `String`, succeeding with
`{}` when they match and failing with a [`VerifyPasswordError`](#VerifyPasswordError)
otherwise.

The stored string carries everything needed to reproduce its own hash: the salt,
the iteration count, and the digest algorithm. We parse those back out, re-derive
the hash through the same [`hashPasswordHelper`](#hashPasswordHelper) used to
create it, and compare the result to the stored string. A match proves the
password is the one that produced the stored hash.
-}
verifyPassword : String -> String -> Crypto.SecureContext -> Task VerifyPasswordError {}
verifyPassword password phcString secureContext =
    when PhcString.parse phcString is
        Err error ->
            Task.fail (ParsePhcStringError error)

        Ok parsed ->
            when paramsFromPhcString parsed is
                Err error ->
                    Task.fail error

                Ok { salt, iterations, digestAlgorithm } ->
                    hashPasswordHelper secureContext
                        { password = password
                        , salt = salt
                        , iterations = iterations
                        , digestAlgorithm = digestAlgorithm
                        }
                        |> Task.mapError RederiveError
                        |> Task.andThen (\rederivedPhcString ->
                            if rederivedPhcString == PhcString.toString parsed then
                                Task.succeed {}

                            else
                                Task.fail PasswordMismatch
                        )


{-| Recover everything [`hashPasswordHelper`](#hashPasswordHelper) needs to
reproduce the hash from a parsed PHC string: the raw salt `Bytes`, the iteration
count, and the digest algorithm.
-}
paramsFromPhcString : PhcString.PhcString -> Result VerifyPasswordError { salt : Bytes, iterations : Int, digestAlgorithm : Crypto.DigestAlgorithm }
paramsFromPhcString parsed =
    Result.map3
        (\salt iterations digestAlgorithm ->
            { salt = salt
            , iterations = iterations
            , digestAlgorithm = digestAlgorithm
            }
        )
        (saltBytesFromTail parsed.tail)
        (iterationsFromParams parsed.params)
        (digestAlgorithmFromId parsed.id)


{-| Pull the raw salt `Bytes` out of a parsed PHC string's tail by base64
decoding the salt segment.
-}
saltBytesFromTail : PhcString.Tail -> Result VerifyPasswordError Bytes
saltBytesFromTail tail =
    when tail is
        PhcString.SaltAndHash { salt } ->
            decodeSalt salt

        PhcString.SaltOnly salt ->
            decodeSalt salt

        PhcString.NoTail ->
            Err MissingSalt


{-| Base64 decode a salt segment into raw `Bytes`.
-}
decodeSalt : String -> Result VerifyPasswordError Bytes
decodeSalt salt =
    Base64.Decode.bytes salt
        |> Result.mapError InvalidSalt


{-| Read the PBKDF2 iteration count from a parsed PHC string's `i` parameter.
-}
iterationsFromParams : Dict.Dict String String -> Result VerifyPasswordError Int
iterationsFromParams params =
    when Dict.get "i" params is
        Nothing ->
            Err MissingIterations

        Just value ->
            when String.toInt value is
                Nothing ->
                    Err (InvalidIterations value)

                Just iterations ->
                    Ok iterations


{-| Map a PHC identifier back to the digest algorithm it was hashed with. This
is the inverse of the `pbkdf2IdString` mapping inside
[`hashPasswordHelper`](#hashPasswordHelper).
-}
digestAlgorithmFromId : String -> Result VerifyPasswordError Crypto.DigestAlgorithm
digestAlgorithmFromId id =
    when id is
        "pbkdf2-sha256" ->
            Ok Crypto.Sha256

        "pbkdf2-sha384" ->
            Ok Crypto.Sha384

        "pbkdf2-sha512" ->
            Ok Crypto.Sha512

        _ ->
            Err (UnknownDigestAlgorithm id)


{-| Errors that can happen when verifying a user's password with [`verify`](#verify).
-}
type VerifyError
    = NoPasswordForUser
    | VerificationFailed VerifyPasswordError
    | SqlError Sqlite.Error


{-| Verify a `password` for `userId` and, on success, open a fresh session.

Looks up the user's stored (PHC-formatted) password and compares it via
[`verifyPassword`](#verifyPassword). On a match, opens a session and records a
`user_logged_in` event. A wrong password records a `login_failed` event and fails
with `VerificationFailed PasswordMismatch`. No stored password fails with
`NoPasswordForUser`.
-}
verify :
    { userId : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task VerifyError { session : Auth.Simple.Session.Session, token : String }
verify { userId, password } database secureContext =
    Auth.Simple.Method.Password.get userId database
        |> Task.mapError SqlError
        |> Task.andThen
            (\maybeStored ->
                when maybeStored is
                    Nothing ->
                        Task.fail NoPasswordForUser

                    Just stored ->
                        verifyPassword password stored.password secureContext
                            |> Task.mapError VerificationFailed
                            |> Task.onError (recordFailedLogin userId database secureContext)
                            |> Task.andThen
                                (\_ ->
                                    openSession userId database secureContext
                                )
            )


{-| On a password mismatch, record a `login_failed` event, then re-raise the
original verification error. Other verification failures (corrupt stored hash,
etc.) pass through unlogged — they are not failed credentials.
-}
recordFailedLogin : String -> Sqlite.Database -> Crypto.SecureContext -> VerifyError -> Task VerifyError a
recordFailedLogin userId database secureContext verifyError =
    when verifyError is
        VerificationFailed PasswordMismatch ->
            Auth.Simple.AuthEvent.create
                { userId = Just userId
                , eventType = Auth.Simple.AuthEvent.LoginFailed
                , metadata = Nothing
                }
                database
                secureContext
                |> Task.mapError SqlError
                |> Task.andThen (\_ -> Task.fail verifyError)

        _ ->
            Task.fail verifyError


{-| Open a session for a verified user and record a `user_logged_in` event,
returning `{ session, token }` (see [`Auth.Simple.Session.create`](Auth.Simple.Session)).

Both writes run in one [`Sqlite.inTransaction`](Sqlite#inTransaction): they land
together or roll back together, so a session never exists without its
`user_logged_in` record. The session lasts 30 days, matching [`create`](#create).
-}
openSession : String -> Sqlite.Database -> Crypto.SecureContext -> Task VerifyError { session : Auth.Simple.Session.Session, token : String }
openSession userId database secureContext =
    let
        sessionLifetimeMillis : Int
        sessionLifetimeMillis =
            30 * 24 * 60 * 60 * 1000
    in
    Time.now
        |> Task.andThen
            (\now ->
                Sqlite.inTransaction database
                    (Auth.Simple.Session.create
                        { userId = userId
                        , expiresAt = Time.posixToMillis now + sessionLifetimeMillis
                        }
                        database
                        secureContext
                        |> Task.andThen
                            (\created ->
                                Auth.Simple.AuthEvent.create
                                    { userId = Just userId
                                    , eventType = Auth.Simple.AuthEvent.UserLoggedIn
                                    , metadata = Nothing
                                    }
                                    database
                                    secureContext
                                    |> Task.map (\_ -> created)
                            )
                    )
                    |> Task.mapError SqlError
            )


{-| The single failure a username login surfaces to a caller, plus genuine
database faults.

`InvalidCredentials` deliberately collapses every credential-level failure —
unknown username, no password on file, and wrong password — into one
indistinguishable result. Telling them apart would let an attacker enumerate
which usernames exist. `LoginDatabaseError` is reserved for real infrastructure
failures, which are not a statement about the credentials.
-}
type LoginError
    = InvalidCredentials
    | LoginDatabaseError Sqlite.Error


{-| Log in with a `username` and `password`, opening a session on success.

This is the entry point a login form maps onto: it resolves the `username` to its
`userId` via [`Auth.Simple.Identifier.Username.getByUsername`](Auth.Simple.Identifier.Username),
then defers to [`verify`](#verify). Identity lives on `userId`, so `verify` stays
identifier-agnostic and this function is the thin resolution layer on top.

Every credential-level failure returns `InvalidCredentials`. When the username is
unknown we still run a throwaway password hash before failing, so the unknown-user
path costs the same as the wrong-password path and the two can't be told apart by
timing.
-}
login :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task LoginError { session : Auth.Simple.Session.Session, token : String }
login { username, password } database secureContext =
    Auth.Simple.Identifier.Username.getByUsername username database
        |> Task.mapError LoginDatabaseError
        |> Task.andThen
            (\maybeUsername ->
                when maybeUsername is
                    Nothing ->
                        -- Burn an equivalent password hash so a missing username
                        -- is indistinguishable, by timing, from a wrong password.
                        hashPassword password secureContext
                            |> Task.map (\_ -> {})
                            |> Task.onError (\_ -> Task.succeed {})
                            |> Task.andThen (\_ -> Task.fail InvalidCredentials)

                    Just usernameRow ->
                        verify
                            { userId = usernameRow.userId
                            , password = password
                            }
                            database
                            secureContext
                            |> Task.mapError loginErrorFromVerifyError
            )


{-| Map a [`VerifyError`](#VerifyError) onto a [`LoginError`](#LoginError),
folding every credential-level failure into `InvalidCredentials` and passing only
genuine database faults through as `LoginDatabaseError`.
-}
loginErrorFromVerifyError : VerifyError -> LoginError
loginErrorFromVerifyError verifyError =
    when verifyError is
        SqlError sqlError ->
            LoginDatabaseError sqlError

        NoPasswordForUser ->
            InvalidCredentials

        VerificationFailed _ ->
            InvalidCredentials


{-| Errors that can happen when creating a user with
[`create`](#create).
-}
type CreateError
    = HashError HashPasswordError
    | DatabaseError Sqlite.Error


{-| Everything needed to persist a new user across the package's tables: the
generated identifiers, the hashed password, and the timestamp shared by every
inserted row.
-}
type alias NewUser =
    { userId : String
    , usernameRowId : String
    , eventId : String
    , username : String
    , phcPassword : String
    , createdAt : Int
    }


{-| Create a user with a username and password and save it to the database,
returning the new user's `userId`.

`password` is a plain-text password. This function handles properly hashing
it before saving to the database.

A single transaction inserts the new user (`users`), their username
(`usernames`), and their hashed password (`passwords`), and records a
`user_registered` event (`auth_events`). It does **not** open a session:
registration and login are separate steps, so the user must log in via
[`verify`](#verify) to obtain a session token.
-}
create :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task CreateError { userId : String }
create { username, password } database secureContext =
    Task.map
        (\userId usernameRowId eventId now phcPassword ->
            { userId = userId
            , usernameRowId = usernameRowId
            , eventId = eventId
            , username = username
            , phcPassword = phcPassword
            , createdAt = Time.posixToMillis now
            }
        )
        (Crypto.randomUuidV4 secureContext)
        |> Task.andMap (Crypto.randomUuidV4 secureContext)
        |> Task.andMap (Crypto.randomUuidV4 secureContext)
        |> Task.andMap Time.now
        |> Task.andMap (Task.mapError HashError (hashPassword password secureContext))
        |> Task.andThen (persistNewUser database)


{-| Insert every row for a new user inside a single transaction, returning the
created user's `userId` on success. If any insert fails the whole transaction is
rolled back.
-}
persistNewUser : Sqlite.Database -> NewUser -> Task CreateError { userId : String }
persistNewUser database newUser =
    Sqlite.inTransaction database
        (insertUser database newUser
            |> Task.andThen (\_ -> insertUsername database newUser)
            |> Task.andThen (\_ -> insertPassword database newUser)
            |> Task.andThen (\_ -> insertAuthEvent database newUser)
        )
        |> Task.mapError DatabaseError
        |> Task.map (\_ -> { userId = newUser.userId })


{-| Insert the new user's row into the `users` table.
-}
insertUser : Sqlite.Database -> NewUser -> Task Sqlite.Error Sqlite.ExecutionSummary
insertUser database { userId, createdAt } =
    Auth.Simple.User.insert database
        { id = userId
        , createdAt = createdAt
        }


{-| Insert the new user's username into the `usernames` table.
-}
insertUsername : Sqlite.Database -> NewUser -> Task Sqlite.Error Sqlite.ExecutionSummary
insertUsername database { usernameRowId, userId, username, createdAt } =
    Auth.Simple.Identifier.Username.insert database
        { id = usernameRowId
        , userId = userId
        , username = username
        , createdAt = createdAt
        }


{-| Insert the new user's hashed password into the `passwords` table.
-}
insertPassword : Sqlite.Database -> NewUser -> Task Sqlite.Error Sqlite.ExecutionSummary
insertPassword database { userId, phcPassword, createdAt } =
    Auth.Simple.Method.Password.insert database
        { userId = userId
        , password = phcPassword
        , createdAt = createdAt
        , updatedAt = createdAt
        , lastUsed = Nothing
        , failedLoginAttemptsCount = 0
        , lockedUntil = Nothing
        }


{-| Record a `user_registered` event in the `auth_events` table.
-}
insertAuthEvent : Sqlite.Database -> NewUser -> Task Sqlite.Error Sqlite.ExecutionSummary
insertAuthEvent database { eventId, userId, createdAt } =
    Auth.Simple.AuthEvent.insert database
        { id = eventId
        , userId = Just userId
        , eventType = Auth.Simple.AuthEvent.eventTypeToString Auth.Simple.AuthEvent.UserRegistered
        , occurredAt = createdAt
        , metadata = Nothing
        }
