module Auth.Simple exposing ( migrationV1, addUsersTableMigrationSQL )

{-| Exploring the structure of the package...

# Tables

## Base tables

These tables are the tables that are necessary to be created
and exist with a specific schema (minimal schema) for the auth
to work at all.

- `users` - user data, can be augmented after this with more data
- `sessions` - login session; method-agnostic
- `auth_events` - event log for auditing; can be disabled?

## Unknown... TBD

I'm not sure if these tables are method-specific or just part of
the base tables? I could create them and they could just be empty?

- `user_usernames`
- `user_emails`

## Password-specific method

These are only needed if the password auth method is added to the
database.

- `passwords`
- `password_reset_tokens`

# Migrations

@docs migrationV1, addUsersTableMigrationSQL
-}


import Sqlite
import Sqlite.Encode
import Sqlite.Decode
import Task exposing (Task)
import Utils.Sqlite.PragmaTableXInfo


{-| Failure modes when validating the live `users` table shape.
-}
type SchemaCheckError
    = MissingRequiredColumns (Array String)
    | SchemaQueryFailed Sqlite.Error


{-| The migration necessary to support basic authentication.

This should be run prior to any authentication-specific migrations.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.migrationV1` - Add tables necessary for simple auth"
    , statements = 
        [ addUsersTableMigrationSQL
        , addSessionsTableMigrationSql
        , addAuthEventsTableMigrationSql
        ]
    }



--- `users` table


{-| Migration SQL for adding a users table for this package
to interact with.
-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS users (
        id TEXT PRIMARY KEY,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
    );
    """


{-| The columns the `users` table must contain for this package to function.

Consumers can extend the table with additional columns; only these names are
checked for presence.
-}
requiredUsersColumns : Array String
requiredUsersColumns =
    [ "id", "created_at", "updated_at" ]


{-| Confirm the live `users` table has every column this package depends on.

Run as part of application initiation. Succeeds with `{}` when every name in
`requiredUsersColumns` is present in the live table; fails with
`MissingRequiredColumns` carrying the names of the missing columns (in the
order declared by `requiredUsersColumns`).
-}
checkUsersTableSchema : Sqlite.Database -> Task SchemaCheckError {}
checkUsersTableSchema =
    checkTableSchema "users" requiredUsersColumns



--- `sessions` table


{-| Migration SQL for adding a `sessions` table.

`id` is an opaque token chosen by the consumer (random bytes, UUID, etc.).
`revoked_at` is nullable so explicit logout/revocation can mark a row without
deleting it, preserving the `auth_events` audit trail.
-}
addSessionsTableMigrationSql : String
addSessionsTableMigrationSql =
    """
    CREATE TABLE IF NOT EXISTS sessions (
        id TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        expires_at INTEGER NOT NULL,
        last_used_at INTEGER NOT NULL,
        revoked_at INTEGER,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    );
    """


{-| The columns the `sessions` table must contain for this package to function.
-}
requiredSessionsColumns : Array String
requiredSessionsColumns =
    [ "id", "user_id", "created_at", "expires_at", "last_used_at", "revoked_at" ]


{-| Confirm the live `sessions` table has every column this package depends on.
-}
checkSessionsTableSchema : Sqlite.Database -> Task SchemaCheckError {}
checkSessionsTableSchema =
    checkTableSchema "sessions" requiredSessionsColumns



--- `auth_events` table


{-| Migration SQL for adding an `auth_events` audit table.

`user_id` is nullable because failed login attempts may not resolve to a known
user. `ON DELETE SET NULL` preserves audit history when a user is purged.
`metadata` holds a JSON blob for method-specific fields (IP, user-agent, etc.).
-}
addAuthEventsTableMigrationSql : String
addAuthEventsTableMigrationSql =
    """
    CREATE TABLE IF NOT EXISTS auth_events (
        id TEXT PRIMARY KEY,
        user_id TEXT,
        event_type TEXT NOT NULL,
        occurred_at INTEGER NOT NULL,
        metadata TEXT,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL
    );
    """


{-| The columns the `auth_events` table must contain for this package to function.
-}
requiredAuthEventsColumns : Array String
requiredAuthEventsColumns =
    [ "id", "user_id", "event_type", "occurred_at", "metadata" ]


{-| Confirm the live `auth_events` table has every column this package depends on.
-}
checkAuthEventsTableSchema : Sqlite.Database -> Task SchemaCheckError {}
checkAuthEventsTableSchema =
    checkTableSchema "auth_events" requiredAuthEventsColumns



--- Utilities


{-| Shared body for the per-table `check*TableSchema` functions.

Runs `PRAGMA table_info` on `tableName`, then fails with
`MissingRequiredColumns` listing any names from `requiredColumns` that
are absent from the live table (preserving the order given).
-}
checkTableSchema : String -> Array String -> Sqlite.Database -> Task SchemaCheckError {}
checkTableSchema tableName requiredColumns db =
    Utils.Sqlite.PragmaTableXInfo.tableSchemaQuery tableName
        |> Sqlite.getAll db
        |> Task.mapError SchemaQueryFailed
        |> Task.andThen
            (\columns ->
                let
                    presentNames =
                        Array.map .name columns

                    missing =
                        Array.keepIf
                            (\required -> not (Array.member required presentNames))
                            requiredColumns
                in
                if Array.isEmpty missing then
                    Task.succeed {}

                else
                    Task.fail (MissingRequiredColumns missing)
            )
