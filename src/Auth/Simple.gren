module Auth.Simple exposing ( migrationV1, addUsersTableMigrationSQL )

{-| Simple authentication for SQLite databases in Gren.

This module exposes the base-level migrations and SQL required to run the
authentication functionality in the package.

# Migrations

## Migration (v1)

The initial migration that must be run for this package to operate properly
on a given SQLite database.

@docs migrationV1

The `migrationV1` runs these SQL strings. They are exposed here for ease of 
use outside of the `gren-sqlite-migrate` package.

@docs addUsersTableMigrationSQL
-}


import Sqlite
import Sqlite.Encode
import Sqlite.Decode
import Task exposing (Task)
import Utils.Sqlite.PragmaTableXInfo


{-| Failure modes when validating the live `users` table shape.
-}
type SchemaCheckError
    = MissingRequiredColumns (Array String)
    | SchemaQueryFailed Sqlite.Error


{-| The migration necessary to support basic authentication. This assumes 
a `users` table does not already exist. This migration
 
The migration runs the SQL found in `addUsersTableMigrationSQL`. It provides
the minimum schema this package needs to operate.

This migration is structured to be dropped in and used with the 
`gren-sqlite-migrate` package. If you want to migrate through some other method,
the SQL for this package is exposed as the `addUsersTableMigrationSQL` variable.
-}
migrationV1 : { name : String, statements : Array String }
migrationV1 =
    { name = "`Auth.Simple.migrationV1` - Add tables necessary for simple auth"
    , statements =
        [ addUsersTableMigrationSQL
        ]
    }


{-| SQL for adding the bare `users` table to a database:

    CREATE TABLE IF NOT EXISTS users (
        id TEXT PRIMARY KEY,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
    );
-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE IF NOT EXISTS users (
        id TEXT PRIMARY KEY,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
    );
    """
