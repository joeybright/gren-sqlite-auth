module Auth.Simple exposing (..)

{-| Exploring the structure of the package...

# Tables

## Base tables

These tables are the tables that are necessary to be created
and exist with a specific schema (minimal schema) for the auth
to work at all.

- `users` - user data, can be augmented after this with more data
- `sessions` - login session; method-agnostic
- `auth_events` - event log for auditing; can be disabled?

## Unknown... TBD

I'm not sure if these tables are method-specific or just part of
the base tables? I could create them and they could just be empty?

- `user_usernames`
- `user_emails`

## Password-specific method

These are only needed if the password auth method is added to the
database.

- `passwords`
- `password_reset_tokens`
-}
    

import Sqlite
import Sqlite.Encode
import Sqlite.Decode
import Task exposing (Task)
import Utils.Sqlite.PragmaTableXInfo


{-| The migration necessary to support basic authentication.

This should be run prior to any authentication-specific migrations.
-}
migration : Array { name : String, statements : Array String }
migration =
    [ addUsersTableMigration
    , addSessionsTableMigration
    , addAuthEventsTableMigration
    ]



---


{-|-}
addUsersTableMigration : { name : String, statements : Array String }
addUsersTableMigration =
    { name = "Add users table"
    , statements = [ addUsersTableMigrationSQL ]
    }


{-| Migration SQL for adding a users table for this package
to interact with.
-}
addUsersTableMigrationSQL : String
addUsersTableMigrationSQL =
    """
    CREATE TABLE users (
        id TEXT PRIMARY KEY,
        created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
        updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    );
    """


{-| Query the live `users` table schema.

Pair with `Sqlite.getAll` to get an `Array Utils.Sqlite.PragmaTableXInfo.Column`
to compare against the minimum shape required by this package.
-}
getUserTableSchema : Sqlite.Query Utils.Sqlite.PragmaTableXInfo.Column
getUserTableSchema =
    Utils.Sqlite.PragmaTableXInfo.tableSchemaQuery "users"


{-| The columns the `users` table must contain for this package to function.

Consumers can extend the table with additional columns; only these names are
checked for presence.
-}
requiredUsersColumns : Array String
requiredUsersColumns =
    [ "id", "created_at", "updated_at" ]


{-| Failure modes when validating the live `users` table shape.
-}
type SchemaCheckError
    = MissingRequiredColumns (Array String)
    | SchemaQueryFailed Sqlite.Error


{-| Confirm the live `users` table has every column this package depends on.

Run as part of application initiation. Succeeds with `{}` when every name in
`requiredUsersColumns` is present in the live table; fails with
`MissingRequiredColumns` carrying the names of the missing columns (in the
order declared by `requiredUsersColumns`).
-}
checkUsersTableSchema : Sqlite.Database -> Task SchemaCheckError {}
checkUsersTableSchema db =
    Utils.Sqlite.PragmaTableXInfo.tableSchemaQuery "users"
        |> Sqlite.getAll db 
        |> Task.mapError SchemaQueryFailed
        |> Task.andThen
            (\columns ->
                let
                    presentNames =
                        Array.map .name columns

                    missing =
                        Array.keepIf
                            (\required -> not (Array.member required presentNames))
                            requiredUsersColumns
                in
                if Array.isEmpty missing then
                    Task.succeed {}

                else
                    Task.fail (MissingRequiredColumns missing)
            )



---


{-|-}
addSessionsTableMigration : { name : String, statements : Array String }
addSessionsTableMigration =
    { name = "Add sessions table"
    , statements = [ addSessionsTableMigrationSql ]
    }


{-|-}
addSessionsTableMigrationSql : String
addSessionsTableMigrationSql =
    """
    CREATE TABLE IF NOT EXISTS sessions
    """



---


{-|-}
addAuthEventsTableMigration : { name : String, statements : Array String }
addAuthEventsTableMigration =
    { name = "Add auth_events table"
    , statements = [ addSessionsTableMigrationSql ]
    }


{-|-}
addAuthEventsTableMigrationSql : String
addAuthEventsTableMigrationSql =
    """
    CREATE TABLE IF NOT EXISTS auth_events
    """
