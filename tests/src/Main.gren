module Main exposing (main)

{-|-}

import Auth.Simple
import Auth.Simple.UsernamePassword
import Auth.Simple.Identifier.Username
import Auth.Simple.Method.Password
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Init
import Node
import Sqlite
import Sqlite.Migrate
import Test.Runner.Effectful exposing ( test, describe, await )


{-|-}
migrationSmokeTest : FileSystem.Permission -> Sqlite.Migrate.Permissions -> Test.Runner.Effectful.Test
migrationSmokeTest fileSystemPermission migratePermissions =
    describe "Auth.Simple.migration"
        [ await "Open ./test.sqlite"
            (Sqlite.open fileSystemPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "./test.sqlite"))
            (\db ->
                await "Apply Auth.Simple.migration"
                    (Sqlite.Migrate.migrate db migratePermissions Auth.Simple.migration)
                    (\_ ->
                        test "Runs without error"
                            (\_ -> Expect.pass)
                    )
            )
        ]


{-|-}
main : Test.Runner.Effectful.Program a
main =
    Node.defineSimpleProgram
        (\env ->
            Init.await FileSystem.initialize
                (\fileSystemPermission ->
                    await "Get secure context for Crypto functions" Crypto.getSecureContext
                        (\secureContext ->
                            migrationSmokeTest
                                fileSystemPermission
                                { secureContext = secureContext }
                        )
                        |> Test.Runner.Effectful.run env
                )
        )
