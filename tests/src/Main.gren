module Main exposing (main)

{-|-}

import Crypto
import FileSystem
import Init
import Node
import Test.Runner.Effectful exposing ( await, concat )
import Tests.PhcString
import Tests.Register
import Tests.CredentialLogin
import Tests.PasswordChange
import Tests.CodeLogin
import Tests.SqliteAuth


{-|-}
main : Test.Runner.Effectful.Program a
main =
    Node.defineSimpleProgram
        (\env ->
            Init.await FileSystem.initialize
                (\fsPermission ->
                    await "Get secure context for Crypto functions" Crypto.getSecureContext
                        (\secureContext ->
                            concat
                                [ Test.Runner.Effectful.wrap Tests.PhcString.tests
                                , Tests.Register.tests fsPermission secureContext
                                , Tests.CredentialLogin.tests fsPermission secureContext
                                , Tests.PasswordChange.tests fsPermission secureContext
                                , Tests.CodeLogin.tests fsPermission secureContext
                                , Tests.SqliteAuth.tests fsPermission secureContext
                                ]
                        )
                        |> Test.Runner.Effectful.run env
                )
        )
