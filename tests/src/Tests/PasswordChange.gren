module Tests.PasswordChange exposing ( tests )

{-| End-to-end tests for replacing a stored password: a change through
[`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password)
(proving the current password), and a forgotten-password reset through
[`Password.requestReset`](Auth.Simple.Credential.Password) /
[`Password.reset`](Auth.Simple.Credential.Password) (redeeming an emailed
token). Run against the on-disk `tests/test.sqlite`; each run derives a unique
username from a fresh UUID.

@docs tests

-}

import Auth.Simple
import Auth.Simple.Credential.Code as Code
import Auth.Simple.Credential.Password as Password
import Auth.Simple.Identifier.Username as Username
import Auth.Simple.Login as Login
import Auth.Simple.Register as Register
import Auth.Simple.Token.Session as Session
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Migrate
import Task exposing ( Task )
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| The ways setting up a test account can fail: hashing the password, or the
registration writes that [`Auth.Simple.Register.register`](Auth.Simple.Register)
drives.
-}
type SetupError
    = HashError Password.HashPasswordError
    | RegisterError (Register.Error Username.AsIdentifierError)


{-| Hash the password, then register the username + password combo through
[`Auth.Simple.Register.register`](Auth.Simple.Register).
-}
doRegister :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task SetupError { userId : String }
doRegister { username, password } database secureContext =
    Password.hashWithDefaults (Password.fromString password) secureContext
        |> Task.mapError HashError
        |> Task.andThen
            (\hashedPassword ->
                Register.register database secureContext
                    Username.identifier
                    Password.stored
                    { userId = Nothing
                    , value = username
                    , secret = hashedPassword
                    }
                    |> Task.mapError RegisterError
            )


{-| The ways driving [`Password.change`](Auth.Simple.Credential.Password) can
fail in these tests: hashing the new password, or the change itself.
-}
type ChangeError
    = ChangeHashError Password.HashPasswordError
    | ChangeError Password.ChangeError


{-| Hash the new password, then replace the old one through
[`Password.change`](Auth.Simple.Credential.Password), proving the current
password.
-}
doChange :
    { userId : String, current : String, new : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task ChangeError {}
doChange { userId, current, new } database secureContext =
    Password.hashWithDefaults (Password.fromString new) secureContext
        |> Task.mapError ChangeHashError
        |> Task.andThen
            (\hashedNew ->
                Password.change database secureContext
                    Session.token
                    { userId = userId
                    , current = Password.fromString current
                    , new = hashedNew
                    }
                    |> Task.mapError ChangeError
            )


{-| The ways driving [`Password.reset`](Auth.Simple.Credential.Password) can
fail in these tests: hashing the new password, or the redemption itself.
-}
type ResetError
    = ResetHashError Password.HashPasswordError
    | ResetError Password.ResetError


{-| Hash the new password, then redeem a reset token through
[`Password.reset`](Auth.Simple.Credential.Password) — the forgotten-password
flow.
-}
doReset :
    { token : String, new : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task ResetError { userId : String }
doReset { token, new } database secureContext =
    Password.hashWithDefaults (Password.fromString new) secureContext
        |> Task.mapError ResetHashError
        |> Task.andThen
            (\hashedNew ->
                Password.reset database secureContext
                    Session.token
                    { token = token
                    , new = hashedNew
                    }
                    |> Task.mapError ResetError
            )


{-|-}
doLogin :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { identifier : String
    , secret : Password.Password_ Password.PlainText
    }
    -> Task
        (Login.Error Username.AsIdentifierError Password.AsCredentialError Sqlite.Error)
        { session : Session.Session
        , token : String
        }
doLogin database secureContext =
    Login.login database secureContext
        Username.identifier
        Password.credential
        Session.token


{-| Exercise changing a password with and without the right current password,
and resetting a forgotten one with a dedicated reset token: request → redeem →
single-use, with unknown identifiers and garbage tokens rejected. Both change
and reset must revoke the sessions issued before them.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        originalPassword : String
        originalPassword =
            "original password"

        changedPassword : String
        changedPassword =
            "changed password"

        resetPassword : String
        resetPassword =
            "reset password"

        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ Auth.Simple.migrationV1
            , Username.migration.v1
            , Password.migrationV1
            , Session.migration.v1
            , Code.migration.v1
            ]
    in
    await
        "Open the on-disk test database (password change)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test.sqlite"))
        (\database ->
            await
                "Apply migrations (password change)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix (password change)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            let
                                username : String
                                username =
                                    "change-" ++ suffix
                            in
                            await
                                "Register the account to change"
                                (doRegister { username = username, password = originalPassword } database secureContext)
                                (\created ->
                                    await
                                        "Log in before the change"
                                        (doLogin database secureContext { identifier = username, secret = Password.fromString originalPassword })
                                        (\preChange ->
                                            concat
                                                [ awaitError
                                                    "Change the password with a wrong current password"
                                                    (doChange { userId = created.userId, current = "not the password", new = changedPassword } database secureContext)
                                                    (\error ->
                                                        test "a wrong current password fails with InvalidCredentials"
                                                            (\_ -> Expect.equal (ChangeError Password.InvalidCredentials) error)
                                                    )
                                                , await
                                                    "Change the password with the correct current password"
                                                    (doChange { userId = created.userId, current = originalPassword, new = changedPassword } database secureContext)
                                                    (\_ ->
                                                        concat
                                                            [ await
                                                                "Verify the pre-change session"
                                                                (Session.verifyToken { token = preChange.token } database secureContext)
                                                                (\maybeSession ->
                                                                    test "sessions issued before a change no longer verify"
                                                                        (\_ -> Expect.equal Nothing maybeSession)
                                                                )
                                                            , awaitError
                                                                "Log in with the old password"
                                                                (doLogin database secureContext { identifier = username, secret = Password.fromString originalPassword })
                                                                (\error ->
                                                                    test "the old password no longer logs in"
                                                                        (\_ -> Expect.equal Login.InvalidCredentials error)
                                                                )
                                                            , await
                                                                "Log in with the new password"
                                                                (doLogin database secureContext { identifier = username, secret = Password.fromString changedPassword })
                                                                (\postChange ->
                                                                    concat
                                                                        [ test "the new password logs in as the same user"
                                                                            (\_ -> Expect.equal created.userId postChange.session.userId)
                                                                        , await
                                                                            "Request a reset token for an unknown username"
                                                                            (Password.requestReset database secureContext Username.identifier { identifier = "nobody-" ++ suffix })
                                                                            (\maybeDeliverable ->
                                                                                test "an unknown identifier requests Nothing"
                                                                                    (\_ -> Expect.equal Nothing maybeDeliverable)
                                                                            )
                                                                        , awaitError
                                                                            "Redeem a garbage reset token"
                                                                            (doReset { token = "not-a-real-token", new = resetPassword } database secureContext)
                                                                            (\error ->
                                                                                test "a garbage token is rejected with InvalidResetToken"
                                                                                    (\_ -> Expect.equal (ResetError Password.InvalidResetToken) error)
                                                                            )
                                                                        , await
                                                                            "Request a reset token for the account"
                                                                            (Password.requestReset database secureContext Username.identifier { identifier = username })
                                                                            (\maybeDeliverable ->
                                                                                when maybeDeliverable is
                                                                                    Nothing ->
                                                                                        test "requesting a reset token for a known user yields a token"
                                                                                            (\_ -> Expect.fail "expected Just { token }, got Nothing")

                                                                                    Just { token } ->
                                                                                        await
                                                                                            "Redeem the reset token"
                                                                                            (doReset { token = token, new = resetPassword } database secureContext)
                                                                                            (\resetResult ->
                                                                                                concat
                                                                                                    [ test "reset returns the user it reset"
                                                                                                        (\_ -> Expect.equal created.userId resetResult.userId)
                                                                                                    , await
                                                                                                        "Verify the pre-reset session"
                                                                                                        (Session.verifyToken { token = postChange.token } database secureContext)
                                                                                                        (\maybeSession ->
                                                                                                            test "sessions issued before a reset no longer verify"
                                                                                                                (\_ -> Expect.equal Nothing maybeSession)
                                                                                                        )
                                                                                                    , await
                                                                                                        "Log in with the reset password"
                                                                                                        (doLogin database secureContext { identifier = username, secret = Password.fromString resetPassword })
                                                                                                        (\result ->
                                                                                                            test "the reset password logs in as the same user"
                                                                                                                (\_ -> Expect.equal created.userId result.session.userId)
                                                                                                        )
                                                                                                    , awaitError
                                                                                                        "Redeem the same token again"
                                                                                                        (doReset { token = token, new = "another password" } database secureContext)
                                                                                                        (\error ->
                                                                                                            test "a redeemed token is rejected with InvalidResetToken"
                                                                                                                (\_ -> Expect.equal (ResetError Password.InvalidResetToken) error)
                                                                                                        )
                                                                                                    ]
                                                                                            )
                                                                            )
                                                                        ]
                                                                )
                                                            ]
                                                    )
                                                ]
                                        )
                                )
                        )
                )
        )
