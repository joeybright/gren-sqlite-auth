module Tests.PasswordChange exposing ( tests )

{-| End-to-end tests for replacing a stored password through
[`Auth.Simple.Credential.Password.change`](Auth.Simple.Credential.Password):
proving with the current password (a change), and proving with an emailed
one-time code from
[`Auth.Simple.Credential.Code.request`](Auth.Simple.Credential.Code) (a
reset). Run against the on-disk `tests/test.sqlite`; each run derives a unique
username from a fresh UUID.

@docs tests

-}

import Auth.Simple
import Auth.Simple.Credential.Code as Code
import Auth.Simple.Credential.Password as Password
import Auth.Simple.Identifier.Username as Username
import Auth.Simple.Login as Login
import Auth.Simple.Register as Register
import Auth.Simple.Token.Session as Session
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Migrate
import Task exposing ( Task )
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| The ways setting up a test account can fail: hashing the password, or the
registration writes that [`Auth.Simple.Register.register`](Auth.Simple.Register)
drives.
-}
type SetupError
    = HashError Password.HashPasswordError
    | RegisterError (Register.Error Username.AsIdentifierError)


{-| Hash the password, then register the username + password combo through
[`Auth.Simple.Register.register`](Auth.Simple.Register).
-}
doRegister :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task SetupError { userId : String }
doRegister { username, password } database secureContext =
    Password.hashWithDefaults (Password.fromString password) secureContext
        |> Task.mapError HashError
        |> Task.andThen
            (\hashedPassword ->
                Register.register database secureContext
                    Username.identifier
                    Password.stored
                    { userId = Nothing
                    , value = username
                    , secret = hashedPassword
                    }
                    |> Task.mapError RegisterError
            )


{-| The ways driving [`Password.change`](Auth.Simple.Credential.Password) can
fail in these tests: hashing the new password, or the change itself (proof
error type varies with the proof credential).
-}
type ChangeError proofError
    = ChangeHashError Password.HashPasswordError
    | ChangeError (Password.ChangeError proofError)


{-| Hash the new password, then replace the old one through
[`Password.change`](Auth.Simple.Credential.Password), proving with the current
password.
-}
doChange :
    { userId : String, current : String, new : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task (ChangeError Password.AsCredentialError) {}
doChange { userId, current, new } database secureContext =
    Password.hashWithDefaults (Password.fromString new) secureContext
        |> Task.mapError ChangeHashError
        |> Task.andThen
            (\hashedNew ->
                Password.change database secureContext
                    Password.credential
                    { userId = userId
                    , proof = Password.fromString current
                    , new = hashedNew
                    }
                    |> Task.mapError ChangeError
            )


{-| Hash the new password, then replace the old one through
[`Password.change`](Auth.Simple.Credential.Password), proving with a one-time
code — the reset flow.
-}
doReset :
    { userId : String, code : String, new : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task (ChangeError Code.AsCredentialError) {}
doReset { userId, code, new } database secureContext =
    Password.hashWithDefaults (Password.fromString new) secureContext
        |> Task.mapError ChangeHashError
        |> Task.andThen
            (\hashedNew ->
                Password.change database secureContext
                    Code.credential
                    { userId = userId
                    , proof = code
                    , new = hashedNew
                    }
                    |> Task.mapError ChangeError
            )


{-|-}
doLogin :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { identifier : String
    , secret : Password.Password_ Password.PlainText
    }
    -> Task
        (Login.Error Username.AsIdentifierError Password.AsCredentialError Sqlite.Error)
        { session : Session.Session
        , token : String
        }
doLogin database secureContext =
    Login.login database secureContext
        Username.identifier
        Password.credential
        Session.token


{-| Exercise changing a password with and without the right current password,
and resetting it with a one-time code: request → change-with-code → single-use.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        originalPassword : String
        originalPassword =
            "original password"

        changedPassword : String
        changedPassword =
            "changed password"

        resetPassword : String
        resetPassword =
            "reset password"

        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ Auth.Simple.migrationV1
            , Username.migration.v1
            , Password.migrationV1
            , Session.migration.v1
            , Code.migration.v1
            ]
    in
    await
        "Open the on-disk test database (password change)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test.sqlite"))
        (\database ->
            await
                "Apply migrations (password change)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix (password change)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            let
                                username : String
                                username =
                                    "change-" ++ suffix
                            in
                            await
                                "Register the account to change"
                                (doRegister { username = username, password = originalPassword } database secureContext)
                                (\created ->
                                    concat
                                        [ awaitError
                                            "Change the password with a wrong current password"
                                            (doChange { userId = created.userId, current = "not the password", new = changedPassword } database secureContext)
                                            (\error ->
                                                test "a wrong current password fails with InvalidCredentials"
                                                    (\_ -> Expect.equal (ChangeError Password.InvalidCredentials) error)
                                            )
                                        , await
                                            "Change the password with the correct current password"
                                            (doChange { userId = created.userId, current = originalPassword, new = changedPassword } database secureContext)
                                            (\_ ->
                                                concat
                                                    [ awaitError
                                                        "Log in with the old password"
                                                        (doLogin database secureContext { identifier = username, secret = Password.fromString originalPassword })
                                                        (\error ->
                                                            test "the old password no longer logs in"
                                                                (\_ -> Expect.equal Login.InvalidCredentials error)
                                                        )
                                                    , await
                                                        "Log in with the new password"
                                                        (doLogin database secureContext { identifier = username, secret = Password.fromString changedPassword })
                                                        (\result ->
                                                            test "the new password logs in as the same user"
                                                                (\_ -> Expect.equal created.userId result.session.userId)
                                                        )
                                                    , await
                                                        "Request a one-time code for the reset"
                                                        (Code.request database secureContext Username.identifier { identifier = username })
                                                        (\maybeDeliverable ->
                                                            when maybeDeliverable is
                                                                Nothing ->
                                                                    test "requesting a code for a known user yields a code"
                                                                        (\_ -> Expect.fail "expected Just { code }, got Nothing")

                                                                Just { code } ->
                                                                    await
                                                                        "Reset the password with the code"
                                                                        (doReset { userId = created.userId, code = code, new = resetPassword } database secureContext)
                                                                        (\_ ->
                                                                            concat
                                                                                [ await
                                                                                    "Log in with the reset password"
                                                                                    (doLogin database secureContext { identifier = username, secret = Password.fromString resetPassword })
                                                                                    (\result ->
                                                                                        test "the reset password logs in as the same user"
                                                                                            (\_ -> Expect.equal created.userId result.session.userId)
                                                                                    )
                                                                                , awaitError
                                                                                    "Reset again with the consumed code"
                                                                                    (doReset { userId = created.userId, code = code, new = "another password" } database secureContext)
                                                                                    (\error ->
                                                                                        test "a consumed code is rejected with InvalidCredentials"
                                                                                            (\_ -> Expect.equal (ChangeError Password.InvalidCredentials) error)
                                                                                    )
                                                                                ]
                                                                        )
                                                        )
                                                    ]
                                            )
                                        ]
                                )
                        )
                )
        )
