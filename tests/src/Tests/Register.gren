module Tests.Register exposing ( tests )

{-| End-to-end tests for registration through the modular
[`Auth.Simple.Register`](Auth.Simple.Register) workflow, run against the on-disk
`tests/test.sqlite`.

Covers the typed errors around the (already sound) hashing core: a too-short
password is rejected by
[`Password.validateLength`](Auth.Simple.Credential.Password) before any write, a
blank username is rejected as `UsernameBlank`, a repeated username is reported as
`UsernameTaken`, and — because the username identifier normalizes — a
case/whitespace variant of an existing username is *also* `UsernameTaken`. A
clean registration still succeeds. The database persists across runs, so each
run derives unique usernames from a fresh UUID.

@docs tests

-}

import Auth.Simple
import Auth.Simple.Credential.Password as Password
import Auth.Simple.Identifier.Username as Username
import Auth.Simple.Register as Register
import Auth.Simple.Token.Session as Session
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Migrate
import Task exposing ( Task )
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| The ways setting up an account can fail: hashing the password, or the
registration writes that [`Auth.Simple.Register.register`](Auth.Simple.Register)
drives.
-}
type SetupError
    = HashError Password.HashPasswordError
    | RegisterError (Register.Error Username.AsIdentifierError Password.AsCredentialError)


{-| Hash the password, then register the username + password combo through
[`Auth.Simple.Register.register`](Auth.Simple.Register).
-}
doRegister :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task SetupError { userId : String }
doRegister { username, password } database secureContext =
    Password.hashWithDefaults (Password.fromString password) secureContext
        |> Task.mapError HashError
        |> Task.andThen
            (\hashedPassword ->
                Register.register database secureContext
                    Username.identifier
                    Password.credential
                    { userId = Nothing
                    , value = username
                    , secret = hashedPassword
                    }
                    |> Task.mapError RegisterError
            )


{-| Exercise registration's validation, duplicate handling, and case-insensitive
uniqueness against a real database.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        password : String
        password =
            "valid password"

        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ Auth.Simple.migrationV1
            , Username.migration.v1
            , Password.migrationV1
            , Session.migration.v1
            ]
    in
    await
        "Open the on-disk test database (registration)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test.sqlite"))
        (\database ->
            await
                "Apply migrations (registration)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix (registration)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            concat
                                [ -- Validation: too-short password, rejected before any hashing or write.
                                  test "a password under the minimum is rejected by validateLength"
                                    (\_ ->
                                        Expect.equal
                                            (Err { minimum = 8, actual = 7 })
                                            (Password.validateLength (Password.fromString "1234567"))
                                    )

                                , -- Validation: a password at the minimum passes.
                                  test "a password at the minimum passes validateLength"
                                    (\_ ->
                                        Expect.equal
                                            (Ok (Password.fromString "12345678"))
                                            (Password.validateLength (Password.fromString "12345678"))
                                    )

                                , -- Validation: blank (whitespace-only) username.
                                  awaitError
                                    "Register with a whitespace-only username"
                                    (doRegister { username = "   ", password = password } database secureContext)
                                    (\error ->
                                        test "a blank username is rejected with UsernameBlank"
                                            (\_ -> Expect.equal (RegisterError (Register.IdentifierError Username.UsernameBlank)) error)
                                    )

                                , -- Happy path, then an exact-duplicate registration.
                                  await
                                    "Register a fresh user"
                                    (doRegister { username = "dup-" ++ suffix, password = password } database secureContext)
                                    (\created ->
                                        concat
                                            [ test "a clean registration returns a non-empty userId"
                                                (\_ -> Expect.notEqual "" created.userId)
                                            , awaitError
                                                "Register the same username again"
                                                (doRegister { username = "dup-" ++ suffix, password = password } database secureContext)
                                                (\error ->
                                                    test "a duplicate username is rejected with UsernameTaken"
                                                        (\_ -> Expect.equal (RegisterError (Register.IdentifierError Username.UsernameTaken)) error)
                                                )
                                            ]
                                    )

                                , -- Case-insensitive uniqueness: a mixed-case original then a
                                  -- lower-case, whitespace-padded variant collide as one account.
                                  await
                                    "Register a mixed-case username"
                                    (doRegister { username = "CaseTest-" ++ suffix, password = password } database secureContext)
                                    (\_ ->
                                        awaitError
                                            "Register a case/whitespace variant of it"
                                            (doRegister { username = "  casetest-" ++ suffix ++ "  ", password = password } database secureContext)
                                            (\error ->
                                                test "a case/whitespace variant is rejected with UsernameTaken"
                                                    (\_ -> Expect.equal (RegisterError (Register.IdentifierError Username.UsernameTaken)) error)
                                            )
                                    )
                                ]
                        )
                )
        )
