module Tests.SqliteAuth exposing ( tests )

{-| End-to-end tests of the `Sqlite.Auth` pipeline, run against the on-disk
`tests/test-sqlite-auth.sqlite`.

This suite covers only *cross-module* behavior — the journeys and side effects no
single-module suite can see. Each module's own behavior (token hashing at rest,
`Session.verify`/`revoke`, username resolution, password validate outcomes,
username rename resolution) lives in `Tests.Sqlite.Auth.{User,Username,Password,
Session}`; the assertions that duplicated those have been removed.

What remains is integration:

  - registration drives all four steps (user, username, password, session) and
    asserts the issued session belongs to the created user — the `validate → issue`
    witness handoff;
  - login as an existing user resolves a typed username and issues a session, and
    an unknown username is rejected exactly like a wrong password;
  - a taken username rolls the whole registration transaction back, leaving no
    orphaned user row and the username with its original owner;
  - `Password.change` and `Password.reset` revoke the user's existing sessions,
    the reset auto-logs-in from the redeemed token and the token is single-use,
    and a reset for an unknown username mints nothing;
  - a rename then logs in by the new username with the unchanged password;
  - the email-OTP `Email.user → Otp.request → Otp.verify → Session.issue` journey
    hands the minted `Verified` witness straight into session issue for the right user.

The database file persists across runs, so each run derives a unique username
from a fresh UUID. Session idle expiry is not covered — it is unobservable
without injecting a clock.

@docs tests

-}

import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Auth.Email as Email
import Sqlite.Auth.Internal as Internal
import Sqlite.Auth.Otp as Otp
import Sqlite.Auth.Password as Password
import Sqlite.Auth.Session as Session
import Sqlite.Auth.User as User
import Sqlite.Auth.Username as Username
import Sqlite.Decode
import Sqlite.Migrate
import Task exposing ( Task )
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )
import Tests.Sqlite.Auth.Helpers exposing (hashed)


{-| The ways the combined pipelines can fail: hashing the new password, a
database fault on any write, a real fault while validating, a validation
that didn't verify, or a username that normalizes to nothing. `NotVerified`
covers unknown username and wrong password alike — `Password.validate`
deliberately answers `Rejected` to both.
-}
type Error
    = HashError Password.HashError
    | StorageError Sqlite.Error
    | ValidateError Password.ValidateError
    | NotVerified
    | ResetFailed Password.ResetError
    | InvalidUsername


{-| Normalize a raw username string — the shape every `Sqlite.Auth.Username`
entry point demands — failing the pipeline on a name that normalizes to
nothing.
-}
normalized : String -> Task Error (Username.Username Username.Normalized)
normalized string =
    when Username.normalize (Username.fromString string) is
        Just username ->
            Task.succeed username

        Nothing ->
            Task.fail InvalidUsername


{-| Resolve who owns a raw username string: normalize it and look it up with
`Username.user`.
-}
resolve : Sqlite.Database -> String -> Task Error (Maybe Internal.User)
resolve database string =
    normalized string
        |> Task.andThen
            (\username ->
                Username.user database { username = username }
                    |> Task.mapError StorageError
            )


{-| Count the rows in `users` — used to prove a failed registration rolls its
user insert back.
-}
countUsers : Sqlite.Database -> Task Sqlite.Error Int
countUsers database =
    Sqlite.getOne database
        { query =
            """
            SELECT COUNT(*) AS user_count FROM users
            """
        , parameters = []
        , rowDecoder =
            Sqlite.Decode.int "user_count"
                (\count -> Sqlite.Decode.succeed count)
        }


{-| The README sketch's pipeline: hash the password, create the user and
attach the username and password inside one transaction (a taken username
must roll back the user insert), then validate the candidate and issue a
session for the minted witness.
-}
register :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { username : String, password : String }
    -> Task Error { user : Internal.User, session : Session.Session, token : String }
register database secureContext { username, password } =
    Task.map2
        (\hashedPassword username_ -> { hashedPassword = hashedPassword, username = username_ })
        (hashed secureContext password
            |> Task.mapError HashError
        )
        (normalized username)
        |> Task.andThen
            (\new ->
                Sqlite.inTransaction database
                    (User.new database secureContext
                        |> Task.andThen (Username.new database { username = new.username })
                        |> Task.andThen (Password.add database new.hashedPassword)
                    )
                    |> Task.mapError StorageError
            )
        |> Task.andThen
            (\user ->
                validateAndIssue database secureContext { password = password } (Just user)
                    |> Task.map
                        (\issued ->
                            { user = user
                            , session = issued.session
                            , token = issued.token
                            }
                        )
            )


{-| Log in an existing user from nothing but their typed credentials: resolve
the username with `Username.user` and pipe the whole `Maybe` into the
validate-and-issue tail — an unknown username burns a hash round inside
`Password.validate` and is rejected exactly like a wrong password.
-}
login :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { username : String, password : String }
    -> Task Error { session : Session.Session, token : String }
login database secureContext { username, password } =
    resolve database username
        |> Task.andThen (validateAndIssue database secureContext { password = password })


{-| Change an account's password the real way: resolve the username, prove the
current password to mint the `Verified` witness, and hand it to
`Password.change` with the new hash.
-}
changePassword :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { username : String, current : String, new : String }
    -> Task Error {}
changePassword database secureContext { username, current, new } =
    Task.map2
        (\hashedNew maybeUser -> { hashedNew = hashedNew, maybeUser = maybeUser })
        (hashed secureContext new
            |> Task.mapError HashError
        )
        (resolve database username)
        |> Task.andThen
            (\{ hashedNew, maybeUser } ->
                Password.validate database secureContext Password.defaultOptions (Password.fromString current) maybeUser
                    |> Task.mapError ValidateError
                    |> Task.andThen
                        (\outcome ->
                            when outcome is
                                Password.Verified proof ->
                                    Password.change database hashedNew proof
                                        |> Task.mapError StorageError
                                        |> Task.map (\_ -> {})

                                Password.Rejected ->
                                    Task.fail NotVerified

                                Password.Locked ->
                                    Task.fail NotVerified
                        )
            )


{-| Rename an account's username the real way: prove the password to mint the
`Verified` witness, then hand it to `Username.change`.
-}
renameUsername :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { from : String, to : String, password : String }
    -> Task Error {}
renameUsername database secureContext { from, to, password } =
    normalized to
        |> Task.andThen
            (\toName ->
                resolve database from
                    |> Task.andThen
                        (\maybeUser ->
                            Password.validate database secureContext Password.defaultOptions (Password.fromString password) maybeUser
                                |> Task.mapError ValidateError
                        )
                    |> Task.andThen
                        (\outcome ->
                            when outcome is
                                Password.Verified proof ->
                                    Username.change database
                                        { newUsername = toName }
                                        proof
                                        |> Task.mapError StorageError
                                        |> Task.map (\_ -> {})

                                Password.Rejected ->
                                    Task.fail NotVerified

                                Password.Locked ->
                                    Task.fail NotVerified
                        )
            )


{-| Phase one of the forgotten-password flow: resolve the username and, when
someone owns it, mint a reset token — the raw token to embed in an emailed
link. A username nobody owns yields `Nothing`, and nothing is minted.
-}
requestResetFor :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { username : String }
    -> Task Error (Maybe { token : String })
requestResetFor database secureContext { username } =
    resolve database username
        |> Task.andThen
            (\maybeUser ->
                when maybeUser is
                    Nothing ->
                        Task.succeed Nothing

                    Just user ->
                        Password.requestReset database secureContext Password.defaultOptions user
                            |> Task.mapError StorageError
                            |> Task.map Just
            )


{-| Phase two of the forgotten-password flow: hash the new password, redeem
the token, and issue a session from the minted `Verified` witness — the
auto-login a reset link lands on.
-}
redeemReset :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { token : String, new : String }
    -> Task Error { session : Session.Session, token : String }
redeemReset database secureContext input =
    hashed secureContext input.new
        |> Task.mapError HashError
        |> Task.andThen
            (\hashedNew ->
                Password.reset database secureContext { token = input.token, new = hashedNew }
                    |> Task.mapError ResetFailed
            )
        |> Task.andThen
            (Session.issue database secureContext Session.defaultOptions
                >> Task.mapError StorageError
            )


{-| The shared tail of both pipelines: validate the candidate password against
the (maybe-resolved) user's stored hash and, on the `Verified` outcome, issue
a session for the minted witness.
-}
validateAndIssue :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { password : String }
    -> Maybe Internal.User
    -> Task Error { session : Session.Session, token : String }
validateAndIssue database secureContext { password } maybeUser =
    Password.validate database secureContext Password.defaultOptions (Password.fromString password) maybeUser
        |> Task.mapError ValidateError
        |> Task.andThen
            (\outcome ->
                when outcome is
                    Password.Verified proof ->
                        Session.issue database secureContext Session.defaultOptions proof
                            |> Task.mapError StorageError

                    Password.Rejected ->
                        Task.fail NotVerified

                    Password.Locked ->
                        Task.fail NotVerified
            )


{-| Open the database, migrate, and run every `Sqlite.Auth` flow:
registration + login, logout, password change, password reset, and username
rename — each on its own account derived from a fresh UUID suffix.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ User.migrationV1
            , Username.migrationV1
            , Email.migrationV1
            , Password.migrationV1
            , Session.migrationV1
            , Otp.migrationV1
            ]
    in
    await
        "Open the on-disk test database (Sqlite.Auth)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test-sqlite-auth.sqlite"))
        (\database ->
            await
                "Apply migrations (Sqlite.Auth)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix (Sqlite.Auth)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            concat
                                [ registrationAndLoginTests database secureContext suffix
                                , duplicateRegistrationTests database secureContext suffix
                                , passwordChangeTests database secureContext suffix
                                , passwordResetTests database secureContext suffix
                                , usernameChangeTests database secureContext suffix
                                , emailOtpTests database secureContext suffix
                                ]
                        )
                )
        )


{-| The original end-to-end pipeline: register an account, assert the issued
session is real and hashed at rest, then log the same account in as an
existing user — including the rejected and unknown-username paths.
-}
registrationAndLoginTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
registrationAndLoginTests database secureContext suffix =
    await
        "Create a user with a username and password, then issue a session"
        (register database
            secureContext
            { username = "pipeline-" ++ suffix
            , password = "example password"
            }
        )
        (\result ->
            concat
                [ test "the issued session belongs to the user the pipeline created"
                    (\_ -> Expect.equal (User.id result.user) result.session.userId)
                , test "issue returns a non-empty raw token"
                    (\_ -> Expect.notEqual "" result.token)
                , await
                    "Log the existing user in by typed username and password"
                    (login database
                        secureContext
                        { username = "Pipeline-" ++ suffix
                        , password = "example password"
                        }
                    )
                    (\loggedIn ->
                        test "logging in by username issues a session for the registered user"
                            (\_ -> Expect.equal (User.id result.user) loggedIn.session.userId)
                    )
                , awaitError
                    "Log in with a username nobody owns"
                    (login database
                        secureContext
                        { username = "nobody-" ++ suffix
                        , password = "example password"
                        }
                    )
                    (\error ->
                        test "an unknown username is rejected exactly like a wrong password"
                            (\_ -> Expect.equal NotVerified error)
                    )
                ]
        )


{-| Registering a taken username must fail without side effects: the
registration runs in one transaction, so the duplicate attempt's user insert
rolls back and the username keeps its original owner.
-}
duplicateRegistrationTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
duplicateRegistrationTests database secureContext suffix =
    let
        username : String
        username =
            "dupe-" ++ suffix
    in
    await
        "Register an account"
        (register database secureContext { username = username, password = "example password" })
        (\created ->
            await
                "Count users before the duplicate attempt"
                (countUsers database)
                (\countBefore ->
                    awaitError
                        "Register the same username again"
                        (register database secureContext { username = username, password = "other password" })
                        (\_ ->
                            concat
                                [ await
                                    "Count users after the failed attempt"
                                    (countUsers database)
                                    (\countAfter ->
                                        test "a failed registration leaves no orphaned user row"
                                            (\_ -> Expect.equal countBefore countAfter)
                                    )
                                , await
                                    "Resolve the contested username"
                                    (resolve database username)
                                    (\maybeUser ->
                                        test "the username still belongs to its original owner"
                                            (\_ -> Expect.equal (Just (User.id created.user)) (Maybe.map User.id maybeUser))
                                    )
                                ]
                        )
                )
        )


{-| Change a password by proving the current one, then assert the cross-module
side effects: existing sessions are revoked, and the new password logs in.
-}
passwordChangeTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
passwordChangeTests database secureContext suffix =
    let
        username : String
        username =
            "change-" ++ suffix
    in
    await
        "Register an account and change its password"
        (register database secureContext { username = username, password = "old password" }
            |> Task.andThen
                (\created ->
                    changePassword database
                        secureContext
                        { username = username
                        , current = "old password"
                        , new = "new password"
                        }
                        |> Task.map (\_ -> created)
                )
        )
        (\created ->
            concat
                [ awaitError
                    "Verify the pre-change session"
                    (Session.verify database secureContext Session.defaultOptions { token = created.token })
                    (\error ->
                        test "a password change revokes existing sessions"
                            (\_ -> Expect.equal Session.Revoked error)
                    )
                , await
                    "Log in with the new password"
                    (login database secureContext { username = username, password = "new password" })
                    (\loggedIn ->
                        test "the new password logs in as the same user"
                            (\_ -> Expect.equal (User.id created.user) loggedIn.session.userId)
                    )
                ]
        )


{-| The forgotten-password flow end to end: request a reset token, redeem it
for a fresh session (auto-login), and assert the side effects — sessions
revoked, old password dead, token single-use, unknown usernames mint nothing.
-}
passwordResetTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
passwordResetTests database secureContext suffix =
    let
        username : String
        username =
            "reset-" ++ suffix
    in
    concat
        [ await
            "Request a reset for a username nobody owns"
            (requestResetFor database secureContext { username = "ghost-" ++ suffix })
            (\maybeToken ->
                test "an unknown username mints no reset token"
                    (\_ -> Expect.equal Nothing (Maybe.map .token maybeToken))
            )
        , await
            "Register an account and request a password reset"
            (register database secureContext { username = username, password = "old password" }
                |> Task.andThen
                    (\created ->
                        requestResetFor database secureContext { username = username }
                            |> Task.map (\maybeToken -> { created = created, maybeToken = maybeToken })
                    )
            )
            (\{ created, maybeToken } ->
                when maybeToken is
                    Nothing ->
                        test "requesting a reset for a known username mints a token"
                            (\_ -> Expect.fail "no reset token was minted")

                    Just resetToken ->
                        await
                            "Redeem the reset token"
                            (redeemReset database secureContext { token = resetToken.token, new = "reset password" })
                            (\loggedIn ->
                                concat
                                    [ test "redeeming the reset logs the user straight in"
                                        (\_ -> Expect.equal (User.id created.user) loggedIn.session.userId)
                                    , awaitError
                                        "Verify the pre-reset session"
                                        (Session.verify database secureContext Session.defaultOptions { token = created.token })
                                        (\error ->
                                            test "a reset revokes existing sessions"
                                                (\_ -> Expect.equal Session.TokenNotFound error)
                                        )
                                    , awaitError
                                        "Redeem the same token again"
                                        (redeemReset database secureContext { token = resetToken.token, new = "another password" })
                                        (\error ->
                                            test "a reset token is single-use"
                                                (\_ -> Expect.equal (ResetFailed Password.InvalidResetToken) error)
                                        )
                                    ]
                            )
            )
        ]


{-| Rename a username by proving the password, then log in by the new name with
the unchanged password — the rename-then-login journey across `Username`,
`Password`, and `Session`.
-}
usernameChangeTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
usernameChangeTests database secureContext suffix =
    let
        oldName : String
        oldName =
            "rename-" ++ suffix

        newName : String
        newName =
            "renamed-" ++ suffix
    in
    await
        "Register an account and rename its username"
        (register database secureContext { username = oldName, password = "example password" }
            |> Task.andThen
                (\created ->
                    renameUsername database
                        secureContext
                        { from = oldName
                        , to = newName
                        , password = "example password"
                        }
                        |> Task.map (\_ -> created)
                )
        )
        (\created ->
            await
                "Log in with the new username"
                (login database secureContext { username = newName, password = "example password" })
                (\loggedIn ->
                    test "the renamed account logs in with its existing password"
                        (\_ -> Expect.equal (User.id created.user) loggedIn.session.userId)
                )
        )


{-| The end-to-end email-OTP journey: register an account with an attached
email, request a one-time code, verify it, and issue a session from the minted
`Verified` witness — the `Email.user → Otp.request → Otp.verify → Session.issue`
handoff no single-module suite can see. The module-level guarantees (unknown-
email rejection, lockout, throttle) are pinned in `Tests.Sqlite.Auth.Otp`.
-}
emailOtpTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
emailOtpTests database secureContext suffix =
    let
        rawEmail : String
        rawEmail =
            "otp-" ++ suffix ++ "@example.com"

        noThrottle : Otp.Options
        noThrottle =
            { Otp.defaultOptions | issueThrottleMillis = 0 }

        lockOptions : Otp.Options
        lockOptions =
            { Otp.defaultOptions
            | issueThrottleMillis = 0
            , maxFailedAttempts = 1
            }
    in
    await
        "Register an account and attach an email"
        (User.new database secureContext
            |> Task.mapError StorageError
            |> Task.andThen
                (\user ->
                    when Email.normalize (Email.fromString rawEmail) is
                        Just email ->
                            Email.new database { email = email } user
                                |> Task.mapError StorageError
                                |> Task.map (\_ -> user)

                        Nothing ->
                            Task.fail InvalidUsername
                )
        )
        (\user ->
            await
                "Request a one-time passcode"
                (Otp.request database secureContext noThrottle user)
                (\requestOutcome ->
                    when requestOutcome is
                        Otp.Issued { code } ->
                            await
                                "Verify the passcode and issue a session"
                                (Otp.verify database secureContext noThrottle (Just user) { code = code }
                                    |> Task.mapError
                                        (\e ->
                                            when e is
                                                Otp.StorageError err -> StorageError err
                                        )
                                    |> Task.andThen
                                        (\outcome ->
                                            when outcome is
                                                Otp.Verified proof ->
                                                    Session.issue database secureContext Session.defaultOptions proof
                                                        |> Task.mapError StorageError

                                                Otp.Rejected ->
                                                    Task.fail NotVerified

                                                Otp.Locked ->
                                                    Task.fail NotVerified
                                        )
                                )
                                (\issued ->
                                    test "a verified OTP issues a session for the right user"
                                        (\_ -> Expect.equal (User.id user) issued.session.userId)
                                )

                        _ ->
                            test "request returned a non-Issued outcome"
                                (\_ -> Expect.fail "expected Otp.Issued")
                )
        )
