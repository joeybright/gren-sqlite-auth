module Tests.PhcString exposing (tests)

{-| Tests for `Sqlite.Auth.Password.PhcString`.
-}

import Sqlite.Auth.Password.PhcString
import Base64.Decode
import Base64.Encode
import Bytes exposing (Bytes)
import Bytes.Encode
import Crypto
import Dict
import Expect
import Fuzz exposing (Fuzzer)
import String
import Test exposing (Test, describe, fuzzWith, noDistribution, test)
import Test.Runner.Effectful
import Math


{-|-}
tests : Test
tests =
    describe "Sqlite.Auth.Password.PhcString tests"
        [ test "Returns `EmptyInput` on empty input"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.parse ""
                        |> Expect.equal (Err Sqlite.Auth.Password.PhcString.EmptyInput)
                )
        , describe "Examples in PHC string format docs"
            -- Source: https://github.com/P-H-C/phc-string-format/blob/master/phc-sf-spec.md
            [ test "Parses the Argon2id example in docs exactly"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.parse "$argon2id$v=19$m=65536,t=2,p=1$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno"
                        |> Expect.equal
                            (Ok
                                { id = "argon2id"
                                , params =
                                    Dict.empty
                                        |> Dict.set "v" "19"
                                        |> Dict.set "m" "65536"
                                        |> Dict.set "t" "2"
                                        |> Dict.set "p" "1"
                                , tail =
                                    Sqlite.Auth.Password.PhcString.SaltAndHash
                                        { salt = "gZiV/M1gPc22ElAH/Jh1Hw=="
                                        , hash = "CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno="
                                        }
                                }
                            )
                )
            , test "`toString` emits params in Dict order after parsing and turning back into a `String`"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.parse "$argon2id$v=19$m=65536,t=2,p=1$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno"
                        |> Result.map Sqlite.Auth.Password.PhcString.toString
                        |> Expect.equal
                            (Ok "$argon2id$v=19$m=65536,p=1,t=2$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno")
                )
            ]
        , test "Treats unpadded base64 with embedded '=' as a key-value pair"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$YWJjZA==$abcd"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.singleton "YWJjZA" "="
                            , tail = Sqlite.Auth.Password.PhcString.SaltOnly "abcd"
                            }
                        )
            )
        , test "Treats extra '$' inside hash as part of the hash"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$v=19$broken$realsalt$realhash"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.singleton "v" "19"
                            , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "broken==", hash = "realsalt$realhash" }
                            }
                        )
            )
        , test "Preserves trailing '$' as part of the hash"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$gZiV$abcd$"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "gZiV", hash = "abcd$" }
                            }
                        )
            )
        , test "Preserves trailing '=' as part of the hash"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$gZiV$abcd="
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "gZiV", hash = "abcd=" }
                            }
                        )
            )
        , test "Parses lone '$' as empty id with NoTail"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$"
                    |> Expect.equal
                        (Ok { id = "", params = Dict.empty, tail = Sqlite.Auth.Password.PhcString.NoTail })
            )
        , test "Parses '$$' as empty id with empty SaltOnly"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$$"
                    |> Expect.equal
                        (Ok { id = "", params = Dict.empty, tail = Sqlite.Auth.Password.PhcString.SaltOnly "" })
            )
        , test "Parses '$argon2id$' as id with empty SaltOnly"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$"
                    |> Expect.equal
                        (Ok { id = "argon2id", params = Dict.empty, tail = Sqlite.Auth.Password.PhcString.SaltOnly "" })
            )
        , test "Parses '$argon2id$$' as id with empty SaltAndHash"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$$"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "", hash = "" }
                            }
                        )
            )
        , test "Splits a kv pair on the first '=' only"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$argon2id$name=a=b$salt$hash"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.singleton "name" "a=b"
                            , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "salt", hash = "hash" }
                            }
                        )
            )
        , describe "`toString` function tests"
            [ test "Emits id-only string for empty params and NoTail"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.toString
                        { id = "argon2id", params = Dict.empty, tail = Sqlite.Auth.Password.PhcString.NoTail }
                        |> Expect.equal "$argon2id"
                )
            , test "Emits version segment when only 'v' is present"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.toString
                        { id = "argon2id"
                        , params = Dict.singleton "v" "19"
                        , tail = Sqlite.Auth.Password.PhcString.NoTail
                        }
                        |> Expect.equal "$argon2id$v=19"
                )
            , test "Emits version before other params"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.toString
                        { id = "argon2id"
                        , params =
                            Dict.empty
                                |> Dict.set "v" "19"
                                |> Dict.set "m" "65536"
                        , tail = Sqlite.Auth.Password.PhcString.NoTail
                        }
                        |> Expect.equal "$argon2id$v=19$m=65536"
                )
            , test "Emits SaltOnly with a single trailing segment"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.toString
                        { id = "argon2id", params = Dict.empty, tail = Sqlite.Auth.Password.PhcString.SaltOnly "gZiV" }
                        |> Expect.equal "$argon2id$gZiV"
                )
            , test "Emits SaltAndHash with two trailing segments"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.toString
                        { id = "argon2id"
                        , params = Dict.empty
                        , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "gZiV", hash = "CWOr" }
                        }
                        |> Expect.equal "$argon2id$gZiV$CWOr"
                )
            , test "Strips trailing '=' padding from salt and hash"
                (\_ ->
                    Sqlite.Auth.Password.PhcString.toString
                        { id = "argon2id"
                        , params = Dict.empty
                        , tail = Sqlite.Auth.Password.PhcString.SaltAndHash { salt = "gZiV==", hash = "CWOr=" }
                        }
                        |> Expect.equal "$argon2id$gZiV$CWOr"
                )
            ]
        , test "returns MissingLeadingDollar when the '$' prefix is absent"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "argon2id"
                    |> Expect.equal (Err Sqlite.Auth.Password.PhcString.MissingLeadingDollar)
            )
        , test "returns KvPairMissingEquals for a comma chunk without '='"
            (\_ ->
                Sqlite.Auth.Password.PhcString.parse "$id$m=65536,bad"
                    |> Expect.equal (Err (Sqlite.Auth.Password.PhcString.KvPairMissingEquals "bad"))
            )
        , fuzzWith { runs = 200, distribution = noDistribution }
            phcFuzzer
            "toString >> parse round-trips any well-formed PhcString"
            (\phc ->
                Sqlite.Auth.Password.PhcString.toString phc
                    |> Sqlite.Auth.Password.PhcString.parse
                    |> Expect.equal (Ok { phc | tail = padTail phc.tail })
            )
        ]


{-| A fuzzer for well-formed `PhcString` records: segments drawn from
alphabets the format round-trips losslessly (no `$`, `=`, or `,` in the wrong
places, no trailing base64 padding).
-}
phcFuzzer : Fuzzer Sqlite.Auth.Password.PhcString.PhcString
phcFuzzer =
    Fuzz.map3
        (\id params tail -> { id = id, params = params, tail = tail })
        (stringFrom "abcdefghijklmnopqrstuvwxyz0123456789-" 1 10)
        paramsFuzzer
        tailFuzzer


{-| A fuzzer for the params dict, drawing names from a small alphabet that
includes `v` so the version-hoisting path in `toString` gets exercised.
-}
paramsFuzzer : Fuzzer (Dict.Dict String String)
paramsFuzzer =
    Fuzz.arrayOfLengthBetween 0 3
        (Fuzz.map2
            (\name value -> 
                { name = name
                , value = value 
                }
            )
            (stringFrom "imtpv" 1 3)
            (stringFrom "0123456789" 0 4)
        )
        |> Fuzz.map 
            (Array.foldl 
                (\{ name, value } -> 
                    Dict.set name value
                )
                Dict.empty
            )


{-| A fuzzer over all three tail shapes, with salt and hash chunks drawn from
the base64 alphabet (never `=`, so `toString` strips nothing).
-}
tailFuzzer : Fuzzer Sqlite.Auth.Password.PhcString.Tail
tailFuzzer =
    Fuzz.oneOf
        [ Fuzz.constant Sqlite.Auth.Password.PhcString.NoTail
        , Fuzz.map Sqlite.Auth.Password.PhcString.SaltOnly base64Chunk
        , Fuzz.map2
            (\salt hash -> 
                Sqlite.Auth.Password.PhcString.SaltAndHash 
                    { salt = salt
                    , hash = hash 
                    }
            )
            base64Chunk
            base64Chunk
        ]


{-| A fuzzer for an unpadded base64 chunk.
-}
base64Chunk : Fuzzer String
base64Chunk =
    stringFrom "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" 0 12


{-| A fuzzer for strings of the given length range drawn from a fixed alphabet.
-}
stringFrom : String -> Int -> Int -> Fuzzer String
stringFrom alphabet minLength maxLength =
    Fuzz.arrayOfLengthBetween minLength maxLength 
        (Fuzz.oneOfValues 
            (String.toArray alphabet)
        )
        |> Fuzz.map String.fromArray


{-| What the parser hands back for a tail `toString` emitted: salt and hash
re-padded to a multiple of four, mirroring the parser's `padBase64`.
-}
padTail : Sqlite.Auth.Password.PhcString.Tail -> Sqlite.Auth.Password.PhcString.Tail
padTail tail =
    when tail is
        Sqlite.Auth.Password.PhcString.NoTail ->
            Sqlite.Auth.Password.PhcString.NoTail

        Sqlite.Auth.Password.PhcString.SaltOnly salt ->
            Sqlite.Auth.Password.PhcString.SaltOnly (pad salt)

        Sqlite.Auth.Password.PhcString.SaltAndHash { salt, hash } ->
            Sqlite.Auth.Password.PhcString.SaltAndHash { salt = pad salt, hash = pad hash }


{-| Re-pad an unpadded base64 chunk with trailing `=` to a multiple of four,
the way the parser does before handing chunks back.
-}
pad : String -> String
pad string =
    when Math.remainderBy 4 (String.count string) is
        2 ->
            string ++ "=="

        3 ->
            string ++ "="

        _ ->
            string
