module Tests.PhcString exposing (tests)

{-| Tests for `Auth.Simple.Method.Password.PhcString`.

Three groups:

  - **Positive shapes** — `parse` produces the expected record for
    every supported structural shape. Salt and hash are returned as
    parsed.
  - **Basic failures** — malformed delimiters are rejected with typed
    [`Error`](Auth-Simple-Method-Password-PhcString#Error) values.
  - **Permissive behaviour** — inputs that need semantic validation are
    still transformed into structured data for callers to validate.
-}

import Auth.Simple.Method.Password.PhcString as Phc
import Dict
import Expect
import Test exposing (Test, concat, describe, test)


{-| Pure-test suite for the PHC string parser. Lifted into the
effectful runner from `Main` via `Test.Runner.Effectful.wrap`.
-}
tests : Test
tests =
    concat
        [ positiveShapes
        , roundTrip
        , basicFailures
        , permissiveBehaviour
        ]


{-| Structural shapes covered by the PHC spec, parsed to the expected
record. Salt and hash are not validated or normalized.
-}
positiveShapes : Test
positiveShapes =
    describe "PhcString.parse — positive shapes"
        [ test "parses the canonical Argon2id example"
            (\_ ->
                Phc.parse "$argon2id$v=19$m=65536,t=2,p=1$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params =
                                Dict.empty
                                    |> Dict.set "v" "19"
                                    |> Dict.set "m" "65536"
                                    |> Dict.set "t" "2"
                                    |> Dict.set "p" "1"
                            , tail =
                                Phc.SaltAndHash
                                    { salt = "gZiV/M1gPc22ElAH/Jh1Hw"
                                    , hash = "CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno"
                                    }
                            }
                        )
            )
        , test "parses an id-only string"
            (\_ ->
                Phc.parse "$argon2id"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Phc.NoTail
                            }
                        )
            )
        , test "parses id + version"
            (\_ ->
                Phc.parse "$argon2id$v=19"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.singleton "v" "19"
                            , tail = Phc.NoTail
                            }
                        )
            )
        , test "parses id + comma-separated params"
            (\_ ->
                Phc.parse "$argon2id$m=65536,t=2,p=1"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params =
                                Dict.empty
                                    |> Dict.set "m" "65536"
                                    |> Dict.set "t" "2"
                                    |> Dict.set "p" "1"
                            , tail = Phc.NoTail
                            }
                        )
            )
        , test "parses id + salt that needs no padding (length mod 4 == 0)"
            (\_ ->
                Phc.parse "$argon2id$gZiV"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Phc.SaltOnly "gZiV"
                            }
                        )
            )
        , test "parses id + salt + hash that need no padding"
            (\_ ->
                Phc.parse "$argon2id$gZiV$CWOr"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Phc.SaltAndHash { salt = "gZiV", hash = "CWOr" }
                            }
                        )
            )
        , test "keeps an unpadded salt exactly as parsed"
            (\_ ->
                Phc.parse "$argon2id$gZiV/M1gPc22ElAH/Jh1Hw"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Phc.SaltOnly "gZiV/M1gPc22ElAH/Jh1Hw"
                            }
                        )
            )
        ]


{-| `toString` strips padding so its output is spec-conforming PHC.
The full round-trip `parse → toString → parse` is the cleanest
guarantee.
-}
roundTrip : Test
roundTrip =
    describe "PhcString — round-trip"
        [ test "toString strips trailing '=' from a padded salt"
            (\_ ->
                Phc.toString
                    { id = "argon2id"
                    , params = Dict.empty
                    , tail = Phc.SaltOnly "gZiV/M1gPc22ElAH/Jh1Hw=="
                    }
                    |> Expect.equal "$argon2id$gZiV/M1gPc22ElAH/Jh1Hw"
            )
        , test "parse |> toString on the canonical Argon2id sample produces a spec-conforming PHC string (params reordered alphabetically)"
            (\_ ->
                Phc.parse "$argon2id$v=19$m=65536,t=2,p=1$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno"
                    |> Result.map Phc.toString
                    |> Expect.equal
                        (Ok "$argon2id$v=19$m=65536,p=1,t=2$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno")
            )
        , test "parse |> toString |> parse yields the same PhcString"
            (\_ ->
                let
                    input =
                        "$argon2id$v=19$m=65536,t=2,p=1$gZiV/M1gPc22ElAH/Jh1Hw$CWOrkoo7oJBQ/iyh7uJ0LO2aLEfrHwTWllSAxT0zRno"
                in
                Phc.parse input
                    |> Result.map Phc.toString
                    |> Result.andThen Phc.parse
                    |> Expect.equal (Phc.parse input)
            )
        ]


{-| Minimum-effort delimiter malformations the parser rejects with typed
`Error` variants.
-}
basicFailures : Test
basicFailures =
    describe "PhcString.parse — basic failures"
        [ test "rejects empty input with EmptyInput"
            (\_ ->
                Phc.parse ""
                    |> Expect.equal (Err Phc.EmptyInput)
            )
        , test "rejects input that does not start with '$' with MissingLeadingDollar"
            (\_ ->
                Phc.parse "argon2id$v=19$m=1$salt$hash"
                    |> Expect.equal (Err Phc.MissingLeadingDollar)
            )
        , test "rejects a kv pair after a comma missing its '=' with KvPairMissingEquals"
            (\_ ->
                Phc.parse "$argon2id$m=65536,broken$gZiV$abcd"
                    |> Expect.equal (Err (Phc.KvPairMissingEquals "broken"))
            )
        ]


{-| Cases this module deliberately leaves to callers for semantic
validation.
-}
permissiveBehaviour : Test
permissiveBehaviour =
    describe "PhcString.parse — permissive behaviour"
        [ test "parses an identifier without validating its alphabet"
            (\_ ->
                Phc.parse "$Argon2id"
                    |> Expect.equal
                        (Ok
                            { id = "Argon2id"
                            , params = Dict.empty
                            , tail = Phc.NoTail
                            }
                        )
            )
        , test "base64 padding inside a would-be salt follows delimiter parsing"
            (\_ ->
                Phc.parse "$argon2id$YWJjZA==$abcd"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.singleton "YWJjZA" "="
                            , tail = Phc.SaltOnly "abcd"
                            }
                        )
            )
        , test "a kv-name typo is parsed as salt plus hash tail"
            (\_ ->
                Phc.parse "$argon2id$v=19$broken$realsalt$realhash"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.singleton "v" "19"
                            , tail = Phc.SaltAndHash { salt = "broken", hash = "realsalt$realhash" }
                            }
                        )
            )
        , test "a comma inside a kv value breaks the parse"
            -- `,` is the kv-pair separator inside a segment, so a
            -- value containing a literal `,` truncates the value
            -- and leaves the trailing `b` in AfterComma position
            -- with no `=`, surfacing as KvPairMissingEquals.
            (\_ ->
                Phc.parse "$argon2id$data=a,b$salt$hash"
                    |> Expect.equal (Err (Phc.KvPairMissingEquals "b"))
            )
        , test "a trailing '$' after the hash is included in the hash"
            (\_ ->
                Phc.parse "$argon2id$gZiV$abcd$"
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Phc.SaltAndHash { salt = "gZiV", hash = "abcd$" }
                            }
                        )
            )
        , test "base64 padding characters in the hash are preserved"
            (\_ ->
                Phc.parse "$argon2id$gZiV$abcd="
                    |> Expect.equal
                        (Ok
                            { id = "argon2id"
                            , params = Dict.empty
                            , tail = Phc.SaltAndHash { salt = "gZiV", hash = "abcd=" }
                            }
                        )
            )
        ]
