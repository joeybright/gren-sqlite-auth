module Tests.Sqlite.Auth.Password exposing ( tests )

{-| Tests isolated to `Sqlite.Auth.Password` — the credential layer:
`add`/`validate`, the lockout bookkeeping, `change`, and the
`requestReset`/`reset` token flow, exercised against an on-disk database.

Behavior is observed through `validate`'s `Outcome` rather than raw SQL, since
that is the module's own read path. `Password` is opaque, so there are no pure
tests; every group is an effectful `await` chain that creates its own user (the
`passwords.user_id` foreign key) and mints `Verified` witnesses directly
from `Sqlite.Auth.Internal`.

@docs tests

-}

import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Auth.Internal as Internal
import Sqlite.Auth.Password as Password
import Sqlite.Auth.Password.PhcString as PhcString
import Sqlite.Auth.Session as Session
import Sqlite.Auth.User as User
import Sqlite.Decode
import Sqlite.Encode
import Sqlite.Migrate
import Task exposing ( Task )
import Test
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| Hash a plain-text fixture password, ready for `add`, `change`, or `reset`.

`Password.hash` hardcodes SHA-256, whose PBKDF2 minimum is the same 600,000
rounds as `defaultOptions`, so there is no faster option to use — the defaults
are the floor.
-}
hashed : Crypto.SecureContext -> String -> Task Password.HashError (Password.Password Password.Hashed)
hashed secureContext plain =
    Password.hash secureContext Password.defaultOptions (Password.fromString plain)


{-| The shared preamble of most groups here: hash the fixture password, create
a fresh user, store the password for them, and hand the user to the group's
assertions. `label` disambiguates the await descriptions across groups.
-}
withUserAndPassword :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { label : String, password : String }
    -> (Internal.User -> Test.Runner.Effectful.Test)
    -> Test.Runner.Effectful.Test
withUserAndPassword database secureContext { label, password } toTest =
    await
        ("Hash the stored password (" ++ label ++ ")")
        (hashed secureContext password)
        (\storedPassword ->
            await
                ("Create a user (" ++ label ++ ")")
                (User.new database secureContext)
                (\user ->
                    await
                        ("Add the password (" ++ label ++ ")")
                        (Password.add database storedPassword user)
                        (\_ -> toTest user)
                )
        )


{-| Create a fresh user and store a raw string directly into their `passwords`
row, bypassing `Password.hash` — how the known-answer and corrupt-hash groups
plant at-rest values the package didn't produce itself.
-}
withRawStoredHash :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { label : String, phcString : String }
    -> (Internal.User -> Test.Runner.Effectful.Test)
    -> Test.Runner.Effectful.Test
withRawStoredHash database secureContext { label, phcString } toTest =
    await
        ("Create a user (" ++ label ++ ")")
        (User.new database secureContext)
        (\user ->
            await
                ("Insert the raw stored hash (" ++ label ++ ")")
                (insertRawPasswordRow database { userId = User.id user, phcString = phcString })
                (\_ -> toTest user)
        )


{-| Insert a `passwords` row with an arbitrary `password` column value. Only
the columns `validate` reads matter; timestamps are zeroed.
-}
insertRawPasswordRow : Sqlite.Database -> { userId : String, phcString : String } -> Task Sqlite.Error Sqlite.ExecutionSummary
insertRawPasswordRow database { userId, phcString } =
    Sqlite.execute database
        { statement =
            """
            INSERT INTO passwords (user_id, password, created_at, updated_at, last_used, failed_login_attempts_count, locked_until)
            VALUES (:user_id, :password, 0, 0, NULL, 0, NULL)
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            , Sqlite.Encode.string "password" phcString
            ]
        }


{-| Open the database, migrate, and run the database-backed
`Sqlite.Auth.Password` tests.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ User.migrationV1
            , Password.migrationV1
            , Session.migrationV1
            ]
    in
    await
        "Open the on-disk test database (Sqlite.Auth.Password)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test-sqlite-auth-password.sqlite"))
        (\database ->
            await
                "Apply migrations (Sqlite.Auth.Password)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    concat
                        [ validateTests database secureContext
                        , validateRejectsUnknownTests database secureContext
                        , knownAnswerTests database secureContext
                        , corruptStoredHashTests database secureContext
                        , saltRandomnessTests secureContext
                        , emptyPasswordTests database secureContext
                        , lockoutTests database secureContext
                        , lockoutCounterTests database secureContext
                        , lockoutExpiryTests database secureContext
                        , addDuplicateTests database secureContext
                        , changeTests database secureContext
                        , changeInvalidatesResetTokenTests database secureContext
                        , resetTests database secureContext
                        , resetSingleUseTests database secureContext
                        , resetInvalidTokenTests database secureContext
                        , resetExpiredTokenTests database secureContext
                        , resetTokenReplacementTests database secureContext
                        , resetClearsLockoutTests database secureContext
                        , resetTokenUrlSafeTests database secureContext
                        , requestResetSweepTests database secureContext
                        , hashIterationsTooLowTests secureContext
                        ]
                )
        )


{-| A stored password verifies its own candidate and rejects a wrong one.
-}
validateTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
validateTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "validate", password = "correct-horse" }
        (\user ->
            await
                "Validate the correct candidate"
                (Password.validate database secureContext Password.defaultOptions (Password.fromString "correct-horse") (Just user))
                (\correctOutcome ->
                    concat
                        [ test "the correct candidate verifies"
                            (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) correctOutcome)
                        , await
                            "Validate a wrong candidate"
                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "wrong-horse") (Just user))
                            (\wrongOutcome ->
                                test "a wrong candidate is rejected"
                                    (\_ -> Expect.equal Password.Rejected wrongOutcome)
                            )
                        ]
                )
        )


{-| An unknown user and a user with no password both answer `Rejected` — the
burn path that hides which of the two it was.
-}
validateRejectsUnknownTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
validateRejectsUnknownTests database secureContext =
    await
        "Validate with no user"
        (Password.validate database secureContext Password.defaultOptions (Password.fromString "whatever") Nothing)
        (\noUserOutcome ->
            concat
                [ test "an unknown user is rejected"
                    (\_ -> Expect.equal Password.Rejected noUserOutcome)
                , await
                    "Create a user without a password"
                    (User.new database secureContext)
                    (\user ->
                        await
                            "Validate a user that has no password"
                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "whatever") (Just user))
                            (\noPasswordOutcome ->
                                test "a user with no password row is rejected"
                                    (\_ -> Expect.equal Password.Rejected noPasswordOutcome)
                            )
                    )
                ]
        )


{-| Reaching the failed-attempt limit locks the password: a later validate
answers `Locked` even for the right candidate.
-}
lockoutTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
lockoutTests database secureContext =
    let
        lockOptions : Password.Options
        lockOptions =
            { Password.defaultOptions | maxFailedAttempts = 1 }
    in
    withUserAndPassword database
        secureContext
        { label = "lockout", password = "correct-horse" }
        (\user ->
            await
                "Validate a wrong candidate at the attempt limit"
                (Password.validate database secureContext lockOptions (Password.fromString "wrong-horse") (Just user))
                (\wrongOutcome ->
                    concat
                        [ test "the wrong candidate at the limit is rejected"
                            (\_ -> Expect.equal Password.Rejected wrongOutcome)
                        , await
                            "Validate the correct candidate while locked"
                            (Password.validate database secureContext lockOptions (Password.fromString "correct-horse") (Just user))
                            (\lockedOutcome ->
                                test "a locked password answers Locked even for the right candidate"
                                    (\_ -> Expect.equal Password.Locked lockedOutcome)
                            )
                        ]
                )
        )


{-| A PBKDF2-HMAC-SHA256 vector computed independently with Node's
`crypto.pbkdf2Sync`: password `"kat-correct-horse"`, the 16-byte UTF-8 salt
`0123456789abcdef`, 600,000 iterations, 32-byte output. Pins the at-rest PHC
format: if hashing, encoding, or parsing ever drifts, hashes stored today stop
validating and this string catches it.
-}
katPhcString : String
katPhcString =
    "$pbkdf2-sha256$i=600000$MDEyMzQ1Njc4OWFiY2RlZg$1bH0FUhz4L4pWlX/OlMjV4/CLO4TPKXikRQni1s7gBY"


{-| A stored hash produced outside this package (a known-answer vector)
validates its password and rejects a wrong one — the interop/compatibility
guarantee for every hash already at rest.
-}
knownAnswerTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
knownAnswerTests database secureContext =
    withRawStoredHash database
        secureContext
        { label = "known answer", phcString = katPhcString }
        (\user ->
            await
                "Validate the vector's password against the planted hash"
                (Password.validate database secureContext Password.defaultOptions (Password.fromString "kat-correct-horse") (Just user))
                (\correctOutcome ->
                    concat
                        [ test "the known-answer vector verifies its password"
                            (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) correctOutcome)
                        , await
                            "Validate a wrong password against the planted hash"
                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "kat-wrong-horse") (Just user))
                            (\wrongOutcome ->
                                test "the known-answer vector rejects a wrong password"
                                    (\_ -> Expect.equal Password.Rejected wrongOutcome)
                            )
                        ]
                )
        )


{-| A corrupt stored hash is a fault, never a quiet rejection: `validate`
answers `VerificationError` naming exactly what is wrong with the row.
-}
corruptStoredHashTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
corruptStoredHashTests database secureContext =
    concat
        [ withRawStoredHash database
            secureContext
            { label = "corrupt: not PHC", phcString = "not-a-phc-string" }
            (\user ->
                awaitError
                    "Validate against a non-PHC stored value"
                    (Password.validate database secureContext Password.defaultOptions (Password.fromString "whatever") (Just user))
                    (\error ->
                        test "a non-PHC stored value is a parse fault"
                            (\_ -> Expect.equal (Password.VerificationError (Password.ParsePhcStringError PhcString.MissingLeadingDollar)) error)
                    )
            )
        , withRawStoredHash database
            secureContext
            { label = "corrupt: unknown digest", phcString = "$pbkdf2-sha1$i=600000$MDEyMzQ1Njc4OWFiY2RlZg$AAAA" }
            (\user ->
                awaitError
                    "Validate against an unknown digest algorithm"
                    (Password.validate database secureContext Password.defaultOptions (Password.fromString "whatever") (Just user))
                    (\error ->
                        test "an unknown digest algorithm is a fault"
                            (\_ -> Expect.equal (Password.VerificationError (Password.UnknownDigestAlgorithm "pbkdf2-sha1")) error)
                    )
            )
        , withRawStoredHash database
            secureContext
            { label = "corrupt: bad iterations", phcString = "$pbkdf2-sha256$i=abc$MDEyMzQ1Njc4OWFiY2RlZg$AAAA" }
            (\user ->
                awaitError
                    "Validate against a non-numeric iteration count"
                    (Password.validate database secureContext Password.defaultOptions (Password.fromString "whatever") (Just user))
                    (\error ->
                        test "a non-numeric iteration count is a fault"
                            (\_ -> Expect.equal (Password.VerificationError (Password.InvalidIterations "abc")) error)
                    )
            )
        ]


{-| Hashing the same password twice yields different PHC strings — the salt is
random per hash, not fixed or reused.
-}
saltRandomnessTests : Crypto.SecureContext -> Test.Runner.Effectful.Test
saltRandomnessTests secureContext =
    await
        "Hash a password the first time (salt randomness)"
        (hashed secureContext "same password")
        (\first ->
            await
                "Hash the same password again (salt randomness)"
                (hashed secureContext "same password")
                (\second ->
                    test "two hashes of the same password differ"
                        (\_ -> Expect.notEqual first second)
                )
        )


{-| An empty-string password hashes, stores, and validates like any other —
content policy is deliberately the application's job, so this pins the fact
that the package itself imposes none.
-}
emptyPasswordTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
emptyPasswordTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "empty password", password = "" }
        (\user ->
            await
                "Validate the empty password"
                (Password.validate database secureContext Password.defaultOptions (Password.fromString "") (Just user))
                (\emptyOutcome ->
                    concat
                        [ test "an empty password round-trips"
                            (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) emptyOutcome)
                        , await
                            "Validate a non-empty candidate against the empty password"
                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "not empty") (Just user))
                            (\wrongOutcome ->
                                test "a non-empty candidate is rejected"
                                    (\_ -> Expect.equal Password.Rejected wrongOutcome)
                            )
                        ]
                )
        )


{-| The failure counter locks exactly at the limit: below it the correct
candidate still verifies (and resets the counter), and only reaching the limit
after that reset locks the password.
-}
lockoutCounterTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
lockoutCounterTests database secureContext =
    let
        lockOptions : Password.Options
        lockOptions =
            { Password.defaultOptions | maxFailedAttempts = 2 }
    in
    withUserAndPassword database
        secureContext
        { label = "counter", password = "correct-horse" }
        (\user ->
            await
                "Validate a wrong candidate below the limit"
                (Password.validate database secureContext lockOptions (Password.fromString "wrong-horse") (Just user))
                (\firstWrong ->
                    concat
                        [ test "one failure below the limit does not lock"
                            (\_ -> Expect.equal Password.Rejected firstWrong)
                        , await
                            "Validate the correct candidate after one failure"
                            (Password.validate database secureContext lockOptions (Password.fromString "correct-horse") (Just user))
                            (\correctOutcome ->
                                concat
                                    [ test "the correct candidate verifies below the limit"
                                        (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) correctOutcome)
                                    , await
                                        "Validate a wrong candidate after the counter reset"
                                        (Password.validate database secureContext lockOptions (Password.fromString "wrong-horse") (Just user))
                                        (\secondWrong ->
                                            concat
                                                [ test "the counter restarted after the successful check"
                                                    (\_ -> Expect.equal Password.Rejected secondWrong)
                                                , await
                                                    "Validate a wrong candidate at the limit"
                                                    (Password.validate database secureContext lockOptions (Password.fromString "wrong-horse") (Just user))
                                                    (\thirdWrong ->
                                                        concat
                                                            [ test "the failure at the limit is rejected"
                                                                (\_ -> Expect.equal Password.Rejected thirdWrong)
                                                            , await
                                                                "Validate the correct candidate once locked"
                                                                (Password.validate database secureContext lockOptions (Password.fromString "correct-horse") (Just user))
                                                                (\lockedOutcome ->
                                                                    test "reaching the limit locks the password"
                                                                        (\_ -> Expect.equal Password.Locked lockedOutcome)
                                                                )
                                                            ]
                                                    )
                                                ]
                                        )
                                    ]
                            )
                        ]
                )
        )


{-| An expired lock no longer answers `Locked`: with a zero lockout duration
the correct candidate verifies on the attempt after the lock engages.
-}
lockoutExpiryTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
lockoutExpiryTests database secureContext =
    let
        lockOptions : Password.Options
        lockOptions =
            { Password.defaultOptions | maxFailedAttempts = 1, lockoutDurationMillis = 0 }
    in
    withUserAndPassword database
        secureContext
        { label = "lock expiry", password = "correct-horse" }
        (\user ->
            await
                "Validate a wrong candidate to engage the lock"
                (Password.validate database secureContext lockOptions (Password.fromString "wrong-horse") (Just user))
                (\wrongOutcome ->
                    concat
                        [ test "the wrong candidate is rejected"
                            (\_ -> Expect.equal Password.Rejected wrongOutcome)
                        , await
                            "Validate the correct candidate after the lock expired"
                            (Password.validate database secureContext lockOptions (Password.fromString "correct-horse") (Just user))
                            (\correctOutcome ->
                                test "an expired lock lets the correct candidate verify"
                                    (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) correctOutcome)
                            )
                        ]
                )
        )


{-| A user can hold only one password row: a second `add` collides on the
primary key.
-}
addDuplicateTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
addDuplicateTests database secureContext =
    await
        "Hash the stored password (duplicate)"
        (hashed secureContext "correct-horse")
        (\storedPassword ->
            await
                "Create a user (duplicate)"
                (User.new database secureContext)
                (\user ->
                    await
                        "Add the password"
                        (Password.add database storedPassword user)
                        (\_ ->
                            awaitError
                                "Add a second password for the same user"
                                (Password.add database storedPassword user)
                                (\_ ->
                                    test "a user can only have one password row"
                                        (\_ -> Expect.pass)
                                )
                        )
                )
        )


{-| With the owner's proof, `change` replaces the password: the old one stops
verifying and the new one verifies.
-}
changeTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
changeTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "change", password = "old-pass" }
        (\user ->
            await
                "Hash the new password (change)"
                (hashed secureContext "new-pass")
                (\newPassword ->
                    await
                        "Change to the new password"
                        (Password.change database newPassword (Internal.Verified { userId = User.id user }))
                        (\_ ->
                            await
                                "Validate the old password after the change"
                                (Password.validate database secureContext Password.defaultOptions (Password.fromString "old-pass") (Just user))
                                (\oldOutcome ->
                                    concat
                                        [ test "the old password no longer verifies"
                                            (\_ -> Expect.equal Password.Rejected oldOutcome)
                                        , await
                                            "Validate the new password after the change"
                                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "new-pass") (Just user))
                                            (\newOutcome ->
                                                test "the new password verifies"
                                                    (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) newOutcome)
                                            )
                                        ]
                                )
                        )
                )
        )


{-| Changing the password invalidates an outstanding reset token: a token
requested before the change no longer redeems.
-}
changeInvalidatesResetTokenTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
changeInvalidatesResetTokenTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "change invalidates token", password = "old-pass" }
        (\user ->
            await
                "Request a reset token before the change"
                (Password.requestReset database secureContext Password.defaultOptions user)
                (\{ token } ->
                    await
                        "Hash the new password (change invalidates token)"
                        (hashed secureContext "new-pass")
                        (\newPassword ->
                            await
                                "Change the password"
                                (Password.change database newPassword (Internal.Verified { userId = User.id user }))
                                (\_ ->
                                    awaitError
                                        "Redeem the pre-change reset token"
                                        (Password.reset database secureContext { token = token, new = newPassword })
                                        (\error ->
                                            test "a reset token from before the change is rejected"
                                                (\_ -> Expect.equal Password.InvalidResetToken error)
                                        )
                                )
                        )
                )
        )


{-| A reset token redeems once: `reset` mints the witness, and afterward the old
password is gone and the new one verifies.
-}
resetTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "reset", password = "old-pass" }
        (\user ->
            await
                "Request a reset token"
                (Password.requestReset database secureContext Password.defaultOptions user)
                (\{ token } ->
                    await
                        "Hash the new password (reset)"
                        (hashed secureContext "new-pass")
                        (\newPassword ->
                            await
                                "Redeem the reset token"
                                (Password.reset database secureContext { token = token, new = newPassword })
                                (\verified ->
                                    concat
                                        [ test "reset mints a Verified witness for the user"
                                            (\_ -> Expect.equal (Internal.Verified { userId = User.id user }) verified)
                                        , await
                                            "Validate the old password after the reset"
                                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "old-pass") (Just user))
                                            (\oldOutcome ->
                                                concat
                                                    [ test "the old password no longer verifies after reset"
                                                        (\_ -> Expect.equal Password.Rejected oldOutcome)
                                                    , await
                                                        "Validate the new password after the reset"
                                                        (Password.validate database secureContext Password.defaultOptions (Password.fromString "new-pass") (Just user))
                                                        (\newOutcome ->
                                                            test "the new password verifies after reset"
                                                                (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) newOutcome)
                                                        )
                                                    ]
                                            )
                                        ]
                                )
                        )
                )
        )


{-| A redeemed token does not redeem again: the second attempt is rejected and
its candidate password is never set.
-}
resetSingleUseTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetSingleUseTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "single use", password = "old-pass" }
        (\user ->
            await
                "Request a reset token"
                (Password.requestReset database secureContext Password.defaultOptions user)
                (\{ token } ->
                    await
                        "Hash the first replacement password"
                        (hashed secureContext "first-new")
                        (\firstPassword ->
                            await
                                "Redeem the reset token"
                                (Password.reset database secureContext { token = token, new = firstPassword })
                                (\_ ->
                                    await
                                        "Hash the second replacement password"
                                        (hashed secureContext "second-new")
                                        (\secondPassword ->
                                            awaitError
                                                "Redeem the same token again"
                                                (Password.reset database secureContext { token = token, new = secondPassword })
                                                (\error ->
                                                    concat
                                                        [ test "the second redemption is rejected"
                                                            (\_ -> Expect.equal Password.InvalidResetToken error)
                                                        , await
                                                            "Validate the first replacement password"
                                                            (Password.validate database secureContext Password.defaultOptions (Password.fromString "first-new") (Just user))
                                                            (\firstOutcome ->
                                                                concat
                                                                    [ test "the first redemption's password still verifies"
                                                                        (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) firstOutcome)
                                                                    , await
                                                                        "Validate the second redemption's candidate"
                                                                        (Password.validate database secureContext Password.defaultOptions (Password.fromString "second-new") (Just user))
                                                                        (\secondOutcome ->
                                                                            test "the rejected redemption never set its password"
                                                                                (\_ -> Expect.equal Password.Rejected secondOutcome)
                                                                        )
                                                                    ]
                                                            )
                                                        ]
                                                )
                                        )
                                )
                        )
                )
        )


{-| A token that matches no live row is rejected as `InvalidResetToken`.
-}
resetInvalidTokenTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetInvalidTokenTests database secureContext =
    await
        "Hash a replacement password (invalid token)"
        (hashed secureContext "new-pass")
        (\newPassword ->
            awaitError
                "Redeem a bogus reset token"
                (Password.reset database secureContext { token = "not-a-real-token", new = newPassword })
                (\error ->
                    test "an unknown reset token is rejected"
                        (\_ -> Expect.equal Password.InvalidResetToken error)
                )
        )


{-| A token past its lifetime is rejected as `InvalidResetToken`.
-}
resetExpiredTokenTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetExpiredTokenTests database secureContext =
    let
        expiredOptions : Password.Options
        expiredOptions =
            { Password.defaultOptions | resetTokenLifetimeMillis = 0 }
    in
    withUserAndPassword database
        secureContext
        { label = "expired token", password = "old-pass" }
        (\user ->
            await
                "Request a reset token that expires immediately"
                (Password.requestReset database secureContext expiredOptions user)
                (\{ token } ->
                    await
                        "Hash the new password (expired token)"
                        (hashed secureContext "new-pass")
                        (\newPassword ->
                            awaitError
                                "Redeem the expired token"
                                (Password.reset database secureContext { token = token, new = newPassword })
                                (\error ->
                                    test "an expired reset token is rejected"
                                        (\_ -> Expect.equal Password.InvalidResetToken error)
                                )
                        )
                )
        )


{-| A second `requestReset` replaces the first token: only the latest token per
user redeems — the `INSERT OR REPLACE` one-live-token invariant.
-}
resetTokenReplacementTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetTokenReplacementTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "token replacement", password = "old-pass" }
        (\user ->
            await
                "Request the first reset token"
                (Password.requestReset database secureContext Password.defaultOptions user)
                (\first ->
                    await
                        "Request a second reset token"
                        (Password.requestReset database secureContext Password.defaultOptions user)
                        (\second ->
                            await
                                "Hash the replacement password (token replacement)"
                                (hashed secureContext "new-pass")
                                (\newPassword ->
                                    concat
                                        [ awaitError
                                            "Redeem the replaced first token"
                                            (Password.reset database secureContext { token = first.token, new = newPassword })
                                            (\error ->
                                                test "the replaced token no longer redeems"
                                                    (\_ -> Expect.equal Password.InvalidResetToken error)
                                            )
                                        , await
                                            "Redeem the latest token"
                                            (Password.reset database secureContext { token = second.token, new = newPassword })
                                            (\verified ->
                                                test "the latest token redeems"
                                                    (\_ -> Expect.equal (Internal.Verified { userId = User.id user }) verified)
                                            )
                                        ]
                                )
                        )
                )
        )


{-| Redeeming a reset clears a lockout: the fresh password row starts with a
zeroed failure counter and no lock, so the new password logs in immediately.
-}
resetClearsLockoutTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetClearsLockoutTests database secureContext =
    let
        lockOptions : Password.Options
        lockOptions =
            { Password.defaultOptions | maxFailedAttempts = 1 }
    in
    withUserAndPassword database
        secureContext
        { label = "reset clears lockout", password = "old-pass" }
        (\user ->
            await
                "Lock the password with a wrong candidate"
                (Password.validate database secureContext lockOptions (Password.fromString "wrong-horse") (Just user))
                (\_ ->
                    await
                        "Confirm the password is locked"
                        (Password.validate database secureContext lockOptions (Password.fromString "old-pass") (Just user))
                        (\lockedOutcome ->
                            concat
                                [ test "the account is locked before the reset"
                                    (\_ -> Expect.equal Password.Locked lockedOutcome)
                                , await
                                    "Request a reset while locked"
                                    (Password.requestReset database secureContext lockOptions user)
                                    (\{ token } ->
                                        await
                                            "Hash the replacement password (reset clears lockout)"
                                            (hashed secureContext "fresh-pass")
                                            (\newPassword ->
                                                await
                                                    "Redeem the reset while locked"
                                                    (Password.reset database secureContext { token = token, new = newPassword })
                                                    (\_ ->
                                                        await
                                                            "Validate the new password after the reset"
                                                            (Password.validate database secureContext lockOptions (Password.fromString "fresh-pass") (Just user))
                                                            (\freshOutcome ->
                                                                test "the reset password verifies immediately, lock gone"
                                                                    (\_ -> Expect.equal (Password.Verified (Internal.Verified { userId = User.id user })) freshOutcome)
                                                            )
                                                    )
                                            )
                                    )
                                ]
                        )
                )
        )


{-| Raw reset tokens are URL-safe: they travel inside emailed links, so the
base64 must carry no `+`, `/`, or `=`.
-}
resetTokenUrlSafeTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
resetTokenUrlSafeTests database secureContext =
    withUserAndPassword database
        secureContext
        { label = "token URL safety", password = "old-pass" }
        (\user ->
            await
                "Request a reset token (URL safety)"
                (Password.requestReset database secureContext Password.defaultOptions user)
                (\{ token } ->
                    concat
                        [ test "the token contains no '+'"
                            (\_ -> Expect.equal False (String.contains "+" token))
                        , test "the token contains no '/'"
                            (\_ -> Expect.equal False (String.contains "/" token))
                        , test "the token contains no '='"
                            (\_ -> Expect.equal False (String.contains "=" token))
                        ]
                )
        )


{-| `requestReset` sweeps expired token rows: after any later request, an
expired token row is gone from the table, not just unredeemable.
-}
requestResetSweepTests : Sqlite.Database -> Crypto.SecureContext -> Test.Runner.Effectful.Test
requestResetSweepTests database secureContext =
    let
        expiredOptions : Password.Options
        expiredOptions =
            { Password.defaultOptions | resetTokenLifetimeMillis = 0 }
    in
    await
        "Create a user whose token expires immediately (sweep)"
        (User.new database secureContext)
        (\expiredUser ->
            await
                "Request a token that expires immediately (sweep)"
                (Password.requestReset database secureContext expiredOptions expiredUser)
                (\_ ->
                    await
                        "Create a second user (sweep)"
                        (User.new database secureContext)
                        (\otherUser ->
                            await
                                "Request a token for the second user (sweep)"
                                (Password.requestReset database secureContext Password.defaultOptions otherUser)
                                (\_ ->
                                    await
                                        "Count the first user's token rows"
                                        (countResetTokenRows database { userId = User.id expiredUser })
                                        (\count ->
                                            test "the expired token row was swept"
                                                (\_ -> Expect.equal 0 count)
                                        )
                                )
                        )
                )
        )


{-| Count a user's rows in `password_reset_tokens` directly — the one place a
raw query is needed, because sweeping is about the row being gone, not about
any observable `reset` outcome.
-}
countResetTokenRows : Sqlite.Database -> { userId : String } -> Task Sqlite.Error Int
countResetTokenRows database { userId } =
    Sqlite.getOne database
        { query =
            """
            SELECT COUNT(*) AS row_count
            FROM password_reset_tokens
            WHERE user_id = :user_id
            """
        , parameters =
            [ Sqlite.Encode.string "user_id" userId
            ]
        , rowDecoder =
            Sqlite.Decode.int "row_count" Sqlite.Decode.succeed
        }


{-| Hashing below the PBKDF2 minimum for SHA-256 (600,000 iterations) fails with
the invalid-iterations error rather than silently producing a weak hash.
-}
hashIterationsTooLowTests : Crypto.SecureContext -> Test.Runner.Effectful.Test
hashIterationsTooLowTests secureContext =
    let
        tooFewIterations : Password.Options
        tooFewIterations =
            { Password.defaultOptions | iterations = 599999 }
    in
    awaitError
        "Hash with fewer than the minimum iterations"
        (Password.hash secureContext tooFewIterations (Password.fromString "secret"))
        (\error ->
            test "hashing below the PBKDF2 minimum reports an invalid-iterations error"
                (\_ -> Expect.equal (Password.Pbkdf2DeriveBitsError Crypto.Pbkdf2DeriveBitsErrorIterationsInvalid) error)
        )
