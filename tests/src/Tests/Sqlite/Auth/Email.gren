module Tests.Sqlite.Auth.Email exposing ( tests )

{-| Tests isolated to `Sqlite.Auth.Email` — its pure API (`normalize`,
`fromString`, `toString`) and its SQL behavior (`new`, `change`, `user`)
exercised against an on-disk database.

Each database-backed group interleaves work and assertions: a task runs, its
result is awaited, a test runs against it, and only then does the next task run.
Witnesses are minted directly from `Sqlite.Auth.Internal` so the credential
layer stays out of it; `Sqlite.Auth.User.new` is used only as a fixture to
satisfy the `emails.user_id` foreign key. Database state is always read back
through `Email.user`, the module's own lookup.

@docs tests

-}

import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Auth.Email as Email
import Sqlite.Auth.Email.Parser as Parser
import Sqlite.Auth.User as User
import Sqlite.Migrate
import Task exposing ( Task )
import Test
import Test.Runner.Effectful exposing ( await, awaitError, concat, test, wrap )
import Tests.Sqlite.Auth.Helpers exposing (verifiedFor)


{-| Normalize a fixture email and run `toTest` with it, or fail with a clear
test naming the raw fixture when it does not normalize.
-}
normalizeEmail : String -> (Email.Email Email.Normalized -> Test.Runner.Effectful.Test) -> Test.Runner.Effectful.Test
normalizeEmail string toTest =
    when Email.normalize (Email.fromString string) is
        Just email ->
            toTest email

        Nothing ->
            test ("fixture email should normalize: " ++ string)
                (\_ -> Expect.fail ("expected \"" ++ string ++ "\" to normalize"))


{-| Open the database, migrate, and run the pure and database-backed
`Sqlite.Auth.Email` tests, each derived from a fresh UUID suffix so they never
collide across groups or runs.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ User.migrationV1
            , Email.migrationV1
            ]
    in
    await
        "Open the on-disk test database (Sqlite.Auth.Email)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test-sqlite-auth-email.sqlite"))
        (\database ->
            await
                "Apply migrations (Sqlite.Auth.Email)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique email suffix (Sqlite.Auth.Email)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            concat
                                [ wrap pureTests
                                , userLookupTests database secureContext suffix
                                , newDuplicateTests database secureContext suffix
                                , changeRenameTests database secureContext suffix
                                , changeScopingTests database secureContext suffix
                                , changeWithoutEmailTests database secureContext suffix
                                , changeTakenTests database secureContext suffix
                                , oneEmailPerUserTests database secureContext suffix
                                ]
                        )
                )
        )


{-| `normalize`, `validate`, `fromString`, and `toString` — no database needed.
Now that normalization parses the string as an RFC 5321 address, the pure suite
also pins the strictness: a structurally invalid email no longer normalizes.
-}
pureTests : Test.Test
pureTests =
    Test.describe "Sqlite.Auth.Email pure tests"
        [ Test.test "normalize trims surrounding whitespace and lowercases"
            (\_ ->
                Email.normalize (Email.fromString "  Alice@Example.COM  ")
                    |> Maybe.map Email.toString
                    |> Expect.equal (Just "alice@example.com")
            )
        , Test.test "differently-cased emails normalize to the same value"
            (\_ ->
                Expect.equal
                    (Maybe.map Email.toString (Email.normalize (Email.fromString "ALICE@EXAMPLE.COM")))
                    (Maybe.map Email.toString (Email.normalize (Email.fromString " alice@example.com ")))
            )
        , Test.test "an empty string does not normalize"
            (\_ ->
                Email.normalize (Email.fromString "")
                    |> Maybe.map Email.toString
                    |> Expect.equal Nothing
            )
        , Test.test "a whitespace-only email does not normalize"
            (\_ ->
                Email.normalize (Email.fromString "   ")
                    |> Maybe.map Email.toString
                    |> Expect.equal Nothing
            )
        , Test.test "toString returns the raw string of a fromString value"
            (\_ ->
                Email.toString (Email.fromString "RawValue@Example.com")
                    |> Expect.equal "RawValue@Example.com"
            )
        , Test.test "a structurally invalid email does not normalize"
            (\_ ->
                Email.normalize (Email.fromString "not an email")
                    |> Maybe.map Email.toString
                    |> Expect.equal Nothing
            )
        , Test.test "an email with no at-sign does not normalize"
            (\_ ->
                Email.normalize (Email.fromString "noat")
                    |> Maybe.map Email.toString
                    |> Expect.equal Nothing
            )
        , Test.test "a minimal valid email normalizes"
            (\_ ->
                Email.normalize (Email.fromString "a@b")
                    |> Maybe.map Email.toString
                    |> Expect.equal (Just "a@b")
            )
        , Test.test "validate returns Ok for a valid email"
            (\_ ->
                Email.validate (Email.fromString "a@b.com")
                    |> Result.map Email.toString
                    |> Expect.equal (Ok "a@b.com")
            )
        , Test.test "validate returns the typed parse error for a missing at-sign"
            (\_ ->
                Email.validate (Email.fromString "noat")
                    |> Expect.equal (Err Parser.MissingAtSign)
            )
        , Test.test "validate returns EmptyInput for an empty string"
            (\_ ->
                Email.validate (Email.fromString "")
                    |> Expect.equal (Err Parser.EmptyInput)
            )
        ]


{-| `user` resolves an inserted email to its owner, and an un-inserted one to
`Nothing`.
-}
userLookupTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
userLookupTests database secureContext suffix =
    normalizeEmail ("lookup-" ++ suffix ++ "@example.com")
        (\email ->
            normalizeEmail ("ghost-" ++ suffix ++ "@example.com")
                (\ghost ->
                    await
                        "Create a user (lookup)"
                        (User.new database secureContext)
                        (\user ->
                            await
                                "Insert the email"
                                (Email.new database { email = email } user)
                                (\_ ->
                                    await
                                        "Look up the inserted email"
                                        (Email.user database { email = email })
                                        (\maybeOwner ->
                                            concat
                                                [ test "user resolves an inserted email to its owner"
                                                    (\_ -> Expect.equal (Just (User.id user)) (Maybe.map User.id maybeOwner))
                                                , await
                                                    "Look up the unowned email"
                                                    (Email.user database { email = ghost })
                                                    (\maybeGhost ->
                                                        test "user resolves an unowned email to Nothing"
                                                            (\_ -> Expect.equal Nothing (Maybe.map User.id maybeGhost))
                                                    )
                                                ]
                                        )
                                )
                        )
                )
        )


{-| Inserting an email that already exists fails on the primary key.
-}
newDuplicateTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
newDuplicateTests database secureContext suffix =
    normalizeEmail ("dupe-" ++ suffix ++ "@example.com")
        (\email ->
            await
                "Create a user (duplicate)"
                (User.new database secureContext)
                (\user ->
                    await
                        "Insert the email"
                        (Email.new database { email = email } user)
                        (\_ ->
                            awaitError
                                "Insert the same email for a second user"
                                (User.new database secureContext
                                    |> Task.andThen (Email.new database { email = email })
                                )
                                (\_ ->
                                    test "inserting a duplicate email fails on the primary key"
                                        (\_ -> Expect.pass)
                                )
                        )
                )
        )


{-| With the owner's proof, the old address stops resolving and the new one
resolves to the same user.
-}
changeRenameTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
changeRenameTests database secureContext suffix =
    normalizeEmail ("rename-from-" ++ suffix ++ "@example.com")
        (\from ->
            normalizeEmail ("rename-to-" ++ suffix ++ "@example.com")
                (\to ->
                    await
                        "Create a user (rename)"
                        (User.new database secureContext)
                        (\user ->
                            await
                                "Insert the original email"
                                (Email.new database { email = from } user)
                                (\_ ->
                                    await
                                        "Rename with the owner's proof"
                                        (Email.change database { newEmail = to } (verifiedFor user))
                                        (\_ ->
                                            await
                                                "Look up the old email after renaming"
                                                (Email.user database { email = from })
                                                (\maybeOld ->
                                                    await
                                                        "Look up the new email after renaming"
                                                        (Email.user database { email = to })
                                                        (\maybeNew ->
                                                            concat
                                                                [ test "after change the old email no longer resolves"
                                                                    (\_ -> Expect.equal Nothing (Maybe.map User.id maybeOld))
                                                                , test "after change the new email resolves to the same user"
                                                                    (\_ -> Expect.equal (Just (User.id user)) (Maybe.map User.id maybeNew))
                                                                ]
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )


{-| A proof for a different user renames nothing: the write is scoped to the
witness's user, so a `from` it does not own matches zero rows.
-}
changeScopingTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
changeScopingTests database secureContext suffix =
    normalizeEmail ("scope-a-" ++ suffix ++ "@example.com")
        (\from ->
            normalizeEmail ("scope-b-" ++ suffix ++ "@example.com")
                (\to ->
                    await
                        "Create the original owner (scoping)"
                        (User.new database secureContext)
                        (\userA ->
                            await
                                "Create the mismatched user (scoping)"
                                (User.new database secureContext)
                                (\userB ->
                                    await
                                        "Insert the original email for the first user"
                                        (Email.new database { email = from } userA)
                                        (\_ ->
                                            await
                                                "Rename with a mismatched proof"
                                                (Email.change database { newEmail = to } (verifiedFor userB))
                                                (\_ ->
                                                    await
                                                        "Look up the original email after the mismatched rename"
                                                        (Email.user database { email = from })
                                                        (\maybeFrom ->
                                                            await
                                                                "Look up the target email after the mismatched rename"
                                                                (Email.user database { email = to })
                                                                (\maybeTo ->
                                                                    concat
                                                                        [ test "a mismatched proof leaves the original owner unchanged"
                                                                            (\_ -> Expect.equal (Just (User.id userA)) (Maybe.map User.id maybeFrom))
                                                                        , test "a mismatched proof does not create the target email"
                                                                            (\_ -> Expect.equal Nothing (Maybe.map User.id maybeTo))
                                                                        ]
                                                                )
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )


{-| Renaming a user who holds no email row is a silent no-op: the task
succeeds, and the target address is not created. Surprising, so pinned here.
-}
changeWithoutEmailTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
changeWithoutEmailTests database secureContext suffix =
    normalizeEmail ("orphan-" ++ suffix ++ "@example.com")
        (\target ->
            await
                "Create a user with no email (no-op)"
                (User.new database secureContext)
                (\user ->
                    await
                        "Rename the user who has no email row"
                        (Email.change database { newEmail = target } (verifiedFor user))
                        (\_ ->
                            await
                                "Look up the target email after the no-op rename"
                                (Email.user database { email = target })
                                (\maybeOwner ->
                                    test "renaming without an email row creates nothing"
                                        (\_ -> Expect.equal Nothing (Maybe.map User.id maybeOwner))
                                )
                        )
                )
        )


{-| Renaming to an email that is already taken fails on the primary key.
-}
changeTakenTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
changeTakenTests database secureContext suffix =
    normalizeEmail ("taken-one-" ++ suffix ++ "@example.com")
        (\one ->
            normalizeEmail ("taken-two-" ++ suffix ++ "@example.com")
                (\two ->
                    await
                        "Create the first user (taken)"
                        (User.new database secureContext)
                        (\userA ->
                            await
                                "Insert the first email"
                                (Email.new database { email = one } userA)
                                (\_ ->
                                    await
                                        "Create the second user (taken)"
                                        (User.new database secureContext)
                                        (\userB ->
                                            await
                                                "Insert the second email"
                                                (Email.new database { email = two } userB)
                                                (\_ ->
                                                    awaitError
                                                        "Rename the second user's email to the first"
                                                        (Email.change database { newEmail = one } (verifiedFor userB))
                                                        (\_ ->
                                                            test "renaming to a taken email fails on the primary key"
                                                                (\_ -> Expect.pass)
                                                        )
                                                )
                                        )
                                )
                        )
                )
        )


{-| A user can hold only one email row: a second `new` for the same user
collides on the `user_id` unique constraint.
-}
oneEmailPerUserTests : Sqlite.Database -> Crypto.SecureContext -> String -> Test.Runner.Effectful.Test
oneEmailPerUserTests database secureContext suffix =
    normalizeEmail ("first-" ++ suffix ++ "@example.com")
        (\first ->
            normalizeEmail ("second-" ++ suffix ++ "@example.com")
                (\second ->
                    await
                        "Create a user (one-per-user)"
                        (User.new database secureContext)
                        (\user ->
                            await
                                "Insert the first email"
                                (Email.new database { email = first } user)
                                (\_ ->
                                    awaitError
                                        "Insert a second email for the same user"
                                        (Email.new database { email = second } user)
                                        (\_ ->
                                            test "a user can only have one email row"
                                                (\_ -> Expect.pass)
                                        )
                                )
                        )
                )
        )
