module Tests.CredentialLogin exposing ( tests )

{-| End-to-end tests for the generic [`Auth.Simple.Login`](Auth.Simple.Login)
workflow, run against the on-disk `tests/test.sqlite`.

An account is set up through [`Auth.Simple.Register.register`](Auth.Simple.Register),
driven with the username identifier and the password credential: it creates the
`users` row, the `usernames` row (the identifier), and the hashed `passwords` row
(the credential). With that in place, login is built by partially applying `login`
with the same identifier and credential, then called with a runtime username +
plain-text password.

Covers the hardened failure behavior: a wrong password, an unknown username, and
a user with no stored credential all collapse to `InvalidCredentials`; expired
and revoked sessions no longer verify; and five wrong passwords lock the account
even against the correct password.

The database persists across runs, so each run derives a unique username from a
fresh UUID.

@docs tests

-}

import Auth.Simple
import Auth.Simple.Credential.Code as Code
import Auth.Simple.Credential.Password as Password
import Auth.Simple.Identifier.Username as Username
import Auth.Simple.Login as Login
import Auth.Simple.Register as Register
import Auth.Simple.Token.Session as Session
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Migrate
import Task exposing ( Task )
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| The ways setting up a test account can fail: hashing the password, or the
registration writes that [`Auth.Simple.Register.register`](Auth.Simple.Register)
drives.
-}
type SetupError
    = HashError Password.HashPasswordError
    | RegisterError (Register.Error Username.AsIdentifierError)


{-| Register an identifier + credential combo through
[`Auth.Simple.Register.register`](Auth.Simple.Register): hash the plain-text password
into a `Password_ Hashed`, then create the user, the username identifier, and the
password credential in one task. Returns the new `userId`.
-}
doRegister :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task SetupError { userId : String }
doRegister { username, password } database secureContext =
    Password.hashWithDefaults (Password.fromString password) secureContext
        |> Task.mapError HashError
        |> Task.andThen
            (\hashedPassword ->
                Register.register database secureContext
                    Username.identifier
                    Password.stored
                    { userId = Nothing
                    , value = username
                    , secret = hashedPassword
                    }
                    |> Task.mapError RegisterError
            )


{-| Register a username with no credential behind it, so login against it can
only ever fail.
-}
registerIdentifierOnly :
    String
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task (Register.Error Username.AsIdentifierError) { userId : String }
registerIdentifierOnly username database secureContext =
    Register.identifier database secureContext
        Username.identifier
        { userId = Nothing
        , value = username
        }


{-|-}
doLogin :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { identifier : String
    , secret : Password.Password_ Password.PlainText
    }
    -> Task
        (Login.Error Username.AsIdentifierError Password.AsCredentialError Sqlite.Error)
        { session : Session.Session
        , token : String
        }
doLogin database secureContext =
    Login.login database secureContext
        Username.identifier
        Password.credential
        Session.token


{-| Run one wrong-password login and swallow the expected failure, for stacking
lockout attempts.
-}
wrongLogin : Sqlite.Database -> Crypto.SecureContext -> String -> Task x {}
wrongLogin database secureContext username =
    doLogin database secureContext { identifier = username, secret = Password.fromString "not the password" }
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| Create an account, then drive [`Auth.Simple.Login.login`](Auth.Simple.Login)
with the username identifier and password credential. Asserts the issued session
belongs to the new user, that every flavor of bad input fails with
`InvalidCredentials`, that dead sessions don't verify, and that repeated failures
lock the account.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        password : String
        password =
            "example password"

        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ Auth.Simple.migrationV1
            , Username.migration.v1
            , Password.migrationV1
            , Session.migration.v1
            , Code.migration.v1
            ]
    in
    await
        "Open the on-disk test database (credential login)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test.sqlite"))
        (\database ->
            await
                "Apply migrations (credential login)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix (credential login)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            let
                                username : String
                                username =
                                    "alice-" ++ suffix
                            in
                            await
                                "Register the identifier + credential combo"
                                (doRegister { username = username, password = password } database secureContext)
                                (\created ->
                                    concat
                                        [ await
                                            "Log in with the username and correct password"
                                            (doLogin database secureContext { identifier = username, secret = Password.fromString password })
                                            (\result ->
                                                await
                                                    "Verify the session by its raw token"
                                                    (Session.verifyToken result.token database secureContext)
                                                    (\maybeSession ->
                                                        concat
                                                            [ test "the new session belongs to the user that just logged in"
                                                                (\_ -> Expect.equal created.userId result.session.userId)
                                                            , test "login returns a non-empty raw token"
                                                                (\_ -> Expect.notEqual "" result.token)
                                                            , test "the stored session token is a hash, not the raw token"
                                                                (\_ -> Expect.notEqual result.token result.session.sessionToken)
                                                            , test "verifying the raw token resolves the stored session"
                                                                (\_ -> Expect.equal (Just result.session.sessionToken) (Maybe.map .sessionToken maybeSession))
                                                            , test "verification touches last_used_at"
                                                                (\_ ->
                                                                    Maybe.map .lastUsedAt maybeSession
                                                                        |> Maybe.withDefault 0
                                                                        |> Expect.atLeast result.session.lastUsedAt
                                                                )
                                                            ]
                                                    )
                                            )
                                        , awaitError
                                            "Log in with the right username but wrong password"
                                            (doLogin database secureContext { identifier = username, secret = Password.fromString "wrong password" })
                                            (\error ->
                                                test "a wrong password fails with InvalidCredentials"
                                                    (\_ -> Expect.equal Login.InvalidCredentials error)
                                            )
                                        , awaitError
                                            "Log in with a username that does not exist"
                                            (doLogin database secureContext { identifier = "does-not-exist-" ++ suffix, secret = Password.fromString password })
                                            (\error ->
                                                test "an unknown username also fails with InvalidCredentials"
                                                    (\_ -> Expect.equal Login.InvalidCredentials error)
                                            )
                                        , await
                                            "Log in, then revoke the session"
                                            (doLogin database secureContext { identifier = username, secret = Password.fromString password }
                                                |> Task.andThen
                                                    (\result ->
                                                        Session.revoke result.token database secureContext
                                                            |> Task.mapError Login.TokenError
                                                            |> Task.map (\_ -> result.token)
                                                    )
                                            )
                                            (\revokedToken ->
                                                await
                                                    "Verify the revoked token"
                                                    (Session.verifyToken revokedToken database secureContext)
                                                    (\maybeSession ->
                                                        test "a revoked session no longer verifies"
                                                            (\_ -> Expect.equal Nothing maybeSession)
                                                    )
                                            )
                                        , await
                                            "Create a session that expired in the past"
                                            (Session.create { userId = created.userId, expiresAt = 0 } database secureContext)
                                            (\expired ->
                                                await
                                                    "Verify the expired token"
                                                    (Session.verifyToken expired.token database secureContext)
                                                    (\maybeSession ->
                                                        test "an expired session no longer verifies"
                                                            (\_ -> Expect.equal Nothing maybeSession)
                                                    )
                                            )
                                        , await
                                            "Register a username with no credential"
                                            (registerIdentifierOnly ("nopass-" ++ suffix) database secureContext)
                                            (\_ ->
                                                awaitError
                                                    "Log in against the credential-less username"
                                                    (doLogin database secureContext { identifier = "nopass-" ++ suffix, secret = Password.fromString password })
                                                    (\error ->
                                                        test "a user with no stored credential fails with InvalidCredentials"
                                                            (\_ -> Expect.equal Login.InvalidCredentials error)
                                                    )
                                            )
                                        , await
                                            "Register a second account and burn five wrong passwords"
                                            (doRegister { username = "bob-" ++ suffix, password = password } database secureContext
                                                |> Task.andThen
                                                    (\_ ->
                                                        Task.sequence (Array.repeat 5 (wrongLogin database secureContext ("bob-" ++ suffix)))
                                                    )
                                            )
                                            (\_ ->
                                                awaitError
                                                    "Log in with the correct password while locked"
                                                    (doLogin database secureContext { identifier = "bob-" ++ suffix, secret = Password.fromString password })
                                                    (\error ->
                                                        test "five failures lock the account even against the correct password"
                                                            (\_ -> Expect.equal Login.Locked error)
                                                    )
                                            )
                                        ]
                                )
                        )
                )
        )
