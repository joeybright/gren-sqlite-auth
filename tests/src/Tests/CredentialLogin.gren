module Tests.CredentialLogin exposing ( tests )

{-| End-to-end tests for the generic [`Auth.Simple.Login`](Auth.Simple.Login)
workflow, run against the on-disk `tests/test.sqlite`.

An account is set up through [`Auth.Simple.Register.register`](Auth.Simple.Register),
driven with the username identifier and the password credential: it creates the
`users` row, the `usernames` row (the identifier), and the hashed `passwords` row
(the credential). With that in place, login is built by partially applying `login`
with the same identifier and credential, then called with a runtime username +
plain-text password.

The database persists across runs, so each run derives a unique username from a
fresh UUID.

@docs tests

-}

import Auth.Simple
import Auth.Simple.Credential.Password as Password
import Auth.Simple.Identifier.Username as Username
import Auth.Simple.Login as Login
import Auth.Simple.Register as Register
import Auth.Simple.Session
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Migrate
import Task exposing ( Task )
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| The ways setting up a test account can fail: hashing the password, or the
registration writes that [`Auth.Simple.Register.register`](Auth.Simple.Register)
drives.
-}
type SetupError
    = HashError Password.HashPasswordError
    | RegisterError (Register.Error Sqlite.Error Password.AsCredentialError)


{-| Register an identifier + credential combo through
[`Auth.Simple.Register.register`](Auth.Simple.Register): hash the plain-text password
into a `Password_ Hashed`, then create the user, the username identifier, and the
password credential in one task. Returns the new `userId`.
-}
doRegister :
    { username : String, password : String }
    -> Sqlite.Database
    -> Crypto.SecureContext
    -> Task SetupError { userId : String }
doRegister { username, password } database secureContext =
    Password.hashWithDefaults (Password.fromString password) secureContext
        |> Task.mapError HashError
        |> Task.andThen
            (\hashedPassword ->
                Register.register database secureContext Username.identifier Password.credential
                    { userId = Nothing, value = username, secret = hashedPassword }
                    |> Task.mapError RegisterError
            )


{-|-}
doLogin :
    Sqlite.Database
    -> Crypto.SecureContext
    -> { identifier : String
    , secret : Password.Password_ Password.PlainText 
    }
    -> Task 
        (Login.Error Sqlite.Error Password.AsCredentialError) 
        { session : Auth.Simple.Session.Session
        , token : String 
        }
doLogin database secureContext =
    Login.login database secureContext Username.identifier Password.credential


{-| Create an account, then drive [`Auth.Simple.Login.login`](Auth.Simple.Login)
with the username identifier and password credential. Asserts the issued session
belongs to the new user, that a wrong password fails with `CredentialError`, and
that an unknown username fails with `IdentifierNotFound`.
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        password : String
        password =
            "example password"

        migrations : Array Sqlite.Migrate.Migration
        migrations =
            [ Auth.Simple.migrationV1
            , Username.migration.v1
            , Password.migrationV1
            ]
    in
    await
        "Open the on-disk test database (credential login)"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test.sqlite"))
        (\database ->
            await
                "Apply migrations (credential login)"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix (credential login)"
                        (Crypto.randomUuidV4 secureContext)
                        (\suffix ->
                            let
                                username : String
                                username =
                                    "alice-" ++ suffix
                            in
                            await
                                "Register the identifier + credential combo"
                                (doRegister { username = username, password = password } database secureContext)
                                (\created ->
                                    concat
                                        [ await
                                            "Log in with the username and correct password"
                                            (doLogin database secureContext { identifier = username, secret = Password.fromString password })
                                            (\result ->
                                                await
                                                    "Look up the session by its raw token"
                                                    (Auth.Simple.Session.getByToken result.token database secureContext)
                                                    (\maybeSession ->
                                                        concat
                                                            [ test "the new session belongs to the user that just logged in"
                                                                (\_ -> Expect.equal created.userId result.session.userId)
                                                            , test "login returns a non-empty raw token"
                                                                (\_ -> Expect.notEqual "" result.token)
                                                            , test "the stored session id is a hash, not the raw token"
                                                                (\_ -> Expect.notEqual result.token result.session.id)
                                                            , test "looking up by the raw token resolves the stored session"
                                                                (\_ -> Expect.equal (Just result.session.id) (Maybe.map .id maybeSession))
                                                            ]
                                                    )
                                            )
                                        , awaitError
                                            "Log in with the right username but wrong password"
                                            (doLogin database secureContext { identifier = username, secret = Password.fromString "wrong password" })
                                            (\error ->
                                                test "a wrong password fails with CredentialError PasswordMismatch"
                                                    (\_ ->
                                                        Expect.equal
                                                            (Login.CredentialError (Password.VerificationError Password.PasswordMismatch))
                                                            error
                                                    )
                                            )
                                        , awaitError
                                            "Log in with a username that does not exist"
                                            (doLogin database secureContext { identifier = "does-not-exist-" ++ suffix, secret = Password.fromString password })
                                            (\error ->
                                                test "an unknown username fails with IdentifierNotFound"
                                                    (\_ -> Expect.equal Login.IdentifierNotFound error)
                                            )
                                        ]
                                )
                        )
                )
        )
