module Tests.Login exposing ( tests )

{-| End-to-end test against a real on-disk SQLite database (`tests/test.sqlite`).

Registration and login are separate steps. First it registers a user via
[`Auth.Simple.UsernamePassword.create`](Auth.Simple.UsernamePassword), which
returns only the new `userId` and issues no session. Then it logs in via
[`login`](Auth.Simple.UsernamePassword) — the realistic flow, starting from the
typed username and password rather than a `userId` the handler wouldn't have. The
database persists across runs, so each run gives the user a random username suffix
to avoid the `usernames.username` UNIQUE constraint.

@docs tests

-}

import Auth.Simple
import Auth.Simple.Identifier.Username
import Auth.Simple.Credential.Password
import Auth.Simple.Session
import Auth.Simple.UsernamePassword
import Crypto
import Expect
import FileSystem
import FileSystem.Path
import Sqlite
import Sqlite.Migrate
import Test.Runner.Effectful exposing ( await, awaitError, concat, test )


{-| Register a user (user, username, password) through `create`, then log in
through `login` with that username and password. Asserts the issued session
belongs to the registered user, and that both a wrong password and an unknown
username are rejected with the same `InvalidCredentials` (so neither reveals
whether the username exists).
-}
tests : FileSystem.Permission -> Crypto.SecureContext -> Test.Runner.Effectful.Test
tests fsPermission secureContext =
    let
        password : String
        password =
            "example password"

        migrations : Array Sqlite.Migrate.Migration
        migrations =
            -- One migration per feature, in dependency order. `migrate` records
            -- each in `__gren_sqlite_migrate` and skips ones already applied.
            [ Auth.Simple.migrationV1
            , Auth.Simple.Identifier.Username.migration.v1
            , Auth.Simple.Credential.Password.migrationV1
            ]
    in
    await
        "Open the on-disk test database"
        (Sqlite.open fsPermission Sqlite.defaultOptions (FileSystem.Path.fromPosixString "test.sqlite"))
        (\database ->
            await
                "Apply migrations"
                (Sqlite.Migrate.migrate database { secureContext = secureContext } migrations)
                (\_ ->
                    await
                        "Generate a unique username suffix"
                        (Crypto.randomUuidV4 secureContext)
                        (\usernameSuffix ->
                            let
                                username : String
                                username =
                                    "alice-" ++ usernameSuffix
                            in
                            await
                                "Register the user via create"
                                (Auth.Simple.UsernamePassword.create
                                    { username = username
                                    , password = password
                                    }
                                    database
                                    secureContext
                                )
                                (\created ->
                                    concat
                                        [ await
                                            "Log in via login (username + password)"
                                            (Auth.Simple.UsernamePassword.login
                                                { username = username
                                                , password = password
                                                }
                                                database
                                                secureContext
                                            )
                                            (\result ->
                                                await
                                                    "Look up the session by its raw token"
                                                    (Auth.Simple.Session.getByToken result.token database secureContext)
                                                    (\maybeSession ->
                                                        concat
                                                            [ test "the new session belongs to the user that just logged in"
                                                                (\_ -> Expect.equal created.userId result.session.userId)
                                                            , test "login returns a non-empty raw token"
                                                                (\_ -> Expect.notEqual "" result.token)
                                                            , test "the stored session id is a hash, not the raw token"
                                                                (\_ -> Expect.notEqual result.token result.session.id)
                                                            , test "looking up by the raw token resolves the stored session"
                                                                (\_ -> Expect.equal (Just result.session.id) (Maybe.map .id maybeSession))
                                                            ]
                                                    )
                                            )
                                        , awaitError
                                            "Log in with the right username but wrong password"
                                            (Auth.Simple.UsernamePassword.login
                                                { username = username
                                                , password = "wrong password"
                                                }
                                                database
                                                secureContext
                                            )
                                            (\error ->
                                                test "a wrong password is rejected with InvalidCredentials"
                                                    (\_ -> Expect.equal Auth.Simple.UsernamePassword.InvalidCredentials error)
                                            )
                                        , awaitError
                                            "Log in with a username that does not exist"
                                            (Auth.Simple.UsernamePassword.login
                                                { username = "does-not-exist-" ++ usernameSuffix
                                                , password = password
                                                }
                                                database
                                                secureContext
                                            )
                                            (\error ->
                                                test "an unknown username is rejected with the same InvalidCredentials"
                                                    (\_ -> Expect.equal Auth.Simple.UsernamePassword.InvalidCredentials error)
                                            )
                                        ]
                                )
                        )
                )
        )
